    {/* ── full sync: replay every block from genesis, rebuilding state ── */}
    {name === "syncgenesis" && (
      <svg viewBox="0 0 480 196" role="img" aria-label="Full sync replays every block from genesis">
        <text class="t-cap" x="40" y="26">{L("genesis")}</text>
        <text class="t-cap" x="442" y="26">{L("head")}</text>
