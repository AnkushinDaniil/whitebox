---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  useTranslations,
  localizePath,
  entryLang,
  entrySlug,
  type Lang,
} from "@/i18n/utils";
import { FORKS, ARTICLE_META, type EipCategory } from "@/data/forks";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const explorables = (
  await getCollection("explorables", ({ data }) => !data.draft && data.spine)
)
  .filter((e) => entryLang(e.id) === lang)
  .sort((a, b) => a.data.order - b.data.order);

// Foundational series (everything that isn't a numbered EIP), grouped by topic.
const foundational = explorables.filter((e) => e.data.topic !== "EIPs");
const byTopic = foundational.reduce<Record<string, typeof explorables>>(
  (acc, e) => {
    (acc[e.data.topic] ??= []).push(e);
    return acc;
  },
  {},
);

// EIP explorables are English-only deep-dives, so the category + fork views
// always resolve and link to the EN entry (even on the RU hub).
const enBySlug = new Map(
  (await getCollection("explorables", ({ data }) => !data.draft && data.spine))
    .filter((e) => entryLang(e.id) === "en")
    .map((e) => [entrySlug(e.id), e]),
);
const CATS: { key: EipCategory; label: string; desc: string }[] = [
  { key: "execution", label: t.hub.catExecution, desc: t.hub.catExecutionD },
  { key: "consensus", label: t.hub.catConsensus, desc: t.hub.catConsensusD },
  { key: "general", label: t.hub.catGeneral, desc: t.hub.catGeneralD },
];
const catArticles = (cat: EipCategory) =>
  Object.entries(ARTICLE_META)
    .filter(([, m]) => m.category === cat)
    .map(([slug, m]) => ({ slug, meta: m, entry: enBySlug.get(slug) }))
    .filter((x) => x.entry)
    .sort((a, b) => (a.entry!.data.order ?? 0) - (b.entry!.data.order ?? 0));

const forks = [...FORKS].reverse(); // newest first
const eipNum = (e: string) => e.split("/")[0];
const specHref = (e: string) =>
  /^\d/.test(e) ? `https://eips.ethereum.org/EIPS/eip-${eipNum(e)}` : null;
---

<BaseLayout title={t.hub.h1} description={t.hub.lede} lang={lang}>
  <div class="wrap">
    <header class="hub-head">
      <p class="mono-label">{t.hub.eyebrow}</p>
      <h1>{t.hub.h1}</h1>
      <p class="lede">{t.hub.lede}</p>
    </header>

    {/* ── Guided series (foundational explorables) ── */}
    <h2 class="section-title">{t.hub.seriesTitle}</h2>
    {
      Object.entries(byTopic).map(([topic, items]) => (
        <section class="topic-group">
          <h3 class="topic-title">{topic}</h3>
          <ul>
            {items.map((e) => (
              <li>
                <a href={localizePath(`/${entrySlug(e.id)}`, lang)}>
                  <span class="meta">
                    <span class="t">{e.data.title}</span>
                    <span class="d">{e.data.dek}</span>
                  </span>
                  {e.data.readingMinutes && (
                    <span class="time">{e.data.readingMinutes}{t.exp.min}</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    {/* ── EIPs by category ── */}
    <section class="cat-section">
      <h2 class="section-title">{t.hub.catTitle}</h2>
      <p class="section-lede">{t.hub.catLede}</p>
      {
        CATS.map((c) => {
          const items = catArticles(c.key);
          return items.length > 0 ? (
            <div class="cat-block">
              <h3 class="cat-h">
                <span class={`dot ${c.key}`} />
                {c.label}
                <span class="cat-d">{c.desc}</span>
              </h3>
              <ul>
                {items.map(({ slug, meta, entry }) => (
                  <li>
                    <a href={`/${slug}`}>
                      <span class="meta">
                        <span class="t">
                          <span class="eip-tag">EIP-{meta.eip}</span>
                          {entry!.data.title}
                        </span>
                        <span class="d">{entry!.data.dek}</span>
                      </span>
                      {entry!.data.readingMinutes && (
                        <span class="time">{entry!.data.readingMinutes}{t.exp.min}</span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : null;
        })
      }
    </section>

    {/* ── Every fork, every EIP ── */}
    <section class="forks-section">
      <h2 class="section-title">{t.hub.forksTitle}</h2>
      <p class="section-lede">{t.hub.forksLede}</p>
      <ol class="forks">
        {
          forks.map((f) => (
            <li class="fork">
              <div class="fork-head">
                <span class="fork-name">{f.name}</span>
                {f.cl && f.cl !== f.name && (
                  <span class="cl">{t.hub.forksCl} · {f.cl}</span>
                )}
                <span class="fork-date">{f.display}</span>
              </div>
              <p class="fork-blurb">{f.blurb}</p>
              {f.eips.length > 0 && (
                <div class="chips">
                  {f.eips.map((e) =>
                    e.slug ? (
                      <a class="chip covered" href={`/${e.slug}`}>
                        <span class={`dot ${e.category}`} />
                        <b>EIP-{e.eip}</b> {e.title}
                      </a>
                    ) : specHref(e.eip) ? (
                      <a class="chip" href={specHref(e.eip)!} target="_blank" rel="noopener noreferrer">
                        <span class={`dot ${e.category}`} />
                        <b>EIP-{e.eip}</b> {e.title}
                      </a>
                    ) : (
                      <span class="chip plain">
                        <span class={`dot ${e.category}`} />
                        {e.title}
                      </span>
                    ),
                  )}
                </div>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="roadmap">
      <h2 class="section-title">{t.hub.roadmapTitle}</h2>
      <p class="rm-note">{t.hub.roadmapNote}</p>
      <ul class="rm-list">
        {t.hub.roadmapItems.map((i) => <li>{i}</li>)}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: 50rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 0;
  }
  .hub-head h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.03em;
    margin: 0.6rem 0 0.8rem;
    font-weight: 700;
  }
  .lede {
    color: var(--color-ink-muted);
    font-size: 1.08rem;
    max-width: 58ch;
    line-height: 1.6;
  }
  .section-title {
    margin: 3rem 0 0;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
    font-weight: 700;
    color: var(--color-ink);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .section-lede {
    color: var(--color-ink-muted);
    font-size: 0.95rem;
    margin: 0.8rem 0 0;
    max-width: 60ch;
    line-height: 1.55;
  }
  .topic-group {
    margin-top: 1.6rem;
  }
  .topic-title {
    font-size: 0.78rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin: 0 0 0.2rem;
  }
  ul {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .topic-group a,
  .cat-block a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .topic-group a:hover,
  .cat-block a:hover {
    border-color: var(--color-border-strong);
    background: var(--color-surface-2);
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .meta .t {
    color: var(--color-ink);
    font-weight: 600;
  }
  .meta .d {
    color: var(--color-ink-faint);
    font-size: 0.84rem;
  }
  .eip-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-accent);
    background: color-mix(in oklab, var(--color-accent) 12%, var(--color-surface));
    border: 1px solid color-mix(in oklab, var(--color-accent) 30%, transparent);
    border-radius: 4px;
    padding: 0.05rem 0.35rem;
    margin-right: 0.45rem;
    vertical-align: middle;
  }
  .time {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-faint);
  }

  /* category blocks */
  .cat-block {
    margin-top: 1.6rem;
  }
  .cat-h {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0;
  }
  .cat-d {
    font-weight: 400;
    font-size: 0.82rem;
    color: var(--color-ink-faint);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
    flex: none;
    align-self: center;
  }
  .dot.execution {
    background: var(--color-accent);
  }
  .dot.consensus {
    background: var(--color-node-leaf);
  }
  .dot.general {
    background: var(--color-node-extension);
  }

  /* fork timeline */
  .forks {
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .fork {
    border: 1px solid var(--color-border);
    border-left: 2px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-surface);
    padding: 0.85rem 1rem;
  }
  .fork-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .fork-name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-ink);
  }
  .cl {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-node-leaf);
    border: 1px solid color-mix(in oklab, var(--color-node-leaf) 35%, transparent);
    border-radius: 4px;
    padding: 0.02rem 0.32rem;
  }
  .fork-date {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-faint);
  }
  .fork-blurb {
    color: var(--color-ink-muted);
    font-size: 0.86rem;
    line-height: 1.45;
    margin: 0.35rem 0 0.65rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.76rem;
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    padding: 0.28rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 5px;
    background: var(--color-surface-2);
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .chip b {
    color: var(--color-ink);
    font-weight: 600;
  }
  a.chip:hover {
    border-color: var(--color-border-strong);
    color: var(--color-ink);
  }
  a.chip.covered {
    border-color: color-mix(in oklab, var(--color-accent) 40%, transparent);
    background: color-mix(in oklab, var(--color-accent) 9%, var(--color-surface));
  }
  a.chip.covered b {
    color: var(--color-accent-strong);
  }
  a.chip.covered:hover {
    border-color: var(--color-accent);
    background: color-mix(in oklab, var(--color-accent) 15%, var(--color-surface));
  }
  .chip.plain {
    opacity: 0.85;
  }

  .roadmap {
    margin-top: 1.4rem;
  }
  .rm-note {
    color: var(--color-ink-muted);
    margin: 0.8rem 0 0.6rem;
    font-size: 0.92rem;
  }
  .rm-list {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .rm-list li {
    color: var(--color-ink-faint);
    font-size: 0.9rem;
    padding-left: 1rem;
    position: relative;
  }
  .rm-list li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--color-border-strong);
  }
</style>
