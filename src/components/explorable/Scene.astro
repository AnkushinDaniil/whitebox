        <rect class="dc-you" x="20" y="40" width="150" height="96" rx="8" />
        <text class="t-cap" x="95" y="60">{L("your contract")}</text>
        <rect class="dc-slot dc-empty" x="40" y="74" width="110" height="24" rx="4" />
        <text class="t-fld dc-slott" x="95" y="90">storage: empty</text>
        <text class="t-x dc-unchanged" x="95" y="120">{L("✗ never written")}</text>
        <path class="sarrow dc-c1" d="M170 74 H262" /><text class="t-cap dc-cl" x="216" y="66">CALL</text>
        <rect class="dc-libbox" x="262" y="40" width="196" height="96" rx="8" />
        <text class="t-cap" x="360" y="60">{L("Library")}</text>
