        <g class="mpt-node">
          <rect class="mpt-leaf" x="56" y="246" width="82" height="34" rx="7" />
          <text class="mpt-kind-l" x="97" y="262" text-anchor="middle">{L("leaf")}</text>
          <text class="mpt-lval" x="97" y="275" text-anchor="middle">0xB2 · 6 Ξ</text>
        </g>
        <g class="mpt-node">
          <rect class="mpt-leaf mpt-leaf-hot" x="194" y="244" width="92" height="38" rx="7" />
          <text class="mpt-kind-l mpt-leaflbl-hot" x="240" y="260" text-anchor="middle">{L("leaf")} ✎</text>
          <text class="mpt-lval mpt-lv-before" x="240" y="274" text-anchor="middle">0xA1 · 9 Ξ</text>
          <text class="mpt-lval mpt-lv-after" x="240" y="274" text-anchor="middle">0xA1 · 14 Ξ</text>
        </g>
        <g class="mpt-node">
          <rect class="mpt-leaf" x="342" y="246" width="82" height="34" rx="7" />
          <text class="mpt-kind-l" x="383" y="262" text-anchor="middle">{L("leaf")}</text>
          <text class="mpt-lval" x="383" y="275" text-anchor="middle">0xC3 · 2 Ξ</text>
        </g>

        <text class="t-cap" x="240" y="322" text-anchor="middle">{L("edit one leaf → its path re-hashes up to a new root")}</text>
      </svg>
    )}

    {/* ── full sync: replay every block from genesis, rebuilding state ── */}
    {name === "syncgenesis" && (
      <svg viewBox="0 0 480 196" role="img" aria-label="Full sync replays every block from genesis">
        <text class="t-cap" x="40" y="26">{L("genesis")}</text>
        <text class="t-cap" x="442" y="26">{L("head")}</text>
        {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => (
          <rect class="block" x={24 + i * 56} y="34" width="44" height="30" rx="5" />
        ))}
