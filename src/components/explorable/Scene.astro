        <rect class="ga-track" x="40" y="42" width="400" height="24" rx="12" />
        <rect class="ga-spent" x="44" y="46" width="302" height="16" rx="6" />
        <rect class="ga-fill" x="348" y="46" width="88" height="16" rx="6" />
