---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  useTranslations,
  localizePath,
  entryLang,
  entrySlug,
  type Lang,
} from "@/i18n/utils";
import { BOOK, flatChapters } from "@/data/book";
import { FORKS } from "@/data/forks";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const all = await getCollection("explorables", ({ data }) => !data.draft);
const meta = (slug: string) => {
  const inLang = all.find((e) => entrySlug(e.id) === slug && entryLang(e.id) === lang);
  const enOnly = all.find((e) => entrySlug(e.id) === slug && entryLang(e.id) === "en");
  const e = inLang ?? enOnly;
  const hasLang = !!inLang;
  return e ? { data: e.data, hasLang } : null;
};
const numberOf = new Map(flatChapters().map((c) => [c.slug, c.number]));

const forks = [...FORKS].reverse();
const eipNum = (e: string) => e.split("/")[0];
const specHref = (e: string) =>
  /^\d/.test(e) ? `https://eips.ethereum.org/EIPS/eip-${eipNum(e)}` : null;
---

<BaseLayout title={t.hub.h1} description={t.hub.lede} lang={lang}>
  <div class="wrap">
    <header class="hub-head">
      <p class="mono-label">{t.hub.eyebrow}</p>
      <h1>{t.hub.h1}</h1>
      <p class="lede">{t.hub.lede}</p>
    </header>

    {/* ── The book, in order ── */}
    <div class="toc">
      {
        BOOK.map((part) => (
          <section class="part">
            <div class="part-head">
              <span class="part-n">{t.book.part} {part.n}</span>
              <h2 class="part-title">{t.book.parts[part.n]?.title ?? part.title}</h2>
              <p class="part-blurb">{t.book.parts[part.n]?.blurb ?? part.blurb}</p>
            </div>
            {part.groups.map((g) => (
              <div class="group">
                {(g.forkName || g.label) && (
                  <div class="group-head">
                    <span class="group-name">
                      {g.forkName ?? (g.label === "Application layer" ? t.book.appLayer : g.label)}
                    </span>
                    {g.date && <span class="group-date">{g.date}</span>}
                  </div>
                )}
                <ul>
                  {g.chapters.map((ch) => {
                    const m = meta(ch.slug);
                    if (!m) return null;
                    const href = m.hasLang
                      ? localizePath(`/${ch.slug}`, lang)
                      : `/${ch.slug}`;
                    return (
                      <li>
                        <a href={href}>
                          <span class="ch-n">{numberOf.get(ch.slug)}</span>
                          <span class="ch-meta">
                            <span class="ch-t">{m.data.title}</span>
                            <span class="ch-d">{m.data.dek}</span>
                          </span>
                          {m.data.readingMinutes && (
                            <span class="time">{m.data.readingMinutes}{t.exp.min}</span>
                          )}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
          </section>
        ))
      }
    </div>

    {/* ── Full fork history (appendix / alternate index) ── */}
    <section class="forks-section">
      <h2 class="section-title">{t.hub.forksTitle}</h2>
      <p class="section-lede">{t.hub.forksLede}</p>
      <ol class="forks">
        {
          forks.map((f) => (
            <li class="fork">
              <div class="fork-head">
                <span class="fork-name">{f.name}</span>
                {f.cl && f.cl !== f.name && (
                  <span class="cl">{t.hub.forksCl} · {f.cl}</span>
                )}
                <span class="fork-date">{f.display}</span>
              </div>
              <p class="fork-blurb">{f.blurb}</p>
              {f.eips.length > 0 && (
                <div class="chips">
                  {f.eips.map((e) =>
                    e.slug ? (
                      <a class="chip covered" href={`/${e.slug}`}>
                        <span class={`dot ${e.category}`} />
                        <b>EIP-{e.eip}</b> {e.title}
                      </a>
                    ) : specHref(e.eip) ? (
                      <a class="chip" href={specHref(e.eip)!} target="_blank" rel="noopener noreferrer">
                        <span class={`dot ${e.category}`} />
                        <b>EIP-{e.eip}</b> {e.title}
                      </a>
                    ) : (
                      <span class="chip plain">
                        <span class={`dot ${e.category}`} />
                        {e.title}
                      </span>
                    ),
                  )}
                </div>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="roadmap">
      <h2 class="section-title">{t.hub.roadmapTitle}</h2>
      <p class="rm-note">{t.hub.roadmapNote}</p>
      <ul class="rm-list">
        {t.hub.roadmapItems.map((i) => <li>{i}</li>)}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: 50rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 0;
  }
  .hub-head h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.03em;
    margin: 0.6rem 0 0.8rem;
    font-weight: 700;
  }
  .lede {
    color: var(--color-ink-muted);
    font-size: 1.08rem;
    max-width: 58ch;
    line-height: 1.6;
  }

  /* book table of contents */
  .toc {
    margin-top: 1rem;
  }
  .part {
    margin-top: 2.6rem;
  }
  .part-head {
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1rem;
  }
  .part-n {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .part-title {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0.25rem 0 0.4rem;
  }
  .part-blurb {
    color: var(--color-ink-muted);
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 60ch;
    margin: 0;
  }
  .group {
    margin-top: 1rem;
  }
  .group-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 1.2rem 0 0.5rem;
  }
  .group-name {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-node-leaf);
  }
  .group-date {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-ink-faint);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .toc a {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .toc a:hover {
    border-color: var(--color-border-strong);
    background: var(--color-surface-2);
  }
  .ch-n {
    flex: none;
    width: 1.8rem;
    height: 1.8rem;
    display: inline-grid;
    place-items: center;
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-ink-muted);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
  }
  .ch-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
    flex: 1;
  }
  .ch-t {
    color: var(--color-ink);
    font-weight: 600;
  }
  .ch-d {
    color: var(--color-ink-faint);
    font-size: 0.84rem;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .eip-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-accent);
    background: color-mix(in oklab, var(--color-accent) 12%, var(--color-surface));
    border: 1px solid color-mix(in oklab, var(--color-accent) 30%, transparent);
    border-radius: 4px;
    padding: 0.05rem 0.35rem;
    margin-right: 0.45rem;
    vertical-align: middle;
  }
  .time {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-faint);
  }

  /* shared section titles */
  .section-title {
    margin: 3rem 0 0;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
    font-weight: 700;
    color: var(--color-ink);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .section-lede {
    color: var(--color-ink-muted);
    font-size: 0.95rem;
    margin: 0.8rem 0 0;
    max-width: 60ch;
    line-height: 1.55;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
    flex: none;
    align-self: center;
  }
  .dot.execution { background: var(--color-accent); }
  .dot.consensus { background: var(--color-node-leaf); }
  .dot.general { background: var(--color-node-extension); }

  /* fork timeline */
  .forks {
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .fork {
    border: 1px solid var(--color-border);
    border-left: 2px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-surface);
    padding: 0.85rem 1rem;
  }
  .fork-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .fork-name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-ink);
  }
  .cl {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-node-leaf);
    border: 1px solid color-mix(in oklab, var(--color-node-leaf) 35%, transparent);
    border-radius: 4px;
    padding: 0.02rem 0.32rem;
  }
  .fork-date {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-faint);
  }
  .fork-blurb {
    color: var(--color-ink-muted);
    font-size: 0.86rem;
    line-height: 1.45;
    margin: 0.35rem 0 0.65rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.76rem;
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    padding: 0.28rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 5px;
    background: var(--color-surface-2);
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .chip b {
    color: var(--color-ink);
    font-weight: 600;
  }
  a.chip:hover {
    border-color: var(--color-border-strong);
    color: var(--color-ink);
  }
  a.chip.covered {
    border-color: color-mix(in oklab, var(--color-accent) 40%, transparent);
    background: color-mix(in oklab, var(--color-accent) 9%, var(--color-surface));
  }
  a.chip.covered b {
    color: var(--color-accent-strong);
  }
  a.chip.covered:hover {
    border-color: var(--color-accent);
    background: color-mix(in oklab, var(--color-accent) 15%, var(--color-surface));
  }
  .chip.plain {
    opacity: 0.85;
  }

  .roadmap {
    margin-top: 1.4rem;
  }
  .rm-note {
    color: var(--color-ink-muted);
    margin: 0.8rem 0 0.6rem;
    font-size: 0.92rem;
  }
  .rm-list {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .rm-list li {
    color: var(--color-ink-faint);
    font-size: 0.9rem;
    padding-left: 1rem;
    position: relative;
  }
  .rm-list li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--color-border-strong);
  }
</style>
