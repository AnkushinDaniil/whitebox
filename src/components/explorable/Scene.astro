        <text class="t-x sh-cost" x="240" y="108" text-anchor="middle">{L("a multiply/divide + a pushed constant, for a basic bit shift")}</text>
        <text class="t-x sh-signed" x="240" y="136" text-anchor="middle">{L("and DIV can't do a correct signed (arithmetic) right shift")}</text>
        <text class="t-cap" x="240" y="166" text-anchor="middle">{L("a fundamental CPU operation, simulated with arithmetic")}</text>
      </svg>
    )}

    {/* ── EIP-145: native SHL / SHR / SAR ── */}
    {name === "sh-ops" && (
      <svg viewBox="0 0 480 178" role="img" aria-label="EIP-145 adds native SHL, SHR, and SAR shift opcodes">
        <text class="t-cap" x="240" y="18">{L("EIP-145: three native shift opcodes")}</text>
        {[
          { op: "SHL", lbl: "shift left", y: 44, cls: "sh-move0", bits: [2, 4, 5], sign: false },
          { op: "SHR", lbl: "logical right", y: 82, cls: "sh-move1", bits: [1, 2, 4], sign: false },
          { op: "SAR", lbl: "arithmetic right", y: 120, cls: "sh-move2", bits: [1, 3, 4], sign: true },
        ].map((r) => (
          <g>
            <text class="sh-opn2" x="26" y={r.y - 2} text-anchor="start">{r.op}</text>
            <text class="sh-opd2" x="26" y={r.y + 14} text-anchor="start">{L(r.lbl)}</text>
            {[0, 1, 2, 3, 4, 5].map((i) => (
              <rect class="sh-cell" x={170 + i * 30} y={r.y - 12} width="26" height="26" rx="4" />
            ))}
            {r.sign && <text class="sh-one sh-sign" x="183" y={r.y + 6} text-anchor="middle">1</text>}
            <g class={`sh-move ${r.cls}`}>
              {r.bits.map((p) => (
                <text class="sh-one" x={183 + p * 30} y={r.y + 6} text-anchor="middle">1</text>
              ))}
            </g>
          </g>
        ))}
        <text class="t-cap sh-3" x="240" y="166" text-anchor="middle">{L("SAR preserves the sign bit — signed shifts finally correct")}</text>
      </svg>
    )}

    {/* ── EIP-145: cheaper bit-twiddling ── */}
    {name === "sh-result" && (
      <svg viewBox="0 0 480 168" role="img" aria-label="Native shifts make bit manipulation cheaper and smaller">
        <text class="t-cap" x="240" y="26">{L("every shift gets cheaper and smaller")}</text>
        <text class="sh-codeold" x="240" y="80" text-anchor="middle">PUSH1 0x10  MUL</text>
        <text class="sh-codenew" x="240" y="80" text-anchor="middle">SHL</text>
        <text class="t-ok sh-use" x="240" y="122" text-anchor="middle">{L("packing structs, bitmaps, fixed-point, cryptography — all leaner")}</text>
        <text class="t-cap" x="240" y="150" text-anchor="middle">{L("compilers emit them; the same 'add the missing primitive' story")}</text>
      </svg>
    )}

    {/* ── EIP-3198/7516: the protocol computes fees the EVM couldn't read ── */}
    {name === "fm-blind" && (
      <svg viewBox="0 0 480 192" role="img" aria-label="EIP-1559 computes a base fee each block but a contract could only read the combined gas price, not the base fee itself">
        <text class="t-cap" x="240" y="20">{L("the protocol computes fees each block…")}</text>
        <rect class="fm-proto" x="24" y="36" width="200" height="64" rx="8" />
        <text class="t-cap fm-pt" x="124" y="58">{L("EIP-1559 base fee")}</text>
        <text class="t-fld fm-pt2" x="124" y="78">{L("EIP-4844 blob base fee")}</text>
        <text class="t-fld fm-pt3" x="124" y="94">{L("computed, burned, on-chain")}</text>
        <path class="sarrow fm-wall" d="M224 68 H300" /><text class="t-x fm-walll" x="262" y="60">{L("no way in")}</text>
        <rect class="fm-evm" x="300" y="36" width="156" height="64" rx="8" />
        <text class="t-cap fm-et" x="378" y="60">{L("a contract")}</text>
        <text class="t-x fm-et2" x="378" y="82">{L("sees only GASPRICE")}</text>
        <text class="t-x fm-mix" x="240" y="132" text-anchor="middle">{L("GASPRICE = base + priority, fused — can't read the base fee alone")}</text>
        <text class="t-cap" x="240" y="160" text-anchor="middle">{L("gas oracles & relayers computing refunds are flying blind")}</text>
        <text class="t-cap" x="240" y="182" text-anchor="middle">{L("the fee exists in the protocol but not in the EVM")}</text>
      </svg>
    )}

    {/* ── EIP-3198/7516: two opcodes expose the fees ── */}
    {name === "fm-opcode" && (
      <svg viewBox="0 0 480 176" role="img" aria-label="BASEFEE and BLOBBASEFEE opcodes push the protocol-computed fees onto the stack">
        <text class="t-cap" x="240" y="20">{L("just expose the value the protocol already has")}</text>
        <g class="fm-op fm-op0"><rect class="fm-opbox" x="40" y="40" width="190" height="56" rx="8" /><text class="t-ok fm-opn" x="135" y="64">BASEFEE · 0x48</text><text class="t-cap fm-opd" x="135" y="84">{L("pushes the block's base fee")}</text></g>
        <g class="fm-op fm-op1"><rect class="fm-opbox" x="250" y="40" width="190" height="56" rx="8" /><text class="t-ok fm-opn" x="345" y="64">BLOBBASEFEE · 0x4a</text><text class="t-cap fm-opd" x="345" y="84">{L("pushes the blob base fee")}</text></g>
        <text class="t-ok fm-one" x="240" y="128" text-anchor="middle">{L("one-instruction reads of a value already computed each block")}</text>
        <text class="t-cap" x="240" y="156" text-anchor="middle">{L("3198 ships with London/1559 · 7516 ships with Cancun/4844")}</text>
      </svg>
    )}

    {/* ── EIP-3198/7516: contracts reason about the fee market ── */}
    {name === "fm-use" && (
      <svg viewBox="0 0 480 172" role="img" aria-label="Contracts can now reason about the fee market on-chain">
        <text class="t-cap" x="240" y="20">{L("contracts can reason about the fee market on-chain")}</text>
        <g class="fm-row fm-r0"><rect class="fm-chip" x="40" y="36" width="400" height="24" rx="5" /><text class="t-cap fm-cl" x="60" y="52" text-anchor="start">{L("relayers & smart accounts reimburse gas accurately")}</text></g>
        <g class="fm-row fm-r1"><rect class="fm-chip" x="40" y="66" width="400" height="24" rx="5" /><text class="t-cap fm-cl" x="60" y="82" text-anchor="start">{L("on-chain gas oracles & congestion-aware logic")}</text></g>
        <g class="fm-row fm-r2"><rect class="fm-chip" x="40" y="96" width="400" height="24" rx="5" /><text class="t-cap fm-cl" x="60" y="112" text-anchor="start">{L("rollups read the blob base fee to price data availability")}</text></g>
        <text class="t-ok fm-done" x="240" y="148" text-anchor="middle">{L("the missing read that completes EIP-1559 and EIP-4844")}</text>
      </svg>
    )}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .scene {
    margin: 1.6rem auto;
    max-width: 580px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: radial-gradient(120% 100% at 50% 0%, var(--color-surface-2), var(--color-canvas));
    padding: 1.1rem 1.2rem 0.9rem;
  }
  .scene-wide { max-width: 720px; }
  .scene-stage svg { width: 100%; height: auto; display: block; }
  figcaption {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-ink-faint);
    text-align: center;
  }

  /* shared primitives */
  .sheet, .node, .msg, .op, .blk, .cell, .trie, .hdr, .gauge, .si, .pkt, .addr-box {
    fill: url(#wb-node);
    stroke: var(--color-border-strong);
    stroke-width: 1.4;
  }
  .hair, .hair2 { stroke: var(--color-border); stroke-width: 1; }
  .t-mid { fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; }
  .t-l { fill: var(--color-ink); font-family: var(--font-mono); font-size: 12px; }
  .t-r { fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 12px; text-anchor: end; }
  .t-s { fill: var(--color-ink); font-family: var(--font-mono); font-size: 12px; text-anchor: middle; }
  .t-op { fill: var(--color-ink); font-family: var(--font-mono); font-size: 12px; }
  .t-cap { fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 10px; text-anchor: middle; }
  .t-x { fill: var(--color-changed); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; }
  .arrow, .arrow2, .arrow3, .link, .conv { fill: none; stroke: var(--color-border-strong); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .link.dashed { stroke-dasharray: 4 4; }
  .wb-defs { position: absolute; width: 0; height: 0; overflow: visible; }

  /* root (redesigned): directed accent flow, a tree glyph, a hashing root chip */
  .rt-flow { fill: none; stroke: var(--color-accent); stroke-width: 2; }
  .rt-edge { stroke: var(--color-border-strong); stroke-width: 1.6; }
  .rt-edge-hot { animation: rt-edgehot 4s ease-in-out infinite; }
  @keyframes rt-edgehot { 0%,45% { stroke: var(--color-border-strong) } 58%,82% { stroke: var(--color-changed); stroke-width: 2.2 } 100% { stroke: var(--color-border-strong) } }
  .rt-root { fill: url(#wb-accent-fill); stroke: var(--color-accent); stroke-width: 1.6; animation: rt-roothot 4s ease-in-out infinite; }
  @keyframes rt-roothot { 0%,52% { stroke: var(--color-accent) } 64%,86% { stroke: var(--color-changed); stroke-width: 2.4 } 100% { stroke: var(--color-accent) } }
  .rt-trielbl { fill: var(--color-accent-strong); font-family: var(--font-mono); font-size: 10px; }
  .rt-leaf { fill: var(--color-surface-3); stroke: var(--color-border-strong); stroke-width: 1.4; }
  .rt-leaf-hot { animation: rt-leafhot 4s ease-in-out infinite; }
  @keyframes rt-leafhot { 0%,40% { fill: var(--color-surface-3) } 55%,80% { fill: color-mix(in oklab, var(--color-changed) 30%, var(--color-surface)); stroke: var(--color-changed) } 100% { fill: var(--color-surface-3) } }
  .rt-editcell { stroke: var(--color-changed); }
  .rt-pencil { fill: var(--color-changed); font-size: 14px; text-anchor: middle; }
  .rt-hashchip { fill: url(#wb-glow); stroke: var(--color-hash); stroke-width: 1.8; animation: rt-pulse 4s ease-in-out infinite; }
  .rt-hashglyph { fill: var(--color-hash); font-family: var(--font-mono); font-size: 13px; }
  @keyframes rt-pulse { 0%,42% { stroke: var(--color-hash) } 56%,82% { stroke: var(--color-changed) } 100% { stroke: var(--color-hash) } }

  /* mpt: a real trie whose nodes re-hash up the edited path, one level at a time */
  .mpt-rootlbl { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; }
  .mpt-edge { fill: none; stroke: var(--color-ink-faint); stroke-width: 1.7; stroke-linecap: round; }
  .mpt-branch { fill: color-mix(in oklab, var(--color-node-branch) 20%, var(--color-surface)); stroke: var(--color-node-branch); stroke-width: 1.6; }
  .mpt-ext { fill: color-mix(in oklab, var(--color-node-extension) 16%, var(--color-surface)); stroke: var(--color-node-extension); stroke-width: 1.6; }
  .mpt-leaf { fill: color-mix(in oklab, var(--color-node-leaf) 16%, var(--color-surface)); stroke: var(--color-node-leaf); stroke-width: 1.6; }
  .mpt-kind { fill: var(--color-ink); font-family: var(--font-mono); font-size: 11px; font-weight: 600; }
  .mpt-kind-l { fill: var(--color-node-leaf); font-family: var(--font-mono); font-size: 10px; }
  .mpt-kind-e { fill: var(--color-node-extension); font-family: var(--font-mono); font-size: 9.5px; }
  .mpt-typ { fill: var(--color-node-branch); font-family: var(--font-mono); font-size: 10px; }
  .mpt-hash { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 10px; }
  .mpt-lval { fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 9.5px; }

  /* the changed path lights up level by level and HOLDS lit until the loop resets,
     so any single frame in the hold window shows the whole re-hashed path at once */
  .mpt-leaf-hot { animation: mpt-leafhot 7s ease-in-out infinite; }
  @keyframes mpt-leafhot {
    0%,8% { fill: color-mix(in oklab, var(--color-node-leaf) 16%, var(--color-surface)); stroke: var(--color-node-leaf); stroke-width: 1.6; }
    15%,90% { fill: color-mix(in oklab, var(--color-changed) 26%, var(--color-surface)); stroke: var(--color-changed); stroke-width: 2.4; }
    96%,100% { fill: color-mix(in oklab, var(--color-node-leaf) 16%, var(--color-surface)); stroke: var(--color-node-leaf); stroke-width: 1.6; }
  }
  .mpt-leaflbl-hot { animation: mpt-leaflblhot 7s ease-in-out infinite; }
  @keyframes mpt-leaflblhot { 0%,8% { fill: var(--color-node-leaf) } 15%,90% { fill: var(--color-changed) } 96%,100% { fill: var(--color-node-leaf) } }
  .mpt-lv-before { animation: mpt-lvbefore 7s ease-in-out infinite; }
  @keyframes mpt-lvbefore { 0%,12% { fill: var(--color-ink-muted) } 16%,93% { fill: transparent } 97%,100% { fill: var(--color-ink-muted) } }
  .mpt-lv-after { fill: transparent; animation: mpt-lvafter 7s ease-in-out infinite; }
  @keyframes mpt-lvafter { 0%,12% { fill: transparent } 16%,93% { fill: var(--color-changed) } 97%,100% { fill: transparent } }

  .mpt-e-bot { animation: mpt-ebot 7s ease-in-out infinite; }
  @keyframes mpt-ebot { 0%,14% { stroke: var(--color-ink-faint); stroke-width: 1.7 } 18%,92% { stroke: var(--color-changed); stroke-width: 2.6 } 96%,100% { stroke: var(--color-ink-faint); stroke-width: 1.7 } }

  .mpt-branch-hot { animation: mpt-branchhot 7s ease-in-out infinite; }
  @keyframes mpt-branchhot {
    0%,22% { fill: color-mix(in oklab, var(--color-node-branch) 20%, var(--color-surface)); stroke: var(--color-node-branch); stroke-width: 1.6; }
    28%,90% { fill: color-mix(in oklab, var(--color-changed) 26%, var(--color-surface)); stroke: var(--color-changed); stroke-width: 2.4; }
    96%,100% { fill: color-mix(in oklab, var(--color-node-branch) 20%, var(--color-surface)); stroke: var(--color-node-branch); stroke-width: 1.6; }
  }
  .mpt-hb-before { animation: mpt-hbbefore 7s ease-in-out infinite; }
  @keyframes mpt-hbbefore { 0%,24% { fill: var(--color-ink-faint) } 28%,93% { fill: transparent } 97%,100% { fill: var(--color-ink-faint) } }
  .mpt-hb-after { fill: transparent; animation: mpt-hbafter 7s ease-in-out infinite; }
  @keyframes mpt-hbafter { 0%,24% { fill: transparent } 28%,93% { fill: var(--color-changed) } 97%,100% { fill: transparent } }

  .mpt-e-mid { animation: mpt-emid 7s ease-in-out infinite; }
  @keyframes mpt-emid { 0%,32% { stroke: var(--color-ink-faint); stroke-width: 1.7 } 36%,92% { stroke: var(--color-changed); stroke-width: 2.6 } 96%,100% { stroke: var(--color-ink-faint); stroke-width: 1.7 } }

  .mpt-ext-hot { animation: mpt-exthot 7s ease-in-out infinite; }
  @keyframes mpt-exthot {
    0%,38% { fill: color-mix(in oklab, var(--color-node-extension) 16%, var(--color-surface)); stroke: var(--color-node-extension); stroke-width: 1.6; }
    44%,90% { fill: color-mix(in oklab, var(--color-changed) 26%, var(--color-surface)); stroke: var(--color-changed); stroke-width: 2.4; }
    96%,100% { fill: color-mix(in oklab, var(--color-node-extension) 16%, var(--color-surface)); stroke: var(--color-node-extension); stroke-width: 1.6; }
  }
  .mpt-he-before { animation: mpt-hebefore 7s ease-in-out infinite; }
  @keyframes mpt-hebefore { 0%,40% { fill: var(--color-ink-faint) } 44%,93% { fill: transparent } 97%,100% { fill: var(--color-ink-faint) } }
  .mpt-he-after { fill: transparent; animation: mpt-heafter 7s ease-in-out infinite; }
  @keyframes mpt-heafter { 0%,40% { fill: transparent } 44%,93% { fill: var(--color-changed) } 97%,100% { fill: transparent } }

  .mpt-e-top { animation: mpt-etop 7s ease-in-out infinite; }
  @keyframes mpt-etop { 0%,50% { stroke: var(--color-ink-faint); stroke-width: 1.7 } 54%,92% { stroke: var(--color-changed); stroke-width: 2.6 } 96%,100% { stroke: var(--color-ink-faint); stroke-width: 1.7 } }

  .mpt-root-hot { animation: mpt-roothot 7s ease-in-out infinite; }
  @keyframes mpt-roothot {
    0%,56% { fill: color-mix(in oklab, var(--color-node-branch) 20%, var(--color-surface)); stroke: var(--color-node-branch); stroke-width: 1.6; }
    62%,90% { fill: color-mix(in oklab, var(--color-changed) 30%, var(--color-surface)); stroke: var(--color-changed); stroke-width: 2.6; }
    96%,100% { fill: color-mix(in oklab, var(--color-node-branch) 20%, var(--color-surface)); stroke: var(--color-node-branch); stroke-width: 1.6; }
  }
  .mpt-h-before { animation: mpt-hbefore 7s ease-in-out infinite; }
  @keyframes mpt-hbefore { 0%,58% { fill: var(--color-ink-faint) } 62%,93% { fill: transparent } 97%,100% { fill: var(--color-ink-faint) } }
  .mpt-h-after { fill: transparent; animation: mpt-hafter 7s ease-in-out infinite; }
  @keyframes mpt-hafter { 0%,58% { fill: transparent } 62%,93% { fill: var(--color-changed) } 97%,100% { fill: transparent } }

  /* state: an edit pulses a row and floats a +5 up */
  .rowhl { fill: color-mix(in oklab, var(--color-accent) 12%, transparent); stroke: none; opacity: 0; animation: hl 4s ease-in-out infinite; }
  .bal { animation: balbump 4s ease-in-out infinite; }
  .edit { animation: editfly 4s ease-in-out infinite; }
  @keyframes hl { 0%,40% { opacity: 0 } 55%,80% { opacity: 1 } 100% { opacity: 0 } }
  @keyframes balbump { 0%,55% { fill: var(--color-ink-muted) } 65% { fill: var(--color-node-leaf) } 100% { fill: var(--color-ink-muted) } }
  @keyframes editfly { 0% { transform: translateX(0); opacity: 0 } 15% { opacity: 1 } 45% { transform: translateX(120px); opacity: 1 } 55% { transform: translateX(120px); opacity: 0 } 100% { opacity: 0 } }
  .pkt { fill: color-mix(in oklab, var(--color-node-leaf) 16%, var(--color-surface)); stroke: var(--color-node-leaf); }

  /* sign: stamp in, hold ✓, then crack to ✗ */
  .seal-c { fill: color-mix(in oklab, var(--color-node-leaf) 16%, var(--color-surface)); stroke: var(--color-node-leaf); stroke-width: 2; transform-box: fill-box; transform-origin: center; animation: stamp 5s ease-in-out infinite; }
  .seal-m { fill: var(--color-node-leaf); font-size: 24px; text-anchor: middle; animation: stamp 5s ease-in-out infinite; }
  .crack { opacity: 0; animation: crack 5s ease-in-out infinite; }
  .arrow, .arrow2 { stroke-dasharray: 70; stroke-dashoffset: 70; animation: draw 5s ease-in-out infinite; }
  @keyframes stamp { 0% { transform: scale(0.2); opacity: 0 } 15% { transform: scale(1.15); opacity: 1 } 22%,55% { transform: scale(1); opacity: 1 } 70% { opacity: 0.15 } 100% { opacity: 0 } }
  @keyframes crack { 0%,60% { opacity: 0 } 72%,92% { opacity: 1 } 100% { opacity: 0 } }
  @keyframes draw { 0% { stroke-dashoffset: 70 } 20%,100% { stroke-dashoffset: 0 } }

  /* verify: parallel lanes — a true message passes, a tampered one fails */
  .vmsg { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .vmsg.ok { stroke: var(--color-node-leaf); fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); }
  .vmsg.bad { stroke: var(--color-changed); fill: color-mix(in oklab, var(--color-changed) 8%, var(--color-surface)); }
  .bad-word { fill: var(--color-changed); }
  .vsig { fill: color-mix(in oklab, var(--color-hash) 12%, var(--color-surface)); stroke: var(--color-hash); }
  .vbox { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .vlbl.ok-t { fill: var(--color-node-leaf); } .vlbl.bad-t { fill: var(--color-changed); }
  .varrow { fill: none; stroke: var(--color-border-strong); stroke-width: 1.6; stroke-dasharray: 50; stroke-dashoffset: 50; }
  .va-a, .va-c { animation: vdraw 4.5s ease-in-out infinite; }
  .va-b, .va-d { animation: vdraw 4.5s ease-in-out 0.5s infinite; }
  @keyframes vdraw { 0%,8% { stroke-dashoffset: 50 } 26%,100% { stroke-dashoffset: 0 } }
  .ok-c { fill: color-mix(in oklab, var(--color-node-leaf) 16%, var(--color-surface)); stroke: var(--color-node-leaf); stroke-width: 2; }
  .ok-m { fill: var(--color-node-leaf); font-size: 16px; text-anchor: middle; }
  .bad-c { fill: color-mix(in oklab, var(--color-changed) 16%, var(--color-surface)); stroke: var(--color-changed); stroke-width: 2; }
  .bad-m { fill: var(--color-changed); font-size: 16px; text-anchor: middle; }
  .vres { opacity: 0; }
  .v-ok, .v-bad { animation: vpop 4.5s ease-in-out infinite; }
  @keyframes vpop { 0%,40% { opacity: 0 } 52%,92% { opacity: 1 } 100% { opacity: 0 } }

  /* recover: address materializes */
  .seal-c2 { fill: color-mix(in oklab, var(--color-hash) 16%, var(--color-surface)); stroke: var(--color-hash); }
  .seal-m2 { fill: var(--color-hash); font-size: 22px; text-anchor: middle; }
  .recover-q { animation: blink 4s ease-in-out infinite; }
  .arrow3 { stroke-dasharray: 100; stroke-dashoffset: 100; animation: draw3 4s ease-in-out infinite; }
  .addr-box { fill: color-mix(in oklab, var(--color-accent) 10%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .t-addr { fill: var(--color-accent-strong); font-family: var(--font-mono); font-size: 13px; text-anchor: middle; }
  .addr-reveal { opacity: 0; animation: reveal 4s ease-in-out infinite; }
  @keyframes blink { 0%,40% { opacity: 1 } 55%,100% { opacity: 0 } }
  @keyframes draw3 { 0%,15% { stroke-dashoffset: 100 } 45%,100% { stroke-dashoffset: 0 } }
  @keyframes reveal { 0%,45% { opacity: 0; transform: translateX(-8px) } 60%,100% { opacity: 1; transform: translateX(0) } }

  .t-ok { fill: var(--color-node-leaf); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; }

  /* replay: tx applies once, duplicate bounces off the nonce */
  .rp-nonce { fill: var(--color-accent-strong); }
  .ghost { fill: color-mix(in oklab, var(--color-changed) 8%, var(--color-surface)); stroke: var(--color-changed); stroke-dasharray: 4 3; }
  .rp-ok { stroke: var(--color-node-leaf); stroke-dasharray: 180; stroke-dashoffset: 180; animation: draw-ok 5s ease-in-out infinite; }
  .t-ok { animation: fade-hold 5s ease-in-out infinite; }
  .rp-dup { animation: dupbounce 5s ease-in-out infinite; }
  .rp-reject { animation: reject 5s ease-in-out infinite; }
  @keyframes draw-ok { 0% { stroke-dashoffset: 180 } 25%,100% { stroke-dashoffset: 0 } }
  @keyframes fade-hold { 0%,10% { opacity: 0 } 25%,100% { opacity: 1 } }
  @keyframes dupbounce { 0%,40% { transform: translate(0,0); opacity: 0 } 50% { opacity: 1 } 62% { transform: translate(150px,0); opacity: 1 } 78% { transform: translate(40px,0); opacity: 1 } 92% { transform: translate(40px,0); opacity: 0 } 100% { opacity: 0 } }
  @keyframes reject { 0%,62% { opacity: 0 } 74%,92% { opacity: 1 } 100% { opacity: 0 } }
  /* replay disease row: balance leaks; cure row: nonce keeps it safe */
  .rp-h { fill: var(--color-ink-faint); font-size: 9px; text-transform: uppercase; letter-spacing: 0.06em; }
  .rp-noN { fill: var(--color-ink-faint); text-anchor: middle; }
  .rp-d1 { stroke: var(--color-changed); stroke-width: 1.6; stroke-dasharray: 170; stroke-dashoffset: 170; animation: rp-d1 3s ease-in-out infinite; }
  @keyframes rp-d1 { 0%,20% { stroke-dashoffset: 170 } 50%,100% { stroke-dashoffset: 0 } }
  .rp-balbad { fill: var(--color-changed); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; animation: rp-leakpulse 2s ease-in-out infinite; }
  @keyframes rp-leakpulse { 0%,100% { opacity: 0.65 } 50% { opacity: 1 } }
  .rp-balgood { font-family: var(--font-mono); font-size: 11px; text-anchor: middle; }

  /* txfields: each row's justification highlights in turn */
  .txbar { fill: transparent; stroke: none; }
  .t-field { fill: var(--color-accent-strong); font-family: var(--font-mono); font-size: 13px; }
  .t-why { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 11px; }
  .txrow { opacity: 0.4; }
  .tr0 { animation: rowlit 9s steps(1) infinite; }
  .tr1 { animation: rowlit 9s steps(1) 1s infinite; }
  .tr2 { animation: rowlit 9s steps(1) 2s infinite; }
  .tr3 { animation: rowlit 9s steps(1) 3s infinite; }
  .tr4 { animation: rowlit 9s steps(1) 4s infinite; }
  .tr5 { animation: rowlit 9s steps(1) 5s infinite; }
  .tr6 { animation: rowlit 9s steps(1) 6s infinite; }
  .tr7 { animation: rowlit 9s steps(1) 7s infinite; }
  .tr8 { animation: rowlit 9s steps(1) 8s infinite; }
  .txrow.tr0 .txbar, .txrow.tr1 .txbar, .txrow.tr2 .txbar, .txrow.tr3 .txbar, .txrow.tr4 .txbar, .txrow.tr5 .txbar, .txrow.tr6 .txbar, .txrow.tr7 .txbar, .txrow.tr8 .txbar { animation: barlit 9s steps(1) infinite; }
  .tr1 .txbar { animation-delay: 1s } .tr2 .txbar { animation-delay: 2s } .tr3 .txbar { animation-delay: 3s } .tr4 .txbar { animation-delay: 4s } .tr5 .txbar { animation-delay: 5s } .tr6 .txbar { animation-delay: 6s } .tr7 .txbar { animation-delay: 7s } .tr8 .txbar { animation-delay: 8s }
  @keyframes rowlit { 0% { opacity: 0.4 } 0.5%,10% { opacity: 1 } 11%,100% { opacity: 0.7 } }
  @keyframes barlit { 0% { fill: transparent } 0.5%,10% { fill: color-mix(in oklab, var(--color-accent) 12%, transparent) } 11%,100% { fill: transparent } }

  /* blocks: a full trie whose changed path recomputes into the chain */
  .block { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .fchip { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-border); }
  .hchip { fill: color-mix(in oklab, var(--color-hash) 10%, var(--color-surface)); stroke: var(--color-hash); }
  .t-fld { fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 9px; }
  .t-bal { fill: var(--color-ink); font-family: var(--font-mono); font-size: 10px; }
  .t-h { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 8px; }
  .leaf-t { fill: var(--color-node-leaf); }
  .plink { fill: none; stroke: var(--color-border-strong); stroke-width: 1.6; }
  .feed { fill: none; stroke: var(--color-accent-dim); stroke-width: 1.4; stroke-dasharray: 3 3; }
  .feed-lbl { fill: var(--color-accent-dim); }
  .edge { fill: none; stroke: var(--color-border); stroke-width: 1.3; }
  .edge-on { stroke: var(--color-accent); stroke-width: 1.9; }
  .changed-leaf { stroke: var(--color-changed); }
  /* "new" values are the recomputed ones; they cross-fade in as the wave climbs */
  .new, .t-h.new, .t-bal.new { fill: var(--color-changed); }
  .old.oA { animation: kOA 9s linear infinite; } .new.nA { animation: kNA 9s linear infinite; }
  .old.oB { animation: kOB 9s linear infinite; } .new.nB { animation: kNB 9s linear infinite; }
  .old.oC { animation: kOC 9s linear infinite; } .new.nC { animation: kNC 9s linear infinite; }
  .old.oD { animation: kOD 9s linear infinite; } .new.nD { animation: kND 9s linear infinite; }
  .gE { animation: kGE 9s linear infinite; } .gF { animation: kGF 9s linear infinite; } .gG { animation: kGG 9s linear infinite; }
  @keyframes kOA { 0%,9% { opacity: 1 } 15%,93% { opacity: 0 } 100% { opacity: 1 } }
  @keyframes kNA { 0%,9% { opacity: 0 } 15%,93% { opacity: 1 } 100% { opacity: 0 } }
  @keyframes kOB { 0%,23% { opacity: 1 } 29%,93% { opacity: 0 } 100% { opacity: 1 } }
  @keyframes kNB { 0%,23% { opacity: 0 } 29%,93% { opacity: 1 } 100% { opacity: 0 } }
  @keyframes kOC { 0%,35% { opacity: 1 } 41%,93% { opacity: 0 } 100% { opacity: 1 } }
  @keyframes kNC { 0%,35% { opacity: 0 } 41%,93% { opacity: 1 } 100% { opacity: 0 } }
  @keyframes kOD { 0%,45% { opacity: 1 } 51%,93% { opacity: 0 } 100% { opacity: 1 } }
  @keyframes kND { 0%,45% { opacity: 0 } 51%,93% { opacity: 1 } 100% { opacity: 0 } }
  @keyframes kGE { 0%,53% { filter: none } 57%,64% { filter: drop-shadow(0 0 8px var(--color-changed)) } 70%,100% { filter: none } }
  @keyframes kGF { 0%,63% { filter: none } 67%,74% { filter: drop-shadow(0 0 8px var(--color-changed)) } 80%,100% { filter: none } }
  @keyframes kGG { 0%,73% { filter: none } 77%,86% { filter: drop-shadow(0 0 8px var(--color-changed)) } 92%,100% { filter: none } }

  /* sybil: free clones flood a vote; cost collapses the army */
  .attacker { fill: color-mix(in oklab, var(--color-changed) 14%, var(--color-surface)); stroke: var(--color-changed); }
  .t-emoji { font-size: 18px; text-anchor: middle; }
  .clone-c { fill: color-mix(in oklab, var(--color-changed) 12%, var(--color-surface)); stroke: var(--color-changed); }
  .t-vote { fill: var(--color-changed); font-family: var(--font-mono); font-size: 10px; text-anchor: middle; }
  .clone { opacity: 0; transform-box: fill-box; transform-origin: center; }
  .clone-doom { animation: clonedoom 6s ease-in-out infinite; }
  .clone-keep { animation: clonekeep 6s ease-in-out infinite; }
  .sc0 { animation-delay: 0.1s } .sc1 { animation-delay: 0.25s } .sc3 { animation-delay: 0.4s } .sc4 { animation-delay: 0.55s } .sc5 { animation-delay: 0.7s }
  .sybil-free { animation: fade-out-half 6s ease-in-out infinite; }
  .sybil-cost { animation: fade-in-half 6s ease-in-out infinite; }
  @keyframes clonedoom { 0% { opacity: 0; transform: scale(0.3) } 12%,46% { opacity: 1; transform: scale(1) } 62% { opacity: 0; transform: scale(0.3) } 100% { opacity: 0 } }
  @keyframes clonekeep { 0% { opacity: 0; transform: scale(0.3) } 12%,100% { opacity: 1; transform: scale(1) } }
  @keyframes fade-out-half { 0%,40% { opacity: 1 } 52%,100% { opacity: 0 } }
  @keyframes fade-in-half { 0%,46% { opacity: 0 } 58%,100% { opacity: 1 } }

  /* triepath: walk the nibble path down typed nodes, then re-hash up */
  .nib { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .t-nib { fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 12px; text-anchor: middle; }
  .tnode { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .tnode.branch { stroke: var(--color-node-branch); }
  .tnode.extension { stroke: var(--color-node-extension); }
  .tnode.leaf { stroke: var(--color-node-leaf); }
  .tnote { text-anchor: end; }
  .tarrow { fill: none; stroke: var(--color-border-strong); stroke-width: 1.6; }
  .root-chip { fill: color-mix(in oklab, var(--color-accent) 14%, var(--color-surface)); stroke: var(--color-accent); }
  .tp-rehash { animation: fade-hold 6s ease-in-out infinite; }
  .tn { opacity: 0.55; }
  .tn0 { animation: walk 6s ease-in-out infinite; } .tn1 { animation: walk 6s ease-in-out 0.5s infinite; }
  .tn2 { animation: walk 6s ease-in-out 1s infinite; } .tn3 { animation: walk 6s ease-in-out 1.5s infinite; }
  .nb0 { animation: niblit 6s ease-in-out infinite; } .nb1 { animation: niblit 6s ease-in-out 0.5s infinite; }
  .nb2, .nb3, .nb4 { animation: niblit 6s ease-in-out 1s infinite; }
  .tp-root { animation: rootflash 6s ease-in-out infinite; }
  @keyframes walk { 0% { opacity: 0.55 } 8%,30% { opacity: 1 } 70% { opacity: 1 } 80% { opacity: 0.55 } 100% { opacity: 0.55 } }
  @keyframes niblit { 0%,4% { fill: var(--color-surface) } 10%,40% { fill: color-mix(in oklab, var(--color-accent) 16%, var(--color-surface)) } 55%,100% { fill: var(--color-surface) } }
  @keyframes rootflash { 0%,68% { stroke: var(--color-accent); filter: none } 80% { stroke: var(--color-node-leaf); filter: drop-shadow(0 0 7px var(--color-accent-dim)) } 100% { stroke: var(--color-accent); filter: none } }

  /* network: a single host censors (before) → replicated survives (after), 8s loop */
  .net-before { animation: net-before 8s ease-in-out infinite; }
  @keyframes net-before { 0%,44% { opacity: 1 } 52%,100% { opacity: 0 } }
  .net-server { stroke: var(--color-changed); }
  .net-el { fill: var(--color-ink-faint); }
  .net-edit { stroke: var(--color-changed); stroke-dasharray: 130; stroke-dashoffset: 130; animation: net-edit 8s ease-in-out infinite; }
  @keyframes net-edit { 0%,6% { stroke-dashoffset: 130 } 24% { stroke-dashoffset: 40 } 44%,100% { stroke-dashoffset: 40 } }
  .net-censor { opacity: 0; animation: net-censor 8s ease-in-out infinite; }
  @keyframes net-censor { 0%,26% { opacity: 0 } 34%,44% { opacity: 1 } 52%,100% { opacity: 0 } }
  .net-after { opacity: 0; animation: net-after 8s ease-in-out infinite; }
  @keyframes net-after { 0%,48% { opacity: 0 } 58%,100% { opacity: 1 } }
  .net-hub .node, .net-hub { fill: color-mix(in oklab, var(--color-node-extension) 14%, var(--color-surface)); }
  .net-tick { text-anchor: middle; font-size: 13px; opacity: 0; animation: net-tick 8s ease-in-out infinite; }
  @keyframes net-tick { 0%,70% { opacity: 0 } 80%,100% { opacity: 1 } }
  .copy { opacity: 0; transform-box: fill-box; transform-origin: center; }
  .copy .node { fill: color-mix(in oklab, var(--color-node-extension) 10%, var(--color-surface)); }
  .c0 { animation: fan 8s ease-out infinite; }
  .c1 { animation: fan 8s ease-out 0.2s infinite; }
  .c2 { animation: fan 8s ease-out 0.4s infinite; }
  .c3 { animation: fan 8s ease-out 0.6s infinite; }
  @keyframes fan { 0%,50% { opacity: 0; transform: translate(140px, 40px) scale(0.4) } 68% { opacity: 1; transform: translate(0,0) scale(1) } 96% { opacity: 1 } 100% { opacity: 0.2 } }

  /* consensus */
  .blk.win { stroke: var(--color-node-leaf); }
  .blk.lose { stroke: var(--color-changed); opacity: 0.4; }
  .vote { fill: var(--color-node-leaf); opacity: 0; }
  .v0 { animation: pop 5s ease-out infinite; } .v1 { animation: pop 5s ease-out 0.4s infinite; } .v2 { animation: pop 5s ease-out 0.8s infinite; } .v3 { animation: pop 5s ease-out 1.2s infinite; } .v4 { animation: pop 5s ease-out 1.6s infinite; }
  .lock { font-size: 16px; opacity: 0; animation: lockin 5s ease-out infinite; }
  @keyframes pop { 0%,5% { opacity: 0; transform: translateY(-6px) } 25%,80% { opacity: 1; transform: translateY(0) } 100% { opacity: 0 } }
  @keyframes lockin { 0%,70% { opacity: 0; transform: scale(0.4) } 82%,95% { opacity: 1; transform: scale(1) } 100% { opacity: 0 } }

  /* evm: pointer steps, stack changes */
  .op { fill: color-mix(in oklab, var(--color-node-branch) 8%, var(--color-surface)); }
  .pc { fill: none; stroke: var(--color-accent); stroke-width: 2; animation: pcstep 4s steps(1) infinite; }
  @keyframes pcstep { 0% { transform: translateY(0) } 25% { transform: translateY(38px) } 50% { transform: translateY(76px) } 75% { transform: translateY(114px) } 100% { transform: translateY(0) } }
  .evm-si { fill: color-mix(in oklab, var(--color-node-extension) 12%, var(--color-surface)); stroke: var(--color-border-strong); stroke-width: 1.2; }
  .evm-sit { text-anchor: middle; fill: var(--color-node-extension); font-family: var(--font-mono); font-size: 12px; }
  .evm-res { fill: color-mix(in oklab, var(--color-node-leaf) 16%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .evm-rest { fill: var(--color-node-leaf); font-weight: 600; }
  .evm-fold { fill: none; stroke: var(--color-accent); stroke-width: 1.8; }

  /* gas: gauge drains, ops tick, halt */
  .gauge-fill { fill: var(--color-node-leaf); transform-box: fill-box; transform-origin: left; animation: drain 5s ease-in-out infinite; }
  .opx { text-anchor: middle; opacity: 0; }
  .o0 { animation: tick 5s steps(1) infinite; } .o1 { animation: tick 5s steps(1) 1.25s infinite; } .o2 { animation: tick 5s steps(1) 2.5s infinite; } .o3 { fill: var(--color-changed); animation: tick 5s steps(1) 3.75s infinite; }
  @keyframes drain { 0% { transform: scaleX(1); fill: var(--color-node-leaf) } 80% { transform: scaleX(0.04); fill: var(--color-hash) } 90% { transform: scaleX(0.04); fill: var(--color-changed) } 100% { transform: scaleX(1); fill: var(--color-node-leaf) } }
  @keyframes tick { 0%,24% { opacity: 0 } 25%,49% { opacity: 1 } 50%,100% { opacity: 0 } }

  /* root: cells converge into a hash in the header */
  .cell { fill: color-mix(in oklab, var(--color-ink-faint) 10%, var(--color-surface)); }
  .conv { stroke-dasharray: 120; stroke-dashoffset: 120; animation: flow 5s ease-in-out infinite; }
  .c1 { animation-delay: 0.1s; } .c2 { animation-delay: 0.2s; } .c3 { animation-delay: 0.6s; }
  .trie { fill: color-mix(in oklab, var(--color-node-branch) 14%, var(--color-surface)); stroke: var(--color-node-branch); }
  .root-badge { fill: color-mix(in oklab, var(--color-accent) 14%, var(--color-surface)); stroke: var(--color-accent); animation: rootpulse 5s ease-in-out infinite; }
  .t-root { font-family: var(--font-mono); font-size: 11px; text-anchor: middle; }
  @keyframes flow { 0% { stroke-dashoffset: 120 } 60%,100% { stroke-dashoffset: 0 } }

  /* ── batch-txevm: static, glanceable rebuilds (scene-namespaced) ── */
  .sg-box, .sg-vbox { fill: var(--color-surface); stroke: var(--color-border-strong); stroke-width: 1.4; }
  .sg-ar { fill: none; stroke: var(--color-border-strong); stroke-width: 1.8; }
  .sg-seal { fill: color-mix(in oklab, var(--color-node-leaf) 16%, var(--color-surface)); stroke: var(--color-node-leaf); stroke-width: 2; }
  .sg-sealm { fill: var(--color-node-leaf); font-size: 22px; text-anchor: middle; }
  .sg-ok { fill: var(--color-node-leaf); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; }
  .sg-key { fill: var(--color-ink-faint); }

  .vf-msg { fill: var(--color-surface); stroke: var(--color-border-strong); stroke-width: 1.4; }
  .vf-msg.vf-ok { stroke: var(--color-node-leaf); fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); }
  .vf-msg.vf-bad { stroke: var(--color-changed); fill: color-mix(in oklab, var(--color-changed) 8%, var(--color-surface)); }
  .vf-sig { fill: color-mix(in oklab, var(--color-hash) 12%, var(--color-surface)); stroke: var(--color-hash); stroke-width: 1.4; }
  .vf-box { fill: var(--color-surface); stroke: var(--color-border-strong); stroke-width: 1.4; }
  .vf-ar { fill: none; stroke: var(--color-border-strong); stroke-width: 1.6; }
  .vf-okc { fill: color-mix(in oklab, var(--color-node-leaf) 16%, var(--color-surface)); stroke: var(--color-node-leaf); stroke-width: 2; }
  .vf-okm { fill: var(--color-node-leaf); font-size: 15px; text-anchor: middle; }
  .vf-badc { fill: color-mix(in oklab, var(--color-changed) 16%, var(--color-surface)); stroke: var(--color-changed); stroke-width: 2; }
  .vf-badm { fill: var(--color-changed); font-size: 15px; text-anchor: middle; }
  .vf-okt { fill: var(--color-node-leaf); font-family: var(--font-mono); font-size: 11px; }
  .vf-badt { fill: var(--color-changed); font-family: var(--font-mono); font-size: 11px; }
  .vf-word { fill: var(--color-changed); }

  .rc-seal { fill: color-mix(in oklab, var(--color-hash) 16%, var(--color-surface)); stroke: var(--color-hash); stroke-width: 1.6; }
  .rc-sealm { fill: var(--color-hash); font-size: 22px; text-anchor: middle; }
  .rc-ar { fill: none; stroke: var(--color-accent); stroke-width: 1.9; }
  .rc-box { fill: color-mix(in oklab, var(--color-accent) 10%, var(--color-surface)); stroke: var(--color-accent-dim); stroke-width: 1.6; }
  .rc-addr { fill: var(--color-accent-strong); font-family: var(--font-mono); font-size: 14px; text-anchor: middle; }

  .nw-box { fill: var(--color-surface); stroke: var(--color-border-strong); stroke-width: 1.4; }
  .nw-server { fill: var(--color-surface); stroke: var(--color-changed); stroke-width: 1.6; }
  .nw-node { fill: color-mix(in oklab, var(--color-node-extension) 10%, var(--color-surface)); stroke: var(--color-border-strong); stroke-width: 1.4; }
  .nw-ar { fill: none; stroke: var(--color-border-strong); stroke-width: 1.7; }
  .nw-arbad { fill: none; stroke: var(--color-changed); stroke-width: 1.7; }
  .nw-hair { stroke: var(--color-border); stroke-width: 1; }
  .nw-tick { fill: var(--color-node-leaf); font-size: 12px; text-anchor: middle; }
  .nw-peer { stroke: var(--color-border); stroke-width: 1; stroke-dasharray: 3 3; }

  .bk-block { fill: var(--color-surface); stroke: var(--color-border-strong); stroke-width: 1.4; }
  .bk-changed { stroke: var(--color-changed); stroke-width: 1.8; }
  .bk-fchip { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-border); }
  .bk-hchip { fill: color-mix(in oklab, var(--color-hash) 10%, var(--color-surface)); stroke: var(--color-hash); }
  .bk-fld { fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 9px; }
  .bk-new { fill: var(--color-changed); font-family: var(--font-mono); font-size: 9px; }
  .bk-h { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 8px; }
  .bk-bal { fill: var(--color-ink); font-family: var(--font-mono); font-size: 10px; }
  .bk-leaft { fill: var(--color-node-leaf); font-family: var(--font-mono); font-size: 9px; }
  .bk-plink { fill: none; stroke: var(--color-border-strong); stroke-width: 1.6; }
  .bk-feed { fill: none; stroke: var(--color-accent); stroke-width: 1.5; stroke-dasharray: 4 3; }
  .bk-feedlbl { fill: var(--color-accent-strong); font-family: var(--font-mono); font-size: 9px; }
  .bk-node { fill: var(--color-surface); stroke: var(--color-node-branch); stroke-width: 1.4; }
  .bk-leaf { fill: var(--color-surface); stroke: var(--color-node-leaf); stroke-width: 1.4; }
  .bk-edge { fill: none; stroke: var(--color-border); stroke-width: 1.3; }
  .bk-edgeon { fill: none; stroke: var(--color-accent); stroke-width: 2; }
  .bk-nib { fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 10px; text-anchor: middle; }
  .bk-nibchip { fill: var(--color-surface); stroke: var(--color-border); }

  .sy-attacker { fill: color-mix(in oklab, var(--color-changed) 14%, var(--color-surface)); stroke: var(--color-changed); stroke-width: 1.6; }
  .sy-face { fill: var(--color-changed); font-size: 15px; text-anchor: middle; }
  .sy-clone { fill: color-mix(in oklab, var(--color-changed) 12%, var(--color-surface)); stroke: var(--color-changed); stroke-width: 1.4; }
  .sy-keep { fill: color-mix(in oklab, var(--color-node-leaf) 14%, var(--color-surface)); stroke: var(--color-node-leaf); stroke-width: 1.6; }
  .sy-vote { fill: var(--color-changed); font-family: var(--font-mono); font-size: 10px; text-anchor: middle; }
  .sy-votekeep { fill: var(--color-node-leaf); font-family: var(--font-mono); font-size: 10px; text-anchor: middle; }
  .sy-ar { fill: none; stroke: var(--color-changed); stroke-width: 1.5; }
  .sy-arkeep { fill: none; stroke: var(--color-node-leaf); stroke-width: 1.6; }
  .sy-ok { fill: var(--color-node-leaf); font-family: var(--font-mono); font-size: 10px; text-anchor: middle; }

  .ga-track { fill: color-mix(in oklab, var(--color-ink-faint) 12%, var(--color-surface)); stroke: var(--color-border-strong); stroke-width: 1.4; }
  .ga-fill { fill: var(--color-node-leaf); }
