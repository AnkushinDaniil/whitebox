---
/**
 * One animated figure per lesson step. Each `name` renders a self-contained,
 * continuously-looping SVG animation illustrating that idea — the visual half of
 * a 3b1b-style step-by-step lesson. All figures + keyframes live here so the
 * scoped styles stay consistent.
 */
interface Props {
  name:
    | "state"
    | "sign"
    | "verify"
    | "recover"
    | "replay"
    | "txfields"
    | "network"
    | "blocks"
    | "sybil"
    | "consensus"
    | "evm"
    | "gas"
    | "triepath"
    | "root"
    | "syncgenesis"
    | "synctrie"
    | "syncsnap"
    | "synclight"
    | "synccheckpoint"
    | "dbtrie"
    | "dbflat"
    | "dblayers";
  caption?: string;
  /** widen the figure frame for dense diagrams */
  wide?: boolean;
}
const { name, caption, wide } = Astro.props;
---

<figure class:list={["scene", wide && "scene-wide"]}>
  <div class="scene-stage" data-scene={name}>
    {/* ── the shared state: a spreadsheet an edit mutates ── */}
    {name === "state" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="A shared world-state spreadsheet being edited">
        <rect class="sheet" x="120" y="24" width="240" height="150" rx="10" />
        <text class="t-mid" x="240" y="48">WORLD STATE</text>
        <line class="hair" x1="136" y1="58" x2="344" y2="58" />
        <g class="row"><text class="t-l" x="140" y="86">0xAlice</text><text class="t-r" x="330" y="86">14 Ξ</text></g>
        <g class="row hot"><rect class="rowhl" x="130" y="98" width="220" height="24" rx="5" /><text class="t-l" x="140" y="115">0xBob</text><text class="t-r bal" x="330" y="115">9 Ξ</text></g>
        <g class="row"><text class="t-l" x="140" y="144">0xCarol</text><text class="t-r" x="330" y="144">2 Ξ</text></g>
        <g class="edit">
          <rect class="pkt" x="20" y="100" width="74" height="22" rx="6" />
          <text class="t-s" x="57" y="115">+5 Ξ →</text>
        </g>
        <text class="t-cap" x="240" y="198">edits move numbers in one shared sheet</text>
      </svg>
    )}

    {/* ── signatures: a seal stamps, verifies, then a tamper breaks it ── */}
    {name === "sign" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="Signing and verifying">
        <rect class="msg" x="40" y="74" width="150" height="60" rx="8" />
        <text class="t-s" x="115" y="100">"send 5 Ξ</text>
        <text class="t-s" x="115" y="118">to Bob"</text>
        <text class="t-cap" x="115" y="158">message (public)</text>
        <g class="seal">
          <circle class="seal-c" cx="300" cy="104" r="30" />
          <text class="seal-m" x="300" y="110">✓</text>
        </g>
        <g class="crack"><text class="t-x" x="300" y="160">✗ tampered</text></g>
        <path class="arrow" d="M196 104 L262 104" />
        <text class="t-cap" x="300" y="62">signature</text>
        <text class="t-cap" x="430" y="110">verify</text>
        <path class="arrow2" d="M332 104 L398 104" />
      </svg>
    )}

    {/* ── verify: one signature accepts a true message, rejects a tampered one ── */}
    {name === "verify" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="Verification: a valid message passes, a tampered one fails">
        {/* positive lane */}
        <text class="t-cap vlbl ok-t" x="92" y="24">✓ untouched message</text>
        <rect class="vmsg ok" x="16" y="30" width="152" height="46" rx="7" />
        <text class="t-s" x="92" y="50">send 5 Ξ</text>
        <text class="t-s" x="92" y="67">to Bob</text>
        <rect class="vsig" x="188" y="42" width="40" height="22" rx="4" />
        <text class="t-cap" x="208" y="57">sig</text>
        <path class="varrow va-a" d="M228 53 H276" />
        <rect class="vbox" x="276" y="36" width="52" height="34" rx="6" />
        <text class="t-cap" x="302" y="57">verify</text>
        <path class="varrow va-b" d="M328 53 H368" />
        <g class="vres v-ok">
          <circle class="vmark-c ok-c" cx="388" cy="53" r="15" />
          <text class="vmark ok-m" x="388" y="59">✓</text>
          <text class="t-ok" x="430" y="50">VALID</text>
          <text class="t-cap" x="430" y="65">signer 0xYou</text>
        </g>
        {/* negative lane */}
        <text class="t-cap vlbl bad-t" x="92" y="120">✗ one byte flipped</text>
        <rect class="vmsg bad" x="16" y="126" width="152" height="46" rx="7" />
        <text class="t-s" x="92" y="146">send 5 Ξ</text>
        <text class="t-s bad-word" x="92" y="163">to Eve</text>
        <rect class="vsig" x="188" y="138" width="40" height="22" rx="4" />
        <text class="t-cap" x="208" y="153">sig</text>
        <path class="varrow va-c" d="M228 149 H276" />
        <rect class="vbox" x="276" y="132" width="52" height="34" rx="6" />
        <text class="t-cap" x="302" y="153">verify</text>
        <path class="varrow va-d" d="M328 149 H368" />
        <g class="vres v-bad">
          <circle class="vmark-c bad-c" cx="388" cy="149" r="15" />
          <text class="vmark bad-m" x="388" y="155">✗</text>
          <text class="t-x" x="430" y="146">INVALID</text>
          <text class="t-cap" x="430" y="161">signer ≠ you</text>
        </g>
      </svg>
    )}

    {/* ── recovery: the signer's address materializes from the signature ── */}
    {name === "recover" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="Recovering the signer from a signature">
        <circle class="seal-c2" cx="110" cy="100" r="34" />
        <text class="seal-m2" x="110" y="106">✦</text>
        <text class="t-cap" x="110" y="156">signature only</text>
        <path class="arrow3" d="M152 100 L250 100" />
        <text class="t-mid recover-q" x="201" y="88">who signed?</text>
        <g class="addr-reveal">
          <rect class="addr-box" x="270" y="78" width="180" height="44" rx="8" />
          <text class="t-addr" x="360" y="106">0xBob…a3f1</text>
        </g>
        <text class="t-cap" x="360" y="146">no "from" field needed</text>
      </svg>
    )}

    {/* ── replay: a signed tx is reusable; the nonce makes it single-use ── */}
    {name === "replay" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="The nonce defeats replay">
        <rect class="msg rp-card" x="22" y="76" width="158" height="58" rx="8" />
        <text class="t-s" x="101" y="100">send 5 Ξ → Bob</text>
        <text class="t-cap rp-nonce" x="101" y="120">nonce 7 · 🔒</text>
        <rect class="node" x="356" y="76" width="100" height="58" rx="8" />
        <text class="t-cap" x="406" y="98">0xYou</text>
        <text class="t-r" x="446" y="122">9 Ξ</text>
        <path class="arrow rp-ok" d="M180 92 H356" />
        <text class="t-ok" x="268" y="84">✓ applied once</text>
        <g class="rp-dup">
          <rect class="msg ghost" x="22" y="76" width="158" height="58" rx="8" />
          <text class="t-x" x="101" y="108">✗ copy</text>
        </g>
        <text class="t-x rp-reject" x="300" y="160">replay rejected — nonce 7 already spent</text>
      </svg>
    )}

    {/* ── txfields: every field justified by the attack it blocks ── */}
    {name === "txfields" && (
      <svg viewBox="0 0 480 318" role="img" aria-label="Anatomy of a transaction, every field justified">
        <text class="t-mid" x="120" y="22">TRANSACTION</text>
        <text class="t-cap" x="350" y="22">what breaks without it</text>
        {[
          ["chainId", "replay onto another chain"],
          ["nonce", "replay on this chain"],
          ["to", "no recipient (or: new contract)"],
          ["value", "how much ether moves"],
          ["data", "which code + args to run"],
          ["gasLimit", "a loop drains your balance"],
          ["maxFeePerGas", "overpaying a volatile fee"],
          ["maxPriorityFee", "no tip — proposer skips you"],
          ["sig r,s,yParity", "anyone could forge the sender"],
        ].map(([f, why], i) => (
          <g class={`txrow tr${i}`}>
            <rect class="txbar" x="16" y={34 + i * 29} width="448" height="25" rx="4" />
            <text class="t-field" x="28" y={51 + i * 29}>{f}</text>
            <text class="t-why" x="210" y={51 + i * 29}>{why}</text>
          </g>
        ))}
      </svg>
    )}

    {/* ── decentralize: one sheet copies out to many nodes ── */}
    {name === "network" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="Everyone keeps a copy">
        <g class="origin">
          <rect class="node" x="208" y="84" width="64" height="48" rx="8" />
          <line class="hair2" x1="216" y1="100" x2="264" y2="100" /><line class="hair2" x1="216" y1="110" x2="264" y2="110" /><line class="hair2" x1="216" y1="120" x2="256" y2="120" />
        </g>
        {[
          [60, 30], [380, 30], [40, 150], [400, 150],
        ].map(([x, y], i) => (
          <g class={`copy c${i}`}>
            <rect class="node" x={x} y={y} width="64" height="48" rx="8" />
            <line class="hair2" x1={x + 8} y1={y + 16} x2={x + 56} y2={y + 16} /><line class="hair2" x1={x + 8} y1={y + 26} x2={x + 56} y2={y + 26} /><line class="hair2" x1={x + 8} y1={y + 36} x2={x + 48} y2={y + 36} />
          </g>
        ))}
        <text class="t-cap" x="240" y="200">no master copy — every node holds the whole state</text>
      </svg>
    )}

    {/* ── blocks: a full state trie; one balance edit recomputes the path up
         to a new stateRoot, into the header, then breaks every later block ── */}
    {name === "blocks" && (
      <svg viewBox="0 0 480 326" role="img" aria-label="A full state trie recomputing one path into the block chain">
        {/* the block chain, top */}
        {[0, 1, 2].map((i) => {
          const x = 14 + i * 162;
          const sr = i === 1 ? "71c4" : "0db8";
          const h = i === 0 ? "3a07" : i === 1 ? "88b2" : "f0c5";
          return (
            <g class="blk-g">
              <rect class="block" x={x} y="12" width="132" height="86" rx="8" />
              <text class="t-cap" x={x + 66} y="27">block #{i + 1}</text>
              <rect class="fchip" x={x + 8} y="33" width="116" height="17" rx="3" />
              {i === 0 && <text class="t-fld old oD" x={x + 14} y="45">stateRoot 9f12</text>}
              {i === 0 && <text class="t-fld new nD" x={x + 14} y="45">stateRoot a2e0</text>}
              {i !== 0 && <text class="t-fld" x={x + 14} y="45">stateRoot {sr}</text>}
              <rect class="fchip" x={x + 8} y="53" width="116" height="17" rx="3" />
              <text class="t-fld" x={x + 14} y="65">txsRoot c1{i}9</text>
              <text class="t-cap" x={x + 18} y="90">prev</text>
              <rect class={`hchip ${i === 0 ? "gE" : i === 1 ? "gF" : "gG"}`} x={x + 48} y="76" width="76" height="17" rx="3" />
              <text class="t-fld" x={x + 55} y="89">hash {h}</text>
            </g>
          );
        })}
        <path class="plink gF" d="M146 85 H176" /><path class="plink gG" d="M308 85 H338" />
        <path class="feed" d="M160 143 H6 V44 H22" />
        <text class="t-cap feed-lbl" x="350" y="128">root → block.stateRoot</text>

        {/* root branch */}
        <rect class="tnode branch" x="160" y="128" width="100" height="30" rx="6" />
        <text class="t-fld" x="172" y="141">branch</text>
        <text class="t-h old oC" x="172" y="153">root 91f3</text>
        <text class="t-h new nC" x="172" y="153">root 2d7a</text>

        {/* edges from root */}
        <path class="edge edge-on" d="M198 158 L120 190" /><text class="t-nib" x="148" y="178">a</text>
        <path class="edge" d="M224 158 L312 190" /><text class="t-nib" x="276" y="178">f</text>

        {/* on-path branch (prefix a) and off-path branch (prefix f) */}
        <rect class="tnode branch" x="64" y="190" width="92" height="30" rx="6" />
        <text class="t-fld" x="74" y="203">branch</text>
        <text class="t-h old oB" x="74" y="215">a· 3c08</text>
        <text class="t-h new nB" x="74" y="215">a· 8a41</text>
        <rect class="tnode branch" x="274" y="190" width="92" height="30" rx="6" />
        <text class="t-fld" x="284" y="203">branch</text>
        <text class="t-h" x="284" y="215">f· 77c2</text>

        {/* edges to leaves */}
        <path class="edge edge-on" d="M100 220 L74 264" /><text class="t-nib" x="80" y="246">7</text>
        <path class="edge" d="M120 220 L162 264" /><text class="t-nib" x="150" y="246">9</text>
        <path class="edge" d="M312 220 L300 264" /><text class="t-nib" x="300" y="246">2</text>
        <path class="edge" d="M330 220 L388 264" /><text class="t-nib" x="366" y="246">5</text>

        {/* the four accounts — only Alice (a7) changes */}
        <rect class="tnode leaf changed-leaf" x="24" y="264" width="92" height="50" rx="6" />
        <text class="t-fld leaf-t" x="34" y="278">a7 · Alice</text>
        <text class="t-bal old oA" x="34" y="293">bal 14 Ξ</text>
        <text class="t-bal new nA" x="34" y="293">bal 9 Ξ</text>
        <text class="t-h old oA" x="34" y="307">h 3c1a</text>
        <text class="t-h new nA" x="34" y="307">h 8a47</text>
        {[
          [120, "a9 · Bob", "bal 6 Ξ", "h 55de"],
          [250, "f2 · Carol", "bal 20 Ξ", "h 9e10"],
          [346, "f5 · Dave", "bal 3 Ξ", "h b204"],
        ].map(([x, who, bal, h]) => (
          <g>
            <rect class="tnode leaf" x={x} y="264" width="92" height="50" rx="6" />
            <text class="t-fld leaf-t" x={Number(x) + 10} y="278">{who}</text>
            <text class="t-bal" x={Number(x) + 10} y="293">{bal}</text>
            <text class="t-h" x={Number(x) + 10} y="307">{h}</text>
          </g>
        ))}
      </svg>
    )}

    {/* ── sybil: free identities overwhelm a vote; cost makes them safe ── */}
    {name === "sybil" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="Sybil attack and costly identity">
        <circle class="attacker" cx="64" cy="98" r="22" />
        <text class="t-emoji" x="64" y="105">😈</text>
        <text class="t-cap" x="64" y="138">one actor</text>
        {[[180, 44], [250, 40], [320, 60], [200, 110], [280, 120], [360, 110]].map(([x, y], i) => (
          <g class={`clone ${i === 2 ? "clone-keep" : "clone-doom"} sc${i}`}>
            <circle class="clone-c" cx={x} cy={y} r="13" />
            <text class="t-vote" x={x} y={y + 4}>+1</text>
          </g>
        ))}
        <text class="t-x sybil-free" x="300" y="166">free identities → outvote everyone</text>
        <text class="t-ok sybil-cost" x="300" y="166">each must stake real money → can't afford an army</text>
      </svg>
    )}

    {/* ── consensus: votes pile on the heavier fork; finalized locks ── */}
    {name === "consensus" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="Consensus picks the heaviest chain">
        <rect class="blk" x="24" y="92" width="44" height="28" rx="5" /><rect class="blk" x="96" y="92" width="44" height="28" rx="5" />
        <path class="link" d="M68 106 H96" />
        {/* honest fork */}
        <rect class="blk win" x="190" y="58" width="44" height="28" rx="5" /><rect class="blk win" x="262" y="58" width="44" height="28" rx="5" />
        <path class="link" d="M140 100 L190 72" /><path class="link" d="M234 72 H262" />
        <text class="lock" x="318" y="76">🔒</text>
        {[0, 1, 2, 3, 4].map((i) => (<circle class={`vote v${i}`} cx={205 + i * 22} cy="40" r="4" />))}
        {/* attacker fork */}
        <rect class="blk lose" x="190" y="134" width="44" height="28" rx="5" />
        <path class="link dashed" d="M140 112 L190 148" />
        <text class="t-x" x="300" y="152">✗ outvoted</text>
        <text class="t-cap" x="240" y="198">most-backed history wins; finalized blocks lock</text>
      </svg>
    )}

    {/* ── the EVM: an instruction pointer steps; the stack moves ── */}
    {name === "evm" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="The EVM stepping through code">
        <g class="prog">
          {["PUSH 2", "PUSH 3", "ADD", "MUL"].map((op, i) => (
            <g><rect class="op" x="40" y={30 + i * 38} width="120" height="28" rx="5" /><text class="t-op" x="54" y={49 + i * 38}>{op}</text></g>
          ))}
          <rect class="pc" x="34" y="30" width="132" height="28" rx="6" />
        </g>
        <text class="t-cap" x="100" y="196">code runs the same everywhere</text>
        <g class="stack">
          <text class="t-cap" x="330" y="30">stack</text>
          <rect class="si s0" x="280" y="120" width="100" height="24" rx="4" /><text class="t-op si-t s0t" x="330" y="137">2</text>
          <rect class="si s1" x="280" y="92" width="100" height="24" rx="4" /><text class="t-op si-t s1t" x="330" y="109">3</text>
          <rect class="si s2" x="280" y="92" width="100" height="24" rx="4" /><text class="t-op si-t s2t" x="330" y="109">5</text>
        </g>
      </svg>
    )}

    {/* ── gas: a meter drains as instructions run, then halts ── */}
    {name === "gas" && (
      <svg viewBox="0 0 480 180" role="img" aria-label="Gas metering">
        <text class="t-cap" x="60" y="56">gas</text>
        <rect class="gauge" x="60" y="64" width="360" height="22" rx="11" />
        <rect class="gauge-fill" x="62" y="66" width="356" height="18" rx="9" />
        <g class="ops">
          {["PUSH −3", "ADD −3", "SSTORE −20000", "out of gas ✋"].map((op, i) => (<text class={`t-op opx o${i}`} x="240" y="118">{op}</text>))}
        </g>
        <text class="t-cap" x="240" y="156">every step costs — no program runs forever</text>
      </svg>
    )}

    {/* ── triepath: an address is a path of nibbles down typed nodes ── */}
    {name === "triepath" && (
      <svg viewBox="0 0 460 250" role="img" aria-label="Walking an address down the trie">
        <text class="t-cap" x="44" y="22">address</text>
        {["a", "7", "3", "f", "c"].map((n, i) => (
          <g>
            <rect class={`nib nb${i}`} x={96 + i * 34} y="9" width="28" height="20" rx="4" />
            <text class={`t-nib nbt${i}`} x={110 + i * 34} y="24">{n}</text>
          </g>
        ))}
        <rect class="root-chip" x="300" y="8" width="146" height="22" rx="5" />
        <text class="t-root tp-root" x="373" y="23">stateRoot ⟳</text>
        {[
          ["branch", "follow slot a"],
          ["branch", "follow slot 7"],
          ["extension", "shared “3 f c”"],
          ["leaf", "value → 9 Ξ"],
        ].map(([kind, note], i) => (
          <g class={`tn tn${i}`}>
            <rect class={`tnode ${kind}`} x="90" y={52 + i * 46} width="280" height="34" rx="6" />
            <text class="t-field" x="106" y={73 + i * 46}>{kind}</text>
            <text class="t-cap tnote" x="356" y={73 + i * 46}>{note}</text>
          </g>
        ))}
        <path class="tarrow ta0" d="M230 86 V98" /><path class="tarrow ta1" d="M230 132 V144" /><path class="tarrow ta2" d="M230 178 V190" />
        <text class="t-cap tp-rehash" x="230" y="244">edit the leaf → re-hash up the path → new root</text>
      </svg>
    )}

    {/* ── state root: the whole sheet folds into one hash in a header ── */}
    {name === "root" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="All state folds into one root">
        {[40, 78, 116].map((y, i) => (<rect class={`cell cl${i}`} x="24" y={y} width="70" height="24" rx="4" />))}
        <path class="conv c0" d="M94 52 C150 52 150 96 196 96" /><path class="conv c1" d="M94 90 H196" /><path class="conv c2" d="M94 128 C150 128 150 100 196 100" />
        <rect class="trie" x="196" y="80" width="56" height="34" rx="6" /><text class="t-cap" x="224" y="101">trie</text>
        <path class="conv c3" d="M252 97 H300" />
        <rect class="hdr" x="300" y="56" width="156" height="84" rx="8" />
        <text class="t-cap" x="378" y="76">BLOCK HEADER</text>
        <rect class="root-badge" x="312" y="88" width="132" height="28" rx="5" />
        <text class="t-root" x="378" y="106">stateRoot 0x…</text>
        <text class="t-cap" x="240" y="194">32 bytes that fingerprint the entire world</text>
      </svg>
    )}

    {/* ── full sync: replay every block from genesis, rebuilding state ── */}
    {name === "syncgenesis" && (
      <svg viewBox="0 0 480 196" role="img" aria-label="Full sync replays every block from genesis">
        <text class="t-cap" x="40" y="26">genesis</text>
        <text class="t-cap" x="442" y="26">head</text>
        {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => (
          <rect class="block" x={24 + i * 56} y="34" width="44" height="30" rx="5" />
        ))}
        <rect class="sg-marker" x="24" y="32" width="44" height="34" rx="6" />
        <text class="t-cap" x="240" y="90">re-execute every transaction, block by block</text>
        <rect class="sg-track" x="24" y="106" width="432" height="20" rx="6" />
        <rect class="sg-fill" x="26" y="108" width="428" height="16" rx="5" />
        <text class="t-fld sg-state" x="240" y="121">rebuilding state…</text>
        <text class="t-x" x="240" y="162">⏱ days — but every state transition personally verified</text>
      </svg>
    )}

    {/* ── fast sync: download the state trie node by node, verify by hash ── */}
    {name === "synctrie" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="Fast sync downloads the state trie node by node">
        <path class="sedge" d="M240 46 L150 78" /><path class="sedge" d="M240 46 L240 78" /><path class="sedge" d="M240 46 L330 78" />
        <path class="sedge" d="M150 104 L96 136" /><path class="sedge" d="M150 104 L150 136" /><path class="sedge" d="M330 104 L330 136" /><path class="sedge" d="M330 104 L384 136" />
        <g class="st-n s0"><rect class="tnode branch" x="208" y="22" width="64" height="24" rx="5" /><text class="t-cap" x="240" y="38">root</text><text class="st-ok" x="278" y="30">✓</text></g>
        <g class="st-n s1"><rect class="tnode branch" x="118" y="80" width="64" height="24" rx="5" /><text class="t-cap" x="150" y="96">node</text><text class="st-ok" x="188" y="88">✓</text></g>
        <g class="st-n s2"><rect class="tnode branch" x="208" y="80" width="64" height="24" rx="5" /><text class="t-cap" x="240" y="96">node</text><text class="st-ok" x="278" y="88">✓</text></g>
        <g class="st-n s3"><rect class="tnode branch" x="298" y="80" width="64" height="24" rx="5" /><text class="t-cap" x="330" y="96">node</text><text class="st-ok" x="368" y="88">✓</text></g>
        {[[64, "s4"], [118, "s5"], [298, "s6"], [352, "s7"]].map(([x, c]) => (
          <g class={`st-n ${c}`}><rect class="tnode leaf" x={x} y="138" width="48" height="22" rx="5" /><text class="t-cap" x={Number(x) + 24} y="153">leaf</text></g>
        ))}
        <text class="t-cap" x="240" y="188">verify each node against its parent's hash — but millions of tiny requests, and the pivot keeps moving</text>
      </svg>
    )}

    {/* ── snap sync: download flat key ranges with proofs, rebuild, heal ── */}
    {name === "syncsnap" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="Snap sync downloads flat ranges then heals the trie">
        <text class="t-cap" x="104" y="26">flat state, in big ranges</text>
        {[0, 1, 2, 3].map((i) => (
          <g class={`sn-range r${i}`}>
            <rect class="sn-bar" x="20" y={36 + i * 30} width="176" height="22" rx="5" />
            <text class="t-fld" x="30" y={51 + i * 30}>0x{i}0…{i}f</text>
            <text class="st-ok" x="180" y={51 + i * 30}>✓</text>
          </g>
        ))}
        <path class="sarrow sn-arrow" d="M200 96 H250" />
        <text class="t-cap" x="350" y="26">rebuilt locally</text>
        <rect class="tnode branch sn-t0" x="300" y="40" width="100" height="22" rx="5" /><text class="t-cap" x="350" y="55">root</text>
        <rect class="tnode leaf sn-t1" x="288" y="74" width="56" height="20" rx="4" /><rect class="tnode leaf sn-t2" x="356" y="74" width="56" height="20" rx="4" />
        <g class="sn-heal"><rect class="tnode leaf sn-heal-n" x="356" y="74" width="56" height="20" rx="4" /><text class="st-ok" x="384" y="112">heal ✓</text></g>
        <text class="t-cap" x="240" y="182">a handful of big sequential ranges, not a million nodes — hours, not days</text>
      </svg>
    )}

    {/* ── light client: only headers; fetch state on demand with a proof ── */}
    {name === "synclight" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="A light client keeps only headers and verifies proofs on demand">
        {[0, 1, 2, 3, 4, 5].map((i) => (
          <g><rect class="lhdr" x={20 + i * 74} y="26" width="62" height="26" rx="5" /><text class="t-cap" x={51 + i * 74} y="43">root #{i}</text></g>
        ))}
        <path class="sarrow" d="M51 52 V70" /><text class="t-fld lq" x="120" y="92">balance 0xA?</text>
        <path class="sarrow lp" d="M60 78 L60 110 L160 110" />
        <g class="lproof">
          <rect class="tnode branch" x="160" y="98" width="50" height="22" rx="4" /><rect class="tnode branch" x="230" y="98" width="50" height="22" rx="4" /><rect class="tnode leaf" x="300" y="98" width="56" height="22" rx="4" />
          <path class="sedge on" d="M210 109 H230" /><path class="sedge on" d="M280 109 H300" />
          <text class="t-ok" x="392" y="114">✓ 12 Ξ</text>
        </g>
        <text class="t-cap" x="240" y="172">stores only headers — asks a full node for state, gets a Merkle proof, verifies it itself</text>
      </svg>
    )}

    {/* ── checkpoint sync: trust a recent finalized anchor, skip genesis ── */}
    {name === "synccheckpoint" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="Checkpoint sync starts from a recent trusted finalized block">
        <g class="ck-old">
          <rect class="block" x="20" y="34" width="40" height="26" rx="5" /><text class="t-cap" x="40" y="50">gen</text>
          <path class="ck-crawl" d="M62 47 H430" />
          <text class="t-cap" x="430" y="50">head</text>
          <text class="t-x" x="240" y="78">replay/verify all of history from genesis — weeks</text>
        </g>
        <text class="t-cap ck-instead" x="60" y="116">instead:</text>
        <rect class="ck-anchor" x="280" y="124" width="96" height="30" rx="6" /><text class="t-cap" x="328" y="138">checkpoint</text><text class="ck-lock" x="328" y="150">🔒 finalized</text>
        <path class="sarrow ck-hop" d="M376 139 H424" />
        <rect class="block" x="424" y="126" width="34" height="26" rx="5" /><text class="t-cap" x="441" y="142">head</text>
        <text class="t-ok" x="180" y="186">trusted recent anchor → snap forward → minutes</text>
      </svg>
    )}

    {/* ── flat-db: reading a value by walking the trie = many scattered disk reads ── */}
    {name === "dbtrie" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="Reading one account walks the trie as several scattered disk reads">
        <rect class="db-q" x="14" y="12" width="168" height="26" rx="5" /><text class="t-fld" x="24" y="29">read 0xA7… balance</text>
        <path class="da da1" d="M70 70 L300 60" /><path class="da da2" d="M334 72 L150 104" /><path class="da da3" d="M118 116 L350 116" /><path class="da da4" d="M350 128 L246 150" />
        <g class="dr dr0"><rect class="db-node" x="36" y="56" width="68" height="24" rx="5" /><text class="t-cap" x="70" y="72">root</text></g>
        <g class="dr dr1"><rect class="db-node" x="300" y="48" width="68" height="24" rx="5" /><text class="t-cap" x="334" y="64">node</text></g>
        <g class="dr dr2"><rect class="db-node" x="84" y="104" width="68" height="24" rx="5" /><text class="t-cap" x="118" y="120">node</text></g>
        <g class="dr dr3"><rect class="db-node" x="316" y="104" width="68" height="24" rx="5" /><text class="t-cap" x="350" y="120">node</text></g>
        <g class="dr dr4"><rect class="db-node db-val" x="212" y="150" width="68" height="24" rx="5" /><text class="t-cap" x="246" y="166">value</text></g>
        <text class="t-x" x="240" y="200">one account = 4–6 random disk reads, walking the trie node by node</text>
      </svg>
    )}

    {/* ── flat-db: read the value directly from a flat column, trie kept only for the root ── */}
    {name === "dbflat" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="Flat DB reads the value in one direct lookup; the trie is kept only to recompute the root">
        <rect class="db-q" x="14" y="22" width="150" height="26" rx="5" /><text class="t-fld" x="24" y="39">read 0xA7… balance</text>
        <path class="sarrow df-arrow" d="M164 35 H214" />
        <text class="t-cap" x="280" y="20">flat account column</text>
        {[0, 1, 2, 3].map((i) => (
          <g class={`df-row ${i === 1 ? "df-hit" : ""}`}>
            <rect class="db-flatrow" x="220" y={28 + i * 26} width="170" height="22" rx="4" />
            <text class="t-fld" x="230" y={43 + i * 26}>0x{i === 1 ? "A7" : i + "" + i}… → {i === 1 ? "12 Ξ" : "…"}</text>
          </g>
        ))}
        <text class="t-ok df-ok" x="430" y="59">✓ 1 read</text>
        <g class="df-trie">
          <rect class="tnode branch" x="196" y="150" width="88" height="22" rx="5" /><text class="t-cap" x="240" y="165">trie root</text>
          <text class="t-cap" x="240" y="190">kept aside — only to recompute the stateRoot at commit</text>
        </g>
      </svg>
    )}

    {/* ── flat-db: a read falls through layered snapshots to find a past value ── */}
    {name === "dblayers" && (
      <svg viewBox="0 0 480 224" role="img" aria-label="Layered snapshots let a flat read see recent and past blocks">
        <circle class="dl-token" cx="60" cy="24" r="9" /><text class="dl-qt" x="60" y="28">?</text>
        <text class="t-cap" x="150" y="20">read 0xA7… as of block N−2</text>
        {[
          ["block N — 1-block snapshot", "t1"],
          ["block N−1", "t1"],
          ["block N−2", "t1 hit"],
          ["compacted N−4 … N−1", "t2"],
          ["compacted N−32 … N", "t2"],
          ["base flat DB", "base"],
        ].map(([label, kind], i) => (
          <g class={`dl-layer dll${i} ${kind.includes("hit") ? "dl-found" : ""}`}>
            <rect class={`db-layer ${kind.split(" ")[0]}`} x="120" y={36 + i * 28} width="300" height="22" rx="4" />
            <text class="t-fld" x="132" y={51 + i * 28}>{label}</text>
            {kind.includes("hit") && <text class="st-ok" x="404" y={51 + i * 28}>✓</text>}
          </g>
        ))}
        <text class="t-cap" x="240" y="214">a read falls through ~7 layers — enough for the 128-block reorg depth snap sync needs</text>
      </svg>
    )}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .scene {
    margin: 1.6rem auto;
    max-width: 580px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: radial-gradient(120% 100% at 50% 0%, var(--color-surface-2), var(--color-canvas));
    padding: 1.1rem 1.2rem 0.9rem;
  }
  .scene-wide { max-width: 720px; }
  .scene-stage svg { width: 100%; height: auto; display: block; }
  figcaption {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-ink-faint);
    text-align: center;
  }

  /* shared primitives */
  .sheet, .node, .msg, .op, .blk, .cell, .trie, .hdr, .gauge, .si, .pkt, .addr-box {
    fill: var(--color-surface);
    stroke: var(--color-border-strong);
    stroke-width: 1.2;
  }
  .hair, .hair2 { stroke: var(--color-border); stroke-width: 1; }
  .t-mid { fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; }
  .t-l { fill: var(--color-ink); font-family: var(--font-mono); font-size: 12px; }
  .t-r { fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 12px; text-anchor: end; }
  .t-s { fill: var(--color-ink); font-family: var(--font-mono); font-size: 12px; text-anchor: middle; }
  .t-op { fill: var(--color-ink); font-family: var(--font-mono); font-size: 12px; }
  .t-cap { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 10px; text-anchor: middle; }
  .t-x { fill: var(--color-changed); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; }
  .arrow, .arrow2, .arrow3, .link, .conv { fill: none; stroke: var(--color-border-strong); stroke-width: 1.6; }
  .link.dashed { stroke-dasharray: 4 4; }

  /* state: an edit pulses a row and floats a +5 up */
  .rowhl { fill: color-mix(in oklab, var(--color-accent) 12%, transparent); stroke: none; opacity: 0; animation: hl 4s ease-in-out infinite; }
  .bal { animation: balbump 4s ease-in-out infinite; }
  .edit { animation: editfly 4s ease-in-out infinite; }
  @keyframes hl { 0%,40% { opacity: 0 } 55%,80% { opacity: 1 } 100% { opacity: 0 } }
  @keyframes balbump { 0%,55% { fill: var(--color-ink-muted) } 65% { fill: var(--color-node-leaf) } 100% { fill: var(--color-ink-muted) } }
  @keyframes editfly { 0% { transform: translateX(0); opacity: 0 } 15% { opacity: 1 } 45% { transform: translateX(120px); opacity: 1 } 55% { transform: translateX(120px); opacity: 0 } 100% { opacity: 0 } }
  .pkt { fill: color-mix(in oklab, var(--color-node-leaf) 16%, var(--color-surface)); stroke: var(--color-node-leaf); }

  /* sign: stamp in, hold ✓, then crack to ✗ */
  .seal-c { fill: color-mix(in oklab, var(--color-node-leaf) 16%, var(--color-surface)); stroke: var(--color-node-leaf); stroke-width: 2; transform-box: fill-box; transform-origin: center; animation: stamp 5s ease-in-out infinite; }
  .seal-m { fill: var(--color-node-leaf); font-size: 24px; text-anchor: middle; animation: stamp 5s ease-in-out infinite; }
  .crack { opacity: 0; animation: crack 5s ease-in-out infinite; }
  .arrow, .arrow2 { stroke-dasharray: 70; stroke-dashoffset: 70; animation: draw 5s ease-in-out infinite; }
  @keyframes stamp { 0% { transform: scale(0.2); opacity: 0 } 15% { transform: scale(1.15); opacity: 1 } 22%,55% { transform: scale(1); opacity: 1 } 70% { opacity: 0.15 } 100% { opacity: 0 } }
  @keyframes crack { 0%,60% { opacity: 0 } 72%,92% { opacity: 1 } 100% { opacity: 0 } }
  @keyframes draw { 0% { stroke-dashoffset: 70 } 20%,100% { stroke-dashoffset: 0 } }

  /* verify: parallel lanes — a true message passes, a tampered one fails */
  .vmsg { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .vmsg.ok { stroke: var(--color-node-leaf); fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); }
  .vmsg.bad { stroke: var(--color-changed); fill: color-mix(in oklab, var(--color-changed) 8%, var(--color-surface)); }
  .bad-word { fill: var(--color-changed); }
  .vsig { fill: color-mix(in oklab, var(--color-hash) 12%, var(--color-surface)); stroke: var(--color-hash); }
  .vbox { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .vlbl.ok-t { fill: var(--color-node-leaf); } .vlbl.bad-t { fill: var(--color-changed); }
  .varrow { fill: none; stroke: var(--color-border-strong); stroke-width: 1.6; stroke-dasharray: 50; stroke-dashoffset: 50; }
  .va-a, .va-c { animation: vdraw 4.5s ease-in-out infinite; }
  .va-b, .va-d { animation: vdraw 4.5s ease-in-out 0.5s infinite; }
  @keyframes vdraw { 0%,8% { stroke-dashoffset: 50 } 26%,100% { stroke-dashoffset: 0 } }
  .ok-c { fill: color-mix(in oklab, var(--color-node-leaf) 16%, var(--color-surface)); stroke: var(--color-node-leaf); stroke-width: 2; }
  .ok-m { fill: var(--color-node-leaf); font-size: 16px; text-anchor: middle; }
  .bad-c { fill: color-mix(in oklab, var(--color-changed) 16%, var(--color-surface)); stroke: var(--color-changed); stroke-width: 2; }
  .bad-m { fill: var(--color-changed); font-size: 16px; text-anchor: middle; }
  .vres { opacity: 0; }
  .v-ok, .v-bad { animation: vpop 4.5s ease-in-out infinite; }
  @keyframes vpop { 0%,40% { opacity: 0 } 52%,92% { opacity: 1 } 100% { opacity: 0 } }

  /* recover: address materializes */
  .seal-c2 { fill: color-mix(in oklab, var(--color-hash) 16%, var(--color-surface)); stroke: var(--color-hash); }
  .seal-m2 { fill: var(--color-hash); font-size: 22px; text-anchor: middle; }
  .recover-q { animation: blink 4s ease-in-out infinite; }
  .arrow3 { stroke-dasharray: 100; stroke-dashoffset: 100; animation: draw3 4s ease-in-out infinite; }
  .addr-box { fill: color-mix(in oklab, var(--color-accent) 10%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .t-addr { fill: var(--color-accent-strong); font-family: var(--font-mono); font-size: 13px; text-anchor: middle; }
  .addr-reveal { opacity: 0; animation: reveal 4s ease-in-out infinite; }
  @keyframes blink { 0%,40% { opacity: 1 } 55%,100% { opacity: 0 } }
  @keyframes draw3 { 0%,15% { stroke-dashoffset: 100 } 45%,100% { stroke-dashoffset: 0 } }
  @keyframes reveal { 0%,45% { opacity: 0; transform: translateX(-8px) } 60%,100% { opacity: 1; transform: translateX(0) } }

  .t-ok { fill: var(--color-node-leaf); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; }

  /* replay: tx applies once, duplicate bounces off the nonce */
  .rp-nonce { fill: var(--color-accent-strong); }
  .ghost { fill: color-mix(in oklab, var(--color-changed) 8%, var(--color-surface)); stroke: var(--color-changed); stroke-dasharray: 4 3; }
  .rp-ok { stroke: var(--color-node-leaf); stroke-dasharray: 180; stroke-dashoffset: 180; animation: draw-ok 5s ease-in-out infinite; }
  .t-ok { animation: fade-hold 5s ease-in-out infinite; }
  .rp-dup { animation: dupbounce 5s ease-in-out infinite; }
  .rp-reject { animation: reject 5s ease-in-out infinite; }
  @keyframes draw-ok { 0% { stroke-dashoffset: 180 } 25%,100% { stroke-dashoffset: 0 } }
  @keyframes fade-hold { 0%,10% { opacity: 0 } 25%,100% { opacity: 1 } }
  @keyframes dupbounce { 0%,40% { transform: translate(0,0); opacity: 0 } 50% { opacity: 1 } 62% { transform: translate(150px,0); opacity: 1 } 78% { transform: translate(40px,0); opacity: 1 } 92% { transform: translate(40px,0); opacity: 0 } 100% { opacity: 0 } }
  @keyframes reject { 0%,62% { opacity: 0 } 74%,92% { opacity: 1 } 100% { opacity: 0 } }

  /* txfields: each row's justification highlights in turn */
  .txbar { fill: transparent; stroke: none; }
  .t-field { fill: var(--color-accent-strong); font-family: var(--font-mono); font-size: 13px; }
  .t-why { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 11px; }
  .txrow { opacity: 0.4; }
  .tr0 { animation: rowlit 9s steps(1) infinite; }
  .tr1 { animation: rowlit 9s steps(1) 1s infinite; }
  .tr2 { animation: rowlit 9s steps(1) 2s infinite; }
  .tr3 { animation: rowlit 9s steps(1) 3s infinite; }
  .tr4 { animation: rowlit 9s steps(1) 4s infinite; }
  .tr5 { animation: rowlit 9s steps(1) 5s infinite; }
  .tr6 { animation: rowlit 9s steps(1) 6s infinite; }
  .tr7 { animation: rowlit 9s steps(1) 7s infinite; }
  .tr8 { animation: rowlit 9s steps(1) 8s infinite; }
  .txrow.tr0 .txbar, .txrow.tr1 .txbar, .txrow.tr2 .txbar, .txrow.tr3 .txbar, .txrow.tr4 .txbar, .txrow.tr5 .txbar, .txrow.tr6 .txbar, .txrow.tr7 .txbar, .txrow.tr8 .txbar { animation: barlit 9s steps(1) infinite; }
  .tr1 .txbar { animation-delay: 1s } .tr2 .txbar { animation-delay: 2s } .tr3 .txbar { animation-delay: 3s } .tr4 .txbar { animation-delay: 4s } .tr5 .txbar { animation-delay: 5s } .tr6 .txbar { animation-delay: 6s } .tr7 .txbar { animation-delay: 7s } .tr8 .txbar { animation-delay: 8s }
  @keyframes rowlit { 0% { opacity: 0.4 } 0.5%,10% { opacity: 1 } 11%,100% { opacity: 0.7 } }
  @keyframes barlit { 0% { fill: transparent } 0.5%,10% { fill: color-mix(in oklab, var(--color-accent) 12%, transparent) } 11%,100% { fill: transparent } }

  /* blocks: a full trie whose changed path recomputes into the chain */
  .block { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .fchip { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-border); }
  .hchip { fill: color-mix(in oklab, var(--color-hash) 10%, var(--color-surface)); stroke: var(--color-hash); }
  .t-fld { fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 9px; }
  .t-bal { fill: var(--color-ink); font-family: var(--font-mono); font-size: 10px; }
  .t-h { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 8px; }
  .leaf-t { fill: var(--color-node-leaf); }
  .plink { fill: none; stroke: var(--color-border-strong); stroke-width: 1.6; }
  .feed { fill: none; stroke: var(--color-accent-dim); stroke-width: 1.4; stroke-dasharray: 3 3; }
  .feed-lbl { fill: var(--color-accent-dim); }
  .edge { fill: none; stroke: var(--color-border); stroke-width: 1.3; }
  .edge-on { stroke: var(--color-accent); stroke-width: 1.9; }
  .changed-leaf { stroke: var(--color-changed); }
  /* "new" values are the recomputed ones; they cross-fade in as the wave climbs */
  .new, .t-h.new, .t-bal.new { fill: var(--color-changed); }
  .old.oA { animation: kOA 9s linear infinite; } .new.nA { animation: kNA 9s linear infinite; }
  .old.oB { animation: kOB 9s linear infinite; } .new.nB { animation: kNB 9s linear infinite; }
  .old.oC { animation: kOC 9s linear infinite; } .new.nC { animation: kNC 9s linear infinite; }
  .old.oD { animation: kOD 9s linear infinite; } .new.nD { animation: kND 9s linear infinite; }
  .gE { animation: kGE 9s linear infinite; } .gF { animation: kGF 9s linear infinite; } .gG { animation: kGG 9s linear infinite; }
  @keyframes kOA { 0%,9% { opacity: 1 } 15%,93% { opacity: 0 } 100% { opacity: 1 } }
  @keyframes kNA { 0%,9% { opacity: 0 } 15%,93% { opacity: 1 } 100% { opacity: 0 } }
  @keyframes kOB { 0%,23% { opacity: 1 } 29%,93% { opacity: 0 } 100% { opacity: 1 } }
  @keyframes kNB { 0%,23% { opacity: 0 } 29%,93% { opacity: 1 } 100% { opacity: 0 } }
  @keyframes kOC { 0%,35% { opacity: 1 } 41%,93% { opacity: 0 } 100% { opacity: 1 } }
  @keyframes kNC { 0%,35% { opacity: 0 } 41%,93% { opacity: 1 } 100% { opacity: 0 } }
