  @keyframes fade-in-half { 0%,46% { opacity: 0 } 58%,100% { opacity: 1 } }

  /* triepath: walk the nibble path down typed nodes, then re-hash up */
  .nib { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .t-nib { fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 12px; text-anchor: middle; }
  .tnode { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .tnode.branch { stroke: var(--color-node-branch); }
