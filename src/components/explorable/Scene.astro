    {/* ── snap sync: download flat key ranges with proofs, rebuild, heal ── */}
    {name === "syncsnap" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="Snap sync downloads flat ranges then heals the trie">
        <text class="t-cap" x="104" y="26">{L("flat state, in big ranges")}</text>
