  .hchip { fill: color-mix(in oklab, var(--color-hash) 10%, var(--color-surface)); stroke: var(--color-hash); }
  .t-fld { fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 9px; }
  .t-bal { fill: var(--color-ink); font-family: var(--font-mono); font-size: 10px; }
  .t-h { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 8px; }
  .leaf-t { fill: var(--color-node-leaf); }
  .plink { fill: none; stroke: var(--color-border-strong); stroke-width: 1.6; }
  .feed { fill: none; stroke: var(--color-accent-dim); stroke-width: 1.4; stroke-dasharray: 3 3; }
  .feed-lbl { fill: var(--color-accent-dim); }
  .edge { fill: none; stroke: var(--color-border); stroke-width: 1.3; }
  .edge-on { stroke: var(--color-accent); stroke-width: 1.9; }
