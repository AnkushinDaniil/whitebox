        ))}
        <text class="t-fld st-nn" x="270" y="122">{L("nibble c → its slot")}</text>
        <path class="sarrow st-e2" d="M346 90 H392" />

        <rect class="st-leaf st-gl-leaf" x="392" y="64" width="80" height="52" rx="7" />
