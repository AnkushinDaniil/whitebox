        <text class="t-cap" x="240" y="90">{L("re-execute every transaction, block by block")}</text>
        <rect class="sg-track" x="24" y="106" width="432" height="20" rx="6" />
        <rect class="sg-fill" x="26" y="108" width="428" height="16" rx="5" />
        <text class="t-fld sg-state" x="240" y="121">{L("rebuilding state…")}</text>
        <text class="t-x" x="240" y="162">{L("⏱ days — but every state transition personally verified")}</text>
      </svg>
    )}

    {/* ── fast sync: download the state trie node by node, verify by hash ── */}
    {name === "synctrie" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="Fast sync downloads the state trie node by node">
        <path class="sedge" d="M240 46 L150 78" /><path class="sedge" d="M240 46 L240 78" /><path class="sedge" d="M240 46 L330 78" />
        <path class="sedge" d="M150 104 L96 136" /><path class="sedge" d="M150 104 L150 136" /><path class="sedge" d="M330 104 L330 136" /><path class="sedge" d="M330 104 L384 136" />
        <g class="st-n s0"><rect class="tnode branch" x="208" y="22" width="64" height="24" rx="5" /><text class="t-cap" x="240" y="38">{L("root")}</text><text class="st-ok" x="278" y="30">✓</text></g>
        <g class="st-n s1"><rect class="tnode branch" x="118" y="80" width="64" height="24" rx="5" /><text class="t-cap" x="150" y="96">{L("node")}</text><text class="st-ok" x="188" y="88">✓</text></g>
        <g class="st-n s2"><rect class="tnode branch" x="208" y="80" width="64" height="24" rx="5" /><text class="t-cap" x="240" y="96">{L("node")}</text><text class="st-ok" x="278" y="88">✓</text></g>
        <g class="st-n s3"><rect class="tnode branch" x="298" y="80" width="64" height="24" rx="5" /><text class="t-cap" x="330" y="96">{L("node")}</text><text class="st-ok" x="368" y="88">✓</text></g>
        {[[64, "s4"], [118, "s5"], [298, "s6"], [352, "s7"]].map(([x, c]) => (
          <g class={`st-n ${c}`}><rect class="tnode leaf" x={x} y="138" width="48" height="22" rx="5" /><text class="t-cap" x={Number(x) + 24} y="153">{L("leaf")}</text></g>
        ))}
        <text class="t-cap" x="240" y="188">{L("verify each node against its parent’s hash — but millions of tiny requests, and the pivot keeps moving")}</text>
      </svg>
    )}

    {/* ── snap sync: download flat key ranges with proofs, rebuild, heal ── */}
    {name === "syncsnap" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="Snap sync downloads flat ranges then heals the trie">
        <text class="t-cap" x="104" y="26">{L("flat state, in big ranges")}</text>
        {[0, 1, 2, 3].map((i) => (
          <g class={`sn-range r${i}`}>
            <rect class="sn-bar" x="20" y={36 + i * 30} width="176" height="22" rx="5" />
            <text class="t-fld" x="30" y={51 + i * 30}>0x{i}0…{i}f</text>
            <text class="st-ok" x="180" y={51 + i * 30}>✓</text>
          </g>
        ))}
        <path class="sarrow sn-arrow" d="M200 96 H250" />
        <text class="t-cap" x="350" y="26">{L("rebuilt locally")}</text>
        <rect class="tnode branch sn-t0" x="300" y="40" width="100" height="22" rx="5" /><text class="t-cap" x="350" y="55">{L("root")}</text>
        <rect class="tnode leaf sn-t1" x="288" y="74" width="56" height="20" rx="4" /><rect class="tnode leaf sn-t2" x="356" y="74" width="56" height="20" rx="4" />
        <g class="sn-heal"><rect class="tnode leaf sn-heal-n" x="356" y="74" width="56" height="20" rx="4" /><text class="st-ok" x="384" y="112">{L("heal ✓")}</text></g>
        <text class="t-cap" x="240" y="182">{L("a handful of big sequential ranges, not a million nodes — hours, not days")}</text>
      </svg>
    )}

    {/* ── light client: only headers; fetch state on demand with a proof ── */}
    {name === "synclight" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="A light client keeps only headers and verifies proofs on demand">
        {[0, 1, 2, 3, 4, 5].map((i) => (
          <g><rect class="lhdr" x={20 + i * 74} y="26" width="62" height="26" rx="5" /><text class="t-cap" x={51 + i * 74} y="43">root #{i}</text></g>
        ))}
        <path class="sarrow" d="M51 52 V70" /><text class="t-fld lq" x="120" y="92">{L("balance 0xA?")}</text>
        <path class="sarrow lp" d="M60 78 L60 110 L160 110" />
        <g class="lproof">
          <rect class="tnode branch" x="160" y="98" width="50" height="22" rx="4" /><rect class="tnode branch" x="230" y="98" width="50" height="22" rx="4" /><rect class="tnode leaf" x="300" y="98" width="56" height="22" rx="4" />
          <path class="sedge on" d="M210 109 H230" /><path class="sedge on" d="M280 109 H300" />
          <text class="t-ok" x="392" y="114">✓ 12 Ξ</text>
        </g>
        <text class="t-cap" x="240" y="172">{L("stores only headers — asks a full node for state, gets a Merkle proof, verifies it itself")}</text>
      </svg>
    )}

    {/* ── checkpoint sync: trust a recent finalized anchor, skip genesis ── */}
    {name === "synccheckpoint" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="Checkpoint sync starts from a recent trusted finalized block">
        <g class="ck-old">
          <rect class="block" x="20" y="34" width="40" height="26" rx="5" /><text class="t-cap" x="40" y="50">gen</text>
          <path class="ck-crawl" d="M62 47 H430" />
          <text class="t-cap" x="430" y="50">{L("head")}</text>
          <text class="t-x" x="240" y="78">{L("replay/verify all of history from genesis — weeks")}</text>
        </g>
        <text class="t-cap ck-instead" x="60" y="116">{L("instead:")}</text>
        <rect class="ck-anchor" x="280" y="124" width="96" height="30" rx="6" /><text class="t-cap" x="328" y="138">{L("checkpoint")}</text><text class="ck-lock" x="328" y="150">{L("🔒 finalized")}</text>
        <path class="sarrow ck-hop" d="M376 139 H424" />
        <rect class="block" x="424" y="126" width="34" height="26" rx="5" /><text class="t-cap" x="441" y="142">{L("head")}</text>
        <text class="t-ok" x="180" y="186">{L("trusted recent anchor → snap forward → minutes")}</text>
      </svg>
    )}

    {/* ── flat-db: reading a value by walking the trie = many scattered disk reads ── */}
    {name === "dbtrie" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="Reading one account walks the trie as several scattered disk reads">
        <rect class="db-q" x="14" y="12" width="168" height="26" rx="5" /><text class="t-fld" x="24" y="29">{L("read 0xA7… balance")}</text>
        <path class="da da1" d="M70 70 L300 60" /><path class="da da2" d="M334 72 L150 104" /><path class="da da3" d="M118 116 L350 116" /><path class="da da4" d="M350 128 L246 150" />
        <g class="dr dr0"><rect class="db-node" x="36" y="56" width="68" height="24" rx="5" /><text class="t-cap" x="70" y="72">{L("root")}</text></g>
        <g class="dr dr1"><rect class="db-node" x="300" y="48" width="68" height="24" rx="5" /><text class="t-cap" x="334" y="64">{L("node")}</text></g>
        <g class="dr dr2"><rect class="db-node" x="84" y="104" width="68" height="24" rx="5" /><text class="t-cap" x="118" y="120">{L("node")}</text></g>
        <g class="dr dr3"><rect class="db-node" x="316" y="104" width="68" height="24" rx="5" /><text class="t-cap" x="350" y="120">{L("node")}</text></g>
        <g class="dr dr4"><rect class="db-node db-val" x="212" y="150" width="68" height="24" rx="5" /><text class="t-cap" x="246" y="166">{L("value")}</text></g>
        <text class="t-x" x="240" y="200">{L("one account = 4–6 random disk reads, walking the trie node by node")}</text>
      </svg>
    )}

    {/* ── halfpath: keying nodes by trie path clusters them on disk (locality) ── */}
    {name === "dbhalfpath" && (
      <svg viewBox="0 0 480 232" role="img" aria-label="HalfPath keys nodes by trie path so neighbouring nodes sit together on disk">
        <text class="t-fld hp-bad" x="28" y="26">{L("hash-keyed — random disk slots")}</text>
        {Array.from({ length: 16 }).map((_, i) => (
          <rect class={`hp-cell ${[1, 4, 6, 10, 14].includes(i) ? "hp-node" : ""}`} x={28 + i * 26} y="38" width="24" height="22" rx="3" />
        ))}
        <rect class="hp-head hp-head-a" x="0" y="34" width="6" height="30" rx="2" />
        <text class="t-x" x="240" y="94">{L("six hops, each to a random slot — a cache miss every time")}</text>
        <text class="t-fld hp-ok" x="28" y="142">{L("path-keyed — neighbours sit together")}</text>
        {Array.from({ length: 16 }).map((_, i) => (
          <rect class={`hp-cell ${[6, 7, 8, 9, 10].includes(i) ? "hp-node-ok" : ""}`} x={28 + i * 26} y="154" width="24" height="22" rx="3" />
        ))}
        <rect class="hp-head hp-head-b" x="0" y="150" width="6" height="30" rx="2" />
        <text class="t-ok" x="240" y="210">{L("one sweep over neighbouring slots — ~50% faster, ~25% smaller")}</text>
      </svg>
    )}

    {/* ── flat-db: read the value directly from a flat column, trie kept only for the root ── */}
    {name === "dbflat" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="Flat DB reads the value in one direct lookup; the trie is kept only to recompute the root">
        <rect class="db-q" x="14" y="22" width="150" height="26" rx="5" /><text class="t-fld" x="24" y="39">{L("read 0xA7… balance")}</text>
        <text class="df-six" x="24" y="62">{L("✗ 6 disk hops")}</text><text class="df-one" x="24" y="62">{L("✓ 1 lookup")}</text>
        <path class="sarrow df-arrow" d="M164 35 H214" />
        <text class="t-cap" x="280" y="20">{L("flat account column")}</text>
        {[0, 1, 2, 3].map((i) => (
          <g class={`df-row ${i === 1 ? "df-hit" : ""}`}>
            <rect class="db-flatrow" x="220" y={28 + i * 26} width="170" height="22" rx="4" />
            <text class="t-fld" x="230" y={43 + i * 26}>0x{i === 1 ? "A7" : i + "" + i}… → {i === 1 ? "12 Ξ" : "…"}</text>
          </g>
        ))}
        <text class="t-ok df-ok" x="430" y="59">{L("✓ 1 read")}</text>
        <g class="df-trie">
          <rect class="tnode branch" x="196" y="150" width="88" height="22" rx="5" /><text class="t-cap" x="240" y="165">{L("trie root")}</text>
          <text class="t-cap" x="240" y="190">{L("kept aside — only to recompute the stateRoot at commit")}</text>
        </g>
      </svg>
    )}

    {/* ── flat-db: compaction merges layers in powers of two (8→4→2→1) ── */}
    {name === "dbcompact" && (
      <svg viewBox="0 0 480 214" role="img" aria-label="Compaction merges snapshot layers in powers of two, halving the count each round">
        <g class="cl cl3"><rect class="cbox c8" x="48" y="18" width="384" height="26" rx="5" /><text class="t-fld c-on" x="240" y="35">1 layer — blocks 1–8</text></g>
        <g class="cl cl2">{[0, 1].map((i) => (<g><rect class="cbox c4" x={48 + i * 196} y="64" width="188" height="24" rx="5" /><text class="t-fld c-on" x={142 + i * 196} y="80">blocks {i * 4 + 1}–{i * 4 + 4}</text></g>))}</g>
        <g class="cl cl1">{[0, 1, 2, 3].map((i) => (<g><rect class="cbox c2" x={48 + i * 98} y="110" width="90" height="22" rx="4" /><text class="t-fld c-on" x={93 + i * 98} y="125">{i * 2 + 1}–{i * 2 + 2}</text></g>))}</g>
        <g class="cl cl0">{[0, 1, 2, 3, 4, 5, 6, 7].map((i) => (<g><rect class="cbox c1" x={48 + i * 48} y="156" width="40" height="22" rx="4" /><text class="t-fld c-on" x={68 + i * 48} y="171">b{i + 1}</text></g>))}</g>
        <text class="t-cap c-count cc0" x="240" y="196">{L("8 single-block layers pile up…")}</text>
        <text class="t-cap c-count cc1" x="240" y="196">{L("merge in pairs → 4 layers")}</text>
        <text class="t-cap c-count cc2" x="240" y="196">{L("merge again → 2 layers")}</text>
        <text class="t-cap c-count cc3" x="240" y="196">{L("…→ 1 layer. each round halves them, so 128 blocks need only ~7")}</text>
      </svg>
    )}

    {/* ── flat-db: a layer is a diff of changed keys; a read takes the newest match ── */}
    {name === "dbdiff" && (
      <svg viewBox="0 0 480 224" role="img" aria-label="A layer is a diff of changed keys; a read takes the newest match, else the base">
        <rect class="db-q" x="14" y="18" width="118" height="24" rx="5" /><text class="t-fld" x="24" y="34">{L("read key B")}</text>
        <circle class="dd-token" cx="158" cy="30" r="9" /><text class="dd-qt" x="158" y="34">B</text>
        <rect class="dd-card" x="186" y="34" width="196" height="34" rx="5" />
        <text class="t-fld dd-tag" x="196" y="55">{L("block N · diff")}</text><text class="t-fld" x="300" y="55">A=9  C=2</text>
        <rect class="dd-card dd-hit" x="186" y="78" width="196" height="34" rx="5" />
        <text class="t-fld dd-tag" x="196" y="99">{L("block N−1 · diff")}</text><text class="t-fld dd-found" x="300" y="99">B=5  ✓</text>
        <rect class="dd-card" x="186" y="122" width="196" height="34" rx="5" />
        <text class="t-fld dd-tag" x="196" y="143">{L("block N−2 · diff")}</text><text class="t-fld dd-shadow" x="300" y="143">A=7</text><text class="t-fld" x="338" y="143">D=1</text>
        <text class="dd-shadnote" x="392" y="143">{L("↑ shadowed")}</text>
        <rect class="dd-base" x="186" y="166" width="196" height="28" rx="5" />
        <text class="t-cap" x="284" y="184">{L("base flat DB · the full state")}</text>
        <text class="t-cap" x="240" y="214">{L("a layer holds only the keys its block changed; reads take the first (newest) match, else fall to the base")}</text>
      </svg>
    )}

    {/* ── flat-db: merging two diffs keeps the newest value per key (dedup) ── */}
    {name === "dbmerge" && (
      <svg viewBox="0 0 480 196" role="img" aria-label="Merging two diff layers keeps the newest value of each key, so duplicates collapse">
        <rect class="dd-card" x="18" y="26" width="150" height="44" rx="5" />
        <text class="t-fld dd-tag" x="30" y="44">{L("block 5 · diff")}</text><text class="t-fld" x="30" y="62">A=7   B=5</text>
        <rect class="dd-card" x="18" y="98" width="150" height="44" rx="5" />
        <text class="t-fld dd-tag" x="30" y="116">{L("block 6 · diff")}</text><text class="t-fld" x="30" y="134">A=9   C=2</text>
        <path class="sarrow dm-arrow" d="M168 84 H236" />
        <rect class="dd-card dm-merged" x="240" y="52" width="200" height="78" rx="6" />
        <text class="t-fld dd-tag dm-keep" x="252" y="72">{L("compacted 5–6 · diff")}</text>
        <text class="t-fld dm-keep" x="252" y="94">A=9   B=5   C=2</text>
        <text class="t-x dm-drop" x="252" y="116">{L("A=7 dropped — block 5’s value is gone")}</text>
        <text class="t-cap" x="240" y="178">{L("keep the newest value of each key — duplicates collapse (smaller); intra-range reads are lost")}</text>
      </svg>
    )}

    {/* ── flat-db: a read falls through layered snapshots to find a past value ── */}
    {name === "dblayers" && (
      <svg viewBox="0 0 480 224" role="img" aria-label="Layered snapshots let a flat read see recent and past blocks">
        <circle class="dl-token" cx="60" cy="24" r="9" /><text class="dl-qt" x="60" y="28">?</text>
        <text class="t-cap" x="150" y="20">{L("read 0xA7… as of block N−2")}</text>
        {[
          ["block N — 1-block snapshot", "t1"],
          ["block N−1", "t1"],
          ["block N−2", "t1 hit"],
          ["compacted N−4 … N−1", "t2"],
          ["compacted N−32 … N", "t2"],
          ["base flat DB", "base"],
        ].map(([label, kind], i) => (
          <g class={`dl-layer dll${i} ${kind.includes("hit") ? "dl-found" : ""}`}>
            <rect class={`db-layer ${kind.split(" ")[0]}`} x="120" y={36 + i * 28} width="300" height="22" rx="4" />
            <text class="t-fld" x="132" y={51 + i * 28}>{label}</text>
            {kind.includes("hit") && <text class="st-ok" x="404" y={51 + i * 28}>✓</text>}
          </g>
        ))}
        <text class="t-cap" x="240" y="214">{L("a read falls through ~7 layers — enough for the 128-block reorg depth snap sync needs")}</text>
      </svg>
    )}

    {/* ── consensus: time is sliced into 12s slots, one proposer each ── */}
    {name === "cl-slots" && (
      <svg viewBox="0 0 480 166" role="img" aria-label="Time is divided into 12-second slots, each with one chosen proposer">
        <text class="t-cap" x="44" y="22">{L("time →")}</text>
        {["7k", "41k", "220k", "98k", "3k", "160k", "55k", "12k"].map((id, i) => (
          <g>
            <rect class="sl-cell" x={16 + i * 57} y="40" width="50" height="56" rx="5" />
            <circle class="sl-prop" cx={41 + i * 57} cy="62" r="7" />
            <text class="t-cap" x={41 + i * 57} y="86">#{id}</text>
          </g>
        ))}
        <rect class="sl-now" x="14" y="38" width="54" height="60" rx="6" />
        <text class="t-cap" x="240" y="124">{L("one 12-second slot · one chosen proposer · one block")}</text>
      </svg>
    )}

    {/* ── consensus: RANDAO picks each slot's proposer from the validator set ── */}
    {name === "cl-randao" && (
      <svg viewBox="0 0 480 196" role="img" aria-label="A shared random seed picks the proposer for each slot">
        <rect class="rd-seed" x="20" y="58" width="124" height="60" rx="8" />
        <text class="t-cap" x="82" y="80">{L("RANDAO seed")}</text>
        <text class="t-fld rd-v rdv0" x="82" y="100">0x9f3a…</text><text class="t-fld rd-v rdv1" x="82" y="100">0x2c71…</text><text class="t-fld rd-v rdv2" x="82" y="100">0xb480…</text>
        {[0, 1, 2, 3, 4, 5].map((c) => [0, 1, 2, 3].map((r) => (
          <circle class={`rd-dot ${c === 2 && r === 1 ? "rd-chosen" : ""}`} cx={210 + c * 42} cy={46 + r * 36} r="6" />
        )))}
        <path class="rd-pick" d="M144 88 L290 82" />
        <text class="t-cap rd-lbl" x="300" y="64">{L("→ proposer")}</text>
        <path class="rd-mix" d="M252 46 Q180 20 110 56" /><text class="t-cap rd-mixl" x="200" y="18">{L("each proposer stirs it back in")}</text>
        <text class="t-cap" x="240" y="186">{L("a shared random seed picks each slot’s proposer — unpredictable and ungameable")}</text>
      </svg>
    )}

    {/* ── consensus: a committee attests; votes are weight fork choice follows ── */}
    {name === "cl-attest" && (
      <svg viewBox="0 0 480 196" role="img" aria-label="Each slot a committee attests, voting on the head and a checkpoint">
        <text class="t-cap" x="86" y="24">{L("this slot’s committee")}</text>
        {[0, 1, 2, 3, 4, 5].map((i) => (<circle class={`at-v av${i}`} cx={46 + (i % 3) * 40} cy={56 + Math.floor(i / 3) * 40} r="8" />))}
        {[0, 1, 2, 3, 4, 5].map((i) => (<path class={`at-a aa${i}`} d={`M${66 + (i % 3) * 40} ${56 + Math.floor(i / 3) * 40} L318 80`} />))}
        <rect class="block at-head" x="318" y="56" width="108" height="46" rx="6" /><text class="t-cap" x="372" y="76">{L("head block")}</text>
        <text class="t-cap" x="372" y="92">{L("+ checkpoint")}</text>
        <rect class="at-wtrack" x="318" y="116" width="108" height="14" rx="4" /><rect class="at-wfill" x="320" y="118" width="104" height="10" rx="3" />
        <text class="t-cap" x="372" y="148">{L("accumulated weight")}</text>
        <text class="t-cap" x="240" y="182">{L("each validator attests once per epoch — the vote names the head (fork choice) and a checkpoint (finality)")}</text>
      </svg>
    )}

    {/* ── consensus: epochs, justification, finalization ── */}
    {name === "cl-epoch" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="Epochs group 32 slots; two-thirds justifies a checkpoint, two in a row finalizes">
        <path class="ep-line" d="M40 56 H440" />
        {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => (<line class="ep-tick" x1={70 + i * 20} y1="50" x2={70 + i * 20} y2="62" />))}
        {[0, 1, 2, 3, 4, 5, 6].map((i) => (<line class="ep-tick" x1={262 + i * 20} y1="50" x2={262 + i * 20} y2="62" />))}
        <text class="t-cap" x="160" y="40">{L("epoch N · 32 slots")}</text><text class="t-cap" x="350" y="40">{L("epoch N+1")}</text>
        <circle class="ep-cp ep-c0" cx="92" cy="56" r="11" /><circle class="ep-cp ep-c1" cx="240" cy="56" r="11" /><circle class="ep-cp" cx="400" cy="56" r="11" />
        <rect class="ep-track" x="52" y="92" width="80" height="12" rx="4" /><rect class="ep-fill ep-f0" x="54" y="94" width="76" height="8" rx="3" />
        <rect class="ep-track" x="200" y="92" width="80" height="12" rx="4" /><rect class="ep-fill ep-f1" x="202" y="94" width="76" height="8" rx="3" />
        <text class="t-ok ep-j0" x="92" y="124">{L("justified")}</text><text class="t-ok ep-j1" x="240" y="124">{L("justified")}</text>
        <text class="ep-lock" x="92" y="80">🔒</text><text class="t-ok ep-final" x="92" y="150">{L("finalized")}</text>
        <text class="t-cap" x="240" y="186">{L("⅔ of staked ETH justifies a checkpoint · two justified in a row finalizes the first")}</text>
      </svg>
    )}

    {/* ── consensus: proposer-builder separation ── */}
    {name === "cl-pbs" && (
      <svg viewBox="0 0 480 208" role="img" aria-label="Proposer-builder separation: builders bid, the proposer signs the best header blind">
        {[["0.08", "b0"], ["0.12", "b1"], ["0.05", "b2"]].map(([bid, c], i) => (
          <g class={`pb-builder ${i === 1 ? "pb-win" : ""}`}>
            <rect class="pb-box" x="14" y={18 + i * 56} width="128" height="44" rx="6" />
            <text class="t-fld" x="26" y={38 + i * 56}>{L("builder")}</text><text class="t-fld pb-bid" x="26" y={54 + i * 56}>bid {bid} Ξ</text>
            <path class={`pb-a ${c}`} d={`M142 ${40 + i * 56} L170 95`} />
          </g>
        ))}
        <rect class="pb-relay" x="170" y="72" width="80" height="64" rx="8" /><text class="t-cap" x="210" y="100">{L("relay")}</text><text class="t-cap" x="210" y="116">{L("holds blocks")}</text>
        <path class="pb-a2" d="M250 104 H290" />
        <rect class="pb-prop" x="290" y="74" width="166" height="58" rx="8" /><text class="t-cap" x="373" y="96">{L("proposer")}</text><text class="t-cap pb-sign" x="373" y="114">{L("✓ signs best header, blind")}</text>
        <path class="pb-a3" d="M373 132 V158" /><rect class="pb-block" x="306" y="160" width="134" height="36" rx="6" /><text class="t-cap" x="373" y="182">{L("block published")}</text>
        <text class="t-cap" x="150" y="206">{L("builders bid · the relay reveals the body only after the proposer commits to the header")}</text>
      </svg>
    )}

    {/* ── consensus: the validator lifecycle ── */}
    {name === "cl-life" && (
      <svg viewBox="0 0 480 186" role="img" aria-label="A validator's life: deposit, activation queue, active, exit queue, withdraw — or slashing">
        {[["deposit 32Ξ", 0], ["activation", 1], ["active", 2], ["exit queue", 3], ["withdraw", 4]].map(([label, i]) => (
          <g>
            <rect class={`vl-box ${i === 2 ? "vl-active" : ""}`} x={10 + Number(i) * 94} y="36" width="84" height="46" rx="6" />
            <text class="t-cap" x={52 + Number(i) * 94} y="66">{label}</text>
            {Number(i) < 4 && <path class="vl-a" d={`M${94 + Number(i) * 94} 50 H${104 + Number(i) * 94}`} />}
          </g>
        ))}
        <circle class="vl-token" cx="10" cy="50" r="6" />
        <g class="vl-slashgrp">
          <path class="vl-branch" d="M240 82 V120 H300" />
          <rect class="vl-slash" x="300" y="104" width="140" height="34" rx="6" /><text class="t-x" x="370" y="125">{L("slashed ✗ — ejected, stake cut")}</text>
        </g>
        <text class="t-cap" x="240" y="172">{L("32 ETH in → queues → years of attesting → exit → withdraw. Equivocate and you’re slashed.")}</text>
      </svg>
    )}

    {/* ── EIP-1559: the blind first-price auction it replaced ── */}
    {name === "fee-auction" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="A blind first-price gas auction: you overpay or get stuck">
        <text class="t-cap" x="200" y="22">{L("everyone names a price · the block takes the highest")}</text>
        <rect class="fa-block" x="142" y="30" width="160" height="78" rx="6" />
        {[["100 gwei (you)", "fa-you", 0], ["50 gwei", "fa-in", 1], ["45 gwei", "fa-in", 2], ["30 gwei", "fa-out", 3], ["12 gwei", "fa-out", 4], ["8 gwei", "fa-out", 5]].map(([label, cls, i]) => (
          <g class={`fa-tag ${cls}`}>
            <rect class="fa-rect" x="150" y={34 + Number(i) * 25} width="144" height="20" rx="4" />
            <text class="t-fld" x="160" y={48 + Number(i) * 25}>{label}</text>
          </g>
        ))}
        <text class="t-fld fa-blbl" x="316" y="62">{L("← top bids fill the block")}</text>
        <text class="t-fld fa-stall" x="316" y="140">{L("← these just stall")}</text>
        <text class="t-x" x="240" y="200">{L("you paid 100 gwei to beat 45 — overpaid; no posted price, no discovery")}</text>
      </svg>
    )}

    {/* ── EIP-1559: elastic blocks absorb a demand spike ── */}
    {name === "fee-elastic" && (
      <svg viewBox="0 0 480 178" role="img" aria-label="Elastic blocks absorb a spike while the base fee ramps">
        <rect class="el-block" x="40" y="30" width="120" height="118" rx="8" />
        <rect class="el-fill" x="42" y="32" width="116" height="114" rx="6" />
        <line class="el-target" x1="32" y1="89" x2="168" y2="89" />
        <text class="t-cap" x="206" y="40" text-anchor="start">{L("limit = 2× target")}</text>
        <text class="t-cap" x="206" y="92" text-anchor="start">{L("target (½ full)")}</text>
        <text class="t-fld el-fee" x="206" y="126" text-anchor="start">{L("base fee climbing ↑")}</text>
