        {[0, 1, 2].map((i) => (
          <g class="dc-copybox">
            <rect x="24" y={30 + i * 46} width="188" height="38" rx="6" />
            <text class="t-cap" x="60" y={53 + i * 46}>{`0x${i}${i}…`}</text>
            <text class="t-fld dc-dup" x="180" y={53 + i * 46} text-anchor="end">transfer()</text>
          </g>
        ))}
        <text class="t-x dc-waste" x="118" y="184" text-anchor="middle">{L("same bytecode, over and over")}</text>
        <path class="sarrow dc-a1" d="M220 96 H268" />
        <text class="t-cap" x="360" y="20">{L("share one implementation")}</text>
        {[0, 1, 2].map((i) => (
