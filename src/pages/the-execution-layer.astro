---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const explorables = (
  await getCollection("explorables", ({ data }) => !data.draft && data.spine)
).sort((a, b) => a.data.order - b.data.order);

const byTopic = explorables.reduce<Record<string, typeof explorables>>((acc, e) => {
  (acc[e.data.topic] ??= []).push(e);
  return acc;
}, {});
---

<BaseLayout
  title="The Execution Layer, explained"
  description="An evergreen, ordered path through how Ethereum's execution layer actually works — one explorable at a time."
>
  <div class="wrap">
    <header class="hub-head">
      <p class="mono-label">The evergreen spine</p>
      <h1>The Execution Layer, explained</h1>
      <p class="lede">
        A structured path through Ethereum's execution layer, written once and
        built to last. Each entry is a self-contained explorable: one mechanism,
        one live widget, layered from intuition to spec. Follow it in order, or
        drop into whatever you came to understand.
      </p>
    </header>

    {
      Object.entries(byTopic).map(([topic, items]) => (
        <section class="topic-group">
          <h2 class="topic-title">{topic}</h2>
          <ul>
            {items.map((e) => (
              <li>
                <a href={`/${e.id}`}>
                  <span class="meta">
                    <span class="t">{e.data.title}</span>
                    <span class="d">{e.data.dek}</span>
                  </span>
                  {e.data.readingMinutes && (
                    <span class="time">{e.data.readingMinutes}m</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section class="roadmap">
      <h2 class="topic-title">On the workbench</h2>
      <p class="rm-note">
        The path is being built deliberately, not dumped. Next mechanisms in the
        queue:
      </p>
      <ul class="rm-list">
        <li>The mempool & the EIP-1559 fee market</li>
        <li>The EVM: stack, memory, storage & a live opcode stepper</li>
        <li>Gas & metering: what every instruction costs</li>
        <li>Blocks, validation & the state transition</li>
        <li>Consensus: Proof of Stake, finality & fork choice</li>
        <li>Blobs (EIP-4844), statelessness & rollups</li>
        <li>Node sync: full, snap, light & checkpoint</li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: 50rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 0;
  }
  .hub-head h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.03em;
    margin: 0.6rem 0 0.8rem;
    font-weight: 700;
  }
  .lede {
    color: var(--color-ink-muted);
    font-size: 1.08rem;
    max-width: 58ch;
    line-height: 1.6;
  }
  .topic-group {
    margin-top: 2.5rem;
  }
  .topic-title {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  ul {
    list-style: none;
    margin: 0.8rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .topic-group a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .topic-group a:hover {
    border-color: var(--color-border-strong);
    background: var(--color-surface-2);
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .meta .t {
    color: var(--color-ink);
    font-weight: 600;
  }
  .meta .d {
    color: var(--color-ink-faint);
    font-size: 0.84rem;
  }
  .time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-faint);
  }
  .roadmap {
    margin-top: 2.5rem;
  }
  .rm-note {
    color: var(--color-ink-muted);
    margin: 0.8rem 0 0.6rem;
    font-size: 0.92rem;
  }
  .rm-list {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .rm-list li {
    color: var(--color-ink-faint);
    font-size: 0.9rem;
    padding-left: 1rem;
    position: relative;
  }
  .rm-list li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--color-border-strong);
  }
</style>
