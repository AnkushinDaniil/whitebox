        <text class="t-ok ev-cheap" x="89" y="156">{L("+3 gas · wiped")}</text>

        <rect class="ev-reg ev-rmem" x="170" y="48" width="146" height="120" rx="8" />
        <text class="t-cap" x="243" y="66">{L("memory")}</text>
