    {/* ── mpt: a real trie — edit a leaf, watch each node re-hash up to the root ── */}
    {name === "mpt" && (
      <svg viewBox="0 0 480 340" role="img" aria-label="Editing one account re-hashes every node up the trie path — leaf, branch, extension, root">
