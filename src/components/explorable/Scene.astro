---
import { sceneRu } from "./scene-i18n";
import type { Lang } from "@/i18n/utils";
/**
 * One animated figure per lesson step. Each `name` renders a self-contained,
 * continuously-looping SVG animation illustrating that idea — the visual half of
 * a 3b1b-style step-by-step lesson. All figures + keyframes live here so the
 * scoped styles stay consistent.
 */
interface Props {
  name:
    | "state"
    | "sign"
    | "verify"
    | "recover"
    | "replay"
    | "txfields"
    | "network"
    | "blocks"
    | "sybil"
    | "consensus"
    | "evm"
    | "gas"
    | "triepath"
    | "root"
    | "mpt"
    | "syncgenesis"
    | "synctrie"
    | "syncsnap"
    | "synclight"
    | "synccheckpoint"
    | "dbtrie"
    | "dbhalfpath"
    | "dbflat"
    | "dbcompact"
    | "dbdiff"
    | "dbmerge"
    | "dblayers"
    | "cl-slots"
    | "cl-randao"
    | "cl-attest"
    | "cl-epoch"
    | "cl-pbs"
    | "cl-life"
    | "fee-auction"
    | "fee-elastic"
    | "fee-burn"
    | "blob-calldata"
    | "blob-sidecar"
    | "blob-prune"
    | "blob-fee"
    | "aa-eoa"
    | "aa-userop"
    | "aa-bundler"
    | "aa-paymaster"
    | "se-migrate"
    | "se-delegate"
    | "se-run"
    | "se-powers"
    | "tx-onefmt"
    | "tx-typebyte"
    | "tx-disambig"
    | "tx-family"
    | "r155-replay"
    | "r155-bind"
    | "r155-vencode"
    | "r155-reject"
    | "wd-stuck"
    | "wd-push"
    | "wd-credit"
    | "wd-flavors"
    | "mg-pow"
    | "mg-parallel"
    | "mg-ttd"
    | "mg-loop"
    | "ts-persist"
    | "ts-scratch"
    | "ts-opcodes"
    | "ts-revert"
    | "br-blind"
    | "br-commit"
    | "br-stamp"
    | "br-prove"
    | "ga-flat"
    | "ga-raise"
    | "ga-coldwarm"
    | "ga-acl"
    | "mb-shard"
    | "mb-raise"
    | "mb-consolidate"
    | "mb-payoff"
    | "evm-why"
    | "evm-stack"
    | "evm-gas"
    | "evm-regions"
    | "st-fingerprint"
    | "st-nodes"
    | "st-header"
    | "dc-copy"
    | "dc-call"
    | "dc-delegate"
    | "dc-proxy"
    | "tw-underpriced"
    | "tw-reprice"
    | "tw-6364"
    | "rev-throw"
    | "rev-revert"
    | "rev-catch"
    | "cr-nonce"
    | "cr-create2"
    | "cr-counterfactual"
    | "ci-replay"
    | "ci-domain"
    | "ci-split"
    | "rf-gastoken"
    | "rf-reduce"
    | "rf-cap"
    | "ef-nomark"
    | "ef-reserve"
    | "ef-unlock"
    | "p0-hacks"
    | "p0-opcode"
    | "p0-savings"
    | "sd-danger"
    | "sd-restrict"
    | "sd-result"
    | "zk-cost"
    | "zk-precompile"
    | "zk-unlock"
    | "stc-danger"
    | "stc-static"
    | "stc-use"
    | "sc-heavy"
    | "sc-committee"
    | "sc-handoff"
    | "cd-cost"
    | "cd-reduce"
    | "cd-rollup"
    | "wr-clonly"
    | "wr-request"
    | "wr-trustless"
    | "pr-det"
    | "pr-randao"
    | "pr-caveat"
    | "bls-gap"
    | "bls-precompile"
    | "bls-use"
    | "dp-poll"
    | "dp-inblock"
    | "dp-fast"
    | "ss-naive"
    | "ss-net"
    | "ss-sentry"
    | "ic-gap"
    | "ic-meter"
    | "ic-result"
    | "bh-window"
    | "bh-ring"
    | "bh-payoff"
    | "mc-loop"
    | "mc-op"
    | "mc-result"
    | "ec-copy"
    | "ec-hash"
    | "ec-use"
    | "sh-emul"
    | "sh-ops"
    | "sh-result"
    | "fm-blind"
    | "fm-opcode"
    | "fm-use";
  caption?: string;
  /** widen the figure frame for dense diagrams */
  wide?: boolean;
  lang?: Lang;
}
const { name, caption, wide, lang = "en" } = Astro.props;
const L = (s: string): string => (lang === "ru" ? (sceneRu[s] ?? s) : s);
---

<figure class:list={["scene", wide && "scene-wide"]}>
  <div class="scene-stage" data-scene={name}>
    <svg class="wb-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        <marker id="wb-arrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0.5 0.5 L9.5 5 L0.5 9.5 Z" fill="var(--color-border-strong)" />
        </marker>
        <marker id="wb-arrow-accent" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7.5" markerHeight="7.5" orient="auto-start-reverse">
          <path d="M0.5 0.5 L9.5 5 L0.5 9.5 Z" fill="var(--color-accent)" />
        </marker>
        <linearGradient id="wb-node" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="color-mix(in oklab, var(--color-surface-3) 55%, var(--color-border-strong))" />
          <stop offset="0.5" stop-color="var(--color-surface-2)" />
          <stop offset="1" stop-color="var(--color-surface)" />
        </linearGradient>
        <linearGradient id="wb-accent-fill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="color-mix(in oklab, var(--color-accent) 26%, var(--color-surface))" />
          <stop offset="1" stop-color="var(--color-surface)" />
        </linearGradient>
        <radialGradient id="wb-glow" cx="0.5" cy="0.5" r="0.5">
          <stop offset="0" stop-color="color-mix(in oklab, var(--color-accent) 55%, transparent)" />
          <stop offset="1" stop-color="transparent" />
        </radialGradient>
        <filter id="wb-soft" x="-30%" y="-30%" width="160%" height="160%">
          <feDropShadow dx="0" dy="1.2" stdDeviation="1.6" flood-color="#000" flood-opacity="0.5" />
        </filter>
        <pattern id="wb-hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="7" stroke="var(--color-border-strong)" stroke-width="1" />
        </pattern>
      </defs>
    </svg>
    {/* ── the shared state: a spreadsheet an edit mutates ── */}
    {name === "state" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="A shared world-state spreadsheet being edited">
        <rect class="sheet" x="120" y="24" width="240" height="150" rx="10" />
        <text class="t-mid" x="240" y="48">{L("WORLD STATE")}</text>
        <line class="hair" x1="136" y1="58" x2="344" y2="58" />
        <g class="row"><text class="t-l" x="140" y="86">0xAlice</text><text class="t-r" x="330" y="86">14 Ξ</text></g>
        <g class="row hot"><rect class="rowhl" x="130" y="98" width="220" height="24" rx="5" /><text class="t-l" x="140" y="115">0xBob</text><text class="t-r bal" x="330" y="115">9 Ξ</text></g>
        <g class="row"><text class="t-l" x="140" y="144">0xCarol</text><text class="t-r" x="330" y="144">2 Ξ</text></g>
        <g class="edit">
          <rect class="pkt" x="20" y="100" width="74" height="22" rx="6" />
          <text class="t-s" x="57" y="115">+5 Ξ →</text>
        </g>
        <text class="t-cap" x="240" y="198">{L("edits move numbers in one shared sheet")}</text>
      </svg>
    )}

    {/* ── signatures: a seal stamps, verifies, then a tamper breaks it ── */}
    {name === "sign" && (
      <svg viewBox="0 0 480 190" role="img" aria-label="A message is signed into a signature, then verified as authentic">
        <rect class="sg-box" x="16" y="60" width="120" height="54" rx="8" />
        <text class="t-s" x="76" y="84">send 5 Ξ</text>
        <text class="t-s" x="76" y="102">to Bob</text>
        <text class="t-cap" x="76" y="132">{L("message (public)")}</text>

        <path class="sg-ar" d="M138 87 H204" marker-end="url(#wb-arrow)" />
        <text class="t-cap" x="171" y="78">{L("sign")}</text>
        <text class="t-cap sg-key" x="171" y="104">{L("with key")}</text>

        <circle class="sg-seal" cx="240" cy="87" r="30" />
        <text class="sg-sealm" x="240" y="95">✓</text>
        <text class="t-cap" x="240" y="132">{L("signature")}</text>

        <path class="sg-ar" d="M272 87 H332" marker-end="url(#wb-arrow)" />
        <text class="t-cap" x="302" y="78">{L("verify")}</text>

        <rect class="sg-vbox" x="332" y="63" width="130" height="48" rx="8" />
        <text class="sg-ok" x="397" y="85">{L("✓ authentic")}</text>
        <text class="t-cap" x="397" y="102">signer 0xYou</text>

        <text class="t-cap" x="240" y="172">{L("a signature proves the message came from the key holder")}</text>
      </svg>
    )}

    {/* ── verify: one signature accepts a true message, rejects a tampered one ── */}
    {name === "verify" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="Verification: a valid message passes, a tampered one fails">
        {/* positive lane */}
        <text class="vf-okt" x="16" y="24">{L("✓ untouched message")}</text>
        <rect class="vf-msg vf-ok" x="16" y="30" width="140" height="44" rx="7" />
        <text class="t-s" x="86" y="50">send 5 Ξ</text>
        <text class="t-s" x="86" y="66">to Bob</text>
        <path class="vf-ar" d="M156 52 H194" marker-end="url(#wb-arrow)" />
        <rect class="vf-sig" x="194" y="40" width="40" height="24" rx="4" />
        <text class="t-cap" x="214" y="56">sig</text>
        <path class="vf-ar" d="M234 52 H276" marker-end="url(#wb-arrow)" />
        <rect class="vf-box" x="276" y="36" width="58" height="32" rx="6" />
        <text class="t-cap" x="305" y="56">{L("verify")}</text>
        <path class="vf-ar" d="M334 52 H362" marker-end="url(#wb-arrow)" />
        <circle class="vf-okc" cx="378" cy="52" r="13" />
        <text class="vf-okm" x="378" y="57">✓</text>
        <text class="vf-okt" x="400" y="49" style="text-anchor:start">{L("VALID")}</text>
        <text class="t-cap" x="400" y="63" style="text-anchor:start">signer 0xYou</text>
        {/* negative lane */}
        <text class="vf-badt" x="16" y="118">{L("✗ one byte flipped")}</text>
        <rect class="vf-msg vf-bad" x="16" y="124" width="140" height="44" rx="7" />
        <text class="t-s" x="86" y="144">send 5 Ξ</text>
        <text class="t-s vf-word" x="86" y="160">to Eve</text>
        <path class="vf-ar" d="M156 146 H194" marker-end="url(#wb-arrow)" />
        <rect class="vf-sig" x="194" y="134" width="40" height="24" rx="4" />
        <text class="t-cap" x="214" y="150">sig</text>
        <path class="vf-ar" d="M234 146 H276" marker-end="url(#wb-arrow)" />
        <rect class="vf-box" x="276" y="130" width="58" height="32" rx="6" />
        <text class="t-cap" x="305" y="150">{L("verify")}</text>
        <path class="vf-ar" d="M334 146 H362" marker-end="url(#wb-arrow)" />
        <circle class="vf-badc" cx="378" cy="146" r="13" />
        <text class="vf-badm" x="378" y="151">✗</text>
        <text class="vf-badt" x="400" y="143" style="text-anchor:start">{L("INVALID")}</text>
        <text class="t-cap" x="400" y="157" style="text-anchor:start">signer ≠ you</text>
      </svg>
    )}

    {/* ── recovery: the signer's address materializes from the signature ── */}
    {name === "recover" && (
      <svg viewBox="0 0 480 190" role="img" aria-label="Recovering the signer address from a signature">
        <circle class="rc-seal" cx="86" cy="88" r="32" />
        <text class="rc-sealm" x="86" y="95">✦</text>
        <text class="t-cap" x="86" y="140">{L("signature only")}</text>
        <path class="rc-ar" d="M124 88 H250" marker-end="url(#wb-arrow-accent)" />
        <text class="t-cap" x="187" y="78">ecrecover</text>
        <text class="t-cap" x="187" y="104">{L("who signed?")}</text>
        <rect class="rc-box" x="258" y="64" width="192" height="48" rx="8" />
        <text class="rc-addr" x="354" y="93">0xBob…a3f1</text>
        <text class="t-cap" x="354" y="140">{L("the recovered signer")}</text>
        <text class="t-cap" x="240" y="174">{L("no “from” field needed; the signature reveals the sender")}</text>
      </svg>
    )}

    {/* ── replay: a signed tx is reusable; the nonce makes it single-use ── */}
    {name === "replay" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="Without a nonce a signed edit replays and drains the balance; with a nonce the copy is rejected">
        <text class="t-fld rp-h" x="24" y="24" text-anchor="start">{L("without a nonce")}</text>
        <rect class="msg" x="24" y="30" width="150" height="40" rx="8" />
        <text class="t-s" x="99" y="48">{L("send 5 Ξ → Bob")}</text>
        <text class="t-fld rp-noN" x="99" y="63">(no nonce)</text>
        <g class="rp-dup"><rect class="msg ghost" x="24" y="30" width="150" height="40" rx="8" /><text class="t-x" x="99" y="55">{L("✗ copy, again…")}</text></g>
        <path class="arrow rp-d1" d="M174 50 H344" />
        <rect class="node" x="344" y="30" width="112" height="40" rx="8" />
        <text class="rp-balbad" x="400" y="55">9 → 4 → -1 Ξ</text>
        <text class="t-x rp-leak" x="240" y="88" text-anchor="middle">{L("the same signed edit applies again and again — the balance leaks")}</text>

        <text class="t-fld rp-h" x="24" y="122" text-anchor="start">{L("with a nonce")}</text>
        <rect class="msg rp-card" x="24" y="128" width="150" height="44" rx="8" />
        <text class="t-s" x="99" y="148">{L("send 5 Ξ → Bob")}</text>
        <text class="t-cap rp-nonce" x="99" y="164">nonce 7 · 🔒</text>
        <path class="arrow rp-ok" d="M174 150 H344" />
        <rect class="node" x="344" y="128" width="112" height="44" rx="8" />
        <text class="t-ok rp-balgood" x="400" y="154">9 → 4 Ξ</text>
        <text class="t-x rp-reject" x="240" y="192" text-anchor="middle">{L("the copy is rejected — nonce 7 already spent, so each edit applies once")}</text>
      </svg>
    )}

    {/* ── txfields: every field justified by the attack it blocks ── */}
    {name === "txfields" && (
      <svg viewBox="0 0 480 320" role="img" aria-label="Every transaction field justified by the attack it blocks">
        <text class="txf-hd" x="22" y="20" style="text-anchor:start">{L("TRANSACTION")}</text>
        <text class="txf-hd" x="266" y="20" style="text-anchor:start">{L("what breaks without it")}</text>
        <rect class="txf-tx" x="12" y="26" width="172" height="288" rx="10" />
        {[
          ["chainId", "replay onto another chain"],
          ["nonce", "replay on this chain"],
          ["to", "no recipient (or new contract)"],
          ["value", "how much ether moves"],
          ["data", "which code + args to run"],
          ["gasLimit", "a loop drains your balance"],
          ["maxFeePerGas", "overpaying a volatile fee"],
          ["maxPriorityFee", "no tip, proposer skips you"],
          ["sig r,s,yParity", "anyone could forge the sender"],
        ].map(([f, why], i) => (
          <g>
            {i % 2 === 1 && <rect class="txf-bar" x="250" y={32 + i * 31} width="218" height="27" rx="4" />}
            <rect class="onf-chip" x="22" y={35 + i * 31} width="150" height="21" rx="10" />
            <text class="txf-field" x="32" y={50 + i * 31}>{f}</text>
            <path class="onf-ar" d={`M186 ${45 + i * 31} H262`} marker-end="url(#wb-arrow)" />
            <text class="txf-why" x="266" y={50 + i * 31}>{L(why)}</text>
          </g>
        ))}
      </svg>
    )}

    {/* ── decentralize: a single host censors; a replicated network survives ── */}
    {name === "network" && (
      <svg viewBox="0 0 480 232" role="img" aria-label="One server can silently drop your edit; a replicated network re-checks and keeps it">
        {/* one host can censor */}
        <rect class="nw-box" x="16" y="40" width="88" height="30" rx="6" />
        <text class="t-cap" x="60" y="59">{L("your edit")}</text>
        <path class="nw-ar" d="M104 55 H186" marker-end="url(#wb-arrow)" />
        <text class="t-x" x="150" y="34">{L("✗ dropped")}</text>
        <rect class="nw-server" x="190" y="38" width="100" height="42" rx="8" />
        <text class="t-cap" x="240" y="56">{L("one server")}</text>
        <text class="t-cap" x="240" y="71">{L("single copy")}</text>
        <text class="t-cap" x="240" y="104" text-anchor="middle">{L("a single host can silently drop or rewrite your edit")}</text>

        {/* replicated: every node re-checks */}
        <rect class="nw-box" x="16" y="151" width="80" height="30" rx="6" />
        <text class="t-cap" x="56" y="170">{L("your edit")}</text>
        <path class="nw-ar" d="M96 166 H140" marker-end="url(#wb-arrow)" />
        {[144, 226, 308, 390].map((x, i) => (
          <g>
            <rect class="nw-node" x={x} y="146" width="64" height="48" rx="7" />
            <rect class="bk-fchip" x={x + 8} y="153" width="48" height="9" rx="2" />
            <line class="nw-hair" x1={x + 8} y1={168} x2={x + 48} y2={168} />
            <line class="nw-hair" x1={x + 8} y1={175} x2={x + 40} y2={175} />
            <circle class="vf-okc" cx={x + 50} cy={183} r="8" />
            <text class="nw-tick" x={x + 50} y={187}>✓</text>
            {i < 3 && <line class="nw-peer" x1={x + 64} y1={170} x2={x + 82} y2={170} marker-end="url(#wb-arrow)" />}
          </g>
        ))}
        <text class="t-cap" x="240" y="216" text-anchor="middle">{L("every node re-checks it; no single host can silence it")}</text>
      </svg>
    )}

    {/* ── blocks: a full state trie; one balance edit recomputes the path up
         to a new stateRoot, into the header, then breaks every later block ── */}
    {name === "blocks" && (
      <svg viewBox="0 0 480 328" role="img" aria-label="One balance edit recomputes the trie path into a new stateRoot in the block header">
        {/* the block chain, top */}
        {[0, 1, 2].map((i) => {
          const x = 14 + i * 162;
          const sr = i === 1 ? "71c4" : "0db8";
          const h = i === 0 ? "3a07" : i === 1 ? "88b2" : "f0c5";
          return (
            <g>
              <rect class="bk-block" x={x} y="12" width="132" height="86" rx="8" />
              <text class="t-cap" x={x + 66} y="27">block #{i + 1}</text>
              <rect class="bk-fchip" x={x + 8} y="33" width="116" height="17" rx="3" />
              {i === 0 && <text class="bk-new" x={x + 14} y="45">stateRoot a2e0</text>}
              {i !== 0 && <text class="bk-fld" x={x + 14} y="45">stateRoot {sr}</text>}
              <rect class="bk-fchip" x={x + 8} y="53" width="116" height="17" rx="3" />
              <text class="bk-fld" x={x + 14} y="65">txsRoot c1{i}9</text>
              <text class="t-cap" x={x + 18} y="90">prev</text>
              <rect class="bk-hchip" x={x + 48} y="76" width="76" height="17" rx="3" />
              <text class="bk-fld" x={x + 55} y="89">hash {h}</text>
            </g>
          );
        })}
        <path class="bk-plink" d="M176 85 H150" marker-end="url(#wb-arrow)" />
        <path class="bk-plink" d="M338 85 H312" marker-end="url(#wb-arrow)" />
        <path class="bk-feed" d="M160 143 H6 V44 H12" marker-end="url(#wb-arrow-accent)" />
        <text class="bk-feedlbl" x="30" y="120">{L("new root")}</text>
        <text class="bk-feedlbl" x="30" y="132">{L("→ block.stateRoot")}</text>

        {/* root branch */}
        <rect class="bk-node bk-changed" x="160" y="128" width="104" height="30" rx="6" />
        <text class="bk-fld" x="172" y="141">{L("branch")}</text>
        <text class="bk-new" x="172" y="153">root 2d7a</text>

        {/* edges from root */}
        <path class="bk-edgeon" d="M196 158 L120 190" marker-end="url(#wb-arrow-accent)" />
        <path class="bk-edge" d="M228 158 L312 190" marker-end="url(#wb-arrow)" />
        <rect class="bk-nibchip" x="141" y="166" width="16" height="15" rx="3" /><text class="bk-nib" x="149" y="177">a</text>
        <rect class="bk-nibchip" x="272" y="166" width="16" height="15" rx="3" /><text class="bk-nib" x="280" y="177">f</text>

        {/* on-path branch (prefix a) and off-path branch (prefix f) */}
        <rect class="bk-node bk-changed" x="64" y="190" width="92" height="30" rx="6" />
        <text class="bk-fld" x="74" y="203">{L("branch")}</text>
        <text class="bk-new" x="74" y="215">a· 8a41</text>
        <rect class="bk-node" x="274" y="190" width="92" height="30" rx="6" />
        <text class="bk-fld" x="284" y="203">{L("branch")}</text>
        <text class="bk-h" x="284" y="215">f· 77c2</text>

        {/* edges to leaves */}
        <path class="bk-edgeon" d="M98 220 L78 261" marker-end="url(#wb-arrow-accent)" />
        <path class="bk-edge" d="M122 220 L162 262" marker-end="url(#wb-arrow)" />
        <path class="bk-edge" d="M312 220 L300 262" marker-end="url(#wb-arrow)" />
