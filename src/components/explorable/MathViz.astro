---
/**
 * MathViz — data-driven, mechanically faithful visualizations of the math
 * behind an EIP. Unlike Scene (decorative loops) or Formula (annotated
 * symbols), each figure here computes the *actual* values from the formula and
 * plots them: control-loop step responses, exponential price curves, diverging
 * cost functions, modular ring buffers. The numbers on screen are real.
 */
import { sceneRu } from "./scene-i18n";
import type { Lang } from "@/i18n/utils";

interface Props {
  name:
    | "fee-controller"
    | "gas-cold-warm"
    | "blob-exponential"
    | "ring-buffer";
  caption?: string;
  lang?: Lang;
}
const { name, caption, lang = "en" } = Astro.props;
const L = (s: string): string => (lang === "ru" ? (sceneRu[s] ?? s) : s);

// ── tiny plot helpers ───────────────────────────────────────────────
const scale = (v: number, d: [number, number], r: [number, number]) =>
  r[0] + ((v - d[0]) / (d[1] - d[0])) * (r[1] - r[0]);
const polyline = (pts: number[][]) =>
  pts.map((p, i) => `${i ? "L" : "M"}${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join(" ");

// ── fee-controller: EIP-1559 base fee step response ─────────────────
// base_{n+1} = base_n · (1 + (usage − 1)/8), usage = gasUsed / target.
function feeController() {
  const usage = [...Array(4).fill(1), ...Array(10).fill(2), ...Array(16).fill(0.25)];
  let b = 1;
  const fee = [1];
  for (const u of usage) {
    b *= 1 + (u - 1) / 8;
    fee.push(b);
  }
  const N = usage.length;
  const maxFee = Math.max(...fee) * 1.12;
  const PX0 = 52, PX1 = 458, FY0 = 44, FY1 = 150;
  const fx = (i: number) => scale(i, [0, N], [PX0, PX1]);
  const fy = (v: number) => scale(v, [0, maxFee], [FY1, FY0]);
  const feePts = fee.map((v, i) => [fx(i), fy(v)]);
  const UY0 = 182, UY1 = 214;
  const uy = (u: number) => scale(u, [0, 2], [UY1, UY0]);
  const bw = (PX1 - PX0) / N - 1.5;
  const bars = usage.map((u, i) => ({ x: fx(i) + 0.75, y: uy(u), h: UY1 - uy(u), over: u > 1, under: u < 1 }));
  // phase bands (flat / ramp / decay)
  const bands = [
    { x0: fx(0), x1: fx(4), cls: "mv-bflat" },
    { x0: fx(4), x1: fx(14), cls: "mv-bover" },
    { x0: fx(14), x1: fx(N), cls: "mv-bunder" },
  ];
  // y gridlines at 1,2,3
  const grid = [1, 2, 3].filter((g) => g <= maxFee).map((g) => ({ y: fy(g), label: `${g}×` }));
  return {
    feeD: polyline(feePts),
    areaD: `${polyline(feePts)} L${fx(N).toFixed(1)} ${FY1} L${fx(0).toFixed(1)} ${FY1} Z`,
    feePts, bars, bands, grid, fx, fy, uy, N, FY0, FY1, UY0, UY1, PX0, PX1,
    peak: feePts[14], end: feePts[N],
  };
}

// ── gas-cold-warm: EIP-2929 cumulative gas, real vs naive flat-high ──
function gasColdWarm() {
  const NA = 10;
  const COLD = 2100, WARM = 100, NAIVE = 2100;
  const real: number[] = [], naive: number[] = [];
  let r = 0, n = 0;
  for (let i = 1; i <= NA; i++) {
    r += i === 1 ? COLD : WARM;
    n += NAIVE;
    real.push(r);
    naive.push(n);
  }
  const maxY = naive[NA - 1] * 1.08;
  const PX0 = 54, PX1 = 452, PY0 = 40, PY1 = 162;
  const gx = (i: number) => scale(i, [1, NA], [PX0, PX1]);
  const gy = (v: number) => scale(v, [0, maxY], [PY1, PY0]);
  const realPts = real.map((v, i) => [gx(i + 1), gy(v)]);
  const naivePts = naive.map((v, i) => [gx(i + 1), gy(v)]);
  const gap = `${polyline(realPts)} L${gx(NA).toFixed(1)} ${gy(naive[NA - 1]).toFixed(1)} ${[...naivePts].reverse().map((p) => `L${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join(" ")} Z`;
  const grid = [5000, 10000, 15000, 20000].filter((g) => g <= maxY).map((g) => ({ y: gy(g), label: `${g / 1000}k` }));
  return {
    realD: polyline(realPts), naiveD: polyline(naivePts), gap,
    realPts, naivePts, grid, gx, gy, NA, PX0, PX1, PY0, PY1,
    realEnd: realPts[NA - 1], naiveEnd: naivePts[NA - 1],
  };
}

// ── blob-exponential: EIP-4844 blob_base_fee = MIN · e^(excess/UF) ──
function blobExponential() {
  const XMAX = 2.4; // excess / UPDATE_FRACTION
  const pts: number[][] = [];
  for (let k = 0; k <= 48; k++) {
    const x = (k / 48) * XMAX;
    pts.push([x, Math.exp(x)]);
  }
  const maxY = Math.exp(XMAX) * 1.04;
  const PX0 = 54, PX1 = 452, PY0 = 40, PY1 = 160;
  const bx = (x: number) => scale(x, [0, XMAX], [PX0, PX1]);
  const by = (v: number) => scale(v, [0, maxY], [PY1, PY0]);
  const curve = pts.map((p) => [bx(p[0]), by(p[1])]);
  const grid = [1, 3, 6, 9].filter((g) => g <= maxY).map((g) => ({ y: by(g), label: `${g}×` }));
  // x ticks in "blocks over target" — excess grows ~ when above target
  const xticks = [0, 0.6, 1.2, 1.8, 2.4].map((x) => ({ x: bx(x), label: x.toFixed(1) }));
  return {
    curveD: polyline(curve),
    areaD: `${polyline(curve)} L${bx(XMAX).toFixed(1)} ${PY1} L${bx(0).toFixed(1)} ${PY1} Z`,
    curve, grid, xticks, bx, by, PX0, PX1, PY0, PY1,
    targetPt: [bx(0), by(1)],
  };
}

// ── ring-buffer: EIP-4788 index = timestamp mod N ───────────────────
function ringBuffer() {
  const RN = 12, CX = 168, CY = 126, RR = 76;
  const slots = Array.from({ length: RN }, (_, i) => {
    const a = -Math.PI / 2 + (i / RN) * 2 * Math.PI;
    return { i, x: CX + Math.cos(a) * RR, y: CY + Math.sin(a) * RR, a: (a * 180) / Math.PI };
  });
  return { slots, RN, CX, CY, RR };
}

const fc = name === "fee-controller" ? feeController() : null;
const gw = name === "gas-cold-warm" ? gasColdWarm() : null;
const be = name === "blob-exponential" ? blobExponential() : null;
const rb = name === "ring-buffer" ? ringBuffer() : null;
---

<figure class="mathviz">
  <div class="mv-stage">
    {fc && (
      <svg viewBox="0 0 480 232" role="img" aria-label="EIP-1559 base fee step response over blocks">
        <text class="mv-title" x="240" y="18">{L("base fee responds to how full blocks are")}</text>
        {fc.bands.map((b) => (
          <rect class={`mv-band ${b.cls}`} x={b.x0} y={fc.FY0} width={b.x1 - b.x0} height={fc.FY1 - fc.FY0} />
        ))}
        {fc.grid.map((g) => (
          <g>
            <line class="mv-grid" x1={fc.PX0} y1={g.y} x2={fc.PX1} y2={g.y} />
            <text class="mv-tlabel" x={fc.PX0 - 6} y={g.y + 3} text-anchor="end">{g.label}</text>
          </g>
        ))}
        <line class="mv-axis" x1={fc.PX0} y1={fc.FY1} x2={fc.PX1} y2={fc.FY1} />
        <path class="mv-area" d={fc.areaD} />
        <path class="mv-line mv-draw" d={fc.feeD} pathLength="1" />
        <circle class="mv-dot" r="3.4" style={`offset-path:path('${fc.feeD}')`} />
        {/* usage track */}
        <line class="mv-target" x1={fc.PX0} y1={fc.uy(1)} x2={fc.PX1} y2={fc.uy(1)} />
        <text class="mv-tlabel mv-aok" x={fc.PX1 - 2} y={fc.uy(1) - 3} text-anchor="end">{L("target (½-full)")}</text>
        {fc.bars.map((b, i) => (
          <rect class={`mv-ubar ${b.over ? "mv-uover" : b.under ? "mv-uunder" : ""}`} style={`animation-delay:${(i * 0.12).toFixed(2)}s`} x={b.x} y={b.y} width={(fc.PX1 - fc.PX0) / fc.N - 1.5} height={Math.max(0.5, b.h)} />
        ))}
        <text class="mv-anno mv-aover" x={fc.peak[0]} y={fc.peak[1] - 8} text-anchor="middle">{L("full → +12.5%/block")}</text>
        <text class="mv-anno" x={fc.end[0]} y={fc.end[1] - 8} text-anchor="end">{L("demand drops → decays")}</text>
        <text class="mv-tlabel" x={240} y="228" text-anchor="middle">{L("blocks →  ·  gas used per block (bars), base fee ×start (line)")}</text>
      </svg>
    )}

    {gw && (
      <svg viewBox="0 0 480 210" role="img" aria-label="Cumulative gas for repeated access: cold/warm vs a naive flat-high price">
        <text class="mv-title" x="240" y="18">{L("cumulative gas for N reads of one slot")}</text>
        {gw.grid.map((g) => (
          <g>
            <line class="mv-grid" x1={gw.PX0} y1={g.y} x2={gw.PX1} y2={g.y} />
            <text class="mv-tlabel" x={gw.PX0 - 6} y={g.y + 3} text-anchor="end">{g.label}</text>
          </g>
        ))}
        <line class="mv-axis" x1={gw.PX0} y1={gw.PY1} x2={gw.PX1} y2={gw.PY1} />
        <path class="mv-gap" d={gw.gap} />
        <path class="mv-line2 mv-draw2" d={gw.naiveD} pathLength="1" />
        <path class="mv-line mv-draw" d={gw.realD} pathLength="1" />
        <text class="mv-anno mv-aover" x={gw.naiveEnd[0] - 4} y={gw.naiveEnd[1] + 2} text-anchor="end">{L("naive flat 2100 each")}</text>
        <text class="mv-anno mv-aok" x={gw.realEnd[0] - 4} y={gw.realEnd[1] - 6} text-anchor="end">{L("cold once, then warm 100")}</text>
        <text class="mv-tlabel" x={240} y="206" text-anchor="middle">{L("number of accesses to the same slot →")}</text>
      </svg>
    )}

    {be && (
      <svg viewBox="0 0 480 206" role="img" aria-label="Blob base fee grows exponentially with excess blob gas">
        <text class="mv-title" x="240" y="18">{L("blob base fee = MIN · e^(excess / UPDATE_FRACTION)")}</text>
        {be.grid.map((g) => (
          <g>
            <line class="mv-grid" x1={be.PX0} y1={g.y} x2={be.PX1} y2={g.y} />
            <text class="mv-tlabel" x={be.PX0 - 6} y={g.y + 3} text-anchor="end">{g.label}</text>
          </g>
        ))}
        <line class="mv-axis" x1={be.PX0} y1={be.PY1} x2={be.PX1} y2={be.PY1} />
        {be.xticks.map((t) => (
          <text class="mv-tlabel" x={t.x} y={be.PY1 + 13} text-anchor="middle">{t.label}</text>
        ))}
        <path class="mv-area" d={be.areaD} />
        <path class="mv-line mv-draw" d={be.curveD} pathLength="1" />
        <circle class="mv-dot" r="3.6" style={`offset-path:path('${be.curveD}')`} />
        <circle class="mv-mark" cx={be.targetPt[0]} cy={be.targetPt[1]} r="4" />
        <text class="mv-anno mv-aok" x={be.targetPt[0] + 6} y={be.targetPt[1] - 6} text-anchor="start">{L("at target (3 blobs): price holds")}</text>
        <text class="mv-anno mv-aover" x={be.PX1 - 4} y={be.PY0 + 14} text-anchor="end">{L("over target → exponential")}</text>
        <text class="mv-tlabel" x={240} y="202" text-anchor="middle">{L("excess blob gas (blocks above target) →")}</text>
      </svg>
    )}

    {rb && (
      <svg viewBox="0 0 480 240" role="img" aria-label="The beacon-roots ring buffer: index = timestamp mod 8191">
        <text class="mv-title" x="240" y="20">{L("index = timestamp mod 8191 — a wrapping ring")}</text>
        <circle class="mv-ringline" cx={rb.CX} cy={rb.CY} r={rb.RR} />
        {rb.slots.map((s, i) => (
          <g class="mv-slot" style={`animation-delay:${(i * 0.18).toFixed(2)}s`}>
            <circle class={`mv-cell ${i === rb.RN - 1 ? "mv-cnewest" : ""}`} cx={s.x} cy={s.y} r="13" />
            <text class="mv-cidx" x={s.x} y={s.y + 3.5} text-anchor="middle">{s.i}</text>
          </g>
        ))}
        <g class="mv-ptr" style={`transform-origin:${rb.CX}px ${rb.CY}px`}>
          <line class="mv-ptrline" x1={rb.CX} y1={rb.CY} x2={rb.CX} y2={rb.CY - rb.RR + 16} />
          <circle class="mv-ptrhub" cx={rb.CX} cy={rb.CY} r="4" />
        </g>
        <text class="mv-anno" x={rb.CX} y={rb.CY} text-anchor="middle" dy="0">{L("write")}</text>
        {/* legend */}
        <text class="mv-rlbl" x="300" y="92" text-anchor="start">{L("each block writes")}</text>
        <text class="mv-rlbl mv-aok" x="300" y="110" text-anchor="start">(timestamp → root)</text>
        <text class="mv-rlbl" x="300" y="136" text-anchor="start">{L("at slot timestamp mod N")}</text>
        <text class="mv-rlbl mv-aover" x="300" y="154" text-anchor="start">{L("oldest is overwritten")}</text>
        <text class="mv-rlbl" x="300" y="180" text-anchor="start">{L("~8191 slots ≈ 27 hours")}</text>
        <text class="mv-tlabel" x={240} y="232" text-anchor="middle">{L("bounded storage: new roots overwrite the oldest, forever")}</text>
      </svg>
    )}
  </div>
  {caption && <figcaption class="mv-cap">{caption}</figcaption>}
</figure>

<style>
  .mathviz {
    margin: 1.7rem auto;
    max-width: 600px;
    border: 1px solid var(--color-border);
    border-left: 2px solid var(--color-accent);
    border-radius: var(--radius-lg, var(--radius));
    background: radial-gradient(120% 130% at 50% 0%, var(--color-surface-2), var(--color-surface));
    overflow: hidden;
  }
  .mv-stage {
    padding: 0.4rem 0.6rem 0.2rem;
  }
  .mv-stage svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .mv-cap {
    margin: 0;
    padding: 0.35rem 0.95rem 0.8rem;
    font-size: 0.8rem;
    color: var(--color-ink-faint);
    line-height: 1.45;
  }
  .mv-title {
    fill: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 11px;
    text-anchor: middle;
    font-weight: 600;
  }
  .mv-tlabel {
    fill: var(--color-ink-faint);
    font-family: var(--font-mono);
    font-size: 8.5px;
  }
  .mv-axis {
    stroke: var(--color-border-strong);
    stroke-width: 1;
  }
  .mv-grid {
    stroke: var(--color-border);
    stroke-width: 1;
    stroke-dasharray: 2 3;
    opacity: 0.6;
  }
  .mv-line {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2.1;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .mv-line2 {
    fill: none;
    stroke: var(--color-changed);
    stroke-width: 1.6;
    stroke-dasharray: 4 3;
    opacity: 0.85;
  }
  .mv-area {
    fill: color-mix(in oklab, var(--color-accent) 10%, transparent);
    stroke: none;
  }
  .mv-gap {
    fill: color-mix(in oklab, var(--color-changed) 9%, transparent);
    stroke: none;
  }
  .mv-dot {
    fill: var(--color-accent-strong);
    filter: drop-shadow(0 0 5px color-mix(in oklab, var(--color-accent) 70%, transparent));
  }
  .mv-mark {
    fill: var(--color-node-leaf);
    stroke: var(--color-surface);
    stroke-width: 1.5;
  }
  .mv-target {
    stroke: var(--color-node-leaf);
    stroke-width: 1;
    stroke-dasharray: 3 3;
    opacity: 0.7;
  }
  .mv-band {
    opacity: 0.5;
  }
  .mv-bflat {
    fill: color-mix(in oklab, var(--color-border) 30%, transparent);
  }
  .mv-bover {
    fill: color-mix(in oklab, var(--color-changed) 7%, transparent);
  }
  .mv-bunder {
    fill: color-mix(in oklab, var(--color-node-leaf) 7%, transparent);
  }
  .mv-ubar {
    fill: var(--color-border-strong);
  }
  .mv-uover {
    fill: color-mix(in oklab, var(--color-changed) 60%, var(--color-surface));
  }
  .mv-uunder {
    fill: color-mix(in oklab, var(--color-node-leaf) 55%, var(--color-surface));
  }
  .mv-anno {
    fill: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 8.5px;
  }
  .mv-aover {
    fill: var(--color-changed);
  }
  .mv-aok {
    fill: var(--color-node-leaf);
  }
  /* ring buffer */
  .mv-ringline {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }
  .mv-cell {
    fill: var(--color-surface);
    stroke: var(--color-border-strong);
    stroke-width: 1.2;
  }
  .mv-cnewest {
    fill: color-mix(in oklab, var(--color-node-leaf) 12%, var(--color-surface));
    stroke: var(--color-node-leaf);
  }
  .mv-cidx {
    fill: var(--color-ink-faint);
    font-family: var(--font-mono);
    font-size: 9px;
  }
  .mv-ptrline {
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .mv-ptrhub {
    fill: var(--color-accent-strong);
  }
  .mv-rlbl {
    fill: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 9px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mv-draw {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: mv-draw 5.5s ease-in-out infinite;
    }
    .mv-draw2 {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: mv-draw 5.5s ease-in-out 0.3s infinite;
    }
    @keyframes mv-draw {
      0% { stroke-dashoffset: 1; }
      45%, 100% { stroke-dashoffset: 0; }
    }
    .mv-dot {
      offset-distance: 0%;
      animation: mv-travel 5.5s ease-in-out infinite;
    }
    @keyframes mv-travel {
      0% { offset-distance: 0%; opacity: 0; }
      6% { opacity: 1; }
      45% { offset-distance: 100%; opacity: 1; }
      55%, 100% { offset-distance: 100%; opacity: 0; }
    }
    .mv-ubar {
      transform-box: fill-box;
      transform-origin: bottom;
      animation: mv-grow 5.5s ease-out infinite;
    }
    @keyframes mv-grow {
      0%, 4% { transform: scaleY(0); }
      18%, 100% { transform: scaleY(1); }
    }
    .mv-mark {
      animation: mv-pulse 5.5s ease-in-out infinite;
    }
    @keyframes mv-pulse {
      0%, 100% { r: 4; opacity: 0.8; }
      50% { r: 5.4; opacity: 1; }
    }
    .mv-ptr {
      animation: mv-spin 9s steps(12) infinite;
    }
    @keyframes mv-spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    .mv-slot .mv-cell {
      animation: mv-write 9s steps(1) infinite;
    }
    @keyframes mv-write {
      0%, 92% { fill: var(--color-surface); stroke: var(--color-border-strong); }
      4%, 8% { fill: color-mix(in oklab, var(--color-accent) 16%, var(--color-surface)); stroke: var(--color-accent); }
    }
  }
</style>
