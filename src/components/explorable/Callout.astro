---
interface Props {
  type?: "note" | "insight" | "warning" | "aside";
  title?: string;
}
const { type = "note", title } = Astro.props;

const ICON: Record<string, string> = {
  note: "›",
  insight: "✦",
  warning: "!",
  aside: "↳",
};
---

<aside class:list={["callout", `c-${type}`]}>
  <span class="icon" aria-hidden="true">{ICON[type]}</span>
  <div class="content">
    {title && <p class="c-title">{title}</p>}
    <div class="c-body"><slot /></div>
  </div>
</aside>

<style>
  .callout {
    display: grid;
    grid-template-columns: 1.6rem 1fr;
    gap: 0.6rem;
    margin: 1.4rem 0;
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    font-size: 0.92rem;
  }
  .icon {
    font-family: var(--font-mono);
    width: 1.6rem;
    height: 1.6rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 0.85rem;
    color: var(--accent, var(--color-accent));
    background: color-mix(in oklab, var(--accent, var(--color-accent)) 14%, transparent);
  }
  .c-title {
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 0.2rem;
    font-size: 0.9rem;
  }
  .c-body :global(p) {
    margin: 0;
    color: var(--color-ink-muted);
  }
  .c-body :global(p + p) {
    margin-top: 0.5rem;
  }
  .c-insight {
    --accent: var(--color-accent);
    border-color: var(--color-accent-dim);
  }
  .c-warning {
    --accent: #ffcb6b;
  }
  .c-aside {
    --accent: var(--color-ink-faint);
  }
  .c-note {
    --accent: #82aaff;
  }
</style>
