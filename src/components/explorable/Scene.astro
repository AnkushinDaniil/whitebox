---
import { sceneRu } from "./scene-i18n";
import type { Lang } from "@/i18n/utils";
/**
 * One animated figure per lesson step. Each `name` renders a self-contained,
 * continuously-looping SVG animation illustrating that idea — the visual half of
 * a 3b1b-style step-by-step lesson. All figures + keyframes live here so the
 * scoped styles stay consistent.
 */
interface Props {
  name:
    | "state"
    | "sign"
    | "verify"
    | "recover"
    | "replay"
    | "txfields"
    | "network"
    | "blocks"
    | "sybil"
    | "consensus"
    | "evm"
    | "gas"
    | "triepath"
    | "root"
    | "syncgenesis"
    | "synctrie"
    | "syncsnap"
    | "synclight"
    | "synccheckpoint"
    | "dbtrie"
    | "dbhalfpath"
    | "dbflat"
    | "dbcompact"
    | "dbdiff"
    | "dbmerge"
    | "dblayers"
    | "cl-slots"
    | "cl-randao"
    | "cl-attest"
    | "cl-epoch"
    | "cl-pbs"
    | "cl-life"
    | "fee-auction"
    | "fee-elastic"
    | "fee-burn"
    | "blob-calldata"
    | "blob-sidecar"
    | "blob-prune"
    | "blob-fee"
    | "aa-eoa"
    | "aa-userop"
    | "aa-bundler"
    | "aa-paymaster"
    | "se-migrate"
    | "se-delegate"
    | "se-run"
    | "se-powers";
  caption?: string;
  /** widen the figure frame for dense diagrams */
  wide?: boolean;
  lang?: Lang;
}
const { name, caption, wide, lang = "en" } = Astro.props;
const L = (s: string): string => (lang === "ru" ? (sceneRu[s] ?? s) : s);
---

<figure class:list={["scene", wide && "scene-wide"]}>
  <div class="scene-stage" data-scene={name}>
    {/* ── the shared state: a spreadsheet an edit mutates ── */}
    {name === "state" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="A shared world-state spreadsheet being edited">
        <rect class="sheet" x="120" y="24" width="240" height="150" rx="10" />
        <text class="t-mid" x="240" y="48">{L("WORLD STATE")}</text>
        <line class="hair" x1="136" y1="58" x2="344" y2="58" />
        <g class="row"><text class="t-l" x="140" y="86">0xAlice</text><text class="t-r" x="330" y="86">14 Ξ</text></g>
        <g class="row hot"><rect class="rowhl" x="130" y="98" width="220" height="24" rx="5" /><text class="t-l" x="140" y="115">0xBob</text><text class="t-r bal" x="330" y="115">9 Ξ</text></g>
        <g class="row"><text class="t-l" x="140" y="144">0xCarol</text><text class="t-r" x="330" y="144">2 Ξ</text></g>
        <g class="edit">
          <rect class="pkt" x="20" y="100" width="74" height="22" rx="6" />
          <text class="t-s" x="57" y="115">+5 Ξ →</text>
        </g>
        <text class="t-cap" x="240" y="198">{L("edits move numbers in one shared sheet")}</text>
      </svg>
    )}

    {/* ── signatures: a seal stamps, verifies, then a tamper breaks it ── */}
    {name === "sign" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="Signing and verifying">
        <rect class="msg" x="40" y="74" width="150" height="60" rx="8" />
        <text class="t-s" x="115" y="100">{L("“send 5 Ξ")}</text>
        <text class="t-s" x="115" y="118">{L("to Bob”")}</text>
        <text class="t-cap" x="115" y="158">{L("message (public)")}</text>
        <g class="seal">
          <circle class="seal-c" cx="300" cy="104" r="30" />
          <text class="seal-m" x="300" y="110">✓</text>
        </g>
        <g class="crack"><text class="t-x" x="300" y="160">{L("✗ tampered")}</text></g>
        <path class="arrow" d="M196 104 L262 104" />
        <text class="t-cap" x="300" y="62">{L("signature")}</text>
        <text class="t-cap" x="430" y="110">{L("verify")}</text>
        <path class="arrow2" d="M332 104 L398 104" />
      </svg>
    )}

    {/* ── verify: one signature accepts a true message, rejects a tampered one ── */}
    {name === "verify" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="Verification: a valid message passes, a tampered one fails">
        {/* positive lane */}
        <text class="t-cap vlbl ok-t" x="92" y="24">{L("✓ untouched message")}</text>
        <rect class="vmsg ok" x="16" y="30" width="152" height="46" rx="7" />
        <text class="t-s" x="92" y="50">{L("send 5 Ξ")}</text>
        <text class="t-s" x="92" y="67">{L("to Bob")}</text>
        <rect class="vsig" x="188" y="42" width="40" height="22" rx="4" />
        <text class="t-cap" x="208" y="57">sig</text>
        <path class="varrow va-a" d="M228 53 H276" />
        <rect class="vbox" x="276" y="36" width="52" height="34" rx="6" />
        <text class="t-cap" x="302" y="57">{L("verify")}</text>
        <path class="varrow va-b" d="M328 53 H368" />
        <g class="vres v-ok">
          <circle class="vmark-c ok-c" cx="388" cy="53" r="15" />
          <text class="vmark ok-m" x="388" y="59">✓</text>
          <text class="t-ok" x="430" y="50">{L("VALID")}</text>
          <text class="t-cap" x="430" y="65">{L("signer 0xYou")}</text>
        </g>
        {/* negative lane */}
        <text class="t-cap vlbl bad-t" x="92" y="120">{L("✗ one byte flipped")}</text>
        <rect class="vmsg bad" x="16" y="126" width="152" height="46" rx="7" />
        <text class="t-s" x="92" y="146">{L("send 5 Ξ")}</text>
        <text class="t-s bad-word" x="92" y="163">{L("to Eve")}</text>
        <rect class="vsig" x="188" y="138" width="40" height="22" rx="4" />
        <text class="t-cap" x="208" y="153">sig</text>
        <path class="varrow va-c" d="M228 149 H276" />
        <rect class="vbox" x="276" y="132" width="52" height="34" rx="6" />
        <text class="t-cap" x="302" y="153">{L("verify")}</text>
        <path class="varrow va-d" d="M328 149 H368" />
        <g class="vres v-bad">
          <circle class="vmark-c bad-c" cx="388" cy="149" r="15" />
          <text class="vmark bad-m" x="388" y="155">✗</text>
          <text class="t-x" x="430" y="146">{L("INVALID")}</text>
          <text class="t-cap" x="430" y="161">{L("signer ≠ you")}</text>
        </g>
      </svg>
    )}

    {/* ── recovery: the signer's address materializes from the signature ── */}
    {name === "recover" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="Recovering the signer from a signature">
        <circle class="seal-c2" cx="110" cy="100" r="34" />
        <text class="seal-m2" x="110" y="106">✦</text>
        <text class="t-cap" x="110" y="156">{L("signature only")}</text>
        <path class="arrow3" d="M152 100 L250 100" />
        <text class="t-mid recover-q" x="201" y="88">{L("who signed?")}</text>
        <g class="addr-reveal">
          <rect class="addr-box" x="270" y="78" width="180" height="44" rx="8" />
          <text class="t-addr" x="360" y="106">0xBob…a3f1</text>
        </g>
        <text class="t-cap" x="360" y="146">{L("no “from” field needed")}</text>
      </svg>
    )}

    {/* ── replay: a signed tx is reusable; the nonce makes it single-use ── */}
    {name === "replay" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="The nonce defeats replay">
        <rect class="msg rp-card" x="22" y="76" width="158" height="58" rx="8" />
        <text class="t-s" x="101" y="100">{L("send 5 Ξ → Bob")}</text>
        <text class="t-cap rp-nonce" x="101" y="120">nonce 7 · 🔒</text>
        <rect class="node" x="356" y="76" width="100" height="58" rx="8" />
        <text class="t-cap" x="406" y="98">0xYou</text>
        <text class="t-r" x="446" y="122">9 Ξ</text>
        <path class="arrow rp-ok" d="M180 92 H356" />
        <text class="t-ok" x="268" y="84">{L("✓ applied once")}</text>
        <g class="rp-dup">
          <rect class="msg ghost" x="22" y="76" width="158" height="58" rx="8" />
          <text class="t-x" x="101" y="108">{L("✗ copy")}</text>
        </g>
        <text class="t-x rp-reject" x="300" y="160">{L("replay rejected — nonce 7 already spent")}</text>
      </svg>
    )}

    {/* ── txfields: every field justified by the attack it blocks ── */}
    {name === "txfields" && (
      <svg viewBox="0 0 480 318" role="img" aria-label="Anatomy of a transaction, every field justified">
        <text class="t-mid" x="120" y="22">{L("TRANSACTION")}</text>
        <text class="t-cap" x="350" y="22">{L("what breaks without it")}</text>
        {[
          ["chainId", "replay onto another chain"],
          ["nonce", "replay on this chain"],
          ["to", "no recipient (or: new contract)"],
          ["value", "how much ether moves"],
          ["data", "which code + args to run"],
          ["gasLimit", "a loop drains your balance"],
          ["maxFeePerGas", "overpaying a volatile fee"],
          ["maxPriorityFee", "no tip — proposer skips you"],
          ["sig r,s,yParity", "anyone could forge the sender"],
        ].map(([f, why], i) => (
          <g class={`txrow tr${i}`}>
            <rect class="txbar" x="16" y={34 + i * 29} width="448" height="25" rx="4" />
            <text class="t-field" x="28" y={51 + i * 29}>{f}</text>
            <text class="t-why" x="210" y={51 + i * 29}>{why}</text>
          </g>
        ))}
      </svg>
    )}

    {/* ── decentralize: one sheet copies out to many nodes ── */}
    {name === "network" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="Everyone keeps a copy">
        <g class="origin">
          <rect class="node" x="208" y="84" width="64" height="48" rx="8" />
          <line class="hair2" x1="216" y1="100" x2="264" y2="100" /><line class="hair2" x1="216" y1="110" x2="264" y2="110" /><line class="hair2" x1="216" y1="120" x2="256" y2="120" />
        </g>
        {[
          [60, 30], [380, 30], [40, 150], [400, 150],
        ].map(([x, y], i) => (
          <g class={`copy c${i}`}>
            <rect class="node" x={x} y={y} width="64" height="48" rx="8" />
            <line class="hair2" x1={x + 8} y1={y + 16} x2={x + 56} y2={y + 16} /><line class="hair2" x1={x + 8} y1={y + 26} x2={x + 56} y2={y + 26} /><line class="hair2" x1={x + 8} y1={y + 36} x2={x + 48} y2={y + 36} />
          </g>
        ))}
        <text class="t-cap" x="240" y="200">{L("no master copy — every node holds the whole state")}</text>
      </svg>
    )}

    {/* ── blocks: a full state trie; one balance edit recomputes the path up
         to a new stateRoot, into the header, then breaks every later block ── */}
    {name === "blocks" && (
      <svg viewBox="0 0 480 326" role="img" aria-label="A full state trie recomputing one path into the block chain">
        {/* the block chain, top */}
        {[0, 1, 2].map((i) => {
          const x = 14 + i * 162;
          const sr = i === 1 ? "71c4" : "0db8";
          const h = i === 0 ? "3a07" : i === 1 ? "88b2" : "f0c5";
          return (
            <g class="blk-g">
              <rect class="block" x={x} y="12" width="132" height="86" rx="8" />
              <text class="t-cap" x={x + 66} y="27">block #{i + 1}</text>
              <rect class="fchip" x={x + 8} y="33" width="116" height="17" rx="3" />
              {i === 0 && <text class="t-fld old oD" x={x + 14} y="45">stateRoot 9f12</text>}
              {i === 0 && <text class="t-fld new nD" x={x + 14} y="45">stateRoot a2e0</text>}
              {i !== 0 && <text class="t-fld" x={x + 14} y="45">stateRoot {sr}</text>}
              <rect class="fchip" x={x + 8} y="53" width="116" height="17" rx="3" />
              <text class="t-fld" x={x + 14} y="65">txsRoot c1{i}9</text>
              <text class="t-cap" x={x + 18} y="90">prev</text>
              <rect class={`hchip ${i === 0 ? "gE" : i === 1 ? "gF" : "gG"}`} x={x + 48} y="76" width="76" height="17" rx="3" />
              <text class="t-fld" x={x + 55} y="89">hash {h}</text>
            </g>
          );
        })}
        <path class="plink gF" d="M146 85 H176" /><path class="plink gG" d="M308 85 H338" />
        <path class="feed" d="M160 143 H6 V44 H22" />
        <text class="t-cap feed-lbl" x="350" y="128">root → block.stateRoot</text>

        {/* root branch */}
        <rect class="tnode branch" x="160" y="128" width="100" height="30" rx="6" />
        <text class="t-fld" x="172" y="141">{L("branch")}</text>
        <text class="t-h old oC" x="172" y="153">root 91f3</text>
        <text class="t-h new nC" x="172" y="153">root 2d7a</text>

        {/* edges from root */}
        <path class="edge edge-on" d="M198 158 L120 190" /><text class="t-nib" x="148" y="178">a</text>
        <path class="edge" d="M224 158 L312 190" /><text class="t-nib" x="276" y="178">f</text>

        {/* on-path branch (prefix a) and off-path branch (prefix f) */}
        <rect class="tnode branch" x="64" y="190" width="92" height="30" rx="6" />
        <text class="t-fld" x="74" y="203">{L("branch")}</text>
        <text class="t-h old oB" x="74" y="215">a· 3c08</text>
        <text class="t-h new nB" x="74" y="215">a· 8a41</text>
        <rect class="tnode branch" x="274" y="190" width="92" height="30" rx="6" />
        <text class="t-fld" x="284" y="203">{L("branch")}</text>
        <text class="t-h" x="284" y="215">f· 77c2</text>

        {/* edges to leaves */}
        <path class="edge edge-on" d="M100 220 L74 264" /><text class="t-nib" x="80" y="246">7</text>
        <path class="edge" d="M120 220 L162 264" /><text class="t-nib" x="150" y="246">9</text>
        <path class="edge" d="M312 220 L300 264" /><text class="t-nib" x="300" y="246">2</text>
        <path class="edge" d="M330 220 L388 264" /><text class="t-nib" x="366" y="246">5</text>

        {/* the four accounts — only Alice (a7) changes */}
        <rect class="tnode leaf changed-leaf" x="24" y="264" width="92" height="50" rx="6" />
        <text class="t-fld leaf-t" x="34" y="278">a7 · Alice</text>
        <text class="t-bal old oA" x="34" y="293">{L("bal 14 Ξ")}</text>
        <text class="t-bal new nA" x="34" y="293">{L("bal 9 Ξ")}</text>
        <text class="t-h old oA" x="34" y="307">h 3c1a</text>
        <text class="t-h new nA" x="34" y="307">h 8a47</text>
        {[
          [120, "a9 · Bob", "bal 6 Ξ", "h 55de"],
          [250, "f2 · Carol", "bal 20 Ξ", "h 9e10"],
          [346, "f5 · Dave", "bal 3 Ξ", "h b204"],
        ].map(([x, who, bal, h]) => (
          <g>
            <rect class="tnode leaf" x={x} y="264" width="92" height="50" rx="6" />
            <text class="t-fld leaf-t" x={Number(x) + 10} y="278">{who}</text>
            <text class="t-bal" x={Number(x) + 10} y="293">{bal}</text>
            <text class="t-h" x={Number(x) + 10} y="307">{h}</text>
          </g>
        ))}
      </svg>
    )}

    {/* ── sybil: free identities overwhelm a vote; cost makes them safe ── */}
    {name === "sybil" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="Sybil attack and costly identity">
        <circle class="attacker" cx="64" cy="98" r="22" />
        <text class="t-emoji" x="64" y="105">😈</text>
        <text class="t-cap" x="64" y="138">{L("one actor")}</text>
        {[[180, 44], [250, 40], [320, 60], [200, 110], [280, 120], [360, 110]].map(([x, y], i) => (
          <g class={`clone ${i === 2 ? "clone-keep" : "clone-doom"} sc${i}`}>
            <circle class="clone-c" cx={x} cy={y} r="13" />
            <text class="t-vote" x={x} y={y + 4}>+1</text>
          </g>
        ))}
        <text class="t-x sybil-free" x="300" y="166">{L("free identities → outvote everyone")}</text>
        <text class="t-ok sybil-cost" x="300" y="166">{L("each must stake real money → can’t afford an army")}</text>
      </svg>
    )}

    {/* ── consensus: votes pile on the heavier fork; finalized locks ── */}
    {name === "consensus" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="Consensus picks the heaviest chain">
        <rect class="blk" x="24" y="92" width="44" height="28" rx="5" /><rect class="blk" x="96" y="92" width="44" height="28" rx="5" />
        <path class="link" d="M68 106 H96" />
        {/* honest fork */}
        <rect class="blk win" x="190" y="58" width="44" height="28" rx="5" /><rect class="blk win" x="262" y="58" width="44" height="28" rx="5" />
        <path class="link" d="M140 100 L190 72" /><path class="link" d="M234 72 H262" />
        <text class="lock" x="318" y="76">🔒</text>
        {[0, 1, 2, 3, 4].map((i) => (<circle class={`vote v${i}`} cx={205 + i * 22} cy="40" r="4" />))}
        {/* attacker fork */}
        <rect class="blk lose" x="190" y="134" width="44" height="28" rx="5" />
        <path class="link dashed" d="M140 112 L190 148" />
        <text class="t-x" x="300" y="152">{L("✗ outvoted")}</text>
        <text class="t-cap" x="240" y="198">{L("most-backed history wins; finalized blocks lock")}</text>
      </svg>
    )}

    {/* ── the EVM: an instruction pointer steps; the stack moves ── */}
    {name === "evm" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="The EVM stepping through code">
        <g class="prog">
          {["PUSH 2", "PUSH 3", "ADD", "MUL"].map((op, i) => (
            <g><rect class="op" x="40" y={30 + i * 38} width="120" height="28" rx="5" /><text class="t-op" x="54" y={49 + i * 38}>{op}</text></g>
          ))}
          <rect class="pc" x="34" y="30" width="132" height="28" rx="6" />
        </g>
        <text class="t-cap" x="100" y="196">{L("code runs the same everywhere")}</text>
        <g class="stack">
          <text class="t-cap" x="330" y="30">{L("stack")}</text>
          <rect class="si s0" x="280" y="120" width="100" height="24" rx="4" /><text class="t-op si-t s0t" x="330" y="137">2</text>
          <rect class="si s1" x="280" y="92" width="100" height="24" rx="4" /><text class="t-op si-t s1t" x="330" y="109">3</text>
          <rect class="si s2" x="280" y="92" width="100" height="24" rx="4" /><text class="t-op si-t s2t" x="330" y="109">5</text>
        </g>
      </svg>
    )}

    {/* ── gas: a meter drains as instructions run, then halts ── */}
    {name === "gas" && (
      <svg viewBox="0 0 480 180" role="img" aria-label="Gas metering">
        <text class="t-cap" x="60" y="56">{L("gas")}</text>
        <rect class="gauge" x="60" y="64" width="360" height="22" rx="11" />
        <rect class="gauge-fill" x="62" y="66" width="356" height="18" rx="9" />
        <g class="ops">
          {["PUSH −3", "ADD −3", "SSTORE −20000", "out of gas ✋"].map((op, i) => (<text class={`t-op opx o${i}`} x="240" y="118">{op}</text>))}
        </g>
        <text class="t-cap" x="240" y="156">{L("every step costs — no program runs forever")}</text>
      </svg>
    )}

    {/* ── triepath: an address is a path of nibbles down typed nodes ── */}
    {name === "triepath" && (
      <svg viewBox="0 0 460 250" role="img" aria-label="Walking an address down the trie">
        <text class="t-cap" x="44" y="22">{L("address")}</text>
        {["a", "7", "3", "f", "c"].map((n, i) => (
          <g>
            <rect class={`nib nb${i}`} x={96 + i * 34} y="9" width="28" height="20" rx="4" />
            <text class={`t-nib nbt${i}`} x={110 + i * 34} y="24">{n}</text>
          </g>
        ))}
        <rect class="root-chip" x="300" y="8" width="146" height="22" rx="5" />
        <text class="t-root tp-root" x="373" y="23">stateRoot ⟳</text>
        {[
          ["branch", "follow slot a"],
          ["branch", "follow slot 7"],
          ["extension", "shared “3 f c”"],
          ["leaf", "value → 9 Ξ"],
        ].map(([kind, note], i) => (
          <g class={`tn tn${i}`}>
            <rect class={`tnode ${kind}`} x="90" y={52 + i * 46} width="280" height="34" rx="6" />
            <text class="t-field" x="106" y={73 + i * 46}>{kind}</text>
            <text class="t-cap tnote" x="356" y={73 + i * 46}>{note}</text>
          </g>
        ))}
        <path class="tarrow ta0" d="M230 86 V98" /><path class="tarrow ta1" d="M230 132 V144" /><path class="tarrow ta2" d="M230 178 V190" />
        <text class="t-cap tp-rehash" x="230" y="244">{L("edit the leaf → re-hash up the path → new root")}</text>
      </svg>
    )}

    {/* ── state root: the whole sheet folds into one hash in a header ── */}
    {name === "root" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="All state folds into one root">
        {[40, 78, 116].map((y, i) => (<rect class={`cell cl${i}`} x="24" y={y} width="70" height="24" rx="4" />))}
        <path class="conv c0" d="M94 52 C150 52 150 96 196 96" /><path class="conv c1" d="M94 90 H196" /><path class="conv c2" d="M94 128 C150 128 150 100 196 100" />
        <rect class="trie" x="196" y="80" width="56" height="34" rx="6" /><text class="t-cap" x="224" y="101">trie</text>
        <path class="conv c3" d="M252 97 H300" />
        <rect class="hdr" x="300" y="56" width="156" height="84" rx="8" />
        <text class="t-cap" x="378" y="76">{L("BLOCK HEADER")}</text>
        <rect class="root-badge" x="312" y="88" width="132" height="28" rx="5" />
        <text class="t-root" x="378" y="106">stateRoot 0x…</text>
        <text class="t-cap" x="240" y="194">{L("32 bytes that fingerprint the entire world")}</text>
      </svg>
    )}

    {/* ── full sync: replay every block from genesis, rebuilding state ── */}
    {name === "syncgenesis" && (
      <svg viewBox="0 0 480 196" role="img" aria-label="Full sync replays every block from genesis">
        <text class="t-cap" x="40" y="26">{L("genesis")}</text>
        <text class="t-cap" x="442" y="26">{L("head")}</text>
        {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => (
          <rect class="block" x={24 + i * 56} y="34" width="44" height="30" rx="5" />
        ))}
        <rect class="sg-marker" x="24" y="32" width="44" height="34" rx="6" />
        <text class="t-cap" x="240" y="90">{L("re-execute every transaction, block by block")}</text>
        <rect class="sg-track" x="24" y="106" width="432" height="20" rx="6" />
        <rect class="sg-fill" x="26" y="108" width="428" height="16" rx="5" />
        <text class="t-fld sg-state" x="240" y="121">{L("rebuilding state…")}</text>
        <text class="t-x" x="240" y="162">{L("⏱ days — but every state transition personally verified")}</text>
      </svg>
    )}

    {/* ── fast sync: download the state trie node by node, verify by hash ── */}
    {name === "synctrie" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="Fast sync downloads the state trie node by node">
        <path class="sedge" d="M240 46 L150 78" /><path class="sedge" d="M240 46 L240 78" /><path class="sedge" d="M240 46 L330 78" />
        <path class="sedge" d="M150 104 L96 136" /><path class="sedge" d="M150 104 L150 136" /><path class="sedge" d="M330 104 L330 136" /><path class="sedge" d="M330 104 L384 136" />
        <g class="st-n s0"><rect class="tnode branch" x="208" y="22" width="64" height="24" rx="5" /><text class="t-cap" x="240" y="38">{L("root")}</text><text class="st-ok" x="278" y="30">✓</text></g>
        <g class="st-n s1"><rect class="tnode branch" x="118" y="80" width="64" height="24" rx="5" /><text class="t-cap" x="150" y="96">{L("node")}</text><text class="st-ok" x="188" y="88">✓</text></g>
        <g class="st-n s2"><rect class="tnode branch" x="208" y="80" width="64" height="24" rx="5" /><text class="t-cap" x="240" y="96">{L("node")}</text><text class="st-ok" x="278" y="88">✓</text></g>
        <g class="st-n s3"><rect class="tnode branch" x="298" y="80" width="64" height="24" rx="5" /><text class="t-cap" x="330" y="96">{L("node")}</text><text class="st-ok" x="368" y="88">✓</text></g>
        {[[64, "s4"], [118, "s5"], [298, "s6"], [352, "s7"]].map(([x, c]) => (
          <g class={`st-n ${c}`}><rect class="tnode leaf" x={x} y="138" width="48" height="22" rx="5" /><text class="t-cap" x={Number(x) + 24} y="153">{L("leaf")}</text></g>
        ))}
        <text class="t-cap" x="240" y="188">{L("verify each node against its parent’s hash — but millions of tiny requests, and the pivot keeps moving")}</text>
      </svg>
    )}

    {/* ── snap sync: download flat key ranges with proofs, rebuild, heal ── */}
    {name === "syncsnap" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="Snap sync downloads flat ranges then heals the trie">
        <text class="t-cap" x="104" y="26">{L("flat state, in big ranges")}</text>
        {[0, 1, 2, 3].map((i) => (
          <g class={`sn-range r${i}`}>
            <rect class="sn-bar" x="20" y={36 + i * 30} width="176" height="22" rx="5" />
            <text class="t-fld" x="30" y={51 + i * 30}>0x{i}0…{i}f</text>
            <text class="st-ok" x="180" y={51 + i * 30}>✓</text>
          </g>
        ))}
        <path class="sarrow sn-arrow" d="M200 96 H250" />
        <text class="t-cap" x="350" y="26">{L("rebuilt locally")}</text>
        <rect class="tnode branch sn-t0" x="300" y="40" width="100" height="22" rx="5" /><text class="t-cap" x="350" y="55">{L("root")}</text>
        <rect class="tnode leaf sn-t1" x="288" y="74" width="56" height="20" rx="4" /><rect class="tnode leaf sn-t2" x="356" y="74" width="56" height="20" rx="4" />
        <g class="sn-heal"><rect class="tnode leaf sn-heal-n" x="356" y="74" width="56" height="20" rx="4" /><text class="st-ok" x="384" y="112">{L("heal ✓")}</text></g>
        <text class="t-cap" x="240" y="182">{L("a handful of big sequential ranges, not a million nodes — hours, not days")}</text>
      </svg>
    )}

    {/* ── light client: only headers; fetch state on demand with a proof ── */}
    {name === "synclight" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="A light client keeps only headers and verifies proofs on demand">
        {[0, 1, 2, 3, 4, 5].map((i) => (
          <g><rect class="lhdr" x={20 + i * 74} y="26" width="62" height="26" rx="5" /><text class="t-cap" x={51 + i * 74} y="43">root #{i}</text></g>
        ))}
        <path class="sarrow" d="M51 52 V70" /><text class="t-fld lq" x="120" y="92">{L("balance 0xA?")}</text>
        <path class="sarrow lp" d="M60 78 L60 110 L160 110" />
        <g class="lproof">
          <rect class="tnode branch" x="160" y="98" width="50" height="22" rx="4" /><rect class="tnode branch" x="230" y="98" width="50" height="22" rx="4" /><rect class="tnode leaf" x="300" y="98" width="56" height="22" rx="4" />
          <path class="sedge on" d="M210 109 H230" /><path class="sedge on" d="M280 109 H300" />
          <text class="t-ok" x="392" y="114">✓ 12 Ξ</text>
        </g>
        <text class="t-cap" x="240" y="172">{L("stores only headers — asks a full node for state, gets a Merkle proof, verifies it itself")}</text>
      </svg>
    )}

    {/* ── checkpoint sync: trust a recent finalized anchor, skip genesis ── */}
    {name === "synccheckpoint" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="Checkpoint sync starts from a recent trusted finalized block">
        <g class="ck-old">
          <rect class="block" x="20" y="34" width="40" height="26" rx="5" /><text class="t-cap" x="40" y="50">gen</text>
          <path class="ck-crawl" d="M62 47 H430" />
          <text class="t-cap" x="430" y="50">{L("head")}</text>
          <text class="t-x" x="240" y="78">{L("replay/verify all of history from genesis — weeks")}</text>
        </g>
        <text class="t-cap ck-instead" x="60" y="116">{L("instead:")}</text>
        <rect class="ck-anchor" x="280" y="124" width="96" height="30" rx="6" /><text class="t-cap" x="328" y="138">{L("checkpoint")}</text><text class="ck-lock" x="328" y="150">{L("🔒 finalized")}</text>
        <path class="sarrow ck-hop" d="M376 139 H424" />
        <rect class="block" x="424" y="126" width="34" height="26" rx="5" /><text class="t-cap" x="441" y="142">{L("head")}</text>
        <text class="t-ok" x="180" y="186">{L("trusted recent anchor → snap forward → minutes")}</text>
      </svg>
    )}

    {/* ── flat-db: reading a value by walking the trie = many scattered disk reads ── */}
    {name === "dbtrie" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="Reading one account walks the trie as several scattered disk reads">
        <rect class="db-q" x="14" y="12" width="168" height="26" rx="5" /><text class="t-fld" x="24" y="29">{L("read 0xA7… balance")}</text>
        <path class="da da1" d="M70 70 L300 60" /><path class="da da2" d="M334 72 L150 104" /><path class="da da3" d="M118 116 L350 116" /><path class="da da4" d="M350 128 L246 150" />
        <g class="dr dr0"><rect class="db-node" x="36" y="56" width="68" height="24" rx="5" /><text class="t-cap" x="70" y="72">{L("root")}</text></g>
        <g class="dr dr1"><rect class="db-node" x="300" y="48" width="68" height="24" rx="5" /><text class="t-cap" x="334" y="64">{L("node")}</text></g>
        <g class="dr dr2"><rect class="db-node" x="84" y="104" width="68" height="24" rx="5" /><text class="t-cap" x="118" y="120">{L("node")}</text></g>
        <g class="dr dr3"><rect class="db-node" x="316" y="104" width="68" height="24" rx="5" /><text class="t-cap" x="350" y="120">{L("node")}</text></g>
        <g class="dr dr4"><rect class="db-node db-val" x="212" y="150" width="68" height="24" rx="5" /><text class="t-cap" x="246" y="166">{L("value")}</text></g>
        <text class="t-x" x="240" y="200">{L("one account = 4–6 random disk reads, walking the trie node by node")}</text>
      </svg>
    )}

    {/* ── halfpath: keying nodes by trie path clusters them on disk (locality) ── */}
    {name === "dbhalfpath" && (
      <svg viewBox="0 0 480 232" role="img" aria-label="HalfPath keys nodes by trie path so neighbouring nodes sit together on disk">
        <text class="t-fld hp-bad" x="28" y="26">{L("hash-keyed — random disk slots")}</text>
        {Array.from({ length: 16 }).map((_, i) => (
          <rect class={`hp-cell ${[1, 4, 6, 10, 14].includes(i) ? "hp-node" : ""}`} x={28 + i * 26} y="38" width="24" height="22" rx="3" />
        ))}
        <rect class="hp-head hp-head-a" x="0" y="34" width="6" height="30" rx="2" />
        <text class="t-x" x="240" y="94">{L("six hops, each to a random slot — a cache miss every time")}</text>
        <text class="t-fld hp-ok" x="28" y="142">{L("path-keyed — neighbours sit together")}</text>
        {Array.from({ length: 16 }).map((_, i) => (
          <rect class={`hp-cell ${[6, 7, 8, 9, 10].includes(i) ? "hp-node-ok" : ""}`} x={28 + i * 26} y="154" width="24" height="22" rx="3" />
        ))}
        <rect class="hp-head hp-head-b" x="0" y="150" width="6" height="30" rx="2" />
        <text class="t-ok" x="240" y="210">{L("one sweep over neighbouring slots — ~50% faster, ~25% smaller")}</text>
      </svg>
    )}

    {/* ── flat-db: read the value directly from a flat column, trie kept only for the root ── */}
    {name === "dbflat" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="Flat DB reads the value in one direct lookup; the trie is kept only to recompute the root">
        <rect class="db-q" x="14" y="22" width="150" height="26" rx="5" /><text class="t-fld" x="24" y="39">{L("read 0xA7… balance")}</text>
        <text class="df-six" x="24" y="62">{L("✗ 6 disk hops")}</text><text class="df-one" x="24" y="62">{L("✓ 1 lookup")}</text>
        <path class="sarrow df-arrow" d="M164 35 H214" />
        <text class="t-cap" x="280" y="20">{L("flat account column")}</text>
        {[0, 1, 2, 3].map((i) => (
          <g class={`df-row ${i === 1 ? "df-hit" : ""}`}>
            <rect class="db-flatrow" x="220" y={28 + i * 26} width="170" height="22" rx="4" />
            <text class="t-fld" x="230" y={43 + i * 26}>0x{i === 1 ? "A7" : i + "" + i}… → {i === 1 ? "12 Ξ" : "…"}</text>
          </g>
        ))}
        <text class="t-ok df-ok" x="430" y="59">{L("✓ 1 read")}</text>
        <g class="df-trie">
          <rect class="tnode branch" x="196" y="150" width="88" height="22" rx="5" /><text class="t-cap" x="240" y="165">{L("trie root")}</text>
          <text class="t-cap" x="240" y="190">{L("kept aside — only to recompute the stateRoot at commit")}</text>
        </g>
      </svg>
    )}

    {/* ── flat-db: compaction merges layers in powers of two (8→4→2→1) ── */}
    {name === "dbcompact" && (
      <svg viewBox="0 0 480 214" role="img" aria-label="Compaction merges snapshot layers in powers of two, halving the count each round">
        <g class="cl cl3"><rect class="cbox c8" x="48" y="18" width="384" height="26" rx="5" /><text class="t-fld c-on" x="240" y="35">1 layer — blocks 1–8</text></g>
        <g class="cl cl2">{[0, 1].map((i) => (<g><rect class="cbox c4" x={48 + i * 196} y="64" width="188" height="24" rx="5" /><text class="t-fld c-on" x={142 + i * 196} y="80">blocks {i * 4 + 1}–{i * 4 + 4}</text></g>))}</g>
        <g class="cl cl1">{[0, 1, 2, 3].map((i) => (<g><rect class="cbox c2" x={48 + i * 98} y="110" width="90" height="22" rx="4" /><text class="t-fld c-on" x={93 + i * 98} y="125">{i * 2 + 1}–{i * 2 + 2}</text></g>))}</g>
        <g class="cl cl0">{[0, 1, 2, 3, 4, 5, 6, 7].map((i) => (<g><rect class="cbox c1" x={48 + i * 48} y="156" width="40" height="22" rx="4" /><text class="t-fld c-on" x={68 + i * 48} y="171">b{i + 1}</text></g>))}</g>
        <text class="t-cap c-count cc0" x="240" y="196">{L("8 single-block layers pile up…")}</text>
        <text class="t-cap c-count cc1" x="240" y="196">{L("merge in pairs → 4 layers")}</text>
        <text class="t-cap c-count cc2" x="240" y="196">{L("merge again → 2 layers")}</text>
        <text class="t-cap c-count cc3" x="240" y="196">{L("…→ 1 layer. each round halves them, so 128 blocks need only ~7")}</text>
      </svg>
    )}

    {/* ── flat-db: a layer is a diff of changed keys; a read takes the newest match ── */}
    {name === "dbdiff" && (
      <svg viewBox="0 0 480 224" role="img" aria-label="A layer is a diff of changed keys; a read takes the newest match, else the base">
        <rect class="db-q" x="14" y="18" width="118" height="24" rx="5" /><text class="t-fld" x="24" y="34">{L("read key B")}</text>
        <circle class="dd-token" cx="158" cy="30" r="9" /><text class="dd-qt" x="158" y="34">B</text>
        <rect class="dd-card" x="186" y="34" width="196" height="34" rx="5" />
        <text class="t-fld dd-tag" x="196" y="55">{L("block N · diff")}</text><text class="t-fld" x="300" y="55">A=9  C=2</text>
        <rect class="dd-card dd-hit" x="186" y="78" width="196" height="34" rx="5" />
        <text class="t-fld dd-tag" x="196" y="99">{L("block N−1 · diff")}</text><text class="t-fld dd-found" x="300" y="99">B=5  ✓</text>
        <rect class="dd-card" x="186" y="122" width="196" height="34" rx="5" />
        <text class="t-fld dd-tag" x="196" y="143">{L("block N−2 · diff")}</text><text class="t-fld dd-shadow" x="300" y="143">A=7</text><text class="t-fld" x="338" y="143">D=1</text>
        <text class="dd-shadnote" x="392" y="143">{L("↑ shadowed")}</text>
        <rect class="dd-base" x="186" y="166" width="196" height="28" rx="5" />
        <text class="t-cap" x="284" y="184">{L("base flat DB · the full state")}</text>
        <text class="t-cap" x="240" y="214">{L("a layer holds only the keys its block changed; reads take the first (newest) match, else fall to the base")}</text>
      </svg>
    )}

    {/* ── flat-db: merging two diffs keeps the newest value per key (dedup) ── */}
    {name === "dbmerge" && (
      <svg viewBox="0 0 480 196" role="img" aria-label="Merging two diff layers keeps the newest value of each key, so duplicates collapse">
        <rect class="dd-card" x="18" y="26" width="150" height="44" rx="5" />
        <text class="t-fld dd-tag" x="30" y="44">{L("block 5 · diff")}</text><text class="t-fld" x="30" y="62">A=7   B=5</text>
        <rect class="dd-card" x="18" y="98" width="150" height="44" rx="5" />
        <text class="t-fld dd-tag" x="30" y="116">{L("block 6 · diff")}</text><text class="t-fld" x="30" y="134">A=9   C=2</text>
        <path class="sarrow dm-arrow" d="M168 84 H236" />
        <rect class="dd-card dm-merged" x="240" y="52" width="200" height="78" rx="6" />
        <text class="t-fld dd-tag dm-keep" x="252" y="72">{L("compacted 5–6 · diff")}</text>
        <text class="t-fld dm-keep" x="252" y="94">A=9   B=5   C=2</text>
        <text class="t-x dm-drop" x="252" y="116">{L("A=7 dropped — block 5’s value is gone")}</text>
        <text class="t-cap" x="240" y="178">{L("keep the newest value of each key — duplicates collapse (smaller); intra-range reads are lost")}</text>
      </svg>
    )}

    {/* ── flat-db: a read falls through layered snapshots to find a past value ── */}
    {name === "dblayers" && (
      <svg viewBox="0 0 480 224" role="img" aria-label="Layered snapshots let a flat read see recent and past blocks">
        <circle class="dl-token" cx="60" cy="24" r="9" /><text class="dl-qt" x="60" y="28">?</text>
        <text class="t-cap" x="150" y="20">{L("read 0xA7… as of block N−2")}</text>
        {[
          ["block N — 1-block snapshot", "t1"],
          ["block N−1", "t1"],
          ["block N−2", "t1 hit"],
          ["compacted N−4 … N−1", "t2"],
          ["compacted N−32 … N", "t2"],
          ["base flat DB", "base"],
        ].map(([label, kind], i) => (
          <g class={`dl-layer dll${i} ${kind.includes("hit") ? "dl-found" : ""}`}>
            <rect class={`db-layer ${kind.split(" ")[0]}`} x="120" y={36 + i * 28} width="300" height="22" rx="4" />
            <text class="t-fld" x="132" y={51 + i * 28}>{label}</text>
            {kind.includes("hit") && <text class="st-ok" x="404" y={51 + i * 28}>✓</text>}
          </g>
        ))}
        <text class="t-cap" x="240" y="214">{L("a read falls through ~7 layers — enough for the 128-block reorg depth snap sync needs")}</text>
      </svg>
    )}

    {/* ── consensus: time is sliced into 12s slots, one proposer each ── */}
    {name === "cl-slots" && (
      <svg viewBox="0 0 480 166" role="img" aria-label="Time is divided into 12-second slots, each with one chosen proposer">
        <text class="t-cap" x="44" y="22">{L("time →")}</text>
        {["7k", "41k", "220k", "98k", "3k", "160k", "55k", "12k"].map((id, i) => (
          <g>
            <rect class="sl-cell" x={16 + i * 57} y="40" width="50" height="56" rx="5" />
            <circle class="sl-prop" cx={41 + i * 57} cy="62" r="7" />
            <text class="t-cap" x={41 + i * 57} y="86">#{id}</text>
          </g>
        ))}
        <rect class="sl-now" x="14" y="38" width="54" height="60" rx="6" />
        <text class="t-cap" x="240" y="124">{L("one 12-second slot · one chosen proposer · one block")}</text>
      </svg>
    )}

    {/* ── consensus: RANDAO picks each slot's proposer from the validator set ── */}
    {name === "cl-randao" && (
      <svg viewBox="0 0 480 196" role="img" aria-label="A shared random seed picks the proposer for each slot">
        <rect class="rd-seed" x="20" y="58" width="124" height="60" rx="8" />
        <text class="t-cap" x="82" y="80">{L("RANDAO seed")}</text>
        <text class="t-fld rd-v rdv0" x="82" y="100">0x9f3a…</text><text class="t-fld rd-v rdv1" x="82" y="100">0x2c71…</text><text class="t-fld rd-v rdv2" x="82" y="100">0xb480…</text>
        {[0, 1, 2, 3, 4, 5].map((c) => [0, 1, 2, 3].map((r) => (
          <circle class={`rd-dot ${c === 2 && r === 1 ? "rd-chosen" : ""}`} cx={210 + c * 42} cy={46 + r * 36} r="6" />
        )))}
        <path class="rd-pick" d="M144 88 L290 82" />
        <text class="t-cap rd-lbl" x="300" y="64">{L("→ proposer")}</text>
        <path class="rd-mix" d="M252 46 Q180 20 110 56" /><text class="t-cap rd-mixl" x="200" y="18">{L("each proposer stirs it back in")}</text>
        <text class="t-cap" x="240" y="186">{L("a shared random seed picks each slot’s proposer — unpredictable and ungameable")}</text>
      </svg>
    )}

    {/* ── consensus: a committee attests; votes are weight fork choice follows ── */}
    {name === "cl-attest" && (
      <svg viewBox="0 0 480 196" role="img" aria-label="Each slot a committee attests, voting on the head and a checkpoint">
        <text class="t-cap" x="86" y="24">{L("this slot’s committee")}</text>
        {[0, 1, 2, 3, 4, 5].map((i) => (<circle class={`at-v av${i}`} cx={46 + (i % 3) * 40} cy={56 + Math.floor(i / 3) * 40} r="8" />))}
        {[0, 1, 2, 3, 4, 5].map((i) => (<path class={`at-a aa${i}`} d={`M${66 + (i % 3) * 40} ${56 + Math.floor(i / 3) * 40} L318 80`} />))}
        <rect class="block at-head" x="318" y="56" width="108" height="46" rx="6" /><text class="t-cap" x="372" y="76">{L("head block")}</text>
        <text class="t-cap" x="372" y="92">{L("+ checkpoint")}</text>
        <rect class="at-wtrack" x="318" y="116" width="108" height="14" rx="4" /><rect class="at-wfill" x="320" y="118" width="104" height="10" rx="3" />
        <text class="t-cap" x="372" y="148">{L("accumulated weight")}</text>
        <text class="t-cap" x="240" y="182">{L("each validator attests once per epoch — the vote names the head (fork choice) and a checkpoint (finality)")}</text>
