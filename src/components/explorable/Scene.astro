        </g>
        <g class="mpt-node">
          <rect class="mpt-ext mpt-ext-hot" x="196" y="97" width="88" height="30" rx="7" />
          <text class="mpt-kind-e" x="240" y="116" text-anchor="middle">{L("extension")}</text>
