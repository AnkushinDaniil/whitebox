---
import { SITE } from "@/consts";
import { useTranslations, localizePath, withBase, type Lang } from "@/i18n/utils";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <div>
      <p class="line">
        <strong>{SITE.name}</strong> — {t.site.tagline}
      </p>
      <p class="fine">{t.footer.fine} © {year}.</p>
    </div>
    <nav aria-label="Footer">
      <a href={localizePath("/the-execution-layer", lang)}>{t.nav.hub}</a>
      <a href={localizePath("/notes", lang)}>{t.nav.notes}</a>
      <a href={localizePath("/about", lang)}>{t.nav.about}</a>
      <a href={withBase("/rss.xml")}>{t.footer.rss}</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: 5rem;
    background: var(--color-surface);
  }
  .inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .line {
    font-size: 0.95rem;
    color: var(--color-ink);
  }
  .fine {
    font-size: 0.82rem;
    color: var(--color-ink-faint);
    margin-top: 0.4rem;
    max-width: 42ch;
  }
  nav {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    align-items: flex-start;
  }
  nav a {
    font-size: 0.85rem;
    color: var(--color-ink-muted);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--color-accent-strong);
  }
</style>
