  .op { fill: color-mix(in oklab, var(--color-node-branch) 8%, var(--color-surface)); }
  .pc { fill: none; stroke: var(--color-accent); stroke-width: 2; animation: pcstep 4s steps(1) infinite; }
  @keyframes pcstep { 0% { transform: translateY(0) } 25% { transform: translateY(38px) } 50% { transform: translateY(76px) } 75% { transform: translateY(114px) } 100% { transform: translateY(0) } }
