  .c0 { animation: fan 5s ease-out infinite; }
  .c1 { animation: fan 5s ease-out 0.3s infinite; }
  .c2 { animation: fan 5s ease-out 0.6s infinite; }
  .c3 { animation: fan 5s ease-out 0.9s infinite; }
  @keyframes fan { 0% { opacity: 0; transform: translate(140px, 50px) scale(0.4) } 35% { opacity: 1; transform: translate(0,0) scale(1) } 85% { opacity: 1 } 100% { opacity: 0.15 } }

