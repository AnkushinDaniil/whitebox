  .sybil-free { animation: fade-out-half 6s ease-in-out infinite; }
  .sybil-cost { animation: fade-in-half 6s ease-in-out infinite; }
  @keyframes clonedoom { 0% { opacity: 0; transform: scale(0.3) } 12%,46% { opacity: 1; transform: scale(1) } 62% { opacity: 0; transform: scale(0.3) } 100% { opacity: 0 } }
  @keyframes clonekeep { 0% { opacity: 0; transform: scale(0.3) } 12%,100% { opacity: 1; transform: scale(1) } }
