---
/**
 * One animated figure per lesson step. Each `name` renders a self-contained,
 * continuously-looping SVG animation illustrating that idea — the visual half of
 * a 3b1b-style step-by-step lesson. All figures + keyframes live here so the
 * scoped styles stay consistent.
 */
interface Props {
  name:
    | "state"
    | "sign"
    | "recover"
    | "replay"
    | "txfields"
    | "network"
    | "blocks"
    | "sybil"
    | "consensus"
    | "evm"
    | "gas"
    | "triepath"
    | "root";
  caption?: string;
}
const { name, caption } = Astro.props;
---

<figure class="scene">
  <div class="scene-stage" data-scene={name}>
    {/* ── the shared state: a spreadsheet an edit mutates ── */}
    {name === "state" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="A shared world-state spreadsheet being edited">
        <rect class="sheet" x="120" y="24" width="240" height="150" rx="10" />
        <text class="t-mid" x="240" y="48">WORLD STATE</text>
        <line class="hair" x1="136" y1="58" x2="344" y2="58" />
        <g class="row"><text class="t-l" x="140" y="86">0xAlice</text><text class="t-r" x="330" y="86">14 Ξ</text></g>
        <g class="row hot"><rect class="rowhl" x="130" y="98" width="220" height="24" rx="5" /><text class="t-l" x="140" y="115">0xBob</text><text class="t-r bal" x="330" y="115">9 Ξ</text></g>
        <g class="row"><text class="t-l" x="140" y="144">0xCarol</text><text class="t-r" x="330" y="144">2 Ξ</text></g>
        <g class="edit">
          <rect class="pkt" x="20" y="100" width="74" height="22" rx="6" />
          <text class="t-s" x="57" y="115">+5 Ξ →</text>
        </g>
        <text class="t-cap" x="240" y="198">edits move numbers in one shared sheet</text>
      </svg>
    )}

    {/* ── signatures: a seal stamps, verifies, then a tamper breaks it ── */}
    {name === "sign" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="Signing and verifying">
        <rect class="msg" x="40" y="74" width="150" height="60" rx="8" />
        <text class="t-s" x="115" y="100">"send 5 Ξ</text>
        <text class="t-s" x="115" y="118">to Bob"</text>
        <text class="t-cap" x="115" y="158">message (public)</text>
        <g class="seal">
          <circle class="seal-c" cx="300" cy="104" r="30" />
          <text class="seal-m" x="300" y="110">✓</text>
        </g>
        <g class="crack"><text class="t-x" x="300" y="160">✗ tampered</text></g>
        <path class="arrow" d="M196 104 L262 104" />
        <text class="t-cap" x="300" y="62">signature</text>
        <text class="t-cap" x="430" y="110">verify</text>
        <path class="arrow2" d="M332 104 L398 104" />
      </svg>
    )}

    {/* ── recovery: the signer's address materializes from the signature ── */}
    {name === "recover" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="Recovering the signer from a signature">
        <circle class="seal-c2" cx="110" cy="100" r="34" />
        <text class="seal-m2" x="110" y="106">✦</text>
        <text class="t-cap" x="110" y="156">signature only</text>
        <path class="arrow3" d="M152 100 L250 100" />
        <text class="t-mid recover-q" x="201" y="88">who signed?</text>
        <g class="addr-reveal">
          <rect class="addr-box" x="270" y="78" width="180" height="44" rx="8" />
          <text class="t-addr" x="360" y="106">0xBob…a3f1</text>
        </g>
        <text class="t-cap" x="360" y="146">no "from" field needed</text>
      </svg>
    )}

    {/* ── replay: a signed tx is reusable; the nonce makes it single-use ── */}
    {name === "replay" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="The nonce defeats replay">
        <rect class="msg rp-card" x="22" y="76" width="158" height="58" rx="8" />
        <text class="t-s" x="101" y="100">send 5 Ξ → Bob</text>
        <text class="t-cap rp-nonce" x="101" y="120">nonce 7 · 🔒</text>
        <rect class="node" x="356" y="76" width="100" height="58" rx="8" />
        <text class="t-cap" x="406" y="98">0xYou</text>
        <text class="t-r" x="446" y="122">9 Ξ</text>
        <path class="arrow rp-ok" d="M180 92 H356" />
        <text class="t-ok" x="268" y="84">✓ applied once</text>
        <g class="rp-dup">
          <rect class="msg ghost" x="22" y="76" width="158" height="58" rx="8" />
          <text class="t-x" x="101" y="108">✗ copy</text>
        </g>
        <text class="t-x rp-reject" x="300" y="160">replay rejected — nonce 7 already spent</text>
      </svg>
    )}

    {/* ── txfields: every field justified by the attack it blocks ── */}
    {name === "txfields" && (
      <svg viewBox="0 0 480 318" role="img" aria-label="Anatomy of a transaction, every field justified">
        <text class="t-mid" x="120" y="22">TRANSACTION</text>
        <text class="t-cap" x="350" y="22">what breaks without it</text>
        {[
          ["chainId", "replay onto another chain"],
          ["nonce", "replay on this chain"],
          ["to", "no recipient (or: new contract)"],
          ["value", "how much ether moves"],
          ["data", "which code + args to run"],
          ["gasLimit", "a loop drains your balance"],
          ["maxFeePerGas", "overpaying a volatile fee"],
          ["maxPriorityFee", "no tip — proposer skips you"],
          ["sig r,s,yParity", "anyone could forge the sender"],
        ].map(([f, why], i) => (
          <g class={`txrow tr${i}`}>
            <rect class="txbar" x="16" y={34 + i * 29} width="448" height="25" rx="4" />
            <text class="t-field" x="28" y={51 + i * 29}>{f}</text>
            <text class="t-why" x="210" y={51 + i * 29}>{why}</text>
          </g>
        ))}
      </svg>
    )}

    {/* ── decentralize: one sheet copies out to many nodes ── */}
    {name === "network" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="Everyone keeps a copy">
        <g class="origin">
          <rect class="node" x="208" y="84" width="64" height="48" rx="8" />
          <line class="hair2" x1="216" y1="100" x2="264" y2="100" /><line class="hair2" x1="216" y1="110" x2="264" y2="110" /><line class="hair2" x1="216" y1="120" x2="256" y2="120" />
        </g>
        {[
          [60, 30], [380, 30], [40, 150], [400, 150],
        ].map(([x, y], i) => (
          <g class={`copy c${i}`}>
            <rect class="node" x={x} y={y} width="64" height="48" rx="8" />
            <line class="hair2" x1={x + 8} y1={y + 16} x2={x + 56} y2={y + 16} /><line class="hair2" x1={x + 8} y1={y + 26} x2={x + 56} y2={y + 26} /><line class="hair2" x1={x + 8} y1={y + 36} x2={x + 48} y2={y + 36} />
          </g>
        ))}
        <text class="t-cap" x="240" y="200">no master copy — every node holds the whole state</text>
      </svg>
    )}

    {/* ── blocks: edits batched, hash-linked; tampering the past cascades ── */}
    {name === "blocks" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="Blocks hash-linked into a chain">
        {[14, 184, 354].map((x, i) => (
          <g class="blk-g">
            <rect class="block" x={x} y="50" width="112" height="96" rx="8" />
            <text class="t-cap" x={x + 56} y="68">block #{i + 1}</text>
            <rect class={`eline ${i === 0 ? "tamper-line" : ""}`} x={x + 12} y="78" width="88" height="9" rx="2" />
            <rect class="eline" x={x + 12} y="92" width="68" height="9" rx="2" />
            <rect class={`hashchip hc${i}`} x={x + 12} y="116" width="88" height="20" rx="4" />
            <text class={`t-hash htx${i}`} x={x + 56} y="130">hash 9f…{i}c</text>
          </g>
        ))}
        <path class="plink pl1" d="M184 126 H126" /><path class="plink pl2" d="M354 126 H296" />
        <text class="t-cap" x="155" y="120">prev</text><text class="t-cap" x="325" y="120">prev</text>
        <text class="t-x tamper-lbl" x="240" y="174">edit one past block → every hash after it breaks</text>
      </svg>
    )}

    {/* ── sybil: free identities overwhelm a vote; cost makes them safe ── */}
    {name === "sybil" && (
      <svg viewBox="0 0 480 200" role="img" aria-label="Sybil attack and costly identity">
        <circle class="attacker" cx="64" cy="98" r="22" />
        <text class="t-emoji" x="64" y="105">😈</text>
        <text class="t-cap" x="64" y="138">one actor</text>
        {[[180, 44], [250, 40], [320, 60], [200, 110], [280, 120], [360, 110]].map(([x, y], i) => (
          <g class={`clone ${i === 2 ? "clone-keep" : "clone-doom"} sc${i}`}>
            <circle class="clone-c" cx={x} cy={y} r="13" />
            <text class="t-vote" x={x} y={y + 4}>+1</text>
          </g>
        ))}
        <text class="t-x sybil-free" x="300" y="166">free identities → outvote everyone</text>
        <text class="t-ok sybil-cost" x="300" y="166">each must stake real money → can't afford an army</text>
      </svg>
    )}

    {/* ── consensus: votes pile on the heavier fork; finalized locks ── */}
    {name === "consensus" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="Consensus picks the heaviest chain">
        <rect class="blk" x="24" y="92" width="44" height="28" rx="5" /><rect class="blk" x="96" y="92" width="44" height="28" rx="5" />
        <path class="link" d="M68 106 H96" />
        {/* honest fork */}
        <rect class="blk win" x="190" y="58" width="44" height="28" rx="5" /><rect class="blk win" x="262" y="58" width="44" height="28" rx="5" />
        <path class="link" d="M140 100 L190 72" /><path class="link" d="M234 72 H262" />
        <text class="lock" x="318" y="76">🔒</text>
        {[0, 1, 2, 3, 4].map((i) => (<circle class={`vote v${i}`} cx={205 + i * 22} cy="40" r="4" />))}
        {/* attacker fork */}
        <rect class="blk lose" x="190" y="134" width="44" height="28" rx="5" />
        <path class="link dashed" d="M140 112 L190 148" />
        <text class="t-x" x="300" y="152">✗ outvoted</text>
        <text class="t-cap" x="240" y="198">most-backed history wins; finalized blocks lock</text>
      </svg>
    )}

    {/* ── the EVM: an instruction pointer steps; the stack moves ── */}
    {name === "evm" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="The EVM stepping through code">
        <g class="prog">
          {["PUSH 2", "PUSH 3", "ADD", "MUL"].map((op, i) => (
            <g><rect class="op" x="40" y={30 + i * 38} width="120" height="28" rx="5" /><text class="t-op" x="54" y={49 + i * 38}>{op}</text></g>
          ))}
          <rect class="pc" x="34" y="30" width="132" height="28" rx="6" />
        </g>
        <text class="t-cap" x="100" y="196">code runs the same everywhere</text>
        <g class="stack">
          <text class="t-cap" x="330" y="30">stack</text>
          <rect class="si s0" x="280" y="120" width="100" height="24" rx="4" /><text class="t-op si-t s0t" x="330" y="137">2</text>
          <rect class="si s1" x="280" y="92" width="100" height="24" rx="4" /><text class="t-op si-t s1t" x="330" y="109">3</text>
          <rect class="si s2" x="280" y="92" width="100" height="24" rx="4" /><text class="t-op si-t s2t" x="330" y="109">5</text>
        </g>
      </svg>
    )}

    {/* ── gas: a meter drains as instructions run, then halts ── */}
    {name === "gas" && (
      <svg viewBox="0 0 480 180" role="img" aria-label="Gas metering">
        <text class="t-cap" x="60" y="56">gas</text>
        <rect class="gauge" x="60" y="64" width="360" height="22" rx="11" />
        <rect class="gauge-fill" x="62" y="66" width="356" height="18" rx="9" />
        <g class="ops">
          {["PUSH −3", "ADD −3", "SSTORE −20000", "out of gas ✋"].map((op, i) => (<text class={`t-op opx o${i}`} x="240" y="118">{op}</text>))}
        </g>
        <text class="t-cap" x="240" y="156">every step costs — no program runs forever</text>
      </svg>
    )}

    {/* ── triepath: an address is a path of nibbles down typed nodes ── */}
    {name === "triepath" && (
      <svg viewBox="0 0 460 250" role="img" aria-label="Walking an address down the trie">
        <text class="t-cap" x="44" y="22">address</text>
        {["a", "7", "3", "f", "c"].map((n, i) => (
          <g>
            <rect class={`nib nb${i}`} x={96 + i * 34} y="9" width="28" height="20" rx="4" />
            <text class={`t-nib nbt${i}`} x={110 + i * 34} y="24">{n}</text>
          </g>
        ))}
        <rect class="root-chip" x="300" y="8" width="146" height="22" rx="5" />
        <text class="t-root tp-root" x="373" y="23">stateRoot ⟳</text>
        {[
          ["branch", "follow slot a"],
          ["branch", "follow slot 7"],
          ["extension", "shared “3 f c”"],
          ["leaf", "value → 9 Ξ"],
        ].map(([kind, note], i) => (
          <g class={`tn tn${i}`}>
            <rect class={`tnode ${kind}`} x="90" y={52 + i * 46} width="280" height="34" rx="6" />
            <text class="t-field" x="106" y={73 + i * 46}>{kind}</text>
            <text class="t-cap tnote" x="356" y={73 + i * 46}>{note}</text>
          </g>
        ))}
        <path class="tarrow ta0" d="M230 86 V98" /><path class="tarrow ta1" d="M230 132 V144" /><path class="tarrow ta2" d="M230 178 V190" />
        <text class="t-cap tp-rehash" x="230" y="244">edit the leaf → re-hash up the path → new root</text>
      </svg>
    )}

    {/* ── state root: the whole sheet folds into one hash in a header ── */}
    {name === "root" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="All state folds into one root">
        {[40, 78, 116].map((y, i) => (<rect class={`cell cl${i}`} x="24" y={y} width="70" height="24" rx="4" />))}
        <path class="conv c0" d="M94 52 C150 52 150 96 196 96" /><path class="conv c1" d="M94 90 H196" /><path class="conv c2" d="M94 128 C150 128 150 100 196 100" />
        <rect class="trie" x="196" y="80" width="56" height="34" rx="6" /><text class="t-cap" x="224" y="101">trie</text>
        <path class="conv c3" d="M252 97 H300" />
        <rect class="hdr" x="300" y="56" width="156" height="84" rx="8" />
        <text class="t-cap" x="378" y="76">BLOCK HEADER</text>
        <rect class="root-badge" x="312" y="88" width="132" height="28" rx="5" />
        <text class="t-root" x="378" y="106">stateRoot 0x…</text>
        <text class="t-cap" x="240" y="194">32 bytes that fingerprint the entire world</text>
      </svg>
    )}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .scene {
    margin: 1.6rem auto;
    max-width: 580px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: radial-gradient(120% 100% at 50% 0%, var(--color-surface-2), var(--color-canvas));
    padding: 1.1rem 1.2rem 0.9rem;
  }
  .scene-stage svg { width: 100%; height: auto; display: block; }
  figcaption {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-ink-faint);
    text-align: center;
  }

  /* shared primitives */
  .sheet, .node, .msg, .op, .blk, .cell, .trie, .hdr, .gauge, .si, .pkt, .addr-box {
    fill: var(--color-surface);
    stroke: var(--color-border-strong);
    stroke-width: 1.2;
  }
  .hair, .hair2 { stroke: var(--color-border); stroke-width: 1; }
  .t-mid { fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; }
  .t-l { fill: var(--color-ink); font-family: var(--font-mono); font-size: 12px; }
  .t-r { fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 12px; text-anchor: end; }
  .t-s { fill: var(--color-ink); font-family: var(--font-mono); font-size: 12px; text-anchor: middle; }
  .t-op { fill: var(--color-ink); font-family: var(--font-mono); font-size: 12px; }
  .t-cap { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 10px; text-anchor: middle; }
  .t-x { fill: var(--color-changed); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; }
  .arrow, .arrow2, .arrow3, .link, .conv { fill: none; stroke: var(--color-border-strong); stroke-width: 1.6; }
  .link.dashed { stroke-dasharray: 4 4; }

  /* state: an edit pulses a row and floats a +5 up */
  .rowhl { fill: color-mix(in oklab, var(--color-accent) 12%, transparent); stroke: none; opacity: 0; animation: hl 4s ease-in-out infinite; }
  .bal { animation: balbump 4s ease-in-out infinite; }
  .edit { animation: editfly 4s ease-in-out infinite; }
  @keyframes hl { 0%,40% { opacity: 0 } 55%,80% { opacity: 1 } 100% { opacity: 0 } }
  @keyframes balbump { 0%,55% { fill: var(--color-ink-muted) } 65% { fill: var(--color-node-leaf) } 100% { fill: var(--color-ink-muted) } }
  @keyframes editfly { 0% { transform: translateX(0); opacity: 0 } 15% { opacity: 1 } 45% { transform: translateX(120px); opacity: 1 } 55% { transform: translateX(120px); opacity: 0 } 100% { opacity: 0 } }
  .pkt { fill: color-mix(in oklab, var(--color-node-leaf) 16%, var(--color-surface)); stroke: var(--color-node-leaf); }

  /* sign: stamp in, hold ✓, then crack to ✗ */
  .seal-c { fill: color-mix(in oklab, var(--color-node-leaf) 16%, var(--color-surface)); stroke: var(--color-node-leaf); stroke-width: 2; transform-box: fill-box; transform-origin: center; animation: stamp 5s ease-in-out infinite; }
  .seal-m { fill: var(--color-node-leaf); font-size: 24px; text-anchor: middle; animation: stamp 5s ease-in-out infinite; }
  .crack { opacity: 0; animation: crack 5s ease-in-out infinite; }
  .arrow, .arrow2 { stroke-dasharray: 70; stroke-dashoffset: 70; animation: draw 5s ease-in-out infinite; }
  @keyframes stamp { 0% { transform: scale(0.2); opacity: 0 } 15% { transform: scale(1.15); opacity: 1 } 22%,55% { transform: scale(1); opacity: 1 } 70% { opacity: 0.15 } 100% { opacity: 0 } }
  @keyframes crack { 0%,60% { opacity: 0 } 72%,92% { opacity: 1 } 100% { opacity: 0 } }
  @keyframes draw { 0% { stroke-dashoffset: 70 } 20%,100% { stroke-dashoffset: 0 } }

  /* recover: address materializes */
  .seal-c2 { fill: color-mix(in oklab, var(--color-hash) 16%, var(--color-surface)); stroke: var(--color-hash); }
  .seal-m2 { fill: var(--color-hash); font-size: 22px; text-anchor: middle; }
  .recover-q { animation: blink 4s ease-in-out infinite; }
  .arrow3 { stroke-dasharray: 100; stroke-dashoffset: 100; animation: draw3 4s ease-in-out infinite; }
  .addr-box { fill: color-mix(in oklab, var(--color-accent) 10%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .t-addr { fill: var(--color-accent-strong); font-family: var(--font-mono); font-size: 13px; text-anchor: middle; }
  .addr-reveal { opacity: 0; animation: reveal 4s ease-in-out infinite; }
  @keyframes blink { 0%,40% { opacity: 1 } 55%,100% { opacity: 0 } }
  @keyframes draw3 { 0%,15% { stroke-dashoffset: 100 } 45%,100% { stroke-dashoffset: 0 } }
  @keyframes reveal { 0%,45% { opacity: 0; transform: translateX(-8px) } 60%,100% { opacity: 1; transform: translateX(0) } }

  .t-ok { fill: var(--color-node-leaf); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; }

  /* replay: tx applies once, duplicate bounces off the nonce */
  .rp-nonce { fill: var(--color-accent-strong); }
  .ghost { fill: color-mix(in oklab, var(--color-changed) 8%, var(--color-surface)); stroke: var(--color-changed); stroke-dasharray: 4 3; }
  .rp-ok { stroke: var(--color-node-leaf); stroke-dasharray: 180; stroke-dashoffset: 180; animation: draw-ok 5s ease-in-out infinite; }
  .t-ok { animation: fade-hold 5s ease-in-out infinite; }
  .rp-dup { animation: dupbounce 5s ease-in-out infinite; }
  .rp-reject { animation: reject 5s ease-in-out infinite; }
  @keyframes draw-ok { 0% { stroke-dashoffset: 180 } 25%,100% { stroke-dashoffset: 0 } }
  @keyframes fade-hold { 0%,10% { opacity: 0 } 25%,100% { opacity: 1 } }
  @keyframes dupbounce { 0%,40% { transform: translate(0,0); opacity: 0 } 50% { opacity: 1 } 62% { transform: translate(150px,0); opacity: 1 } 78% { transform: translate(40px,0); opacity: 1 } 92% { transform: translate(40px,0); opacity: 0 } 100% { opacity: 0 } }
  @keyframes reject { 0%,62% { opacity: 0 } 74%,92% { opacity: 1 } 100% { opacity: 0 } }

  /* txfields: each row's justification highlights in turn */
  .txbar { fill: transparent; stroke: none; }
  .t-field { fill: var(--color-accent-strong); font-family: var(--font-mono); font-size: 13px; }
  .t-why { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 11px; }
  .txrow { opacity: 0.4; }
  .tr0 { animation: rowlit 9s steps(1) infinite; }
  .tr1 { animation: rowlit 9s steps(1) 1s infinite; }
  .tr2 { animation: rowlit 9s steps(1) 2s infinite; }
  .tr3 { animation: rowlit 9s steps(1) 3s infinite; }
  .tr4 { animation: rowlit 9s steps(1) 4s infinite; }
  .tr5 { animation: rowlit 9s steps(1) 5s infinite; }
  .tr6 { animation: rowlit 9s steps(1) 6s infinite; }
  .tr7 { animation: rowlit 9s steps(1) 7s infinite; }
  .tr8 { animation: rowlit 9s steps(1) 8s infinite; }
