---
import { SITE } from "@/consts";
import { useTranslations, localizePath, stripLang, withBase, type Lang } from "@/i18n/utils";

interface Props {
  title: string;
  description: string;
  type?: "website" | "article";
  published?: Date;
  image?: string;
  lang?: Lang;
}

const {
  title,
  description,
  type = "website",
  published,
  image = "/og.svg",
  lang = "en",
} = Astro.props;

const t = useTranslations(lang);

const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).toString();
const ogImage = new URL(withBase(image), Astro.site).toString();
const fullTitle =
  title === SITE.name ? `${SITE.name} — ${t.site.tagline}` : `${title} · ${SITE.name}`;

// hreflang alternates: the same page in each language (base- and locale-prefixed).
const canonicalPath = stripLang(path);
const enHref = new URL(localizePath(canonicalPath, "en"), Astro.site).toString();
const ruHref = new URL(localizePath(canonicalPath, "ru"), Astro.site).toString();
const ogLocale = lang === "ru" ? "ru_RU" : "en_US";
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="en" href={enHref} />
<link rel="alternate" hreflang="ru" href={ruHref} />
<link rel="alternate" hreflang="x-default" href={enHref} />
<link rel="sitemap" href={withBase("/sitemap-index.xml")} />
<link rel="alternate" type="application/rss+xml" title={SITE.name} href={withBase("/rss.xml")} />

<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />

<!-- OpenGraph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={ogLocale} />
{published && <meta property="article:published_time" content={published.toISOString()} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<meta name="theme-color" content="#0a0c10" />
<!--
  The site is already dark-mode-first; tell Dark Reader to leave it alone.
  Otherwise the extension re-colors everything (washed-out "weird" visuals) and
  injects styles (e.g. caret-color on inputs) BEFORE React hydrates, which
  triggers hydration mismatches that break the interactive widgets.
-->
<meta name="darkreader-lock" />
<link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />

<!-- Fonts: Inter (UI) + JetBrains Mono (technical). Preconnect for speed. -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;650;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
/>

<!-- JSON-LD -->
<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": type === "article" ? "TechArticle" : "WebSite",
    name: SITE.name,
    headline: title,
    description,
    url: canonical,
    inLanguage: lang,
    ...(published && { datePublished: published.toISOString() }),
  })}
/>
