  .onf-cell { fill: color-mix(in oklab, var(--color-surface-2) 55%, var(--color-surface)); stroke: var(--color-border-strong); stroke-width: 1; }
  .onf-celltext { fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 6.5px; text-anchor: middle; }
  .txf-field { fill: var(--color-accent-strong); font-family: var(--font-mono); font-size: 12px; }
  .txf-why { fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 10px; }
  .txf-hd { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.06em; }

  .onf-rlp { fill: var(--color-surface); stroke: var(--color-border-strong); stroke-width: 1.5; }
  .onf-rlptext { fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; }
  .onf-chip { fill: color-mix(in oklab, var(--color-accent) 8%, var(--color-surface)); stroke: var(--color-accent-dim); stroke-width: 1.2; }
  .onf-parser { fill: color-mix(in oklab, var(--color-changed) 8%, var(--color-surface)); stroke: var(--color-changed); stroke-width: 1.5; }
  .onf-ar { fill: none; stroke: var(--color-border-strong); stroke-width: 1.6; }

  .tb-byte { fill: color-mix(in oklab, var(--color-accent) 18%, var(--color-surface)); stroke: var(--color-accent); stroke-width: 1.6; }
  .tb-bytetext { fill: var(--color-accent-strong); font-family: var(--font-mono); font-size: 18px; text-anchor: middle; }
  .tb-pay { fill: var(--color-surface); stroke: var(--color-border-strong); stroke-width: 1.5; }
  .tb-paytext { fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; }
  .tb-ar { fill: none; stroke: var(--color-accent); stroke-width: 1.8; }
  .tb-dec { fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); stroke: var(--color-node-leaf); stroke-width: 1.5; }
  .tb-ok { fill: var(--color-node-leaf); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; }

  .fam-chip { fill: color-mix(in oklab, var(--color-accent) 12%, var(--color-surface)); stroke: var(--color-accent); stroke-width: 1.3; }
  .fam-byte { fill: var(--color-accent-strong); font-family: var(--font-mono); font-size: 12px; text-anchor: middle; }
  .fam-name { fill: var(--color-surface); stroke: var(--color-border); stroke-width: 1; }
  .fam-namelbl { fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 11px; }
  .fam-next { fill: color-mix(in oklab, var(--color-ink-faint) 8%, var(--color-surface)); stroke: var(--color-border); stroke-width: 1; stroke-dasharray: 4 3; }
  .fam-nextlbl { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 11px; }
  .fam-conn { fill: none; stroke: var(--color-border); stroke-width: 1.2; }

  .dis-typed { fill: color-mix(in oklab, var(--color-node-leaf) 18%, var(--color-surface)); stroke: var(--color-node-leaf); stroke-width: 1.4; }
  .dis-gap { fill: color-mix(in oklab, var(--color-ink-faint) 10%, var(--color-surface)); stroke: var(--color-border); stroke-width: 1; stroke-dasharray: 3 3; }
  .dis-legacy { fill: color-mix(in oklab, var(--color-accent) 16%, var(--color-surface)); stroke: var(--color-accent); stroke-width: 1.4; }
  .dis-zonelbl { fill: var(--color-ink); font-family: var(--font-mono); font-size: 10px; text-anchor: middle; }
  .dis-gaplbl { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 9.5px; text-anchor: middle; }
  .dis-axis { stroke: var(--color-border-strong); stroke-width: 1.4; }
  .dis-tick { stroke: var(--color-border-strong); stroke-width: 1.2; }
  .dis-num { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 9px; text-anchor: middle; }
  .dis-mark { fill: var(--color-accent); }
  .dis-marklbl { fill: var(--color-accent-strong); font-family: var(--font-mono); font-size: 9.5px; text-anchor: middle; }

  .evw-fixed { fill: var(--color-surface); stroke: var(--color-border-strong); stroke-width: 1.5; }
  .evw-prog { fill: var(--color-surface); stroke: var(--color-node-leaf); stroke-width: 1.5; }
  .evw-cc { fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 11px; }
  .evw-op { fill: var(--color-node-leaf); font-family: var(--font-mono); font-size: 11px; }
  .evw-ar { fill: none; stroke: var(--color-accent); stroke-width: 2; }
  .evw-rigid { fill: var(--color-changed); font-family: var(--font-mono); font-size: 10px; text-anchor: middle; }
  .evw-free { fill: var(--color-node-leaf); font-family: var(--font-mono); font-size: 10px; text-anchor: middle; }

  .evg-track { fill: color-mix(in oklab, var(--color-ink-faint) 12%, var(--color-surface)); stroke: var(--color-border-strong); stroke-width: 1.4; }
  .evg-fill { fill: var(--color-node-leaf); }
  .evg-spent { fill: color-mix(in oklab, var(--color-changed) 18%, var(--color-surface)); }
  .evg-tick { stroke: var(--color-border-strong); stroke-width: 1.4; }
  .evg-op { fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 9px; text-anchor: middle; }
  .evg-halt { fill: var(--color-changed); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; }

  .evr-reg { fill: color-mix(in oklab, var(--color-surface-2) 50%, var(--color-surface)); stroke: var(--color-border-strong); stroke-width: 1.4; }
  .evr-stack-cell { fill: color-mix(in oklab, var(--color-node-extension) 30%, var(--color-surface)); stroke: var(--color-node-extension); stroke-width: 1.2; }
  .evr-mem-cell { fill: color-mix(in oklab, var(--color-node-branch) 26%, var(--color-surface)); stroke: var(--color-node-branch); stroke-width: 1; }
  .evr-disk { fill: color-mix(in oklab, var(--color-node-leaf) 22%, var(--color-surface)); stroke: var(--color-node-leaf); stroke-width: 1.3; }
  .evr-diskbody { fill: color-mix(in oklab, var(--color-node-leaf) 14%, var(--color-surface)); stroke: var(--color-node-leaf); stroke-width: 1.3; }
  .evr-persistval { fill: var(--color-node-leaf); font-family: var(--font-mono); font-size: 12px; text-anchor: middle; }
  .evr-cheap { fill: var(--color-node-leaf); font-family: var(--font-mono); font-size: 9.5px; text-anchor: middle; }
  .evr-exp { fill: var(--color-changed); font-family: var(--font-mono); font-size: 9.5px; text-anchor: middle; }
  .evr-sub { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 9px; text-anchor: middle; }
  @keyframes rootpulse { 0%,55% { filter: none } 70% { filter: drop-shadow(0 0 8px var(--color-accent-dim)) } 100% { filter: none } }
  /* editing a cell flips the root value 9f2e → a2e0 (5s) */
  .rt-editcell { animation: rt-editcell 5s ease-in-out infinite; }
  @keyframes rt-editcell { 0%,44% { fill: var(--color-surface) } 54%,72% { fill: color-mix(in oklab, var(--color-changed) 22%, var(--color-surface)) } 82%,100% { fill: var(--color-surface) } }
  .rt-editlbl { fill: var(--color-changed); opacity: 0; animation: rt-editlbl 5s ease-in-out infinite; }
  @keyframes rt-editlbl { 0%,44% { opacity: 0 } 54%,74% { opacity: 1 } 84%,100% { opacity: 0 } }
  .rt-before { fill: var(--color-accent-strong); animation: rt-before 5s ease-in-out infinite; }
  @keyframes rt-before { 0%,52% { opacity: 1 } 58%,82% { opacity: 0 } 90%,100% { opacity: 1 } }
  .rt-after { fill: var(--color-changed); opacity: 0; animation: rt-after 5s ease-in-out infinite; }
  @keyframes rt-after { 0%,54% { opacity: 0 } 60% { opacity: 1; filter: drop-shadow(0 0 5px var(--color-changed)) } 70% { filter: none } 82% { opacity: 1 } 90%,100% { opacity: 0 } }

  /* sync — shared bits */
  .sedge { fill: none; stroke: var(--color-border); stroke-width: 1.2; }
  .sedge.on { stroke: var(--color-accent); stroke-width: 1.8; }
  .sarrow { fill: none; stroke: var(--color-border-strong); stroke-width: 1.6; }
  .st-ok { fill: var(--color-node-leaf); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; }

  /* full sync: a marker crawls block by block while state fills, slowly */
  .sg-marker { fill: none; stroke: var(--color-accent); stroke-width: 2; transform-box: fill-box; animation: sgstep 7s steps(8, jump-none) infinite; }
  @keyframes sgstep { 0% { transform: translateX(0) } 100% { transform: translateX(392px) } }
  .sg-track { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .sg-fill { fill: color-mix(in oklab, var(--color-accent) 30%, var(--color-surface)); transform-box: fill-box; transform-origin: left; animation: sgfill 7s linear infinite; }
  @keyframes sgfill { 0% { transform: scaleX(0.02) } 100% { transform: scaleX(1) } }

  /* fast sync: nodes pop in one by one, top-down */
  .st-n { opacity: 0; }
  .s0 { animation: stpop 6s ease-out infinite; } .s1 { animation: stpop 6s ease-out 0.5s infinite; }
  .s2 { animation: stpop 6s ease-out 1s infinite; } .s3 { animation: stpop 6s ease-out 1.5s infinite; }
  .s4 { animation: stpop 6s ease-out 2.2s infinite; } .s5 { animation: stpop 6s ease-out 2.7s infinite; }
  .s6 { animation: stpop 6s ease-out 3.2s infinite; } .s7 { animation: stpop 6s ease-out 3.7s infinite; }
  @keyframes stpop { 0%,3% { opacity: 0; transform: translateY(-4px) } 9%,90% { opacity: 1; transform: translateY(0) } 100% { opacity: 1 } }

  /* snap sync: big ranges fill fast, then the trie assembles and heals */
  .sn-bar { fill: color-mix(in oklab, var(--color-node-extension) 12%, var(--color-surface)); stroke: var(--color-node-extension); }
  .sn-range { opacity: 0; }
  .r0 { animation: snrange 6s ease-out infinite; } .r1 { animation: snrange 6s ease-out 0.6s infinite; }
  .r2 { animation: snrange 6s ease-out 1.2s infinite; } .r3 { animation: snrange 6s ease-out 1.8s infinite; }
  @keyframes snrange { 0%,4% { opacity: 0; transform: translateX(-10px) } 12%,100% { opacity: 1; transform: translateX(0) } }
  .sn-arrow { stroke-dasharray: 50; stroke-dashoffset: 50; animation: sndraw 6s ease-out infinite; }
  @keyframes sndraw { 0%,30% { stroke-dashoffset: 50 } 42%,100% { stroke-dashoffset: 0 } }
  .sn-t0, .sn-t1, .sn-t2 { opacity: 0; animation: snbuild 6s ease-out infinite; }
  .sn-t1 { animation-delay: 0.3s; } .sn-t2 { animation-delay: 0.5s; }
  @keyframes snbuild { 0%,45% { opacity: 0 } 55%,100% { opacity: 1 } }
  .sn-heal { opacity: 0; animation: snheal 6s ease-in-out infinite; }
  .sn-heal-n { stroke: var(--color-changed); }
  @keyframes snheal { 0%,72% { opacity: 0 } 80% { opacity: 1; filter: drop-shadow(0 0 6px var(--color-changed)) } 92%,100% { opacity: 0 } }

  /* light client: a query lights a proof path, returns a verified value */
  .lhdr { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-border-strong); }
  .lq { fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; }
  .lp { stroke-dasharray: 140; stroke-dashoffset: 140; animation: ldraw 5s ease-in-out infinite; }
  @keyframes ldraw { 0%,18% { stroke-dashoffset: 140 } 40%,100% { stroke-dashoffset: 0 } }
  .lproof { opacity: 0; animation: lreveal 5s ease-in-out infinite; }
  @keyframes lreveal { 0%,42% { opacity: 0 } 56%,92% { opacity: 1 } 100% { opacity: 0 } }

  /* checkpoint sync: the long crawl dims, a trusted anchor hops to head */
  .ck-old { animation: ckdim 6s ease-in-out infinite; }
  @keyframes ckdim { 0%,30% { opacity: 1 } 48%,100% { opacity: 0.32 } }
  .ck-crawl { fill: none; stroke: var(--color-changed); stroke-width: 1.6; stroke-dasharray: 5 4; stroke-dashoffset: 366; animation: ckcrawl 6s linear infinite; }
  @keyframes ckcrawl { 0% { stroke-dashoffset: 366 } 40%,100% { stroke-dashoffset: 0 } }
  .ck-instead, .ck-anchor, .ck-lock, .ck-hop { opacity: 0; animation: ckin 6s ease-out infinite; }
  .ck-anchor { fill: color-mix(in oklab, var(--color-node-leaf) 14%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .ck-lock { fill: var(--color-node-leaf); font-family: var(--font-mono); font-size: 9px; text-anchor: middle; }
  .ck-hop { stroke: var(--color-node-leaf); }
  @keyframes ckin { 0%,50% { opacity: 0 } 62%,100% { opacity: 1 } }

  /* flat-db shared */
  .db-q { fill: color-mix(in oklab, var(--color-accent) 8%, var(--color-surface)); stroke: var(--color-border-strong); }
  .db-node { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .db-val { stroke: var(--color-node-leaf); fill: color-mix(in oklab, var(--color-node-leaf) 10%, var(--color-surface)); }

  /* dbtrie: scattered reads fire in sequence along crossing arrows */
  .dr { opacity: 0; }
  .dr0 { animation: drpop 5s ease-out infinite; } .dr1 { animation: drpop 5s ease-out 0.6s infinite; }
  .dr2 { animation: drpop 5s ease-out 1.2s infinite; } .dr3 { animation: drpop 5s ease-out 1.8s infinite; }
  .dr4 { animation: drpop 5s ease-out 2.4s infinite; }
  @keyframes drpop { 0%,4% { opacity: 0; transform: scale(0.6) } 12%,90% { opacity: 1; transform: scale(1) } 100% { opacity: 1 } }
  .da { fill: none; stroke: var(--color-border-strong); stroke-width: 1.5; stroke-dasharray: 260; stroke-dashoffset: 260; }
  .da1 { animation: dadraw 5s ease-out 0.3s infinite; } .da2 { animation: dadraw 5s ease-out 0.9s infinite; }
  .da3 { animation: dadraw 5s ease-out 1.5s infinite; } .da4 { animation: dadraw 5s ease-out 2.1s infinite; }
  @keyframes dadraw { 0%,6% { stroke-dashoffset: 260 } 16%,100% { stroke-dashoffset: 0 } }

  /* dbhalfpath: a disk head seeks wildly when hash-keyed, sweeps when path-keyed */
  .hp-cell { fill: var(--color-surface); stroke: var(--color-border); }
  .hp-node { fill: color-mix(in oklab, var(--color-node-extension) 22%, var(--color-surface)); stroke: var(--color-node-extension); }
  .hp-node-ok { fill: color-mix(in oklab, var(--color-node-leaf) 20%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .hp-bad { fill: var(--color-changed); } .hp-ok { fill: var(--color-node-leaf); }
  .hp-head { fill: var(--color-accent); }
  .hp-head-a { animation: hashseek 5s linear infinite; }
  .hp-head-b { animation: pathsweep 5s ease-in-out infinite; }
  @keyframes hashseek { 0% { transform: translateX(63px) } 20% { transform: translateX(141px) } 40% { transform: translateX(193px) } 60% { transform: translateX(297px) } 80% { transform: translateX(401px) } 100% { transform: translateX(63px) } }
  @keyframes pathsweep { 0% { transform: translateX(193px) } 45%,55% { transform: translateX(297px) } 100% { transform: translateX(193px) } }

  /* dbflat: one quick lookup hits a flat row; the trie waits aside */
  .df-six { fill: var(--color-changed); font-family: var(--font-mono); font-size: 10px; text-decoration: line-through; animation: dfsix 4.5s ease-in-out infinite; }
  .df-one { fill: var(--color-node-leaf); font-family: var(--font-mono); font-size: 10px; opacity: 0; animation: dfone 4.5s ease-in-out infinite; }
  @keyframes dfsix { 0%,40% { opacity: 1 } 55%,100% { opacity: 0 } }
  @keyframes dfone { 0%,45% { opacity: 0 } 58%,100% { opacity: 1 } }
  .db-flatrow { fill: var(--color-surface); stroke: var(--color-border); }
  .df-hit .db-flatrow { stroke: var(--color-node-leaf); fill: color-mix(in oklab, var(--color-node-leaf) 12%, var(--color-surface)); }
  .df-arrow { stroke-dasharray: 50; stroke-dashoffset: 50; animation: dfdraw 4.5s ease-in-out infinite; }
  @keyframes dfdraw { 0%,10% { stroke-dashoffset: 50 } 30%,100% { stroke-dashoffset: 0 } }
  .df-hit, .df-ok { animation: dfhit 4.5s ease-in-out infinite; }
  @keyframes dfhit { 0%,30% { opacity: 0.35 } 42%,100% { opacity: 1 } }
  .df-trie { animation: dftrie 4.5s ease-in-out infinite; }
  @keyframes dftrie { 0%,60% { opacity: 0.4 } 74% { opacity: 1; filter: drop-shadow(0 0 6px var(--color-accent-dim)) } 100% { opacity: 0.4 } }

  /* dbcompact: levels appear bottom-up, 8 boxes merging to 4 to 2 to 1 */
  .cbox { stroke-width: 1.2; }
  .c1 { fill: color-mix(in oklab, var(--color-node-extension) 14%, var(--color-surface)); stroke: var(--color-node-extension); }
  .c2 { fill: color-mix(in oklab, var(--color-node-branch) 14%, var(--color-surface)); stroke: var(--color-node-branch); }
  .c4 { fill: color-mix(in oklab, var(--color-accent) 12%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .c8 { fill: color-mix(in oklab, var(--color-node-leaf) 14%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .c-on { fill: var(--color-ink-muted); }
  .cl { opacity: 0; }
  .cl0 { animation: clk0 8s ease-in-out infinite; }
  .cl1 { animation: clk1 8s ease-in-out infinite; }
  .cl2 { animation: clk2 8s ease-in-out infinite; }
  .cl3 { animation: clk3 8s ease-in-out infinite; }
  @keyframes clk0 { 0%,20% { opacity: 1 } 27%,93% { opacity: 0 } 100% { opacity: 1 } }
  @keyframes clk1 { 0%,22% { opacity: 0 } 29%,44% { opacity: 1 } 51%,100% { opacity: 0 } }
  @keyframes clk2 { 0%,46% { opacity: 0 } 53%,66% { opacity: 1 } 73%,100% { opacity: 0 } }
  @keyframes clk3 { 0%,68% { opacity: 0 } 75%,92% { opacity: 1 } 99%,100% { opacity: 0 } }
  .c-count { opacity: 0; }
  .cc0 { animation: clk0 8s ease-in-out infinite; } .cc1 { animation: clk1 8s ease-in-out infinite; }
  .cc2 { animation: clk2 8s ease-in-out infinite; } .cc3 { animation: clk3 8s ease-in-out infinite; }

  /* dbdiff: a query token falls through diff layers to the first (newest) match */
  .dd-card { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .dd-hit { stroke: var(--color-node-leaf); fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); }
  .dd-base { fill: color-mix(in oklab, var(--color-hash) 7%, var(--color-surface)); stroke: var(--color-hash); }
  .dd-tag { fill: var(--color-ink-faint); text-anchor: start; }
  .dd-found { fill: var(--color-node-leaf); }
  .dd-shadow { fill: var(--color-ink-faint); text-decoration: line-through; }
  .dd-shadnote { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 9px; text-anchor: start; }
  .dd-token { fill: color-mix(in oklab, var(--color-accent) 22%, var(--color-surface)); stroke: var(--color-accent); animation: ddfall 5s ease-in-out infinite; }
  .dd-qt { fill: var(--color-accent-strong); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; animation: ddfall 5s ease-in-out infinite; }
  @keyframes ddfall { 0%,16% { transform: translateY(0) } 32% { transform: translateY(21px) } 50%,90% { transform: translateY(63px) } 100% { transform: translateY(0) } }

  /* dbmerge: the merged card assembles; the duplicate key drops out */
  .dm-arrow { stroke-dasharray: 70; stroke-dashoffset: 70; animation: dmdraw 5s ease-in-out infinite; }
  @keyframes dmdraw { 0%,12% { stroke-dashoffset: 70 } 30%,100% { stroke-dashoffset: 0 } }
  .dm-merged { stroke: var(--color-node-leaf); }
  rect.dm-merged { fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); }
  .dm-merged, .dm-keep { opacity: 0; animation: dmrev 5s ease-in-out infinite; }
  @keyframes dmrev { 0%,30% { opacity: 0 } 44%,100% { opacity: 1 } }
  .dm-drop { opacity: 0; animation: dmdrop 5s ease-in-out infinite; }
  @keyframes dmdrop { 0%,46% { opacity: 0 } 58%,100% { opacity: 1 } }

  /* dblayers: a token falls through snapshot layers, stops where the value lives */
  .db-layer { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .db-layer.t1 { stroke: var(--color-node-extension); }
  .db-layer.t2 { stroke: var(--color-node-branch); }
  .db-layer.base { stroke: var(--color-hash); fill: color-mix(in oklab, var(--color-hash) 7%, var(--color-surface)); }
  .dl-found .db-layer { stroke: var(--color-node-leaf); fill: color-mix(in oklab, var(--color-node-leaf) 12%, var(--color-surface)); }
  .dl-token { fill: color-mix(in oklab, var(--color-accent) 22%, var(--color-surface)); stroke: var(--color-accent); animation: dldrop 5s ease-in infinite; }
  .dl-qt { fill: var(--color-accent-strong); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; animation: dldrop 5s ease-in infinite; }
  @keyframes dldrop { 0%,8% { transform: translateY(0) } 30% { transform: translateY(23px) } 45% { transform: translateY(51px) } 60%,90% { transform: translateY(79px) } 100% { transform: translateY(0) } }
  .dl-found { animation: dlfound 5s ease-in-out infinite; }
  @keyframes dlfound { 0%,55% { opacity: 0.55 } 64%,90% { opacity: 1 } 100% { opacity: 0.55 } }

  /* consensus — slots: a "now" marker steps across the slot timeline */
  .sl-cell { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .sl-prop { fill: color-mix(in oklab, var(--color-node-extension) 18%, var(--color-surface)); stroke: var(--color-node-extension); }
  .sl-now { fill: color-mix(in oklab, var(--color-accent) 8%, transparent); stroke: var(--color-accent); stroke-width: 2.2; animation: slnow 8s steps(8, jump-none) infinite; }
  @keyframes slnow { 0% { transform: translateX(0) } 100% { transform: translateX(399px) } }

  /* consensus — randao: the seed cycles, a pick lands on a validator */
  .rd-seed { fill: color-mix(in oklab, var(--color-hash) 9%, var(--color-surface)); stroke: var(--color-hash); }
  .rd-v { text-anchor: middle; fill: var(--color-hash); }
  .rdv0 { animation: rdv 4.5s steps(1) infinite; } .rdv1 { opacity: 0; animation: rdv 4.5s steps(1) 1.5s infinite; } .rdv2 { opacity: 0; animation: rdv 4.5s steps(1) 3s infinite; }
  @keyframes rdv { 0%,30% { opacity: 1 } 34%,100% { opacity: 0 } }
  .rd-dot { fill: color-mix(in oklab, var(--color-node-extension) 14%, var(--color-surface)); stroke: var(--color-node-extension); }
  .rd-chosen { fill: color-mix(in oklab, var(--color-accent) 22%, var(--color-surface)); stroke: var(--color-accent); animation: rdpulse 4.5s ease-in-out infinite; }
  @keyframes rdpulse { 0%,40% { filter: none } 55% { filter: drop-shadow(0 0 7px var(--color-accent-dim)) } 100% { filter: none } }
  .rd-pick { fill: none; stroke: var(--color-accent); stroke-width: 1.6; stroke-dasharray: 160; stroke-dashoffset: 160; animation: rddraw 4.5s ease-in-out infinite; }
  @keyframes rddraw { 0%,22% { stroke-dashoffset: 160 } 45%,100% { stroke-dashoffset: 0 } }
  .rd-lbl { animation: fade-hold 4.5s ease-in-out infinite; }
  .rd-mix { fill: none; stroke: var(--color-border-strong); stroke-width: 1.3; stroke-dasharray: 3 3; }
  .rd-mixl { fill: var(--color-ink-faint); }

  /* consensus — attest: committee fires votes, head weight fills */
  .at-v { fill: color-mix(in oklab, var(--color-node-extension) 16%, var(--color-surface)); stroke: var(--color-node-extension); }
  .at-head { fill: color-mix(in oklab, var(--color-accent) 8%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .at-a { fill: none; stroke: var(--color-accent); stroke-width: 1.4; stroke-dasharray: 320; stroke-dashoffset: 320; }
  .aa0 { animation: atdraw 5s ease-out infinite; } .aa1 { animation: atdraw 5s ease-out 0.3s infinite; } .aa2 { animation: atdraw 5s ease-out 0.6s infinite; }
  .aa3 { animation: atdraw 5s ease-out 0.9s infinite; } .aa4 { animation: atdraw 5s ease-out 1.2s infinite; } .aa5 { animation: atdraw 5s ease-out 1.5s infinite; }
  @keyframes atdraw { 0%,6% { stroke-dashoffset: 320 } 30%,90% { stroke-dashoffset: 0 } 100% { stroke-dashoffset: 0 } }
  .at-wtrack { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .at-wfill { fill: var(--color-node-leaf); transform-box: fill-box; transform-origin: left; animation: atfill 5s ease-in-out infinite; }
  @keyframes atfill { 0% { transform: scaleX(0.04) } 70%,100% { transform: scaleX(1) } }

  /* consensus — epoch: two gauges fill, justify, then finalize */
  .ep-line { fill: none; stroke: var(--color-border-strong); stroke-width: 1.5; }
  .ep-tick { stroke: var(--color-border); stroke-width: 1; }
  .ep-cp { fill: var(--color-surface); stroke: var(--color-border-strong); stroke-width: 1.5; }
  .ep-c0 { animation: epc0 7s ease-in-out infinite; } .ep-c1 { animation: epc1 7s ease-in-out infinite; }
  @keyframes epc0 { 0%,24% { stroke: var(--color-border-strong) } 30%,100% { stroke: var(--color-node-leaf) } }
  @keyframes epc1 { 0%,54% { stroke: var(--color-border-strong) } 60%,100% { stroke: var(--color-node-leaf) } }
  .ep-track { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .ep-fill { fill: var(--color-node-leaf); transform-box: fill-box; transform-origin: left; }
  .ep-f0 { animation: epf0 7s ease-in-out infinite; } .ep-f1 { animation: epf1 7s ease-in-out infinite; }
  @keyframes epf0 { 0% { transform: scaleX(0.04) } 24%,100% { transform: scaleX(1) } }
  @keyframes epf1 { 0%,30% { transform: scaleX(0.04) } 54%,100% { transform: scaleX(1) } }
  .ep-j0 { text-anchor: middle; opacity: 0; animation: epj0 7s ease-in-out infinite; }
  .ep-j1 { text-anchor: middle; opacity: 0; animation: epj1 7s ease-in-out infinite; }
  @keyframes epj0 { 0%,26% { opacity: 0 } 32%,100% { opacity: 1 } }
  @keyframes epj1 { 0%,56% { opacity: 0 } 62%,100% { opacity: 1 } }
  .ep-lock { font-size: 13px; text-anchor: middle; opacity: 0; animation: epfin 7s ease-in-out infinite; }
  .ep-final { text-anchor: middle; opacity: 0; animation: epfin 7s ease-in-out infinite; }
  @keyframes epfin { 0%,62% { opacity: 0 } 70%,100% { opacity: 1 } }

  /* consensus — pbs: bids arrive, winner signed, body revealed */
  .pb-box { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .pb-bid { fill: var(--color-ink-muted); }
  .pb-win .pb-box { stroke: var(--color-node-leaf); fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); }
  .pb-win .pb-bid { fill: var(--color-node-leaf); }
  .pb-relay { fill: color-mix(in oklab, var(--color-node-branch) 10%, var(--color-surface)); stroke: var(--color-node-branch); }
  .pb-prop { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .pb-a, .pb-a2, .pb-a3 { fill: none; stroke: var(--color-border-strong); stroke-width: 1.5; stroke-dasharray: 70; stroke-dashoffset: 70; }
  .b0 { animation: pbdraw 6s ease-out 0.2s infinite; } .b1 { animation: pbdraw 6s ease-out 0.4s infinite; } .b2 { animation: pbdraw 6s ease-out 0.6s infinite; }
  .pb-a2 { animation: pbdraw 6s ease-out 1.6s infinite; } .pb-a3 { animation: pbdraw 6s ease-out 3s infinite; }
  @keyframes pbdraw { 0%,8% { stroke-dashoffset: 70 } 24%,100% { stroke-dashoffset: 0 } }
  .pb-sign { fill: var(--color-node-leaf); animation: pbsign 6s ease-in-out infinite; }
  @keyframes pbsign { 0%,40% { opacity: 0.25 } 52%,100% { opacity: 1 } }
  .pb-block { fill: color-mix(in oklab, var(--color-accent) 10%, var(--color-surface)); stroke: var(--color-accent); animation: pbblock 6s ease-in-out infinite; }
  @keyframes pbblock { 0%,55% { opacity: 0.3 } 68%,100% { opacity: 1 } }

  /* consensus — validator lifecycle: a token flows through the stages */
  .vl-box { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .vl-active { stroke: var(--color-node-leaf); }
  .vl-a { fill: none; stroke: var(--color-border-strong); stroke-width: 1.5; }
  .vl-token { fill: color-mix(in oklab, var(--color-accent) 24%, var(--color-surface)); stroke: var(--color-accent); animation: vlflow 7s ease-in-out infinite; }
  @keyframes vlflow { 0%,4% { transform: translateX(42px) } 24% { transform: translateX(136px) } 46% { transform: translateX(230px) } 68% { transform: translateX(324px) } 88%,100% { transform: translateX(418px) } }
  .vl-branch { fill: none; stroke: var(--color-changed); stroke-width: 1.4; stroke-dasharray: 4 3; }
  .vl-slash { fill: color-mix(in oklab, var(--color-changed) 8%, var(--color-surface)); stroke: var(--color-changed); }
  .vl-slashgrp { opacity: 0; animation: vlslash 7s ease-in-out infinite; }
  @keyframes vlslash { 0%,40% { opacity: 0 } 48%,62% { opacity: 1 } 70%,100% { opacity: 0 } }

  /* EIP-1559 — fee-auction: top bids fill the block, you overpay, lows stall */
  .fa-rect { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .fa-block { fill: color-mix(in oklab, var(--color-accent) 6%, transparent); stroke: var(--color-accent-dim); }
  .fa-blbl { fill: var(--color-accent); }
  .fa-stall { fill: var(--color-ink-faint); }
  .fa-in .fa-rect { animation: fa-in 5s ease-in-out infinite; }
  .fa-out .fa-rect { animation: fa-out 5s ease-in-out infinite; }
  .fa-out { animation: fa-dim 5s ease-in-out infinite; }
  .fa-you .fa-rect { fill: color-mix(in oklab, var(--color-hash) 14%, var(--color-surface)); stroke: var(--color-hash); animation: fa-you 5s ease-in-out infinite; }
  @keyframes fa-in { 0%,30% { stroke: var(--color-border-strong) } 45%,100% { stroke: var(--color-node-leaf); fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)) } }
  @keyframes fa-out { 0%,30% { stroke: var(--color-border-strong) } 45%,100% { stroke: var(--color-changed) } }
  @keyframes fa-dim { 0%,40% { opacity: 1 } 55%,100% { opacity: 0.5 } }
  @keyframes fa-you { 0%,60% { filter: none } 72% { filter: drop-shadow(0 0 7px var(--color-hash)) } 100% { filter: none } }

  /* EIP-1559 — fee-elastic: the block fill bursts then recedes as the fee climbs */
  .el-block { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .el-fill { fill: color-mix(in oklab, var(--color-accent) 22%, var(--color-surface)); transform-box: fill-box; transform-origin: bottom; animation: el-fill 6s ease-in-out infinite; }
  @keyframes el-fill { 0%,12% { transform: scaleY(0.5) } 32% { transform: scaleY(0.95) } 80%,100% { transform: scaleY(0.5) } }
  .el-target { stroke: var(--color-node-leaf); stroke-width: 1.4; stroke-dasharray: 5 3; }
  .el-fee { fill: var(--color-hash); opacity: 0; animation: el-fee 6s ease-in-out infinite; }
  @keyframes el-fee { 0%,30% { opacity: 0 } 42%,72% { opacity: 1 } 86%,100% { opacity: 0 } }

  /* EIP-1559 — fee-burn: base flies to the fire, tip flies to the proposer */
  .fb-base { fill: color-mix(in oklab, var(--color-hash) 12%, var(--color-surface)); stroke: var(--color-hash); }
  .fb-tip { fill: color-mix(in oklab, var(--color-node-leaf) 12%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .fb-a1, .fb-a2 { fill: none; stroke: var(--color-border-strong); stroke-width: 1.5; stroke-dasharray: 60; stroke-dashoffset: 60; }
  .fb-a1 { animation: fb-draw 5s ease-in-out infinite; }
  .fb-a2 { animation: fb-draw 5s ease-in-out 0.4s infinite; }
  @keyframes fb-draw { 0%,14% { stroke-dashoffset: 60 } 34%,100% { stroke-dashoffset: 0 } }
  .fb-fire { font-size: 16px; text-anchor: middle; opacity: 0; transform-box: fill-box; transform-origin: center; animation: fb-fire 5s ease-in-out infinite; }
  @keyframes fb-fire { 0%,34% { opacity: 0; transform: scale(0.5) } 46% { opacity: 1; transform: scale(1.15) } 58%,90% { opacity: 1; transform: scale(1) } 100% { opacity: 0 } }
  .fb-burnlbl { animation: fb-late 5s ease-in-out infinite; }
  .fb-prop { fill: var(--color-surface); stroke: var(--color-border-strong); animation: fb-prop 5s ease-in-out infinite; }
  .fb-proplbl { animation: fb-late 5s ease-in-out 0.4s infinite; }
  @keyframes fb-prop { 0%,38% { stroke: var(--color-border-strong) } 50%,100% { stroke: var(--color-node-leaf) } }
  @keyframes fb-late { 0%,40% { opacity: 0.2 } 54%,100% { opacity: 1 } }

  /* EIP-4844 — blob-calldata: copies pile into every block and stay */
  .bc-batch, .bc-tx { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .bc-copy { fill: color-mix(in oklab, var(--color-node-branch) 20%, var(--color-surface)); stroke: var(--color-node-branch); opacity: 0; }
  .s0 .bc-copy { animation: bc-fade 5s ease-out infinite; }
  .s1 .bc-copy { animation: bc-fade 5s ease-out 0.5s infinite; }
  .s2 .bc-copy { animation: bc-fade 5s ease-out 1s infinite; }
  .s3 .bc-copy { animation: bc-fade 5s ease-out 1.5s infinite; }
  @keyframes bc-fade { 0%,4% { opacity: 0 } 14%,100% { opacity: 1 } }

  /* EIP-4844 — blob-sidecar: the blob is bound by a KZG commitment */
  .bs-tx { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .bs-blob { fill: color-mix(in oklab, var(--color-node-branch) 10%, var(--color-surface)); stroke: var(--color-node-branch); }
  .bs-evm { fill: color-mix(in oklab, var(--color-accent) 8%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .bs-evmlink { fill: none; stroke: var(--color-accent-dim); stroke-width: 1.3; stroke-dasharray: 3 3; }
  .bs-a { stroke-dasharray: 100; stroke-dashoffset: 100; animation: bs-draw 5s ease-in-out infinite; }
  @keyframes bs-draw { 0%,18% { stroke-dashoffset: 100 } 42%,100% { stroke-dashoffset: 0 } }
  .bs-kzg { fill: color-mix(in oklab, var(--color-hash) 10%, var(--color-surface)); stroke: var(--color-hash); animation: bs-kzg 5s ease-in-out infinite; }
  @keyframes bs-kzg { 0%,44% { filter: none } 58% { filter: drop-shadow(0 0 7px var(--color-hash)) } 100% { filter: none } }

  /* EIP-4844 — blob-prune: the blob fades after the window; the commitment stays */
  .bp-line, .bp-mark { stroke: var(--color-border-strong); stroke-width: 1.4; }
  .bp-blob { fill: color-mix(in oklab, var(--color-node-branch) 10%, var(--color-surface)); stroke: var(--color-node-branch); animation: bp-blob 6s ease-in-out infinite; }
  @keyframes bp-blob { 0%,42% { opacity: 1 } 58%,100% { opacity: 0.14 } }
  .bp-trash { font-size: 15px; text-anchor: middle; opacity: 0; animation: bp-appear 6s ease-in-out infinite; }
  .bp-pruned { fill: var(--color-changed); opacity: 0; animation: bp-appear 6s ease-in-out infinite; }
  @keyframes bp-appear { 0%,46% { opacity: 0 } 60%,100% { opacity: 1 } }
  .bp-commit { fill: color-mix(in oklab, var(--color-accent) 8%, var(--color-surface)); stroke: var(--color-accent-dim); }

  /* EIP-4844 — blob-fee: over-target blobs appear, then the fee rises a beat later (6s) */
  .bf-slot { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .bf-base { fill: color-mix(in oklab, var(--color-node-leaf) 16%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .bf-surge { fill: color-mix(in oklab, var(--color-changed) 24%, var(--color-surface)); stroke: var(--color-changed); opacity: 0; }
  .bf-surge0 { animation: bf-surge 6s ease-in-out infinite; }
  .bf-surge1 { animation: bf-surge 6s ease-in-out 0.15s infinite; }
  .bf-surge2 { animation: bf-surge 6s ease-in-out 0.3s infinite; }
  @keyframes bf-surge { 0%,42% { opacity: 0 } 48%,72% { opacity: 1 } 78%,100% { opacity: 0 } }
  .bf-spike { opacity: 0; animation: bf-surge 6s ease-in-out infinite; }
  .bf-target { stroke: var(--color-hash); stroke-width: 1.4; stroke-dasharray: 4 3; }
  .bf-tlbl { fill: var(--color-hash); }
  .bf-track { fill: var(--color-surface); stroke: var(--color-border-strong); }
  /* the fee rises AFTER the surge (48%) and falls AFTER it clears (78%) — cause→effect */
  .bf-fill { transform-box: fill-box; transform-origin: left center; animation: bf-fee 6s ease-in-out infinite; }
  @keyframes bf-fee {
    0%,48% { transform: scaleX(0.32); fill: color-mix(in oklab, var(--color-accent) 20%, var(--color-surface)) }
    60%,74% { transform: scaleX(0.88); fill: color-mix(in oklab, var(--color-changed) 34%, var(--color-surface)) }
    88%,100% { transform: scaleX(0.32); fill: color-mix(in oklab, var(--color-accent) 20%, var(--color-surface)) }
  }
  .bf-fee { fill: var(--color-ink-muted); }

  /* shared smart-account op box */
  .au-op { fill: color-mix(in oklab, var(--color-node-extension) 10%, var(--color-surface)); stroke: var(--color-node-extension); }
  .ab-entry { fill: color-mix(in oklab, var(--color-accent) 8%, var(--color-surface)); stroke: var(--color-accent-dim); }

  /* EIP-4337 — aa-eoa: each wish gets rejected (✗) in turn */
  .ae-eoa { fill: color-mix(in oklab, var(--color-accent) 8%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .ae-chip { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .ae-x { fill: var(--color-changed); opacity: 0; }
  .aw0 .ae-x { animation: ae-rej 5s ease-in-out infinite; } .aw1 .ae-x { animation: ae-rej 5s ease-in-out 0.4s infinite; }
  .aw2 .ae-x { animation: ae-rej 5s ease-in-out 0.8s infinite; } .aw3 .ae-x { animation: ae-rej 5s ease-in-out 1.2s infinite; }
  .aw4 .ae-x { animation: ae-rej 5s ease-in-out 1.6s infinite; }
  @keyframes ae-rej { 0%,10% { opacity: 0 } 22%,88% { opacity: 1 } 100% { opacity: 0 } }

  /* EIP-4337 — aa-userop: the op flows into its own mempool */
  .au-acct { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .au-self { fill: none; stroke: var(--color-changed); stroke-width: 1.4; }
  .au-a { stroke-dasharray: 70; stroke-dashoffset: 70; animation: au-draw 5s ease-in-out infinite; }
  @keyframes au-draw { 0%,16% { stroke-dashoffset: 70 } 40%,100% { stroke-dashoffset: 0 } }
  .au-mem { fill: color-mix(in oklab, var(--color-accent) 8%, var(--color-surface)); stroke: var(--color-accent-dim); animation: au-mem 5s ease-in-out infinite; }
  @keyframes au-mem { 0%,46% { filter: none } 60% { filter: drop-shadow(0 0 7px var(--color-accent-dim)) } 100% { filter: none } }
  .au-tmem { fill: var(--color-surface); stroke: var(--color-border); opacity: 0.55; }

  /* EIP-4337 — aa-bundler: 3 UserOps collapse into 1 tx, which travels to EntryPoint (6s) */
  .ab-op { transform-box: fill-box; }
  .ao0 { animation: ab-col0 6s ease-in-out infinite; }
  .ao1 { animation: ab-col1 6s ease-in-out infinite; }
  .ao2 { animation: ab-col2 6s ease-in-out infinite; }
  @keyframes ab-col0 { 0%,8% { opacity: 1; transform: translate(0,0) } 36% { opacity: 1; transform: translate(126px,41px) } 44%,100% { opacity: 0; transform: translate(140px,41px) } }
  @keyframes ab-col1 { 0%,8% { opacity: 1; transform: translate(0,0) } 36% { opacity: 1; transform: translate(126px,1px) } 44%,100% { opacity: 0; transform: translate(140px,1px) } }
  @keyframes ab-col2 { 0%,8% { opacity: 1; transform: translate(0,0) } 36% { opacity: 1; transform: translate(126px,-39px) } 44%,100% { opacity: 0; transform: translate(140px,-39px) } }
  .ab-bundler { fill: color-mix(in oklab, var(--color-node-branch) 10%, var(--color-surface)); stroke: var(--color-node-branch); }
  .ab-batchbox { fill: color-mix(in oklab, var(--color-node-leaf) 16%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .ab-batch { animation: ab-batch 6s ease-in-out infinite; }
  @keyframes ab-batch { 0%,42% { opacity: 0; transform: translateX(0) } 48% { opacity: 1; transform: translateX(0) } 68% { opacity: 1; transform: translateX(120px) } 74%,100% { opacity: 0; transform: translateX(128px) } }
  .ab-exec { opacity: 0; animation: ab-exec 6s ease-in-out infinite; }
  @keyframes ab-exec { 0%,72% { opacity: 0 } 82%,100% { opacity: 1 } }

  /* EIP-4337 — aa-paymaster: arrows settle gas; bundler reimbursed */
  .ap-pm { fill: color-mix(in oklab, var(--color-node-leaf) 10%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .ap-bundler { fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); stroke: var(--color-node-leaf); opacity: 0; animation: ap-late 5.5s ease-in-out infinite; }
  .ap-a1, .ap-a2, .ap-a3 { stroke-dasharray: 80; stroke-dashoffset: 80; }
  .ap-a1 { animation: ap-draw 5.5s ease-out infinite; } .ap-a2 { animation: ap-draw 5.5s ease-out 0.5s infinite; } .ap-a3 { animation: ap-draw 5.5s ease-out 1.4s infinite; }
  @keyframes ap-draw { 0%,10% { stroke-dashoffset: 80 } 30%,100% { stroke-dashoffset: 0 } }
  @keyframes ap-late { 0%,55% { opacity: 0 } 68%,100% { opacity: 1 } }

  /* EIP-7702 — se-migrate: the EOA is abandoned for a new smart account */
  .sm-eoa { fill: var(--color-surface); stroke: var(--color-border-strong); animation: sm-leave 5s ease-in-out infinite; }
  @keyframes sm-leave { 0%,50% { opacity: 1 } 66%,100% { opacity: 0.5 } }
  .sm-mig { stroke-dasharray: 130; stroke-dashoffset: 130; animation: sm-draw 5s ease-in-out infinite; }
  @keyframes sm-draw { 0%,16% { stroke-dashoffset: 130 } 40%,100% { stroke-dashoffset: 0 } }
  .sm-miglbl { fill: var(--color-ink-faint); }
  .sm-new { fill: color-mix(in oklab, var(--color-node-extension) 10%, var(--color-surface)); stroke: var(--color-node-extension); animation: sm-new 5s ease-in-out infinite; }
  @keyframes sm-new { 0%,52% { filter: none } 66% { filter: drop-shadow(0 0 7px var(--color-node-extension)) } 100% { filter: none } }

  /* EIP-7702 — se-delegate: the code field morphs into a pointer */
  .sd-auth { fill: color-mix(in oklab, var(--color-hash) 8%, var(--color-surface)); stroke: var(--color-hash); }
  .sd-eoa { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .sd-deleg { fill: color-mix(in oklab, var(--color-node-branch) 10%, var(--color-surface)); stroke: var(--color-node-branch); }
  .sd-a1 { stroke-dasharray: 32; stroke-dashoffset: 32; animation: sd-draw 5s ease-in-out infinite; }
  .sd-a2 { stroke-dasharray: 60; stroke-dashoffset: 60; animation: sd-draw 5s ease-in-out 0.5s infinite; }
  @keyframes sd-draw { 0%,12% { stroke-dashoffset: 60 } 34%,100% { stroke-dashoffset: 0 } }
  .sd-code0 { fill: var(--color-ink-faint); animation: sd-out 5s ease-in-out infinite; }
  .sd-code1 { fill: var(--color-accent-strong); opacity: 0; animation: sd-in 5s ease-in-out infinite; }
  @keyframes sd-out { 0%,38% { opacity: 1 } 50%,100% { opacity: 0 } }
  @keyframes sd-in { 0%,40% { opacity: 0 } 52%,100% { opacity: 1 } }

  /* EIP-7702 — se-run: the call loads delegate code, runs as the EOA */
  .sr-caller, .sr-eoa { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .sr-deleg { fill: color-mix(in oklab, var(--color-node-branch) 10%, var(--color-surface)); stroke: var(--color-node-branch); }
  .sr-load { fill: var(--color-ink-faint); }
  .sr-a1 { stroke-dasharray: 52; stroke-dashoffset: 52; animation: sr-draw 5s ease-out infinite; }
  .sr-a2 { stroke-dasharray: 52; stroke-dashoffset: 52; animation: sr-draw 5s ease-out 0.5s infinite; }
  @keyframes sr-draw { 0%,12% { stroke-dashoffset: 52 } 34%,100% { stroke-dashoffset: 0 } }
  .sr-as { opacity: 0; animation: sr-as 5s ease-in-out infinite; }
  @keyframes sr-as { 0%,52% { opacity: 0 } 66%,100% { opacity: 1 } }

  /* EIP-7702 — se-powers: the powers light up on the same address */
  .sp-eoa { fill: color-mix(in oklab, var(--color-accent) 8%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .sp-chip { fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .sp-power { opacity: 0; }
  .spw0 { animation: sp-on 5s ease-out infinite; } .spw1 { animation: sp-on 5s ease-out 0.5s infinite; } .spw2 { animation: sp-on 5s ease-out 1s infinite; }
  @keyframes sp-on { 0%,6% { opacity: 0; transform: translateY(-4px) } 20%,90% { opacity: 1; transform: translateY(0) } 100% { opacity: 1 } }

  /* EIP-2718 — tx-onefmt: one rigid format, decoders must guess */
  .to-rlp { fill: color-mix(in oklab, var(--color-hash) 7%, var(--color-surface)); stroke: var(--color-border-strong); }
  .to-rlptext { text-anchor: middle; }
  .to-feat { opacity: 0; }
  .tf0 { animation: to-nudge 5s ease-in-out infinite; }
  .tf1 { animation: to-nudge 5s ease-in-out 0.4s infinite; }
  @keyframes to-nudge { 0%,8% { opacity: 0; transform: translateY(-6px) } 24%,70% { opacity: 1; transform: translateY(0) } 100% { opacity: 0.5; transform: translateY(0) } }
  .to-chip { fill: color-mix(in oklab, var(--color-node-extension) 10%, var(--color-surface)); stroke: var(--color-node-extension); }
  .to-parser { fill: color-mix(in oklab, var(--color-changed) 8%, var(--color-surface)); stroke: var(--color-changed); opacity: 0; animation: to-guess 5s ease-in-out infinite; }
  @keyframes to-guess { 0%,60% { opacity: 0 } 74% { opacity: 1; transform: translateX(2px) } 78% { transform: translateX(-2px) } 82% { transform: translateX(0) } 100% { opacity: 1 } }
  .tx-byte { fill: var(--color-accent-strong); font-family: var(--font-mono); font-size: 16px; text-anchor: middle; font-weight: 600; }

  /* EIP-2718 — tx-typebyte: the byte selects a decoder */
  .tt-byte { fill: color-mix(in oklab, var(--color-accent) 12%, var(--color-surface)); stroke: var(--color-accent); animation: tt-pulse 5s ease-in-out infinite; }
  @keyframes tt-pulse { 0%,20% { filter: none } 34% { filter: drop-shadow(0 0 7px var(--color-accent-dim)) } 50%,100% { filter: none } }
  .tt-pay { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .tt-paytext { text-anchor: middle; }
  .tt-a { stroke-dasharray: 80; stroke-dashoffset: 80; animation: tt-draw 5s ease-in-out infinite; }
  @keyframes tt-draw { 0%,36% { stroke-dashoffset: 80 } 56%,100% { stroke-dashoffset: 0 } }
  .tt-dec { fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); stroke: var(--color-node-leaf); opacity: 0; animation: tt-dec 5s ease-in-out infinite; }
  @keyframes tt-dec { 0%,56% { opacity: 0 } 70%,100% { opacity: 1 } }

  /* EIP-2718 — tx-disambig: a byte axis; typed & legacy ranges can't overlap (6s) */
  .td-zone { stroke-width: 1; }
  .td-typedz { fill: color-mix(in oklab, var(--color-node-leaf) 26%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .td-gapz { fill: color-mix(in oklab, var(--color-border) 35%, transparent); stroke: var(--color-border); stroke-dasharray: 3 2; }
  .td-legacyz { fill: color-mix(in oklab, var(--color-accent) 26%, var(--color-surface)); stroke: var(--color-accent); }
  .td-tl { font-size: 9px; } .td-legacylbl { fill: var(--color-accent-strong); font-family: var(--font-mono); font-size: 9px; }
  .td-gaplbl { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 8.5px; }
  .td-axis { stroke: var(--color-border-strong); stroke-width: 1.2; }
  .td-tick { stroke: var(--color-border-strong); stroke-width: 1.2; }
  .td-num { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 9px; text-anchor: middle; }
  .td-marklbl { fill: var(--color-ink-faint); }
  /* a first byte hops between the two valid zones, never landing in the gap */
  .td-mark { fill: var(--color-accent-strong); animation: td-mark 6s ease-in-out infinite; }
  @keyframes td-mark { 0%,18% { transform: translateX(0) } 34%,58% { transform: translateX(250px) } 74%,100% { transform: translateX(0) } }
  .td-marklbl { animation: td-marklbl 6s ease-in-out infinite; }
  @keyframes td-marklbl { 0%,18% { transform: translateX(0) } 34%,58% { transform: translateX(250px) } 74%,100% { transform: translateX(0) } }

  /* EIP-2718 — tx-family: the registry, one byte per format */
  .tx-row { opacity: 0; }
  .txr0 { animation: tx-in 6s ease-out infinite; }
  .txr1 { animation: tx-in 6s ease-out 0.3s infinite; }
  .txr2 { animation: tx-in 6s ease-out 0.6s infinite; }
  .txr3 { animation: tx-in 6s ease-out 0.9s infinite; }
  .txr4 { animation: tx-in 6s ease-out 1.2s infinite; }
  .txr5 { animation: tx-future 6s ease-out 1.5s infinite; }
  @keyframes tx-in { 0%,4% { opacity: 0; transform: translateX(-10px) } 18%,94% { opacity: 1; transform: translateX(0) } 100% { opacity: 1 } }
  @keyframes tx-future { 0%,24% { opacity: 0 } 38% { opacity: 1 } 62% { opacity: 0.55 } 82% { opacity: 1 } 100% { opacity: 0.7 } }
  .tx-chip { fill: color-mix(in oklab, var(--color-accent) 10%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .tx-name { fill: var(--color-surface); stroke: var(--color-border); }
  .tx-byte3 { fill: var(--color-accent-strong); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; }
  .tx-namelbl { fill: var(--color-ink-muted); }
  .txr5 .tx-chip { stroke-dasharray: 3 2; }
  .txr5 .tx-name { stroke-dasharray: 3 2; }

  /* EIP-155 — r155-replay: one signed tx, valid on every chain */
  .rv-tx { fill: color-mix(in oklab, var(--color-hash) 9%, var(--color-surface)); stroke: var(--color-hash); animation: rv-pulse 6s ease-in-out infinite; }
  @keyframes rv-pulse { 0%,14% { filter: none } 26% { filter: drop-shadow(0 0 7px var(--color-hash)) } 40%,100% { filter: none } }
  .rv-vsig { fill: var(--color-ink-muted); }
  .rv-a1 { stroke-dasharray: 96; stroke-dashoffset: 96; animation: rv-draw 6s ease-in-out infinite; }
  .rv-a2 { stroke-dasharray: 96; stroke-dashoffset: 96; animation: rv-draw 6s ease-in-out 0.3s infinite; }
  @keyframes rv-draw { 0%,20% { stroke-dashoffset: 96 } 42%,100% { stroke-dashoffset: 0 } }
  .rv-chain { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .rv-ok1 { opacity: 0; animation: rv-fin 6s ease-in-out infinite; }
  .rv-ok2 { opacity: 0; animation: rv-fin 6s ease-in-out 0.3s infinite; }
  @keyframes rv-fin { 0%,48% { opacity: 0 } 62%,100% { opacity: 1 } }

  /* EIP-155 — r155-bind: chainId folded into the signed list */
  .rv-list { fill: var(--color-surface); stroke: var(--color-border); }
  .rv-old { opacity: 0.55; }
  .rv-listc { text-anchor: middle; }
  .rv-new { fill: color-mix(in oklab, var(--color-accent) 8%, var(--color-surface)); stroke: var(--color-accent-dim); opacity: 0; animation: rv-newin 6s ease-in-out infinite; }
  .rv-newt { fill: var(--color-accent-strong); opacity: 0; animation: rv-newin 6s ease-in-out infinite; }
  @keyframes rv-newin { 0%,26% { opacity: 0 } 42%,100% { opacity: 1 } }
  .rv-ha { stroke-dasharray: 24; stroke-dashoffset: 24; animation: rv-hadraw 6s ease-in-out infinite; }
  @keyframes rv-hadraw { 0%,46% { stroke-dashoffset: 24 } 60%,100% { stroke-dashoffset: 0 } }
  .rv-hash { fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); stroke: var(--color-node-leaf); opacity: 0; animation: rv-hashin 6s ease-in-out infinite; }
  @keyframes rv-hashin { 0%,56% { opacity: 0 } 70%,100% { opacity: 1 } }

  /* EIP-155 — r155-vencode: a v number line; the two ranges never overlap */
  .rvn-in { fill: color-mix(in oklab, var(--color-accent) 8%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .rvn-int { fill: var(--color-accent-strong); text-anchor: middle; }
  .rvn-arrow { stroke-dasharray: 42; stroke-dashoffset: 42; animation: st-draw 6s ease-in-out infinite; }
  .rvn-out { fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .rvn-outt { text-anchor: middle; }
  .rvn-axis { stroke: var(--color-border-strong); stroke-width: 1.4; }
  .rvn-tick { stroke: var(--color-border-strong); stroke-width: 1.2; }
  .rvn-num { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 10px; text-anchor: middle; }
  .rvn-legacy { fill: color-mix(in oklab, var(--color-node-extension) 30%, var(--color-surface)); stroke: var(--color-node-extension); }
  .rvn-zl { fill: var(--color-node-extension); }
  .rvn-zl2 { fill: var(--color-node-leaf); }
  .rvn-sub { fill: var(--color-ink-faint); }
  .rvn-gap { fill: color-mix(in oklab, var(--color-border) 40%, transparent); stroke: var(--color-border); stroke-dasharray: 3 2; }
  .rvn-gapt { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 8.5px; text-anchor: middle; }
  .rvn-new { fill: color-mix(in oklab, var(--color-node-leaf) 30%, var(--color-surface)); stroke: var(--color-node-leaf); animation: rvn-newpulse 5s ease-in-out infinite; }
  @keyframes rvn-newpulse { 0%,60% { filter: none } 72% { filter: drop-shadow(0 0 7px var(--color-node-leaf)) } 84%,100% { filter: none } }
  .rvn-mark { fill: var(--color-node-leaf); animation: rvn-drop 5s ease-in-out infinite; }
  @keyframes rvn-drop {
    0%,20% { transform: translate(0,0); opacity: 0 }
    30% { opacity: 1 }
    64%,100% { transform: translate(27px, 60px); opacity: 1 }
  }

  /* EIP-155 — r155-reject: replay on the wrong chain fails recovery */
  .rv-tx2 { fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .rv-ra { stroke-dasharray: 120; stroke-dashoffset: 120; animation: rv-radraw 6s ease-in-out infinite; }
  @keyframes rv-radraw { 0%,16% { stroke-dashoffset: 120 } 38%,100% { stroke-dashoffset: 0 } }
  .rv-chain2 { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .rv-verdict { fill: color-mix(in oklab, var(--color-changed) 8%, var(--color-surface)); stroke: var(--color-changed); opacity: 0; animation: rv-vin 6s ease-in-out infinite; }
  .rv-vtext { opacity: 0; animation: rv-vin 6s ease-in-out infinite; }
  @keyframes rv-vin { 0%,52% { opacity: 0 } 66%,100% { opacity: 1 } }

  /* EIP-4895 — wd-stuck: staked ETH trapped on the consensus layer */
  .wd-cl { fill: color-mix(in oklab, var(--color-node-extension) 9%, var(--color-surface)); stroke: var(--color-node-extension); }
  .wd-el { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .wd-bal { animation: wd-pulse 6s ease-in-out infinite; }
  @keyframes wd-pulse { 0%,30% { opacity: 0.6 } 48%,100% { opacity: 1 } }
  .wd-back { stroke-dasharray: 40; stroke-dashoffset: 40; animation: wd-bdraw 6s ease-in-out infinite; }
  @keyframes wd-bdraw { 0%,18% { stroke-dashoffset: 40 } 40%,100% { stroke-dashoffset: 0 } }
  .wd-noback { opacity: 0; animation: wd-nb 6s ease-in-out infinite; }
  @keyframes wd-nb { 0%,44% { opacity: 0 } 58%,100% { opacity: 1 } }
  .wd-bar { stroke: var(--color-changed); stroke-width: 2.4; opacity: 0; animation: wd-nb 6s ease-in-out infinite; }

  /* EIP-4895 — wd-push: the CL pushes a withdrawals list into the block */
  .wd-clbox { fill: color-mix(in oklab, var(--color-node-extension) 9%, var(--color-surface)); stroke: var(--color-node-extension); }
  .wd-pa { stroke-dasharray: 56; stroke-dashoffset: 56; animation: wd-padraw 6s ease-in-out infinite; }
  @keyframes wd-padraw { 0%,16% { stroke-dashoffset: 56 } 36%,100% { stroke-dashoffset: 0 } }
  .wd-palbl { fill: var(--color-ink-faint); }
  .wd-block { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .wd-hdr { fill: color-mix(in oklab, var(--color-hash) 8%, var(--color-surface)); stroke: var(--color-hash); }
  .wd-hdrt { fill: var(--color-ink-muted); }
  .wd-txs { fill: var(--color-surface); stroke: var(--color-border); }
  .wd-sub { fill: var(--color-ink-faint); }
  .wd-wds { fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); stroke: var(--color-node-leaf); opacity: 0; animation: wd-wdin 6s ease-in-out infinite; }
  @keyframes wd-wdin { 0%,40% { opacity: 0 } 56%,100% { opacity: 1 } }

  /* EIP-4895 — wd-credit: just credit the recipient's balance */
  .wd-obj { fill: color-mix(in oklab, var(--color-node-leaf) 7%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .wd-objc { text-anchor: middle; }
  .wd-ca { stroke-dasharray: 56; stroke-dashoffset: 56; animation: wd-cadraw 6s ease-in-out infinite; }
  @keyframes wd-cadraw { 0%,24% { stroke-dashoffset: 56 } 44%,100% { stroke-dashoffset: 0 } }
  .wd-acct { fill: var(--color-surface); stroke: var(--color-border-strong); }
  /* the balance number actually changes: 10.0 → 12.0 when the credit lands (6s) */
  .wd-balcell { fill: var(--color-surface); stroke: var(--color-border); animation: wd-balcell 6s ease-in-out infinite; }
  @keyframes wd-balcell { 0%,44% { stroke: var(--color-border) } 52% { stroke: var(--color-node-leaf) } 66%,100% { stroke: var(--color-border) } }
  .wd-balbefore, .wd-balafter { font-family: var(--font-mono); font-size: 12px; text-anchor: middle; font-weight: 600; }
  .wd-balbefore { fill: var(--color-ink-muted); animation: wd-balbefore 6s ease-in-out infinite; }
  @keyframes wd-balbefore { 0%,44% { opacity: 1 } 50%,100% { opacity: 0 } }
  .wd-balafter { fill: var(--color-node-leaf); opacity: 0; animation: wd-balafter 6s ease-in-out infinite; }
  @keyframes wd-balafter { 0%,46% { opacity: 0 } 54% { opacity: 1; filter: drop-shadow(0 0 5px var(--color-node-leaf)) } 66% { filter: none } 100% { opacity: 1 } }
  .wd-nocall { opacity: 0; animation: wd-nb 6s ease-in-out infinite; }

  /* EIP-4895 — wd-flavors: a sweep cursor skims excess / empties an exit (8s loop) */
  .wf-32line { stroke: var(--color-border-strong); stroke-width: 1; stroke-dasharray: 4 3; }
  .wf-32lbl { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 9px; }
  .wf-base { fill: color-mix(in oklab, var(--color-node-leaf) 30%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .wf-exitbar { fill: color-mix(in oklab, var(--color-node-extension) 26%, var(--color-surface)); stroke: var(--color-node-extension); animation: wf-exit 8s ease-in-out infinite; }
  @keyframes wf-exit { 0%,56% { opacity: 1; transform: translateY(0) } 64% { opacity: 0.5; transform: translateY(-18px) } 72%,96% { opacity: 0; transform: translateY(-28px) } 100% { opacity: 1; transform: translateY(0) } }
  .wf-excess { fill: color-mix(in oklab, var(--color-accent) 40%, var(--color-surface)); stroke: var(--color-accent); }
  .wf-ex0 { animation: wf-skim 8s ease-in-out infinite; animation-delay: 0s; }
  .wf-ex1 { animation: wf-skim 8s ease-in-out infinite; animation-delay: 2s; }
  .wf-ex3 { animation: wf-skim 8s ease-in-out infinite; animation-delay: 6s; }
  @keyframes wf-skim { 0%,4% { opacity: 1; transform: translateY(0) } 10% { opacity: 0.6; transform: translateY(-16px) } 18%,92% { opacity: 0; transform: translateY(-24px) } 100% { opacity: 1; transform: translateY(0) } }
  .wf-vlbl { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 8.5px; text-anchor: middle; }
  .wf-cursor { fill: var(--color-accent-strong); animation: wf-cursor 8s linear infinite; }
  @keyframes wf-cursor { 0% { transform: translateX(0); opacity: 0.9 } 96% { transform: translateX(338px); opacity: 0.9 } 100% { transform: translateX(338px); opacity: 0 } }

  /* EIP-3675 — mg-pow: miners race for a nonce, burning energy */
  .mg-mrect { fill: color-mix(in oklab, var(--color-node-extension) 8%, var(--color-surface)); stroke: var(--color-node-extension); }
  .mgm0 { animation: mg-flick 1.1s ease-in-out infinite; }
  .mgm1 { animation: mg-flick 1.3s ease-in-out infinite; }
  .mgm2 { animation: mg-flick 0.9s ease-in-out infinite; }
  @keyframes mg-flick { 0%,100% { opacity: 1 } 50% { opacity: 0.72 } }
  .mgm1 .mg-mrect { animation: mg-winglow 5s ease-in-out infinite; }
  @keyframes mg-winglow { 0%,60% { filter: none } 74% { filter: drop-shadow(0 0 7px var(--color-node-leaf)); stroke: var(--color-node-leaf) } 100% { filter: none } }
  /* nonce hex churns rapidly — brute-forcing guesses */
  .mg-na, .mg-nb { text-anchor: middle; fill: var(--color-ink-faint); }
  .mg-na { animation: mg-na 0.5s steps(1) infinite; }
  .mg-nb { animation: mg-nb 0.5s steps(1) infinite; }
  @keyframes mg-na { 0%,49% { opacity: 1 } 50%,100% { opacity: 0 } }
  @keyframes mg-nb { 0%,49% { opacity: 0 } 50%,100% { opacity: 1 } }
  /* energy meter climbs and never returns (sawtooth = each new batch of spend) */
  .mg-elbl { fill: var(--color-ink-faint); font-size: 9px; }
  .mg-etrack { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .mg-efill { fill: color-mix(in oklab, var(--color-changed) 42%, var(--color-surface)); transform-box: fill-box; transform-origin: left center; animation: mg-efill 3s linear infinite; }
  @keyframes mg-efill { 0% { transform: scaleX(0.06) } 92% { transform: scaleX(1) } 100% { transform: scaleX(0.06) } }
  .mg-eclimb { animation: mg-en 3s ease-in-out infinite; }
  @keyframes mg-en { 0%,100% { opacity: 0.6 } 50% { opacity: 1 } }
  .mg-win { opacity: 0; animation: mg-winin 5s ease-in-out infinite; }
  @keyframes mg-winin { 0%,62% { opacity: 0 } 76%,100% { opacity: 1 } }

  /* EIP-3675 — mg-parallel: PoS beacon chain alongside the PoW chain */
  .mg-bb { fill: color-mix(in oklab, var(--color-node-leaf) 9%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .mg-pb { fill: color-mix(in oklab, var(--color-node-extension) 9%, var(--color-surface)); stroke: var(--color-node-extension); }
  .mg-link { stroke: var(--color-border-strong); stroke-width: 1.4; fill: none; }
  .mgb3, .mgp3 { opacity: 0; animation: mg-grow 5s ease-in-out infinite; }
  @keyframes mg-grow { 0%,40% { opacity: 0 } 56%,100% { opacity: 1 } }

  /* EIP-3675 — mg-ttd: total difficulty climbs, crosses TTD, triggers handoff (8s) */
  .mg-tdlbl { fill: var(--color-ink-faint); font-size: 9px; }
  .mg-tdtrack { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .mg-tdfill { fill: color-mix(in oklab, var(--color-node-extension) 40%, var(--color-surface)); transform-box: fill-box; transform-origin: left center; animation: mg-tdfill 8s ease-in-out infinite; }
  @keyframes mg-tdfill {
    0%,6% { transform: scaleX(0.06) }
    9% { transform: scaleX(0.20) } 18% { transform: scaleX(0.20) }
    21% { transform: scaleX(0.36) } 30% { transform: scaleX(0.36) }
    33% { transform: scaleX(0.52) } 42% { transform: scaleX(0.52) }
    45% { transform: scaleX(0.66) } 50% { transform: scaleX(0.66) }
    53% { transform: scaleX(0.82); fill: color-mix(in oklab, var(--color-accent) 40%, var(--color-surface)) }
    100% { transform: scaleX(0.82); fill: color-mix(in oklab, var(--color-accent) 40%, var(--color-surface)) }
  }
  .mg-ttdline { stroke: var(--color-changed); stroke-width: 1.6; stroke-dasharray: 3 2; }
  .mg-ttdlbl { fill: var(--color-changed); font-family: var(--font-mono); font-size: 9px; }
  .mg-crossed { opacity: 0; animation: mg-crossed 8s ease-in-out infinite; }
  @keyframes mg-crossed { 0%,53% { opacity: 0 } 60%,92% { opacity: 1 } 100% { opacity: 0 } }
  .mg-handoff { opacity: 0; animation: mg-handoff 8s ease-in-out infinite; }
  @keyframes mg-handoff { 0%,56% { opacity: 0 } 64%,100% { opacity: 1 } }
  .mg-last { fill: color-mix(in oklab, var(--color-node-extension) 9%, var(--color-surface)); stroke: var(--color-node-extension); }
  .mg-first { fill: color-mix(in oklab, var(--color-node-leaf) 9%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .mg-sub { fill: var(--color-ink-faint); }
  .mg-ha2 { stroke-dasharray: 44; stroke-dashoffset: 44; animation: mg-ha2 8s ease-in-out infinite; }
  @keyframes mg-ha2 { 0%,60% { stroke-dashoffset: 44 } 72%,100% { stroke-dashoffset: 0 } }
  .mg-fld { text-anchor: middle; }
  .mg-f0 { opacity: 0; animation: mg-fin 8s ease-in-out infinite; }
  @keyframes mg-fin { 0%,64% { opacity: 0 } 74%,100% { opacity: 1 } }

  /* EIP-3675 — mg-loop: the CL drives the EL over the Engine API */
  .mg-cl { fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .mg-el { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .mg-a1 { stroke-dasharray: 64; stroke-dashoffset: 64; animation: mg-a1draw 5s ease-in-out infinite; }
  .mg-a2 { stroke-dasharray: 64; stroke-dashoffset: 64; animation: mg-a2draw 5s ease-in-out infinite; }
  @keyframes mg-a1draw { 0%,10% { stroke-dashoffset: 64 } 28%,100% { stroke-dashoffset: 0 } }
  @keyframes mg-a2draw { 0%,40% { stroke-dashoffset: 64 } 58%,100% { stroke-dashoffset: 0 } }
  .mg-leg { text-anchor: middle; }
  .mg-l1 { opacity: 0; animation: mg-legin 5s ease-out infinite; }
  .mg-l2 { opacity: 0; animation: mg-legin 5s ease-out 0.3s infinite; }
  .mg-l3 { opacity: 0; animation: mg-legin 5s ease-out 0.6s infinite; }
  @keyframes mg-legin { 0%,30% { opacity: 0 } 46%,100% { opacity: 1 } }

  /* EIP-1153 — ts-persist: a lock on persistent storage is costly */
  .ts-step { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .ts-cost { fill: color-mix(in oklab, var(--color-changed) 7%, var(--color-surface)); stroke: var(--color-changed); animation: ts-costpulse 5s ease-in-out infinite; }
  @keyframes ts-costpulse { 0%,20% { filter: none } 34% { filter: drop-shadow(0 0 6px var(--color-changed)) } 50%,100% { filter: none } }
  .ts-da1, .ts-da2 { stroke-dasharray: 100; stroke-dashoffset: 100; animation: ts-dadraw 5s ease-in-out infinite; }
  .ts-da2 { animation-delay: 0.3s; }
  @keyframes ts-dadraw { 0%,30% { stroke-dashoffset: 100 } 50%,100% { stroke-dashoffset: 0 } }
  .ts-disk { fill: color-mix(in oklab, var(--color-hash) 8%, var(--color-surface)); stroke: var(--color-hash); }
  .ts-forever { animation: ts-en 4s ease-in-out infinite; }
  @keyframes ts-en { 0%,100% { opacity: 0.6 } 50% { opacity: 1 } }

  /* EIP-1153 — ts-scratch: a value crosses the 'tx ends' line; transient is wiped (7s) */
  .ts-bound { stroke: var(--color-changed); stroke-width: 1.4; stroke-dasharray: 4 3; }
  .ts-boundlbl { fill: var(--color-changed); font-family: var(--font-mono); font-size: 9px; }
  .ts-region { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 8.5px; }
  .ts-rowlbl { fill: var(--color-ink-muted); }
  .ts-c { text-anchor: middle; fill: var(--color-accent-strong); }
  .ts-rc { fill: var(--color-ink-faint); font-size: 8px; }
  .ts-tok { fill: color-mix(in oklab, var(--color-accent) 22%, var(--color-surface)); stroke: var(--color-accent); }
  .ts-tokt2 { fill: color-mix(in oklab, var(--color-node-leaf) 22%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .ts-tokt { fill: var(--color-ink); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; font-weight: 600; }
  .ts-pt { animation: ts-pt 7s ease-in-out infinite; }
  @keyframes ts-pt { 0%,8% { opacity: 0; transform: translateX(0) } 14% { opacity: 1; transform: translateX(0) } 78% { opacity: 1; transform: translateX(214px) } 90% { opacity: 1; transform: translateX(214px) } 97%,100% { opacity: 0; transform: translateX(214px) } }
  .ts-tt { animation: ts-tt 7s ease-in-out infinite; }
  @keyframes ts-tt { 0%,8% { opacity: 0; transform: translateX(0) } 14% { opacity: 1; transform: translateX(0) } 48% { opacity: 1; transform: translateX(140px) } 54% { opacity: 0; transform: translateX(140px) } 100% { opacity: 0; transform: translateX(140px) } }
  .ts-survives { opacity: 0; animation: ts-survives 7s ease-in-out infinite; }
  @keyframes ts-survives { 0%,66% { opacity: 0 } 76%,94% { opacity: 1 } 100% { opacity: 0 } }
  .ts-wiped { opacity: 0; animation: ts-wiped 7s ease-in-out infinite; }
  @keyframes ts-wiped { 0%,52% { opacity: 0 } 62%,94% { opacity: 1 } 100% { opacity: 0 } }

  /* EIP-1153 — ts-opcodes: TSTORE in caller, TLOAD in sub-call */
  .ts-caller { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .ts-callee { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .ts-oa { stroke-dasharray: 72; stroke-dashoffset: 72; animation: ts-oadraw 5s ease-in-out infinite; }
  @keyframes ts-oadraw { 0%,24% { stroke-dashoffset: 72 } 44%,100% { stroke-dashoffset: 0 } }
  .ts-oalbl { fill: var(--color-ink-faint); }
  .ts-c2 { opacity: 0; animation: ts-c2in 5s ease-in-out infinite; }
  @keyframes ts-c2in { 0%,50% { opacity: 0 } 64%,100% { opacity: 1 } }
  .ts-gas { fill: var(--color-ink-muted); }

  /* EIP-1153 — ts-revert: rolled back on revert, cleared at tx end */
  .ts-frame { fill: color-mix(in oklab, var(--color-changed) 6%, var(--color-surface)); stroke: var(--color-changed); }
  .ts-frame2 { fill: color-mix(in oklab, var(--color-node-leaf) 6%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .ts-undo { opacity: 0; animation: tsr-undoin 5s ease-in-out infinite; }
  @keyframes tsr-undoin { 0%,56% { opacity: 0 } 64%,100% { opacity: 1 } }
  .ts-cleared { opacity: 0; animation: tsr-clearin 5s ease-in-out infinite; }
  @keyframes tsr-clearin { 0%,72% { opacity: 0 } 80%,100% { opacity: 1 } }
  /* the slot value snaps back (9→5) on revert, and flips to 0 at tx end */
  .tsr-cell { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .tsr-wrote, .tsr-during { fill: var(--color-accent-strong); font-family: var(--font-mono); font-size: 12px; text-anchor: middle; opacity: 0; }
  .tsr-undone, .tsr-zero { font-family: var(--font-mono); font-size: 12px; text-anchor: middle; opacity: 0; }
  .tsr-undone { fill: var(--color-node-leaf); }
  .tsr-zero { fill: var(--color-node-leaf); }
  .tsr-wrote { animation: tsr-wrote 5s ease-in-out infinite; }
  @keyframes tsr-wrote { 0%,20% { opacity: 0 } 28% { opacity: 1 } 50% { opacity: 1 } 56% { opacity: 0 } 100% { opacity: 0 } }
  .tsr-undone { animation: tsr-undone 5s ease-in-out infinite; }
  @keyframes tsr-undone { 0%,54% { opacity: 0 } 60%,100% { opacity: 1 } }
  .tsr-during { animation: tsr-during 5s ease-in-out infinite; }
  @keyframes tsr-during { 0%,20% { opacity: 0 } 28% { opacity: 1 } 66% { opacity: 1 } 72% { opacity: 0 } 100% { opacity: 0 } }
  .tsr-zero { animation: tsr-zero 5s ease-in-out infinite; }
  @keyframes tsr-zero { 0%,70% { opacity: 0 } 76%,100% { opacity: 1 } }

  /* EIP-4788 — br-blind: the EVM is walled off from CL state */
  .br-cl { fill: color-mix(in oklab, var(--color-node-extension) 8%, var(--color-surface)); stroke: var(--color-node-extension); }
  .br-fl { text-anchor: middle; fill: var(--color-ink-muted); }
  .br-wall { stroke: var(--color-border-strong); stroke-width: 2.4; stroke-dasharray: 4 4; }
  .br-el { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .br-want { animation: br-pulse 5s ease-in-out infinite; }
  @keyframes br-pulse { 0%,100% { opacity: 0.6 } 50% { opacity: 1 } }
  .br-oracle { fill: color-mix(in oklab, var(--color-changed) 8%, var(--color-surface)); stroke: var(--color-changed); animation: br-opulse 5s ease-in-out infinite; }
  @keyframes br-opulse { 0%,30% { filter: none } 46% { filter: drop-shadow(0 0 6px var(--color-changed)) } 62%,100% { filter: none } }

  /* EIP-4788 — br-commit: the beacon root is a Merkle root over state */
  .br-root { fill: color-mix(in oklab, var(--color-accent) 12%, var(--color-surface)); stroke: var(--color-accent); }
  .br-n { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .br-leaf { fill: var(--color-surface); stroke: var(--color-border); }
  .br-leafhi { fill: color-mix(in oklab, var(--color-node-leaf) 10%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .br-edge { stroke: var(--color-border); stroke-width: 1.2; fill: none; }
  .br-path { stroke: var(--color-node-leaf); stroke-width: 1.8; fill: none; stroke-dasharray: 200; stroke-dashoffset: 200; animation: br-pdraw 5s ease-in-out infinite; }
  @keyframes br-pdraw { 0%,24% { stroke-dashoffset: 200 } 46%,100% { stroke-dashoffset: 0 } }
  .br-verok { opacity: 0; animation: br-okin 5s ease-in-out infinite; }
  @keyframes br-okin { 0%,52% { opacity: 0 } 66%,100% { opacity: 1 } }

  /* EIP-4788 — br-stamp: per-block system write into the ring buffer */
  .br-hdr { fill: color-mix(in oklab, var(--color-hash) 8%, var(--color-surface)); stroke: var(--color-hash); }
  .br-hdrt { fill: var(--color-ink-muted); }
  .br-sa { stroke-dasharray: 26; stroke-dashoffset: 26; animation: br-sadraw 5s ease-in-out infinite; }
  @keyframes br-sadraw { 0%,20% { stroke-dashoffset: 26 } 40%,100% { stroke-dashoffset: 0 } }
  .br-salbl { fill: var(--color-ink-faint); }
  .br-ring { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .br-ringt { text-anchor: middle; fill: var(--color-ink-muted); }
  .br-cell { fill: color-mix(in oklab, var(--color-hash) 7%, var(--color-surface)); stroke: var(--color-border); }
  .br-cnew { fill: color-mix(in oklab, var(--color-node-leaf) 10%, var(--color-surface)); stroke: var(--color-node-leaf); animation: br-cnewglow 5s ease-in-out infinite; }
  @keyframes br-cnewglow { 0%,40% { filter: none } 56% { filter: drop-shadow(0 0 6px var(--color-node-leaf)) } 72%,100% { filter: none } }

  /* EIP-4788 — br-prove: read the root, verify a Merkle proof */
  .br-ctr { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .br-c { text-anchor: middle; fill: var(--color-accent-strong); }
  .br-pa1 { stroke-dasharray: 80; stroke-dashoffset: 80; animation: br-pa1draw 5s ease-in-out infinite; }
  @keyframes br-pa1draw { 0%,14% { stroke-dashoffset: 80 } 32%,100% { stroke-dashoffset: 0 } }
  .br-pa1l { fill: var(--color-ink-faint); }
  .br-roots { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .br-c2 { opacity: 0; animation: br-c2in 5s ease-in-out infinite; }
  @keyframes br-c2in { 0%,38% { opacity: 0 } 52%,100% { opacity: 1 } }
  .br-pa2 { stroke-dasharray: 28; stroke-dashoffset: 28; animation: br-pa2draw 5s ease-in-out infinite; }
  @keyframes br-pa2draw { 0%,52% { stroke-dashoffset: 28 } 66%,100% { stroke-dashoffset: 0 } }
  .br-verify { fill: color-mix(in oklab, var(--color-node-leaf) 7%, var(--color-surface)); stroke: var(--color-node-leaf); opacity: 0; animation: br-vin 5s ease-in-out infinite; }
  .br-ok { opacity: 0; animation: br-vin 5s ease-in-out infinite; }
  @keyframes br-vin { 0%,62% { opacity: 0 } 76%,100% { opacity: 1 } }

  /* EIP-2929 — ga-flat: flat underpriced access enables a DoS */
  .ga-tx { fill: color-mix(in oklab, var(--color-changed) 7%, var(--color-surface)); stroke: var(--color-changed); }
  .ga-c { text-anchor: middle; fill: var(--color-ink-muted); }
  .ga-fa { stroke-dasharray: 30; stroke-dashoffset: 30; animation: ga-fadraw 3s ease-in-out infinite; }
  @keyframes ga-fadraw { 0%,30% { stroke-dashoffset: 30 } 60%,100% { stroke-dashoffset: 0 } }
  .ga-cellr { fill: color-mix(in oklab, var(--color-hash) 7%, var(--color-surface)); stroke: var(--color-border); }
  .ga-cn { text-anchor: middle; fill: var(--color-ink-faint); }
  .ga-cell { animation: ga-touch 3s ease-in-out infinite; }
  @keyframes ga-touch { 0%,100% { opacity: 0.5 } 50% { opacity: 1 } }
  .ga-dos { animation: ga-en 4s ease-in-out infinite; }
  @keyframes ga-en { 0%,100% { opacity: 0.6 } 50% { opacity: 1 } }

  /* EIP-2929 — ga-raise: charged 2100 vs real cost, the overcharge shown as a red gap (5s) */
  .ga-rlbl { fill: var(--color-ink-muted); }
  .ga-chlbl { fill: var(--color-changed); }
  .ga-charged { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .ga-real { fill: color-mix(in oklab, var(--color-node-leaf) 44%, var(--color-surface)); transform-box: fill-box; transform-origin: left center; }
  .ga-real0 { animation: ga-diskfill 5s ease-in-out infinite; }
  .ga-real1 { animation: ga-cachefill 5s ease-out 0.4s infinite; }
  .ga-real2 { animation: ga-cachefill 5s ease-out 0.8s infinite; }
  @keyframes ga-diskfill { 0% { transform: scaleX(0) } 40% { transform: scaleX(1) } 100% { transform: scaleX(1) } }
  @keyframes ga-cachefill { 0% { transform: scaleX(0) } 8% { transform: scaleX(1) } 100% { transform: scaleX(1) } }
  .ga-over { fill: color-mix(in oklab, var(--color-changed) 44%, var(--color-surface)); opacity: 0; }
  .ga-over1 { animation: ga-overin 5s ease-in-out 0.4s infinite; }
  .ga-over2 { animation: ga-overin 5s ease-in-out 0.8s infinite; }
  @keyframes ga-overin { 0%,16% { opacity: 0 } 30% { opacity: 0.75 } 45% { opacity: 0.4 } 60% { opacity: 0.75 } 100% { opacity: 0.6 } }
  .ga-leg1 { font-size: 9px; } .ga-leg2 { font-size: 9px; }

  /* EIP-2929 — ga-coldwarm: cold first touch, warm repeats, access set */
  .ga-first { fill: color-mix(in oklab, var(--color-changed) 8%, var(--color-surface)); stroke: var(--color-changed); animation: ga-firstp 5s ease-in-out infinite; }
  @keyframes ga-firstp { 0%,24% { filter: none } 36% { filter: drop-shadow(0 0 6px var(--color-changed)) } 50%,100% { filter: none } }
  .ga-warm { fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); stroke: var(--color-node-leaf); opacity: 0; animation: ga-warmin 5s ease-in-out infinite; }
  .ga-warm.gw2 { animation-delay: 0.3s; }
  @keyframes ga-warmin { 0%,36% { opacity: 0 } 52%,100% { opacity: 1 } }
  .ga-set { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-accent-dim); }

  /* EIP-2930 — ga-acl: an access list pre-warms declared entries */
  .ga-acltx { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .ga-aa { stroke-dasharray: 66; stroke-dashoffset: 66; animation: ga-aadraw 5s ease-in-out infinite; }
  @keyframes ga-aadraw { 0%,24% { stroke-dashoffset: 66 } 44%,100% { stroke-dashoffset: 0 } }
  .ga-aal { fill: var(--color-ink-faint); }
  .ga-warmset { fill: color-mix(in oklab, var(--color-node-leaf) 7%, var(--color-surface)); stroke: var(--color-node-leaf); opacity: 0; animation: ga-wsin 5s ease-in-out infinite; }
  @keyframes ga-wsin { 0%,46% { opacity: 0 } 60%,100% { opacity: 1 } }

  /* EIP-7251 — mb-shard: the 32 ETH cap forces many validators */
  .mb-staker { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .mb-c { text-anchor: middle; fill: var(--color-ink-muted); }
  .mb-sa { stroke-dasharray: 36; stroke-dashoffset: 36; animation: mb-sadraw 4s ease-in-out infinite; }
  @keyframes mb-sadraw { 0%,30% { stroke-dashoffset: 36 } 56%,100% { stroke-dashoffset: 0 } }
  .mb-vcell { fill: color-mix(in oklab, var(--color-node-extension) 8%, var(--color-surface)); stroke: var(--color-node-extension); animation: mb-vc 3.5s ease-in-out infinite; }
  @keyframes mb-vc { 0%,100% { opacity: 0.55 } 50% { opacity: 1 } }
  .mb-vt { text-anchor: middle; fill: var(--color-ink-faint); }
  .mb-load { animation: mb-en 4s ease-in-out infinite; }
  @keyframes mb-en { 0%,100% { opacity: 0.6 } 50% { opacity: 1 } }

  /* EIP-7251 — mb-raise: the earning bar grows 32 → 2048 in one motion (5s) */
  .mb-track { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .mb-grow { fill: color-mix(in oklab, var(--color-node-leaf) 30%, var(--color-surface)); transform-box: fill-box; transform-origin: left center; animation: mb-grow 5s ease-in-out infinite; }
  @keyframes mb-grow { 0%,15% { transform: scaleX(0.12) } 60%,100% { transform: scaleX(1) } }
  .mb-32mark { stroke: var(--color-node-extension); stroke-width: 1.4; stroke-dasharray: 3 2; }
  .mb-32lbl { fill: var(--color-node-extension); }
  .mb-2048lbl { opacity: 0; animation: mb-2048in 5s ease-in-out infinite; }
  @keyframes mb-2048in { 0%,55% { opacity: 0 } 68%,100% { opacity: 1 } }

  /* EIP-7251 — mb-consolidate: merge small validators into one */
  .mb-small { fill: color-mix(in oklab, var(--color-node-extension) 8%, var(--color-surface)); stroke: var(--color-node-extension); }
  .mb-ca { stroke-dasharray: 200; stroke-dashoffset: 200; animation: mb-cadraw 5s ease-in-out infinite; }
  @keyframes mb-cadraw { 0%,24% { stroke-dashoffset: 200 } 46%,100% { stroke-dashoffset: 0 } }
  .mb-req { fill: var(--color-ink-faint); }
  .mb-big { fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); stroke: var(--color-node-leaf); opacity: 0; animation: mb-bigin 5s ease-in-out infinite; }
  @keyframes mb-bigin { 0%,40% { opacity: 0 } 56%,100% { opacity: 1 } }

  /* EIP-7251 — mb-payoff: fewer validators, compounding, opt-in floor */
  .mb-ben { fill: color-mix(in oklab, var(--color-accent) 6%, var(--color-surface)); stroke: var(--color-accent-dim); opacity: 0; }
  .mbb0 { animation: mb-benin 5s ease-out infinite; }
  .mbb1 { animation: mb-benin 5s ease-out 0.3s infinite; }
  .mbb2 { animation: mb-benin 5s ease-out 0.6s infinite; }
  @keyframes mb-benin { 0%,10% { opacity: 0; transform: translateY(-4px) } 26%,94% { opacity: 1; transform: translateY(0) } 100% { opacity: 1 } }

  /* ── EVM — evm-why: a fixed action becomes a program ── */
  .ev-fixed { fill: color-mix(in oklab, var(--color-hash) 8%, var(--color-surface)); stroke: var(--color-border-strong); }
  .ev-cc { text-anchor: middle; fill: var(--color-ink-muted); }
  .ev-rigid { animation: ev-pulse 5s ease-in-out infinite; }
  @keyframes ev-pulse { 0%,100% { opacity: 0.55 } 50% { opacity: 1 } }
  .ev-morph { stroke-dasharray: 54; stroke-dashoffset: 54; animation: ev-mdraw 5s ease-in-out infinite; }
  @keyframes ev-mdraw { 0%,24% { stroke-dashoffset: 54 } 46%,100% { stroke-dashoffset: 0 } }
  .ev-ml { fill: var(--color-ink-faint); }
  .ev-prog { fill: color-mix(in oklab, var(--color-accent) 8%, var(--color-surface)); stroke: var(--color-accent-dim); opacity: 0; animation: ev-progin 5s ease-in-out infinite; }
  @keyframes ev-progin { 0%,30% { opacity: 0 } 46%,100% { opacity: 1 } }
  .ev-op { fill: var(--color-accent-strong); text-anchor: start; opacity: 0; }
  .evo0 { animation: ev-opin 5s ease-out infinite; }
  .evo1 { animation: ev-opin 5s ease-out 0.2s infinite; }
  .evo2 { animation: ev-opin 5s ease-out 0.4s infinite; }
  @keyframes ev-opin { 0%,40% { opacity: 0 } 56%,100% { opacity: 1 } }
  .ev-free { fill: var(--color-node-leaf); opacity: 0; animation: ev-progin 5s ease-in-out infinite; }

  /* ── EVM — evm-stack: the stack machine executes (2+3)×4 ── */
  .ev-op-cap { fill: var(--color-accent-strong); font-family: var(--font-mono); font-size: 11px; font-weight: 600; opacity: 0; }
  .ec0 { animation: evm-p0 13s infinite; }
  .ec1 { animation: evm-p1 13s infinite; }
  .ec2 { animation: evm-p2 13s infinite; }
  .ec3 { animation: evm-p3 13s infinite; }
  .ec4 { animation: evm-p4 13s infinite; }
  @keyframes evm-p0 { 0% { opacity: 0 } 2% { opacity: 1 } 18% { opacity: 1 } 21% { opacity: 0 } 100% { opacity: 0 } }
  @keyframes evm-p1 { 0%,21% { opacity: 0 } 23% { opacity: 1 } 38% { opacity: 1 } 41% { opacity: 0 } 100% { opacity: 0 } }
  @keyframes evm-p2 { 0%,41% { opacity: 0 } 43% { opacity: 1 } 58% { opacity: 1 } 61% { opacity: 0 } 100% { opacity: 0 } }
  @keyframes evm-p3 { 0%,61% { opacity: 0 } 63% { opacity: 1 } 78% { opacity: 1 } 81% { opacity: 0 } 100% { opacity: 0 } }
  @keyframes evm-p4 { 0%,81% { opacity: 0 } 83% { opacity: 1 } 98% { opacity: 1 } 100% { opacity: 0 } }
  .ev-hex { fill: var(--color-ink-faint); text-anchor: start; }
  .ev-asm { fill: var(--color-ink-muted); text-anchor: start; }
  .ev-iprow { fill: color-mix(in oklab, var(--color-accent) 20%, var(--color-surface)); stroke: var(--color-accent); opacity: 0; }
  .ev-ph0 { animation: evm-p0 13s infinite; }
  .ev-ph1 { animation: evm-p1 13s infinite; }
  .ev-ph2 { animation: evm-p2 13s infinite; }
  .ev-ph3 { animation: evm-p3 13s infinite; }
  .ev-ph4 { animation: evm-p4 13s infinite; }
  .ev-slot { fill: none; stroke: var(--color-border); stroke-dasharray: 3 3; }
  .ev-base { stroke: var(--color-border-strong); stroke-width: 2; }
  .ev-toplbl { fill: var(--color-ink-faint); }
  .ev-cell { transform-box: fill-box; transform-origin: center; }
  .ev-cell rect { fill: color-mix(in oklab, var(--color-node-extension) 14%, var(--color-surface)); stroke: var(--color-node-extension); }
  .ev-cell text { fill: var(--color-ink); font-family: var(--font-mono); font-size: 13px; text-anchor: middle; font-weight: 600; }
  .ev-res rect { fill: color-mix(in oklab, var(--color-node-leaf) 16%, var(--color-surface)); stroke: var(--color-node-leaf); filter: drop-shadow(0 0 5px color-mix(in oklab, var(--color-node-leaf) 55%, transparent)); }
  .ev-c2 { animation: evm-c2 13s infinite; }
  .ev-c3 { animation: evm-c3 13s infinite; }
  .ev-c5 { animation: evm-c5 13s infinite; }
  .ev-c4 { animation: evm-c4 13s infinite; }
  .ev-c20 { animation: evm-c20 13s infinite; }
  @keyframes evm-c2 { 0% { opacity: 0; transform: scale(0.5) } 3% { opacity: 1; transform: scale(1) } 40% { opacity: 1; transform: scale(1) } 44% { opacity: 0; transform: scale(0.9) } 100% { opacity: 0 } }
  @keyframes evm-c3 { 0%,20% { opacity: 0; transform: scale(0.5) } 24% { opacity: 1; transform: scale(1) } 40% { opacity: 1 } 44% { opacity: 0; transform: scale(0.9) } 100% { opacity: 0 } }
  @keyframes evm-c5 { 0%,42% { opacity: 0; transform: scale(0.5) } 47% { opacity: 1; transform: scale(1) } 80% { opacity: 1 } 84% { opacity: 0; transform: scale(0.9) } 100% { opacity: 0 } }
  @keyframes evm-c4 { 0%,60% { opacity: 0; transform: scale(0.5) } 64% { opacity: 1; transform: scale(1) } 80% { opacity: 1 } 84% { opacity: 0; transform: scale(0.9) } 100% { opacity: 0 } }
  @keyframes evm-c20 { 0%,82% { opacity: 0; transform: scale(0.5) } 87% { opacity: 1; transform: scale(1) } 100% { opacity: 1 } }
  .ev-final { opacity: 0; animation: evm-final 13s infinite; }
  @keyframes evm-final { 0%,82% { opacity: 0 } 88% { opacity: 1 } 100% { opacity: 1 } }

  /* ── EVM — evm-gas: pay per step, bound the run ── */
  .ev-gtrack { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .ev-gfill { fill: color-mix(in oklab, var(--color-node-leaf) 40%, var(--color-surface)); transform-box: fill-box; transform-origin: left center; animation: ev-drain 6s ease-in-out infinite; }
  @keyframes ev-drain {
    0%,8% { transform: scaleX(1); fill: color-mix(in oklab, var(--color-node-leaf) 40%, var(--color-surface)) }
    20%,26% { transform: scaleX(0.9) }
    36%,42% { transform: scaleX(0.8) }
    52%,58% { transform: scaleX(0.72); fill: color-mix(in oklab, var(--color-accent) 30%, var(--color-surface)) }
    70%,100% { transform: scaleX(0.14); fill: color-mix(in oklab, var(--color-changed) 45%, var(--color-surface)) }
  }
  .ev-gremain { fill: var(--color-ink-muted); }
  .ev-tick line { stroke: var(--color-border-strong); stroke-width: 1.4; }
  .ev-tick { opacity: 0.3; }
  .ev-tk0 { animation: ev-tick 6s ease-out infinite; }
  .ev-tk1 { animation: ev-tick 6s ease-out 0.9s infinite; }
  .ev-tk2 { animation: ev-tick 6s ease-out 1.8s infinite; }
  .ev-tk3 { animation: ev-tick 6s ease-out 3s infinite; }
  @keyframes ev-tick { 0% { opacity: 0.3 } 12% { opacity: 1 } 100% { opacity: 0.5 } }
  .ev-halt { opacity: 0; animation: ev-halt 6s ease-in-out infinite; }
  @keyframes ev-halt { 0%,68% { opacity: 0 } 80% { opacity: 1 } 100% { opacity: 1 } }

  /* ── EVM — evm-regions: a call fills stack/memory then ends; storage survives ── */
  .ev-reg { fill: var(--color-surface); }
  .ev-rstack { stroke: var(--color-node-leaf); }
  .ev-rmem { stroke: var(--color-accent-dim); }
  .ev-rstore { stroke: var(--color-hash); }
  .ev-subm { fill: var(--color-ink-faint); text-anchor: middle; }
  .ev-cheap { fill: var(--color-node-leaf); }
  .ev-exp { fill: var(--color-changed); }
  .ev-disk { fill: color-mix(in oklab, var(--color-hash) 16%, var(--color-surface)); stroke: var(--color-hash); }
  .ev-diskbody { fill: color-mix(in oklab, var(--color-hash) 10%, var(--color-surface)); stroke: var(--color-hash); }
  /* phase captions cycle: run → end → next call (9s loop) */
  .ev-ph { fill: var(--color-accent-strong); font-family: var(--font-mono); font-size: 9.5px; opacity: 0; }
  .ev-phA { animation: ev-phA 9s ease-in-out infinite; }
  .ev-phB { animation: ev-phB 9s ease-in-out infinite; }
  .ev-phC { animation: ev-phC 9s ease-in-out infinite; }
  @keyframes ev-phA { 0% { opacity: 0 } 4% { opacity: 1 } 34% { opacity: 1 } 39% { opacity: 0 } 100% { opacity: 0 } }
  @keyframes ev-phB { 0%,39% { opacity: 0 } 43% { opacity: 1 } 51% { opacity: 1 } 55% { opacity: 0 } 100% { opacity: 0 } }
  @keyframes ev-phC { 0%,55% { opacity: 0 } 59% { opacity: 1 } 90% { opacity: 1 } 95% { opacity: 0 } 100% { opacity: 0 } }
  /* ephemeral stack/memory cells: fill during the call, wiped when it ends */
  .ev-eph { fill: color-mix(in oklab, var(--color-node-leaf) 14%, var(--color-surface)); stroke: var(--color-node-leaf); opacity: 0; animation: ev-eph 9s ease-in-out infinite; }
  .ev-byte { fill: color-mix(in oklab, var(--color-accent) 14%, var(--color-surface)); stroke: var(--color-accent-dim); }
  @keyframes ev-eph { 0% { opacity: 0 } 8% { opacity: 1 } 39% { opacity: 1 } 49% { opacity: 0 } 100% { opacity: 0 } }
  /* persistent storage cell: written during the call, survives across calls */
  .ev-persist { fill: color-mix(in oklab, var(--color-hash) 22%, var(--color-surface)); stroke: var(--color-hash); opacity: 0; animation: ev-persist 9s ease-in-out infinite; }
  .ev-persistval { fill: var(--color-ink); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; font-weight: 600; opacity: 0; animation: ev-persist 9s ease-in-out infinite; }
  @keyframes ev-persist { 0%,12% { opacity: 0 } 20% { opacity: 1; filter: drop-shadow(0 0 6px var(--color-hash)) } 28% { filter: none } 100% { opacity: 1 } }

  /* ── State — st-fingerprint: world state → one root, tamper flips it ── */
  .st-acct rect { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .st-aa { fill: var(--color-ink-muted); text-anchor: start; }
  .st-av { fill: var(--color-ink-faint); }
  .st-tamper rect { animation: st-tamp 6s ease-in-out infinite; }
  .st-avt { animation: st-tampv 6s ease-in-out infinite; }
  @keyframes st-tamp { 0%,54% { stroke: var(--color-border-strong) } 64%,88% { stroke: var(--color-changed) } 100% { stroke: var(--color-border-strong) } }
  @keyframes st-tampv { 0%,54% { fill: var(--color-ink-faint) } 64%,88% { fill: var(--color-changed) } 100% { fill: var(--color-ink-faint) } }
  .st-a1 { stroke-dasharray: 52; stroke-dashoffset: 52; animation: st-draw 6s ease-in-out infinite; }
  .st-a2 { stroke-dasharray: 52; stroke-dashoffset: 52; animation: st-draw 6s ease-in-out 0.3s infinite; }
  @keyframes st-draw { 0%,10% { stroke-dashoffset: 52 } 30%,100% { stroke-dashoffset: 0 } }
  .st-hash { fill: color-mix(in oklab, var(--color-hash) 10%, var(--color-surface)); stroke: var(--color-hash); }
  .st-root { fill: color-mix(in oklab, var(--color-accent) 10%, var(--color-surface)); stroke: var(--color-accent); }
  .st-roothex { font-family: var(--font-mono); font-size: 11px; text-anchor: middle; }
  /* the root hex literally flips to a different value when a leaf is tampered (6s) */
  .st-rootorig { fill: var(--color-accent-strong); animation: st-rootorig 6s ease-in-out infinite; }
  @keyframes st-rootorig { 0%,58% { opacity: 1 } 65%,88% { opacity: 0 } 94%,100% { opacity: 1 } }
  .st-roottamp { fill: var(--color-changed); opacity: 0; animation: st-roottamp 6s ease-in-out infinite; }
  @keyframes st-roottamp { 0%,60% { opacity: 0 } 66%,88% { opacity: 1 } 93%,100% { opacity: 0 } }
  .st-flip { opacity: 0; animation: st-flip 6s ease-in-out infinite; }
  @keyframes st-flip { 0%,56% { opacity: 0 } 66%,90% { opacity: 1 } 100% { opacity: 0 } }

  /* ── State — st-nodes: the three node types ── */
  .st-ext { fill: color-mix(in oklab, var(--color-node-extension) 12%, var(--color-surface)); stroke: var(--color-node-extension); }
  .st-branch { fill: color-mix(in oklab, var(--color-node-branch) 10%, var(--color-surface)); stroke: var(--color-node-branch); }
  .st-leaf { fill: color-mix(in oklab, var(--color-node-leaf) 12%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .st-nn { fill: var(--color-ink-muted); text-anchor: middle; }
  .st-sub2 { fill: var(--color-ink-faint); }
  .st-slot { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .st-hot { fill: color-mix(in oklab, var(--color-node-branch) 45%, var(--color-surface)); stroke: var(--color-node-branch); animation: st-hot 4s ease-in-out infinite; }
  @keyframes st-hot { 0%,100% { opacity: 0.7 } 50% { opacity: 1 } }
  .st-e1 { stroke-dasharray: 48; stroke-dashoffset: 48; animation: st-draw 5s ease-in-out infinite; }
  .st-e2 { stroke-dasharray: 48; stroke-dashoffset: 48; animation: st-draw 5s ease-in-out 0.4s infinite; }
  /* nibble chips light as the walk consumes them (9s loop) */
  .st-nib { fill: color-mix(in oklab, var(--color-accent) 12%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .st-nibt { fill: var(--color-accent-strong); font-family: var(--font-mono); font-size: 10px; text-anchor: middle; }
  .st-nib0 { animation: st-nib0 9s ease-in-out infinite; }
  .st-nib1 { animation: st-nib1 9s ease-in-out infinite; }
  .st-nib2 { animation: st-nib2 9s ease-in-out infinite; }
  @keyframes st-nib0 { 0%,4% { opacity: 0.35 } 8%,100% { opacity: 1 } }
  @keyframes st-nib1 { 0%,16% { opacity: 0.35 } 20%,100% { opacity: 1 } }
  @keyframes st-nib2 { 0%,28% { opacity: 0.35 } 32%,100% { opacity: 1 } }
  /* each node glows twice: on the way down (walk) and on the way up (hash) */
  .st-gl-ext { animation: st-gl-ext 9s ease-in-out infinite; }
  .st-gl-branch { animation: st-gl-branch 9s ease-in-out infinite; }
  .st-gl-leaf { animation: st-gl-leaf 9s ease-in-out infinite; }
  @keyframes st-gl-ext { 0%,2% { filter: none } 8% { filter: drop-shadow(0 0 7px var(--color-node-extension)) } 14%,64% { filter: none } 70% { filter: drop-shadow(0 0 7px var(--color-node-extension)) } 76%,100% { filter: none } }
  @keyframes st-gl-branch { 0%,14% { filter: none } 20% { filter: drop-shadow(0 0 7px var(--color-node-branch)) } 26%,54% { filter: none } 60% { filter: drop-shadow(0 0 7px var(--color-node-branch)) } 66%,100% { filter: none } }
  @keyframes st-gl-leaf { 0%,26% { filter: none } 32% { filter: drop-shadow(0 0 7px var(--color-node-leaf)) } 38%,44% { filter: none } 50% { filter: drop-shadow(0 0 7px var(--color-node-leaf)) } 56%,100% { filter: none } }
  .st-up { opacity: 0; animation: st-up 9s ease-in-out infinite; }
  @keyframes st-up { 0%,42% { opacity: 0 } 50%,76% { opacity: 1 } 84%,100% { opacity: 0 } }

  /* ── State — st-header: roots → header → chained blocks ── */
  .st-hdr { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .st-hf { fill: var(--color-ink-muted); text-anchor: start; font-size: 8.5px; }
  .st-hfhot { fill: var(--color-accent-strong); animation: st-hfhot 5s ease-in-out infinite; }
  @keyframes st-hfhot { 0%,100% { opacity: 0.7 } 50% { opacity: 1 } }
  .st-ha { stroke-dasharray: 44; stroke-dashoffset: 44; animation: st-draw 5s ease-in-out infinite; }
  .st-bh { fill: color-mix(in oklab, var(--color-hash) 10%, var(--color-surface)); stroke: var(--color-hash); }
  /* tamper cascade: a past root goes red, then each later block's hash breaks in sequence (8s loop) */
  .st-tamplbl { opacity: 0; animation: st-tamplbl 8s ease-in-out infinite; }
  @keyframes st-tamplbl { 0%,18% { opacity: 0 } 24%,72% { opacity: 1 } 84%,100% { opacity: 0 } }
  .st-cblock { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .st-cb0 { animation: st-casc 8s ease-in-out infinite; }
  .st-cb1 { animation: st-casc 8s ease-in-out infinite; animation-delay: 0.9s; }
  .st-cb2 { animation: st-casc 8s ease-in-out infinite; animation-delay: 1.8s; }
  @keyframes st-casc {
    0%,22% { stroke: var(--color-border-strong); fill: var(--color-surface) }
    30%,74% { stroke: var(--color-changed); fill: color-mix(in oklab, var(--color-changed) 8%, var(--color-surface)) }
    86%,100% { stroke: var(--color-border-strong); fill: var(--color-surface) }
  }
  .st-sr { fill: var(--color-ink-muted); }
  .st-sr0 { animation: st-srred 8s ease-in-out infinite; }
  .st-sr1 { animation: st-srred 8s ease-in-out infinite; animation-delay: 0.9s; }
  .st-sr2 { animation: st-srred 8s ease-in-out infinite; animation-delay: 1.8s; }
  @keyframes st-srred { 0%,22% { fill: var(--color-ink-muted) } 30%,74% { fill: var(--color-changed) } 86%,100% { fill: var(--color-ink-muted) } }
  .st-clink { stroke: var(--color-border-strong); }
  .st-cl0 { animation: st-linkbreak 8s ease-in-out infinite; animation-delay: 0.5s; }
  .st-cl1 { animation: st-linkbreak 8s ease-in-out infinite; animation-delay: 1.4s; }
  @keyframes st-linkbreak { 0%,26% { stroke: var(--color-border-strong) } 34%,74% { stroke: var(--color-changed) } 86%,100% { stroke: var(--color-border-strong) } }
  .st-break { fill: var(--color-changed); font-size: 12px; opacity: 0; }
  .st-brk0 { animation: st-brk 8s ease-in-out infinite; animation-delay: 0.5s; }
  .st-brk1 { animation: st-brk 8s ease-in-out infinite; animation-delay: 1.4s; }
  @keyframes st-brk { 0%,28% { opacity: 0 } 36%,74% { opacity: 1 } 84%,100% { opacity: 0 } }

  /* ── DELEGATECALL — dc-copy: duplication vs shared library ── */
  .dc-copybox rect { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .dc-dup { fill: var(--color-changed); text-anchor: end; animation: dc-dup 4s ease-in-out infinite; }
  @keyframes dc-dup { 0%,100% { opacity: 0.55 } 50% { opacity: 1 } }
  .dc-waste { animation: dc-dup 4s ease-in-out infinite; }
  .dc-a1 { stroke-dasharray: 50; stroke-dashoffset: 50; animation: st-draw 5s ease-in-out infinite; }
  .dc-thin { fill: color-mix(in oklab, var(--color-accent) 8%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .dc-share { stroke-dasharray: 48; stroke-dashoffset: 48; animation: st-draw 5s ease-in-out 0.3s infinite; }
  .dc-lib { fill: color-mix(in oklab, var(--color-node-branch) 12%, var(--color-surface)); stroke: var(--color-node-branch); }
  .dc-libt { fill: var(--color-accent-strong); text-anchor: middle; }

  /* ── DELEGATECALL — dc-call: write lands in the library ── */
  .dc-you { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .dc-you2 { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .dc-libbox { fill: color-mix(in oklab, var(--color-node-branch) 9%, var(--color-surface)); stroke: var(--color-node-branch); }
  .dc-libsub { fill: var(--color-ink-faint); }
  .dc-slot { stroke-width: 1; }
  .dc-slott, .dc-slott2, .dc-slott3 { text-anchor: middle; fill: var(--color-ink-muted); }
  .dc-empty { fill: var(--color-surface); stroke: var(--color-border); }
  .dc-wrote { fill: color-mix(in oklab, var(--color-changed) 16%, var(--color-surface)); stroke: var(--color-changed); animation: dc-wrote 5s ease-in-out infinite; }
  @keyframes dc-wrote { 0%,40% { opacity: 0.4 } 55%,100% { opacity: 1 } }
  .dc-unchanged { opacity: 0; animation: dc-late 5s ease-in-out infinite; }
  @keyframes dc-late { 0%,55% { opacity: 0 } 68%,100% { opacity: 1 } }
  .dc-c1 { stroke-dasharray: 92; stroke-dashoffset: 92; animation: st-draw 5s ease-in-out infinite; }
  .dc-cl, .dc-dl, .dc-dl2 { fill: var(--color-ink-faint); }

  /* ── DELEGATECALL — dc-delegate: write lands in your storage ── */
  .dc-wrote2 { fill: color-mix(in oklab, var(--color-node-leaf) 16%, var(--color-surface)); stroke: var(--color-node-leaf); animation: dc-wrote 5s ease-in-out infinite; }
  .dc-keep { opacity: 0; animation: dc-late 5s ease-in-out infinite; }
  .dc-keep2 { fill: var(--color-ink-faint); text-anchor: middle; }
  .dc-d1 { stroke-dasharray: 86; stroke-dashoffset: 86; animation: st-draw 5s ease-in-out infinite; }
  .dc-d2 { stroke-dasharray: 86; stroke-dashoffset: 86; animation: st-draw 5s ease-in-out 0.4s infinite; }

  /* ── DELEGATECALL — dc-proxy: upgradeable pattern ── */
  .dc-proxybox { fill: color-mix(in oklab, var(--color-accent) 8%, var(--color-surface)); stroke: var(--color-accent); }
  .dc-p1 { stroke-dasharray: 88; stroke-dashoffset: 88; animation: st-draw 5s ease-in-out infinite; }
  .dc-impl { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .dc-implold { animation: dc-old 6s ease-in-out infinite; }
  @keyframes dc-old { 0%,45% { opacity: 1 } 60%,100% { opacity: 0.4 } }
  .dc-implnew { animation: dc-new 6s ease-in-out infinite; }
  @keyframes dc-new { 0%,45% { opacity: 0.4; stroke: var(--color-border-strong) } 60%,100% { opacity: 1; stroke: var(--color-node-leaf) } }
  .dc-upg { opacity: 0; animation: dc-late 6s ease-in-out infinite; }
  .dc-anc { fill: var(--color-ink-faint); }

  /* ── Tangerine Whistle — tw-underpriced: cheap-but-heavy opcodes ── */
  .tw-oprow { fill: var(--color-surface); stroke: var(--color-border); }
  .tw-op { fill: var(--color-accent-strong); text-anchor: start; }
  .tw-price { fill: var(--color-node-leaf); text-anchor: start; }
  .tw-real { fill: var(--color-ink-faint); text-anchor: start; }
  .tw-atk { fill: color-mix(in oklab, var(--color-changed) 8%, var(--color-surface)); stroke: var(--color-changed); }
  .tw-atkt { fill: var(--color-ink-muted); text-anchor: middle; }
  .tw-nodetrack { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .tw-nodefill { fill: color-mix(in oklab, var(--color-changed) 40%, var(--color-surface)); transform-box: fill-box; transform-origin: left center; animation: tw-crawl 5s linear infinite; }
  @keyframes tw-crawl { 0% { transform: scaleX(0.04) } 100% { transform: scaleX(1) } }
  .tw-stall { animation: dc-dup 3s ease-in-out infinite; }

  /* ── Tangerine Whistle — tw-reprice: each price bar grows old → real cost (5s) ── */
  @keyframes tw-rowin { 0%,8% { opacity: 0 } 24%,100% { opacity: 1 } }  /* kept: used by rev-revert */
  .tw-bef { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 10px; }
  .tw-barbg { fill: var(--color-surface); stroke: var(--color-border); }
  .tw-bar { fill: color-mix(in oklab, var(--color-node-leaf) 42%, var(--color-surface)); transform-box: fill-box; transform-origin: left center; animation: tw-grow 5s ease-out infinite; }
  .tw-bar0 { animation-delay: 0s; } .tw-bar1 { animation-delay: 0.2s; } .tw-bar2 { animation-delay: 0.4s; } .tw-bar3 { animation-delay: 0.6s; }
  @keyframes tw-grow { 0%,10% { transform: scaleX(var(--frac)) } 55%,100% { transform: scaleX(1) } }
  .tw-aft { fill: var(--color-node-leaf); font-family: var(--font-mono); font-size: 10px; opacity: 0; }
  .tw-aft0 { animation: tw-aftin 5s ease-out infinite; } .tw-aft1 { animation: tw-aftin 5s ease-out 0.2s infinite; }
  .tw-aft2 { animation: tw-aftin 5s ease-out 0.4s infinite; } .tw-aft3 { animation: tw-aftin 5s ease-out 0.6s infinite; }
  @keyframes tw-aftin { 0%,46% { opacity: 0 } 58%,100% { opacity: 1 } }

  /* ── Tangerine Whistle — tw-6364: gas splits, 63/64 drains, 1/64 survives (6s) ── */
  .tw-glbl { fill: var(--color-ink-faint); }
  .tw-gbg { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .tw-fwdchunk { fill: color-mix(in oklab, var(--color-accent) 34%, var(--color-surface)); transform-box: fill-box; transform-origin: left center; animation: tw-drain 6s ease-in-out infinite; }
  @keyframes tw-drain { 0%,22% { transform: scaleX(1); fill: color-mix(in oklab, var(--color-accent) 34%, var(--color-surface)) } 58%,100% { transform: scaleX(0.01); fill: color-mix(in oklab, var(--color-changed) 40%, var(--color-surface)) } }
  .tw-sliver { fill: color-mix(in oklab, var(--color-node-leaf) 40%, var(--color-surface)); stroke: var(--color-node-leaf); animation: tw-slivglow 6s ease-in-out infinite; }
  @keyframes tw-slivglow { 0%,58% { filter: none } 68% { filter: drop-shadow(0 0 6px var(--color-node-leaf)) } 80%,100% { filter: none } }
  .tw-fwdlbl { fill: var(--color-ink-muted); }
  .tw-slivlbl { fill: var(--color-node-leaf); font-size: 8px; }
  .tw-fwd2 { stroke-dasharray: 22; stroke-dashoffset: 22; animation: st-draw 6s ease-in-out infinite; }
  .tw-slivarrow { stroke-dasharray: 22; stroke-dashoffset: 22; animation: st-draw 6s ease-in-out infinite; }
  .tw-callee2 { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .tw-recv { fill: var(--color-ink-muted); animation: tw-recv 6s ease-in-out infinite; }
  @keyframes tw-recv { 0%,45% { opacity: 1 } 55%,100% { opacity: 0 } }
  .tw-burned { fill: var(--color-changed); opacity: 0; animation: tw-burned 6s ease-in-out infinite; }
  @keyframes tw-burned { 0%,50% { opacity: 0 } 60%,100% { opacity: 1 } }
  .tw-survive { opacity: 0; animation: tw-survive 6s ease-in-out infinite; }
  .tw-handle2 { opacity: 0; animation: tw-survive 6s ease-in-out infinite; }
  @keyframes tw-survive { 0%,60% { opacity: 0 } 72%,100% { opacity: 1 } }

  /* ── REVERT — rev-throw: throw burns all gas, silent ── */
  .rv-txbox { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .rv-cc { text-anchor: middle; fill: var(--color-accent-strong); }
  .rv-a { stroke-dasharray: 60; stroke-dashoffset: 60; animation: st-draw 5s ease-in-out infinite; }
  .rv-fail { fill: var(--color-changed); font-size: 13px; text-anchor: middle; }
  .rv-throwbox { fill: color-mix(in oklab, var(--color-changed) 8%, var(--color-surface)); stroke: var(--color-changed); }
  .rv-throwt { fill: var(--color-ink-muted); text-anchor: middle; }
  .rv-gtrack { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .rv-gburn { fill: color-mix(in oklab, var(--color-node-leaf) 34%, var(--color-surface)); transform-box: fill-box; transform-origin: left center; animation: rv-burn 5s ease-in-out infinite; }
  @keyframes rv-burn { 0%,30% { transform: scaleX(1); fill: color-mix(in oklab, var(--color-node-leaf) 34%, var(--color-surface)) } 55%,100% { transform: scaleX(0.02); fill: var(--color-changed) } }
  .rv-burn { opacity: 0; animation: dc-late 5s ease-in-out infinite; }

  /* ── REVERT — rev-revert: undo, refund, return ── */
  .rv-op { fill: color-mix(in oklab, var(--color-accent) 12%, var(--color-surface)); stroke: var(--color-accent); animation: tt-pulse 5s ease-in-out infinite; }
  .rv-b1, .rv-b2, .rv-b3 { stroke-dasharray: 130; stroke-dashoffset: 130; animation: st-draw 5s ease-in-out infinite; }
  .rv-b2 { animation-delay: 0.2s; } .rv-b3 { animation-delay: 0.4s; }
  .rv-eff { fill: var(--color-surface); stroke: var(--color-node-leaf); opacity: 0; }
  .rv-e1 { animation: tw-rowin 5s ease-out infinite; }
  .rv-e2 { animation: tw-rowin 5s ease-out 0.25s infinite; }
  .rv-e3 { animation: tw-rowin 5s ease-out 0.5s infinite; }
  .rv-sub { fill: var(--color-ink-faint); }
  /* the three effects, enacted (5s loop, synced to the boxes' tw-rowin) */
  .rvr-cell { fill: var(--color-surface); stroke: var(--color-border-strong); animation: rvr-cellflash 5s ease-in-out infinite; }
  @keyframes rvr-cellflash { 0%,50% { stroke: var(--color-border-strong) } 58% { stroke: var(--color-node-leaf) } 72%,100% { stroke: var(--color-border-strong) } }
  .rvr-changed { fill: var(--color-changed); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; opacity: 0; animation: rvr-changed 5s ease-in-out infinite; }
  @keyframes rvr-changed { 0%,20% { opacity: 0 } 26% { opacity: 1 } 44% { opacity: 1 } 52% { opacity: 0 } 100% { opacity: 0 } }
  .rvr-restored { fill: var(--color-node-leaf); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; opacity: 0; animation: rvr-restored 5s ease-in-out infinite; }
  @keyframes rvr-restored { 0%,50% { opacity: 0 } 58%,100% { opacity: 1 } }
  .rvr-gbg { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .rvr-gfull { fill: color-mix(in oklab, var(--color-node-leaf) 40%, var(--color-surface)); animation: rvr-gfull 5s ease-in-out infinite; }
  @keyframes rvr-gfull { 0%,30% { filter: none } 45% { filter: drop-shadow(0 0 6px var(--color-node-leaf)) } 60%,100% { filter: none } }
  .rvr-blob { fill: var(--color-accent-strong); font-family: var(--font-mono); font-size: 10px; text-anchor: middle; opacity: 0; animation: rvr-blob 5s ease-in-out infinite; }
  @keyframes rvr-blob { 0%,28% { opacity: 0; transform: translateY(6px) } 42% { opacity: 1; transform: translateY(0) } 74% { opacity: 1; transform: translateY(-7px) } 88%,100% { opacity: 0; transform: translateY(-11px) } }

  /* ── REVERT — rev-catch: catchable sub-call revert ── */
  .rv-caller { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .rv-callee2 { fill: color-mix(in oklab, var(--color-changed) 7%, var(--color-surface)); stroke: var(--color-changed); }
  .rv-c1 { stroke-dasharray: 132; stroke-dashoffset: 132; animation: st-draw 5s ease-in-out infinite; }
  .rv-c2 { stroke-dasharray: 132; stroke-dashoffset: 132; animation: st-draw 5s ease-in-out 0.4s infinite; }
  .rv-cl { fill: var(--color-ink-faint); }
  .rv-cl2 { fill: var(--color-changed); }
  .rv-catchl { opacity: 0; animation: dc-late 5s ease-in-out infinite; }

  /* ── CREATE2 — cr-nonce: the address keeps changing with the nonce ── */
  .cr-dep { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .cr-nonceval { text-anchor: middle; fill: var(--color-changed); animation: cr-tick 1.5s ease-in-out infinite; }
  @keyframes cr-tick { 0%,100% { opacity: 0.6 } 50% { opacity: 1 } }
  .cr-kec { fill: color-mix(in oklab, var(--color-hash) 10%, var(--color-surface)); stroke: var(--color-hash); }
  .cr-a1, .cr-a2 { stroke-dasharray: 54; stroke-dashoffset: 54; animation: st-draw 4s ease-in-out infinite; }
  .cr-addr { text-anchor: middle; opacity: 0; }
  .cr-addr0 { animation: cr-cyc0 1.5s steps(1) infinite; }
  .cr-addr1 { animation: cr-cyc1 1.5s steps(1) infinite; }
  .cr-addr2 { animation: cr-cyc2 1.5s steps(1) infinite; }
  @keyframes cr-cyc0 { 0%,32% { opacity: 1 } 34%,100% { opacity: 0 } }
  @keyframes cr-cyc1 { 0%,33% { opacity: 0 } 34%,65% { opacity: 1 } 67%,100% { opacity: 0 } }
  @keyframes cr-cyc2 { 0%,66% { opacity: 0 } 67%,99% { opacity: 1 } 100% { opacity: 0 } }
  .cr-unknow { animation: cr-tick 3s ease-in-out infinite; }

  /* ── CREATE2 — cr-create2: deterministic inputs → one stable address ── */
  .cr-in rect { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .cr-in { opacity: 0; }
  .cr-in0 { animation: cr-inin 5s ease-out infinite; }
  .cr-in1 { animation: cr-inin 5s ease-out 0.2s infinite; }
  .cr-in2 { animation: cr-inin 5s ease-out 0.4s infinite; }
  @keyframes cr-inin { 0%,6% { opacity: 0 } 20%,100% { opacity: 1 } }
  .cr-inv { text-anchor: middle; fill: var(--color-accent-strong); }
  .cr-b1, .cr-b2, .cr-b3 { stroke-dasharray: 80; stroke-dashoffset: 80; animation: cr-bdraw 5s ease-in-out infinite; }
  .cr-b2 { animation-delay: 0.2s; } .cr-b3 { animation-delay: 0.4s; }
  @keyframes cr-bdraw { 0%,30% { stroke-dashoffset: 80 } 50%,100% { stroke-dashoffset: 0 } }
  .cr-b4 { stroke-dasharray: 52; stroke-dashoffset: 52; animation: cr-bdraw 5s ease-in-out 0.5s infinite; }
  .cr-det { fill: color-mix(in oklab, var(--color-node-leaf) 12%, var(--color-surface)); stroke: var(--color-node-leaf); opacity: 0; animation: cr-detin 5s ease-in-out infinite; }
  .cr-detaddr { text-anchor: middle; opacity: 0; animation: cr-detin 5s ease-in-out infinite; }
  @keyframes cr-detin { 0%,58% { opacity: 0 } 70% { opacity: 1; filter: drop-shadow(0 0 5px var(--color-node-leaf)) } 80% { filter: none } 100% { opacity: 1 } }
  .cr-now { opacity: 0; animation: cr-detin 5s ease-in-out infinite; }

  /* ── CREATE2 — cr-counterfactual: address known → funded → deployed (6s) ── */
  .cr-slot { fill: color-mix(in oklab, var(--color-accent) 4%, var(--color-surface)); stroke: var(--color-accent-dim); stroke-dasharray: 5 3; }
  .cr-slotaddr { text-anchor: middle; }
  .cr-s1, .cr-s1b { opacity: 0; animation: cr-p1 6s ease-in-out infinite; }
  @keyframes cr-p1 { 0%,6% { opacity: 0 } 16%,100% { opacity: 1 } }
  .cr-s2, .cr-s2b { opacity: 0; animation: cr-p2 6s ease-in-out infinite; }
  @keyframes cr-p2 { 0%,34% { opacity: 0 } 44%,100% { opacity: 1 } }
  .cr-deployed { fill: color-mix(in oklab, var(--color-node-leaf) 18%, var(--color-surface)); stroke: var(--color-node-leaf); opacity: 0; animation: cr-p3 6s ease-in-out infinite; }
  .cr-s3 { opacity: 0; animation: cr-p3 6s ease-in-out infinite; }
  @keyframes cr-p3 { 0%,62% { opacity: 0 } 74% { opacity: 1; filter: drop-shadow(0 0 5px var(--color-node-leaf)) } 84% { filter: none } 100% { opacity: 1 } }

  /* ── CHAINID — ci-replay: a contract signature replays across chains ── */
  .ci-msg { fill: color-mix(in oklab, var(--color-hash) 9%, var(--color-surface)); stroke: var(--color-hash); animation: rv-pulse 6s ease-in-out infinite; }
  .ci-sig { text-anchor: middle; fill: var(--color-ink-muted); }
  .ci-ra1 { stroke-dasharray: 96; stroke-dashoffset: 96; animation: rv-draw 6s ease-in-out infinite; }
  .ci-ra2 { stroke-dasharray: 96; stroke-dashoffset: 96; animation: rv-draw 6s ease-in-out 0.3s infinite; }
  .ci-chain { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .ci-ok1 { opacity: 0; animation: rv-fin 6s ease-in-out infinite; }
  .ci-ok2 { opacity: 0; animation: rv-fin 6s ease-in-out 0.3s infinite; }

  /* ── CHAINID — ci-domain: read the chain id, fold into the domain ── */
  .ci-op { fill: color-mix(in oklab, var(--color-accent) 12%, var(--color-surface)); stroke: var(--color-accent); animation: tt-pulse 5s ease-in-out infinite; }
  .ci-opv { text-anchor: middle; fill: var(--color-accent-strong); }
  .ci-da { stroke-dasharray: 56; stroke-dashoffset: 56; animation: st-draw 5s ease-in-out infinite; }
  .ci-da2 { stroke-dasharray: 28; stroke-dashoffset: 28; animation: st-draw 5s ease-in-out 0.4s infinite; }
  .ci-dom { fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); stroke: var(--color-node-leaf); opacity: 0; animation: cr-detin 5s ease-in-out infinite; }
  .ci-domt { text-anchor: middle; fill: var(--color-node-leaf); }
  .ci-signed { fill: color-mix(in oklab, var(--color-node-leaf) 6%, var(--color-surface)); stroke: var(--color-node-leaf); opacity: 0; animation: ci-signedin 5s ease-in-out infinite; }
  .ci-signedt { opacity: 0; animation: ci-signedin 5s ease-in-out infinite; }
  @keyframes ci-signedin { 0%,58% { opacity: 0 } 70%,100% { opacity: 1 } }

  /* ── CHAINID — ci-split: different ids on each chain → reject the cross ── */
  .ci-good { animation: ci-goodglow 6s ease-in-out infinite; }
  @keyframes ci-goodglow { 0%,50% { stroke: var(--color-border-strong) } 62%,86% { stroke: var(--color-node-leaf) } 100% { stroke: var(--color-border-strong) } }
  .ci-bad { animation: ci-badglow 6s ease-in-out infinite; }
  @keyframes ci-badglow { 0%,50% { stroke: var(--color-border-strong) } 62%,86% { stroke: var(--color-changed) } 100% { stroke: var(--color-border-strong) } }
  .ci-cmt { text-anchor: middle; fill: var(--color-ink-faint); }

  /* ── EIP-3529 — rf-gastoken: fill slots cheap, clear them for a refund (5s) ── */
  .rf-cheap { fill: color-mix(in oklab, var(--color-node-leaf) 6%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .rf-dear { fill: color-mix(in oklab, var(--color-changed) 6%, var(--color-surface)); stroke: var(--color-changed); }
  .rf-ct { text-anchor: middle; fill: var(--color-ink-faint); }
  .rf-slot { stroke-width: 1; }
  .rf-fill { fill: var(--color-surface); stroke: var(--color-node-leaf); animation: rf-fill 5s ease-in-out infinite; }
  @keyframes rf-fill { 0%,8% { fill: var(--color-surface) } 20%,100% { fill: color-mix(in oklab, var(--color-node-leaf) 34%, var(--color-surface)) } }
  .rf-clear { fill: color-mix(in oklab, var(--color-changed) 30%, var(--color-surface)); stroke: var(--color-changed); animation: rf-clear 5s ease-in-out infinite; }
  @keyframes rf-clear { 0%,50% { fill: color-mix(in oklab, var(--color-changed) 30%, var(--color-surface)) } 66%,100% { fill: var(--color-surface) } }
  .rf-ga { stroke-dasharray: 40; stroke-dashoffset: 40; animation: st-draw 5s ease-in-out infinite; }
  .rf-refund { opacity: 0; animation: dc-late 5s ease-in-out infinite; }
  .rf-2x { animation: mg-en 4s ease-in-out infinite; }

  /* ── EIP-3529 — rf-reduce: before/after table ── */
  .rf-colh { fill: var(--color-ink-faint); }
  .rf-rrow { opacity: 0; animation: tw-rowin 5s ease-out infinite; }
  .rf-rl { fill: var(--color-ink-muted); }
  .rf-bef { fill: var(--color-ink-faint); }
  .rf-aft { fill: var(--color-node-leaf); }
  .rf-zero { fill: var(--color-changed); }
  .rf-ra { stroke-dasharray: 60; stroke-dashoffset: 60; animation: tw-updraw 5s ease-out infinite; }
  @keyframes tw-updraw { 0%,14% { stroke-dashoffset: 60 } 42%,100% { stroke-dashoffset: 0 } }

  /* ── EIP-3529 — rf-cap: block work bounded near the limit (5s) ── */
  .rf-limit { stroke: var(--color-hash); stroke-width: 1.4; stroke-dasharray: 3 2; }
  .rf-limitlbl { fill: var(--color-hash); font-family: var(--font-mono); font-size: 9px; }
  .rf-wl { fill: var(--color-ink-faint); }
  .rf-wtrack { fill: var(--color-surface); stroke: var(--color-border); }
  .rf-wbefore { fill: color-mix(in oklab, var(--color-changed) 34%, var(--color-surface)); transform-box: fill-box; transform-origin: left center; animation: rf-wbefore 5s ease-in-out infinite; }
  @keyframes rf-wbefore { 0%,20% { transform: scaleX(0.4) } 55%,100% { transform: scaleX(1) } }
  .rf-2xlbl { opacity: 0; animation: dc-late 5s ease-in-out infinite; }
  .rf-wafter { fill: color-mix(in oklab, var(--color-node-leaf) 34%, var(--color-surface)); transform-box: fill-box; transform-origin: left center; animation: rf-wafter 5s ease-in-out infinite; }
  @keyframes rf-wafter { 0%,20% { transform: scaleX(0.4) } 55%,100% { transform: scaleX(0.44) } }
  .rf-okcap { opacity: 0; animation: dc-late 5s ease-in-out infinite; }
  .rf-token { opacity: 0; animation: dc-late 5s ease-in-out infinite; }

  /* ── EIP-3541 — ef-nomark: every byte is already an opcode ── */
  .ef-byte { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .ef-first { fill: color-mix(in oklab, var(--color-accent) 12%, var(--color-surface)); stroke: var(--color-accent); animation: tt-pulse 4s ease-in-out infinite; }
  .ef-hex { fill: var(--color-accent-strong); font-family: var(--font-mono); font-size: 13px; text-anchor: middle; }
  .ef-op { fill: var(--color-ink-faint); text-anchor: middle; }
  .ef-q { animation: mg-en 3.5s ease-in-out infinite; }

  /* ── EIP-3541 — ef-reserve: reject new 0xEF code ── */
  .ef-deploy { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .ef-bad { stroke: var(--color-changed); animation: ci-badglow 5s ease-in-out infinite; }
  .ef-ok { stroke: var(--color-node-leaf); }
  .ef-rej { animation: rv-pulse 5s ease-in-out infinite; }
  .ef-reserved { opacity: 0; animation: dc-late 5s ease-in-out infinite; }

  /* ── EIP-3541 — ef-unlock: 0xEF prefixes future formats ── */
  .ef-prefix { fill: color-mix(in oklab, var(--color-accent) 12%, var(--color-surface)); stroke: var(--color-accent); animation: tt-pulse 5s ease-in-out infinite; }
  .ef-u1 { stroke-dasharray: 100; stroke-dashoffset: 100; animation: st-draw 5s ease-in-out infinite; }
  .ef-u2 { stroke-dasharray: 100; stroke-dashoffset: 100; animation: st-draw 5s ease-in-out 0.3s infinite; }
  .ef-use { fill: var(--color-surface); stroke: var(--color-border-strong); opacity: 0; }
  .ef-use0 { animation: tw-rowin 5s ease-out infinite; }
  .ef-use1 { animation: tw-rowin 5s ease-out 0.3s infinite; }
  .ef-uc { text-anchor: middle; fill: var(--color-accent-strong); }

  /* ── EIP-3855 — p0-hacks: the old ways to push zero ── */
  .p0-way { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .p0-code { text-anchor: middle; fill: var(--color-accent-strong); }
  .p0-cost { text-anchor: middle; }
  .p0-cost2 { text-anchor: middle; fill: var(--color-ink-muted); }
  .p0-note { text-anchor: middle; fill: var(--color-ink-faint); }
  .p0-both { opacity: 0; animation: dc-late 5s ease-in-out infinite; }

  /* ── EIP-3855 — p0-opcode: PUSH0 puts 0 on the stack ── */
  .p0-op { fill: color-mix(in oklab, var(--color-accent) 12%, var(--color-surface)); stroke: var(--color-accent); animation: tt-pulse 5s ease-in-out infinite; }
  .p0-opsub { text-anchor: middle; fill: var(--color-accent-strong); }
  .p0-a { stroke-dasharray: 84; stroke-dashoffset: 84; animation: st-draw 5s ease-in-out infinite; }
  .p0-stackslot { fill: none; stroke: var(--color-border); stroke-dasharray: 3 3; }
  .p0-cell { transform-box: fill-box; transform-origin: center; opacity: 0; animation: p0-cell 5s ease-in-out infinite; }
  .p0-cell rect { fill: color-mix(in oklab, var(--color-node-leaf) 16%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .p0-cell text { fill: var(--color-ink); font-family: var(--font-mono); font-size: 13px; text-anchor: middle; font-weight: 600; }
  @keyframes p0-cell { 0%,40% { opacity: 0; transform: scale(0.5) } 55% { opacity: 1; transform: scale(1) } 100% { opacity: 1; transform: scale(1) } }
  .p0-spec { opacity: 0; animation: dc-late 5s ease-in-out infinite; }

  /* ── EIP-3855 — p0-savings: smaller bytecode (5s) ── */
  .p0-bl { fill: var(--color-ink-faint); }
  .p0-track { fill: var(--color-surface); stroke: var(--color-border); }
  .p0-bar { transform-box: fill-box; transform-origin: left center; }
  .p0-barbefore { fill: color-mix(in oklab, var(--color-changed) 30%, var(--color-surface)); }
  .p0-barafter { fill: color-mix(in oklab, var(--color-node-leaf) 34%, var(--color-surface)); animation: p0-shrink 5s ease-in-out infinite; }
  @keyframes p0-shrink { 0%,20% { transform: scaleX(1) } 55%,100% { transform: scaleX(0.62) } }
  .p0-blbl { fill: var(--color-ink-muted); }
  .p0-albl { animation: p0-albl 5s ease-in-out infinite; }
  @keyframes p0-albl { 0%,20% { opacity: 0.5 } 55%,100% { opacity: 1 } }
  .p0-save { opacity: 0; animation: dc-late 5s ease-in-out infinite; }

  /* ── EIP-6780 — sd-danger: SELFDESTRUCT enabled metamorphic contracts ── */
  .sd-c { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .sd-c0 { stroke: var(--color-node-leaf); }
  .sd-c1 { fill: color-mix(in oklab, var(--color-changed) 8%, var(--color-surface)); stroke: var(--color-changed); opacity: 0; animation: dc-late 6s ease-in-out infinite; }
  .sd-addr { text-anchor: middle; fill: var(--color-ink-faint); }
  .sd-a1 { stroke-dasharray: 52; stroke-dashoffset: 52; animation: st-draw 6s ease-in-out infinite; }
  .sd-a2 { stroke-dasharray: 52; stroke-dashoffset: 52; animation: st-draw 6s ease-in-out 0.4s infinite; }
  .sd-sdl, .sd-c2l { fill: var(--color-ink-faint); }
  .sd-empty { fill: color-mix(in oklab, var(--color-border) 20%, transparent); stroke: var(--color-border); stroke-dasharray: 3 2; }
  .sd-wiped { text-anchor: middle; animation: rv-pulse 6s ease-in-out infinite; }
  .sd-meta { opacity: 0; animation: dc-late 6s ease-in-out infinite; }

  /* ── EIP-6780 — sd-restrict: full delete only in the creating tx ── */
  .sd-case { fill: var(--color-surface); }
  .sd-same { stroke: var(--color-node-leaf); }
  .sd-later { stroke: var(--color-accent-dim); }
  .sd-cok { opacity: 0; animation: dc-late 5s ease-in-out infinite; }
  .sd-clater { opacity: 0; animation: dc-late 5s ease-in-out 0.2s infinite; }
  .sd-cn { text-anchor: middle; }
  .sd-cn2 { text-anchor: middle; fill: var(--color-ink-faint); }

  /* ── EIP-6780 — sd-result: metamorphic dead, state simplified ── */
  .sd-stays { stroke: var(--color-node-leaf); opacity: 0; animation: dc-late 5s ease-in-out infinite; }
  .sd-r1 { stroke-dasharray: 76; stroke-dashoffset: 76; animation: st-draw 5s ease-in-out infinite; }
  .sd-nometa { opacity: 0; animation: dc-late 5s ease-in-out infinite; }
  .sd-simpl { opacity: 0; animation: dc-late 5s ease-in-out 0.3s infinite; }

  /* ── EIP-196/197 — zk-cost: pairing in bytecode blows past the gas limit ── */
  .zk-proof { fill: color-mix(in oklab, var(--color-hash) 9%, var(--color-surface)); stroke: var(--color-hash); }
  .zk-pc { text-anchor: middle; fill: var(--color-ink-muted); }
  .zk-a1 { stroke-dasharray: 52; stroke-dashoffset: 52; animation: st-draw 5s ease-in-out infinite; }
  .zk-bytecode { fill: color-mix(in oklab, var(--color-changed) 8%, var(--color-surface)); stroke: var(--color-changed); }
  .zk-gtrack { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .zk-gfill { fill: color-mix(in oklab, var(--color-changed) 40%, var(--color-surface)); transform-box: fill-box; transform-origin: left center; animation: zk-explode 4s ease-in-out infinite; }
  @keyframes zk-explode { 0% { transform: scaleX(0.05) } 90%,100% { transform: scaleX(1) } }
  .zk-limit { stroke: var(--color-hash); stroke-width: 1.4; stroke-dasharray: 3 2; }
  .zk-limitlbl { fill: var(--color-hash); font-family: var(--font-mono); font-size: 9px; }
  .zk-explode { animation: mg-en 4s ease-in-out infinite; }

  /* ── EIP-196/197 — zk-precompile: native math at reserved addresses ── */
  .zk-ctr { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .zk-call { text-anchor: middle; fill: var(--color-accent-strong); }
  .zk-a2 { stroke-dasharray: 66; stroke-dashoffset: 66; animation: st-draw 5s ease-in-out infinite; }
  .zk-al { fill: var(--color-ink-faint); }
  .zk-pre { fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .zk-pt { text-anchor: middle; fill: var(--color-accent-strong); }
  .zk-native { text-anchor: middle; }
  .zk-plist { fill: var(--color-ink-muted); }
  .zk-verify { opacity: 0; animation: dc-late 5s ease-in-out infinite; }

  /* ── EIP-196/197 — zk-unlock: privacy & zk-rollups ── */
  .zk-prefix2 { fill: color-mix(in oklab, var(--color-node-leaf) 12%, var(--color-surface)); stroke: var(--color-node-leaf); animation: tt-pulse 5s ease-in-out infinite; }
  .zk-u1 { stroke-dasharray: 100; stroke-dashoffset: 100; animation: st-draw 5s ease-in-out infinite; }
  .zk-u2 { stroke-dasharray: 100; stroke-dashoffset: 100; animation: st-draw 5s ease-in-out 0.3s infinite; }
  .zk-use { fill: var(--color-surface); stroke: var(--color-border-strong); opacity: 0; }
  .zk-use0 { animation: tw-rowin 5s ease-out infinite; }
  .zk-use1 { animation: tw-rowin 5s ease-out 0.3s infinite; }
  .zk-uc { text-anchor: middle; fill: var(--color-ink-faint); }

  /* ── EIP-214 — stc-danger: a CALL to read lets the callee do anything ── */
  .stc-you { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .stc-c { text-anchor: middle; fill: var(--color-accent-strong); }
  .stc-a1 { stroke-dasharray: 112; stroke-dashoffset: 112; animation: st-draw 5s ease-in-out infinite; }
  .stc-a2 { stroke-dasharray: 112; stroke-dashoffset: 112; stroke: var(--color-changed); animation: st-draw 5s ease-in-out 0.4s infinite; }
  .stc-al { fill: var(--color-ink-faint); }
  .stc-al2 { fill: var(--color-changed); }
  .stc-callee { fill: color-mix(in oklab, var(--color-changed) 7%, var(--color-surface)); stroke: var(--color-changed); }
  .stc-bad { text-anchor: middle; }
  .stc-danger2 { opacity: 0; animation: dc-late 5s ease-in-out infinite; }

  /* ── EIP-214 — stc-static: read-only frame, writes revert ── */
  .stc-sa { stroke-dasharray: 112; stroke-dashoffset: 112; animation: st-draw 5s ease-in-out infinite; }
  .stc-frame { fill: color-mix(in oklab, var(--color-node-leaf) 7%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .stc-ok { text-anchor: middle; }
  .stc-forbid { text-anchor: middle; animation: rv-pulse 5s ease-in-out infinite; }
  .stc-sub { text-anchor: middle; fill: var(--color-ink-faint); }
  .stc-guar { opacity: 0; animation: dc-late 5s ease-in-out infinite; }

  /* ── EIP-214 — stc-use: safe reads / view / reentrancy ── */
  .stc-card rect { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .stc-card { opacity: 0; }
  .stc-card0 { animation: tw-rowin 5s ease-out infinite; }
  .stc-card1 { animation: tw-rowin 5s ease-out 0.2s infinite; }
  .stc-card2 { animation: tw-rowin 5s ease-out 0.4s infinite; }
  .stc-cardsub { text-anchor: middle; fill: var(--color-ink-faint); }

  /* ── Altair — sc-heavy: too many validators for a light client ── */
  .sc-lc { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .sc-lcsub { text-anchor: middle; fill: var(--color-ink-faint); }
  .sc-a1 { stroke-dasharray: 66; stroke-dashoffset: 66; animation: st-draw 5s ease-in-out infinite; }
  .sc-vset { fill: color-mix(in oklab, var(--color-node-extension) 7%, var(--color-surface)); stroke: var(--color-node-extension); }
  .sc-vdot { fill: color-mix(in oklab, var(--color-node-extension) 30%, var(--color-surface)); stroke: var(--color-node-extension); animation: sc-vdot 3s ease-in-out infinite; }
  @keyframes sc-vdot { 0%,100% { opacity: 0.4 } 50% { opacity: 1 } }
  .sc-heavy2 { text-anchor: middle; }
  .sc-trust { opacity: 0; animation: dc-late 5s ease-in-out infinite; }

  /* ── Altair — sc-committee: a sampled committee signs ── */
  .sc-pool { fill: var(--color-surface); stroke: var(--color-node-extension); }
  .sc-pdot { fill: color-mix(in oklab, var(--color-node-extension) 20%, var(--color-surface)); stroke: var(--color-node-extension); }
  .sc-picked { fill: color-mix(in oklab, var(--color-accent) 40%, var(--color-surface)); stroke: var(--color-accent); animation: sc-picked 4s ease-in-out infinite; }
  @keyframes sc-picked { 0%,100% { opacity: 0.7 } 50% { opacity: 1 } }
  .sc-a2 { stroke-dasharray: 58; stroke-dashoffset: 58; animation: st-draw 5s ease-in-out infinite; }
  .sc-al { fill: var(--color-ink-faint); }
  .sc-comm { fill: color-mix(in oklab, var(--color-accent) 8%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .sc-sign { text-anchor: middle; }
  .sc-sigbox { fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); stroke: var(--color-node-leaf); opacity: 0; animation: cr-detin 5s ease-in-out infinite; }
  .sc-agg { text-anchor: middle; opacity: 0; animation: cr-detin 5s ease-in-out infinite; }
  .sc-cheap { opacity: 0; animation: dc-late 5s ease-in-out infinite; }

  /* ── Altair — sc-handoff: hop period to period ── */
  .sc-period { fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .sc-p1 { opacity: 0; animation: tw-rowin 6s ease-out 0.4s infinite; }
  .sc-p2 { opacity: 0; animation: tw-rowin 6s ease-out 0.9s infinite; }
  .sc-psub { text-anchor: middle; fill: var(--color-ink-faint); }
  .sc-h0 { stroke-dasharray: 52; stroke-dashoffset: 52; animation: st-draw 6s ease-in-out 0.2s infinite; }
  .sc-h1 { stroke-dasharray: 52; stroke-dashoffset: 52; animation: st-draw 6s ease-in-out 0.7s infinite; }
  .sc-hlbl { fill: var(--color-ink-faint); }
  .sc-boot { opacity: 0; animation: dc-late 6s ease-in-out infinite; }
  .sc-caveat { fill: var(--color-ink-faint); }

  /* ── EIP-2028 — cd-cost: calldata was the dominant rollup cost ── */
  .cd-l2 { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .cd-c { text-anchor: middle; fill: var(--color-ink-muted); }
  .cd-a1 { stroke-dasharray: 64; stroke-dashoffset: 64; animation: st-draw 5s ease-in-out infinite; }
  .cd-al { fill: var(--color-ink-faint); }
  .cd-l1 { fill: color-mix(in oklab, var(--color-changed) 7%, var(--color-surface)); stroke: var(--color-changed); }
  .cd-price { text-anchor: middle; }
  .cd-dom { opacity: 0; animation: dc-late 5s ease-in-out infinite; }

  /* ── EIP-2028 — cd-reduce: 68 → 16 gas per byte (5s) ── */
  .cd-bl { fill: var(--color-ink-faint); }
  .cd-track { fill: var(--color-surface); stroke: var(--color-border); }
  .cd-bar { transform-box: fill-box; transform-origin: left center; }
  .cd-barbefore { fill: color-mix(in oklab, var(--color-changed) 34%, var(--color-surface)); }
  .cd-barafter { fill: color-mix(in oklab, var(--color-node-leaf) 34%, var(--color-surface)); animation: cd-shrink 5s ease-in-out infinite; }
  @keyframes cd-shrink { 0%,20% { transform: scaleX(1) } 55%,100% { transform: scaleX(0.235) } }
  .cd-blbl { fill: var(--color-changed); font-family: var(--font-mono); font-size: 10px; }
  .cd-albl { font-family: var(--font-mono); font-size: 10px; animation: p0-albl 5s ease-in-out infinite; }
  .cd-save { opacity: 0; animation: dc-late 5s ease-in-out infinite; }

  /* ── EIP-2028 — cd-rollup: the L2 era ── */
  .cd-era { fill: var(--color-surface); stroke: var(--color-border-strong); opacity: 0; }
  .cd-era0 { animation: tw-rowin 5s ease-out infinite; }
  .cd-era1 { animation: tw-rowin 5s ease-out 0.3s infinite; }
  .cd-ec { text-anchor: middle; fill: var(--color-ink-faint); }
  .cd-blob { opacity: 0; animation: dc-late 5s ease-in-out infinite; }

  /* ── EIP-7002 — wr-clonly: only the signing key could exit ── */
  .wr-owner { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .wr-c { text-anchor: middle; fill: var(--color-ink-muted); }
  .wr-c2 { text-anchor: middle; fill: var(--color-ink-faint); }
  .wr-wall { stroke: var(--color-changed); stroke-width: 2.4; stroke-dasharray: 4 4; }
  .wr-blocked { animation: rv-pulse 5s ease-in-out infinite; }
  .wr-val { fill: color-mix(in oklab, var(--color-node-extension) 7%, var(--color-surface)); stroke: var(--color-node-extension); }
  .wr-trap { opacity: 0; animation: dc-late 5s ease-in-out infinite; }

  /* ── EIP-7002 — wr-request: an EL request the CL processes ── */
  .wr-a1 { stroke-dasharray: 56; stroke-dashoffset: 56; animation: st-draw 5s ease-in-out infinite; }
  .wr-a2 { stroke-dasharray: 28; stroke-dashoffset: 28; animation: st-draw 5s ease-in-out 0.4s infinite; }
  .wr-pre { fill: color-mix(in oklab, var(--color-hash) 9%, var(--color-surface)); stroke: var(--color-hash); }
  .wr-cl { fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); stroke: var(--color-node-leaf); opacity: 0; animation: cr-detin 5s ease-in-out infinite; }
  .wr-clt { text-anchor: middle; opacity: 0; animation: cr-detin 5s ease-in-out infinite; }

  /* ── EIP-7002 — wr-trustless: trustless pools & smart-account stakers ── */
  .wr-use { fill: var(--color-surface); stroke: var(--color-border-strong); opacity: 0; }
  .wr-use0 { animation: tw-rowin 5s ease-out infinite; }
  .wr-use1 { animation: tw-rowin 5s ease-out 0.3s infinite; }
  .wr-uc { text-anchor: middle; fill: var(--color-ink-faint); }
  .wr-pectra { opacity: 0; animation: dc-late 5s ease-in-out infinite; }

  /* ── EIP-4399 — pr-det: no randomness; DIFFICULTY abused, then gone ── */
  .pr-evm { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .pr-c { text-anchor: middle; fill: var(--color-ink-muted); }
  .pr-c2 { text-anchor: middle; fill: var(--color-ink-faint); }
  .pr-a1 { stroke-dasharray: 52; stroke-dashoffset: 52; animation: st-draw 5s ease-in-out infinite; }
  .pr-al { fill: var(--color-ink-faint); }
  .pr-diff { fill: color-mix(in oklab, var(--color-changed) 7%, var(--color-surface)); stroke: var(--color-changed); }
  .pr-difft { text-anchor: middle; }
  .pr-gone { opacity: 0; animation: dc-late 5s ease-in-out infinite; }

  /* ── EIP-4399 — pr-randao: RANDAO → PREVRANDAO ── */
  .pr-vslot { fill: color-mix(in oklab, var(--color-node-extension) 12%, var(--color-surface)); stroke: var(--color-node-extension); }
  .pr-vt { text-anchor: middle; fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 10px; }
  .pr-mix { animation: sc-vdot 3s ease-in-out infinite; }
  .pr-xor { fill: var(--color-ink-faint); font-family: var(--font-mono); font-size: 12px; }
  .pr-a2 { stroke-dasharray: 48; stroke-dashoffset: 48; animation: st-draw 5s ease-in-out infinite; }
  .pr-randbox { fill: color-mix(in oklab, var(--color-node-leaf) 10%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .pr-randt { text-anchor: middle; }
  .pr-a3 { stroke-dasharray: 26; stroke-dashoffset: 26; animation: st-draw 5s ease-in-out 0.4s infinite; }
  .pr-op { fill: color-mix(in oklab, var(--color-accent) 12%, var(--color-surface)); stroke: var(--color-accent); animation: tt-pulse 5s ease-in-out infinite; }
  .pr-now { opacity: 0; animation: dc-late 5s ease-in-out infinite; }

  /* ── EIP-4399 — pr-caveat: weak randomness ── */
  .pr-warn { fill: color-mix(in oklab, var(--color-changed) 6%, var(--color-surface)); stroke: var(--color-changed); }
  .pr-w1, .pr-w2 { text-anchor: middle; }
  .pr-w2 { animation: rv-pulse 5s ease-in-out infinite; }
  .pr-safe { fill: color-mix(in oklab, var(--color-node-leaf) 5%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .pr-sc { text-anchor: middle; fill: var(--color-ink-faint); }

  /* ── EIP-2537 — bls-gap: EVM couldn't verify the consensus curve ── */
  .bls-cl { fill: color-mix(in oklab, var(--color-node-extension) 7%, var(--color-surface)); stroke: var(--color-node-extension); }
  .bls-c { text-anchor: middle; fill: var(--color-ink-muted); }
  .bls-c2 { text-anchor: middle; fill: var(--color-ink-faint); }
  .bls-wall { stroke: var(--color-changed); stroke-width: 2.4; stroke-dasharray: 4 4; }
  .bls-blocked { animation: rv-pulse 5s ease-in-out infinite; }
  /* a BLS signature tries to reach the EVM, hits the wall, and rebounds */
  .bls-sig { fill: var(--color-node-extension); animation: bls-fly 5s ease-in-out infinite; }
  @keyframes bls-fly {
    0% { transform: translateX(0); opacity: 0; }
    12% { opacity: 1; }
    38% { transform: translateX(30px); opacity: 1; }
    48% { transform: translateX(14px); }
    60% { transform: translateX(24px); }
    78% { transform: translateX(0); opacity: 0.35; }
    100% { transform: translateX(0); opacity: 0; }
  }
  .bls-evm { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .bls-gap2 { opacity: 0; animation: dc-late 5s ease-in-out infinite; }

  /* ── EIP-2537 — bls-precompile: native BLS12-381 ── */
  .bls-pre { fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .bls-pt { text-anchor: middle; }
  .bls-op rect { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .bls-op { opacity: 0; }
  .bls-op0 { animation: tw-rowin 5s ease-out infinite; }
  .bls-op1 { animation: tw-rowin 5s ease-out 0.2s infinite; }
  .bls-op2 { animation: tw-rowin 5s ease-out 0.4s infinite; }
  .bls-opt { text-anchor: middle; fill: var(--color-accent-strong); }
  .bls-opn { text-anchor: middle; fill: var(--color-ink-faint); }
  .bls-cheap { opacity: 0; animation: dc-late 5s ease-in-out infinite; }
  /* a signature runs through the precompile row and emerges verified */
  .bls-tok { fill: var(--color-node-leaf); animation: bls-through 5s ease-in-out infinite; }
  @keyframes bls-through {
    0% { transform: translateX(0); opacity: 0; }
    10% { opacity: 1; }
    68% { transform: translateX(420px); opacity: 1; }
    80%, 100% { transform: translateX(420px); opacity: 0; }
  }
  .bls-verified { opacity: 0; animation: bls-vfade 5s ease-in-out infinite; }
  @keyframes bls-vfade { 0%, 68% { opacity: 0; } 80%, 100% { opacity: 1; } }

  /* ── EIP-2537 — bls-use: trustless bridges & aggregation ── */
  .bls-usebox { fill: var(--color-surface); stroke: var(--color-border-strong); opacity: 0; }
  .bls-usebox0 { animation: tw-rowin 5s ease-out infinite; }
  .bls-usebox1 { animation: tw-rowin 5s ease-out 0.3s infinite; }
  .bls-uc { text-anchor: middle; fill: var(--color-ink-faint); }
  .bls-align { opacity: 0; animation: dc-late 5s ease-in-out infinite; }
  /* a sync-committee signature crosses into the bridge and is verified */
  .bls-brtok { fill: var(--color-node-leaf); animation: bls-cross 5s ease-in-out infinite; }
  @keyframes bls-cross {
    0% { transform: translateX(0); opacity: 0; }
    15% { opacity: 1; }
    55% { transform: translateX(196px); opacity: 1; }
    66%, 100% { transform: translateX(196px); opacity: 0; }
  }
  .bls-brok { opacity: 0; animation: bls-vfade 5s ease-in-out infinite; }

  /* ── EIP-6110 — dp-poll: the CL polled+voted on the deposit contract ── */
  .dp-dc { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .dp-cl { fill: color-mix(in oklab, var(--color-node-extension) 7%, var(--color-surface)); stroke: var(--color-node-extension); }
  .dp-c { text-anchor: middle; fill: var(--color-ink-faint); }
  .dp-c2 { text-anchor: middle; fill: var(--color-ink-faint); }
  .dp-poll1 { stroke-dasharray: 6 6; animation: dp-trudge 5s linear infinite; }
  @keyframes dp-trudge { from { stroke-dashoffset: 24; } to { stroke-dashoffset: 0; } }
  .dp-pl { text-anchor: middle; fill: var(--color-changed); }
  .dp-slow { opacity: 0; animation: dc-late 5s ease-in-out infinite; }

  /* ── EIP-6110 — dp-inblock: deposits ride inside the block ── */
  .dp-block { fill: var(--color-surface); stroke: var(--color-border-strong); }
  .dp-txs { fill: color-mix(in oklab, var(--color-ink-faint) 12%, var(--color-surface)); stroke: var(--color-border-strong); }
  .dp-deps { fill: color-mix(in oklab, var(--color-node-leaf) 12%, var(--color-surface)); stroke: var(--color-node-leaf); opacity: 0; animation: tw-rowin 5s ease-out 0.3s infinite; }
  .dp-bt { text-anchor: middle; fill: var(--color-ink-muted); }
  .dp-depsl { fill: var(--color-node-leaf); }
  .dp-a2 { opacity: 0; animation: dc-late 5s ease-in-out 0.6s infinite; }
  .dp-clbox { fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); stroke: var(--color-node-leaf); opacity: 0; animation: dc-late 5s ease-in-out 0.9s infinite; }
  .dp-clt { text-anchor: middle; }

  /* ── EIP-6110 — dp-fast: activation time collapses ── */
  .dp-wl { fill: var(--color-ink-faint); }
  .dp-track { fill: color-mix(in oklab, var(--color-ink-faint) 8%, var(--color-surface)); stroke: var(--color-border-strong); }
  .dp-wbefore { fill: color-mix(in oklab, var(--color-changed) 45%, var(--color-surface)); stroke: var(--color-changed); transform-box: fill-box; transform-origin: left center; animation: dp-fill 5s ease-out infinite; }
  @keyframes dp-fill { 0% { transform: scaleX(0); } 60%, 100% { transform: scaleX(1); } }
  .dp-bl { fill: var(--color-changed); }
  .dp-wafter { fill: color-mix(in oklab, var(--color-node-leaf) 55%, var(--color-surface)); stroke: var(--color-node-leaf); transform-box: fill-box; transform-origin: left center; transform: scaleX(0.03); }
  .dp-al { fill: var(--color-node-leaf); }
  .dp-simpl { opacity: 0; animation: dc-late 5s ease-in-out 0.5s infinite; }

  /* ── EIP-2200 — ss-naive: per-write pricing overcharges ── */
  .ss-slot { fill: color-mix(in oklab, var(--color-node-branch) 8%, var(--color-surface)); stroke: var(--color-node-branch); }
  .ss-sl { text-anchor: middle; fill: var(--color-ink-muted); }
  .ss-op { fill: var(--color-surface); stroke: var(--color-changed); }
  .ss-opt { text-anchor: middle; fill: var(--color-changed); }
  .ss-w { opacity: 0; }
  .ss-w0 { animation: tw-rowin 5s ease-out infinite; }
  .ss-w1 { animation: tw-rowin 5s ease-out 0.35s infinite; }
  .ss-w2 { animation: tw-rowin 5s ease-out 0.7s infinite; }
  .ss-sum { opacity: 0; animation: dc-late 5s ease-in-out 1s infinite; }

  /* ── EIP-2200 — ss-net: net metering, and the stipend hole ── */
  .ss-cheapbox { fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .ss-cheap { text-anchor: middle; }
  .ss-dn { opacity: 0; animation: dc-late 5s ease-in-out 0.4s infinite; }
  .ss-hole { fill: color-mix(in oklab, var(--color-changed) 6%, var(--color-surface)); stroke: var(--color-changed); stroke-dasharray: 4 4; opacity: 0; animation: dc-late 5s ease-in-out 0.7s infinite; }
  .ss-hl { text-anchor: middle; fill: var(--color-ink-muted); opacity: 0; animation: dc-late 5s ease-in-out 0.9s infinite; }
  .ss-hl2 { text-anchor: middle; fill: var(--color-changed); opacity: 0; animation: dc-late 5s ease-in-out 1.1s infinite; }
  .ss-post { fill: var(--color-changed); opacity: 0; animation: dc-late 5s ease-in-out 1.4s infinite; }

  /* ── EIP-2200 — ss-sentry: the guard restores safety ── */
  .ss-gate { fill: color-mix(in oklab, var(--color-node-leaf) 8%, var(--color-surface)); stroke: var(--color-node-leaf); }
  .ss-gt { text-anchor: middle; }
  .ss-ll { fill: var(--color-ink-faint); text-anchor: start; }
  .ss-block { stroke: var(--color-changed); animation: rv-pulse 5s ease-in-out infinite; }
  .ss-bl { fill: var(--color-changed); }
  .ss-pass { stroke: var(--color-node-leaf); }
  .ss-pl { fill: var(--color-node-leaf); }

  /* ── EIP-3860 — ic-gap: uncapped, unpriced initcode ── */
  .ic-init { fill: color-mix(in oklab, var(--color-accent) 7%, var(--color-surface)); stroke: var(--color-accent-dim); }
  .ic-it { text-anchor: middle; fill: var(--color-ink-muted); }
  .ic-a1 { opacity: 0; animation: dc-late 5s ease-in-out infinite; }
