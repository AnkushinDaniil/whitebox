  @keyframes niblit { 0%,4% { fill: var(--color-surface) } 10%,40% { fill: color-mix(in oklab, var(--color-accent) 16%, var(--color-surface)) } 55%,100% { fill: var(--color-surface) } }
  @keyframes rootflash { 0%,68% { stroke: var(--color-accent); filter: none } 80% { stroke: var(--color-node-leaf); filter: drop-shadow(0 0 7px var(--color-accent-dim)) } 100% { stroke: var(--color-accent); filter: none } }

  /* network: copies fan out */
  .copy { opacity: 0; transform-box: fill-box; transform-origin: center; }
