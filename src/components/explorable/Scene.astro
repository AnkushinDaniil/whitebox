    {/* ── state root: the whole sheet folds into one hash in a header ── */}
    {name === "root" && (
      <svg viewBox="0 0 480 210" role="img" aria-label="Editing one account produces a brand-new state root">
        {[0, 1, 2].map((i) => (
          <g class={`rt-row rr${i}`}>
            <rect class={`cell${i === 0 ? " rt-editcell" : ""}`} x="18" y={44 + i * 34} width="124" height="26" rx="5" />
            <text class="t-l" x="30" y={62 + i * 34}>{["0xA1…", "0xB2…", "0xC3…"][i]}</text>
            <text class="t-r" x="130" y={62 + i * 34}>{["14 Ξ", "9 Ξ", "2 Ξ"][i]}</text>
